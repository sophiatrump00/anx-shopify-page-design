{% comment %}SuntNeew B21AP tabbed PDP aligned with A20-v8 modular architecture (interactive feature pairs, 6 tabs, progressive FAQ, native cart form, and Judge.me reviews).{% endcomment %}
{{ 'suntneew-a20-v8.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suntneew-b21ap-v1.js' | asset_url }}" defer></script>
<script src="{{ 'suntneew-purchase-panel.js' | asset_url }}" defer></script>
<script src="{{ 'suntneew-progressive-faq.js' | asset_url }}" defer></script>
<style>
  .sn-b21ap-pdp .instructions-layout .starting-details:first-of-type { margin-top: 0; }
  .sn-b21ap-pdp .instructions-layout .starting-details + .starting-details { margin-top: 14px; }
  .sn-b21ap-pdp .pair-tabs { flex-wrap: wrap; gap: 6px 20px; }
</style>
{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'b21ap-product-form-' | append: section.id
  assign rating = product.metafields.reviews.rating.value
  assign review_count = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
  assign gallery_images = product.media | where: 'media_type', 'image'
  assign max_qty = 999
  if selected_variant.inventory_management != blank and selected_variant.inventory_policy == 'deny'
    assign max_qty = selected_variant.inventory_quantity | default: 1 | at_least: 1
  endif
  assign unit_price_cents = selected_variant.price | default: 9499
  assign compare_price_cents = selected_variant.compare_at_price | default: 0
  assign has_saving = false
  if compare_price_cents > unit_price_cents
    assign has_saving = true
    assign saving_cents = compare_price_cents | minus: unit_price_cents
  endif
%}

<div class="sn-a20-pdp sn-b21ap-pdp" data-b21ap-pdp data-form="{{ product_form_id }}">
  <script type="application/json" data-b21ap-variant>
    {
      "id": {{ selected_variant.id | append: '' | json }},
      "sku": {{ selected_variant.sku | default: 'SN-US-JS-B21AP' | json }},
      "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "priceCents": {{ unit_price_cents | json }},
      "compareAtCents": {{ compare_price_cents | json }},
      "available": {{ selected_variant.available | json }},
      "maxQty": {{ max_qty | json }}
    }
  </script>

  <div class="preview-frame" id="frame">
    <div class="storefront" id="top">
      <div class="breadcrumb content" role="navigation" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">›</span>
        <a href="{{ routes.collections_url }}/jump-starters">Jump Starters</a>
        <span aria-hidden="true">›</span>
        <a href="#sales-summary" aria-current="page">B21AP</a>
      </div>

      <section id="gallery" class="product-hero" aria-labelledby="product-title">
        <div class="product-gallery">
          <div id="gallery-content" aria-busy="false">
            <div class="feature-pair gallery-pair" data-carousel="gallery">
              <div class="pair-track" id="pair-gallery" tabindex="0" role="region" aria-label="B21AP product images">
                {%- assign gallery_labels = 'B21AP kit & nozzles|2-in-1 jump starter & 160 PSI pump|5,000A cold-weather start|20,000mAh / 74Wh battery|160 PSI auto-stop compressor|10-protection smart clamps|Roadside & outdoor scenarios|Complete kit contents' | split: '|' -%}
                {%- if gallery_images.size > 0 -%}
                  {%- for media in gallery_images -%}
                    {%- assign slide_label = gallery_labels[forloop.index0] | default: media.alt | default: product.title -%}
                    {%- assign slide_src = media | image_url: width: 1200 -%}
                    {%- assign slide_zoom_src = media | image_url: width: 2000 -%}
                    <article class="feature-card" id="feature-gallery-0{{ forloop.index }}">
                      <h3 class="card-title"><span class="card-number">0{{ forloop.index }}</span>{{ slide_label | escape }}</h3>
                      <div class="image-module">
                        <button class="image-button" type="button" data-zoom-trigger data-zoom-src="{{ slide_zoom_src }}" data-zoom-title="{{ slide_label | escape }}" data-zoom-gallery-index="{{ forloop.index0 }}" aria-label="Enlarge {{ slide_label | escape }} image">
                          {%- if forloop.first -%}
                            <img src="{{ slide_src }}" width="1000" height="1000" alt="{{ media.alt | default: product.title | escape }}" loading="eager" fetchpriority="high" decoding="async" draggable="false">
                          {%- else -%}
                            <img src="{{ slide_src }}" width="1000" height="1000" alt="{{ media.alt | default: product.title | escape }}" loading="lazy" decoding="async" draggable="false">
                          {%- endif -%}
                          <span class="zoom-label" aria-hidden="true">+</span>
                        </button>
                      </div>
                    </article>
                  {%- endfor -%}
                {%- else -%}
                  <article class="feature-card" id="feature-gallery-01">
                    <h3 class="card-title"><span class="card-number">01</span>B21AP Kit</h3>
                    <div class="image-module">
                      <button class="image-button" type="button" data-zoom-trigger data-zoom-src="{{ 'suntneew-b21ap-gallery-01-main.jpg' | asset_url }}" data-zoom-title="B21AP Kit" data-zoom-gallery-index="0" aria-label="Enlarge B21AP Kit image">
                        <img src="{{ 'suntneew-b21ap-gallery-01-main.jpg' | asset_url }}" width="1000" height="1000" alt="{{ product.title | escape }}" loading="eager" fetchpriority="high" decoding="async" draggable="false">
                        <span class="zoom-label" aria-hidden="true">+</span>
                      </button>
                    </div>
                  </article>
                {%- endif -%}
              </div>

              {%- assign slide_count = gallery_images.size | at_least: 1 -%}
              <p class="gallery-current">{{ gallery_labels[0] | escape }}</p>
              <div class="pair-controls">
                <p class="pair-hint">
                  <span class="pair-hint-desktop">Drag or use the arrows</span>
                  <span class="pair-hint-mobile">Swipe to explore</span>
                </p>
                <span class="pair-counter" aria-live="polite" aria-atomic="true">1 / {{ slide_count }}</span>
                <div class="pair-arrows">
                  <button type="button" data-carousel-prev aria-label="Previous product image" aria-controls="pair-gallery" disabled>←</button>
                  <button type="button" data-carousel-next aria-label="Next product image" aria-controls="pair-gallery"{% if slide_count <= 1 %} disabled{% endif %}>→</button>
                </div>
              </div>

              {%- if gallery_images.size > 1 -%}
                <div class="pair-tabs gallery-thumbnails" aria-label="Product image thumbnails">
                  {%- for media in gallery_images -%}
                    {%- assign slide_label = gallery_labels[forloop.index0] | default: media.alt | default: product.title -%}
                    <button type="button" data-carousel-tab="{{ forloop.index0 }}" data-slide-label="{{ slide_label | escape }}" aria-controls="feature-gallery-0{{ forloop.index }}" aria-label="Show image {{ forloop.index }}: {{ slide_label | escape }}" title="{{ slide_label | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                      <img src="{{ media | image_url: width: 176 }}" alt="" width="88" height="88" loading="lazy" decoding="async" draggable="false">
                    </button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </div>

          <p class="gallery-help">
            <span class="gallery-help-desktop">Move over the image to browse photos. Click to enlarge.</span>
            <span class="gallery-help-mobile">Swipe to explore · Tap an image to enlarge.</span>
          </p>

          <div class="gallery-assurances-slot" id="gallery-assurances-slot">
            <div class="assurances" id="purchase-assurances" role="group" aria-label="Delivery, warranty and product support">
              <details name="b21ap-assurance" data-assurance-key="0">
                <summary>
                  <svg viewBox="0 0 24 24" class="assurance-icon" aria-hidden="true"><path d="M12 3 20 6v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"></path><path d="m8.5 12 2.2 2.2 4.8-5"></path></svg>
                  <span><strong>2-year warranty</strong><small>Manufacturer warranty under normal use.</small></span>
                  <span class="assurance-chevron" aria-hidden="true"></span>
                </summary>
                <div class="assurance-panel">
                  <div class="assurance-panel-heading"><strong>2-year warranty</strong><button type="button" class="assurance-close" aria-label="Close 2-year warranty details">×</button></div>
                  <p>Two years from delivery for manufacturing defects and component failure under normal use. Keep your proof of purchase and follow the B21AP manual.</p>
                  <a href="/pages/warranty" target="_blank" rel="noopener">Warranty &amp; service details ↗</a>
                </div>
              </details>
              <details name="b21ap-assurance" data-assurance-key="1">
                <summary>
                  <svg viewBox="0 0 24 24" class="assurance-icon" aria-hidden="true"><path d="M4 7h16v12H4z"></path><path d="m4 10 8 4 8-4M8 5h8"></path></svg>
                  <span><strong>30-Day Returns</strong><small>Request an eligible return within 30 days after delivery.</small></span>
                  <span class="assurance-chevron" aria-hidden="true"></span>
                </summary>
                <div class="assurance-panel">
                  <div class="assurance-panel-heading"><strong>30-Day Returns</strong><button type="button" class="assurance-close" aria-label="Close 30-Day Returns details">×</button></div>
                  <p>Contact us for approval and an RMA before shipping. Return eligibility and shipping terms follow the return policy.</p>
                  <a href="/pages/return-policy" target="_blank" rel="noopener">Read the return policy ↗</a>
                </div>
              </details>
              <details name="b21ap-assurance" data-assurance-key="2">
                <summary>
                  <svg viewBox="0 0 24 24" class="assurance-icon" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"></path><circle cx="7" cy="18" r="2"></circle><circle cx="18" cy="18" r="2"></circle></svg>
                  <span><strong>U.S. Warehouse Delivery</strong><small>Stocked B21AP kits ship domestically.</small></span>
                  <span class="assurance-chevron" aria-hidden="true"></span>
                </summary>
                <div class="assurance-panel">
                  <div class="assurance-panel-heading"><strong>U.S. Warehouse Delivery</strong><button type="button" class="assurance-close" aria-label="Close U.S. Warehouse Delivery details">×</button></div>
                  <p>Allow 2 business days for processing, plus an estimated 2–5 business days in transit after dispatch (Monday–Friday, excluding holidays).</p>
                  <a href="/pages/shipping-policy" target="_blank" rel="noopener">Review shipping details ↗</a>
                </div>
              </details>
              <details name="b21ap-assurance" data-assurance-key="3">
                <summary>
                  <svg viewBox="0 0 24 24" class="assurance-icon" aria-hidden="true"><path d="M3 12h18M12 3v18M6 6l12 12M18 6 6 18"></path></svg>
                  <span><strong>Free U.S. Shipping</strong><small>Standard shipping to the contiguous 48 states and DC.</small></span>
                  <span class="assurance-chevron" aria-hidden="true"></span>
                </summary>
                <div class="assurance-panel">
                  <div class="assurance-panel-heading"><strong>Free U.S. Shipping</strong><button type="button" class="assurance-close" aria-label="Close Free U.S. Shipping details">×</button></div>
                  <p>Alaska, Hawaii, Puerto Rico, other U.S. territories, military addresses and destinations outside the U.S. are excluded.</p>
                  <a href="/pages/shipping-policy" target="_blank" rel="noopener">See eligibility ↗</a>
                </div>
              </details>
              <details name="b21ap-assurance" data-assurance-key="4">
                <summary>
                  <svg viewBox="0 0 24 24" class="assurance-icon" aria-hidden="true"><path d="M4 5h16v12H8l-4 4zM8 9h8M8 13h5"></path></svg>
                  <span><strong>Product Support</strong><small>Help with setup, inflation presets and clamp alerts.</small></span>
                  <span class="assurance-chevron" aria-hidden="true"></span>
                </summary>
                <div class="assurance-panel">
                  <div class="assurance-panel-heading"><strong>Product Support</strong><button type="button" class="assurance-close" aria-label="Close Product Support details">×</button></div>
                  <p>Tell us your question or include your order number for service assistance.</p>
                  <a href="/pages/support-b21ap" target="_blank" rel="noopener">B21AP product support ↗</a>
                </div>
              </details>
            </div>
          </div>
        </div>

        <div class="product-summary" id="sales-summary">
          <p class="eyebrow">B21AP / 2-IN-1 ROADSIDE KIT</p>
          <h1 id="product-title">{{ product.title }}</h1>
          <p class="product-spec-line">12V · 5,000A peak · 160 PSI auto-stop · 20,000mAh · PD 45W</p>

          {%- if rating != blank and review_count > 0 -%}
            <a class="rating-link" href="#reviews">
              <span class="stars" aria-label="{{ rating.rating }} out of {{ rating.scale_max }} stars">★★★★★</span>
              <strong>{{ rating.rating | round: 1 }}</strong>
              <span>{{ 'product.rating_count' | t: count: review_count }}</span>
            </a>
          {%- endif -%}

          <div class="sn-pack-total" aria-live="polite" aria-atomic="true">
            <p class="sn-pack-total__label">Total price</p>
            <div class="sn-pack-total__amounts">
              <strong id="total-price">{{ unit_price_cents | money }}</strong>
              <del id="compare-price"{% unless has_saving %} hidden{% endunless %}>{% if has_saving %}{{ compare_price_cents | money }}{% endif %}</del>
              <span>{{ cart.currency.iso_code | default: shop.currency }}</span>
            </div>
            <p class="sn-pack-total__saving" id="total-saving"{% unless has_saving %} hidden{% endunless %}>
              {% if has_saving %}You save {{ saving_cents | money }} in total vs. regular price{% endif %}
            </p>
          </div>
          <p class="product-tax">Taxes calculated at checkout.</p>

          {%- render 'suntneew-promo-bar', context: 'pdp' -%}

          <p class="product-description">Jump-start dead 12V gas or diesel engines, inflate tires automatically up to 160 PSI, and fast-charge devices from one carry-ready kit.</p>

          <ul class="product-highlights" id="product-highlights" data-collapsed="true" aria-label="Product highlights">
            <li><span><strong>5,000A peak cranking power.</strong> Rated for 12V vehicles up to 9.0L gas or 6.0L diesel in −20°C to 75°C weather.</span></li>
            <li><span><strong>160 PSI smart air compressor.</strong> 4 presets (Car, Motorcycle, Bike, Ball) with real-time PSI gauge and automatic shutoff.</span></li>
            <li><span><strong>Spark-proof smart clamps.</strong> Built-in 10+ safety protections with clear status indicators and buzzer alerts.</span></li>
            <li class="sn-highlight-extra"><span><strong>20,000mAh power bank &amp; PD 45W.</strong> High-density 74Wh reserve with two-way USB-C PD 45W and USB-A fast output.</span></li>
            <li class="sn-highlight-extra"><span><strong>3-mode LED light &amp; EVA hard case.</strong> Steady, Red Warning, and SOS modes packed cleanly with braided air hose &amp; nozzles.</span></li>
          </ul>
          <button type="button" class="sn-highlights-toggle" id="highlights-toggle" aria-controls="product-highlights" aria-expanded="false">+ 2 more highlights ▾</button>

          {% form 'product', product, is: 'product-form', id: product_form_id %}
            <p class="quantity-label"><label id="quantity-label" for="quantity">Number of units</label></p>
            <div class="purchase-row">
              <div class="quantity-control">
                <button id="quantity-minus" type="button" aria-label="Decrease quantity" disabled>−</button>
                <input id="quantity" type="number" min="1" step="1" value="1" inputmode="numeric" aria-describedby="quantity-summary" name="quantity" max="{{ max_qty }}"{% unless selected_variant.available %} disabled{% endunless %}>
                <button id="quantity-plus" type="button" aria-label="Increase quantity"{% unless selected_variant.available and max_qty > 1 %} disabled{% endunless %}>+</button>
              </div>
              <button id="purchase-button" class="purchase-button" type="submit"{% unless selected_variant.available %} disabled{% endunless %}>
                <span id="purchase-label">{% if selected_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
              </button>
            </div>
            <button type="button" class="buy-now"{% unless selected_variant.available %} disabled{% endunless %} data-suntneew-buy-now>Buy now</button>
            <input type="hidden" name="id" id="selected-variant" value="{{ selected_variant.id }}"{% unless selected_variant.available %} disabled{% endunless %}>
          {% endform %}

          <div class="cart-feedback-bar">
            <p class="cart-feedback" role="status" aria-live="polite" hidden></p>
            <div class="cart-feedback-actions">
              <a class="cart-feedback-link" href="{{ routes.cart_url }}" hidden>View your cart</a>
              <a class="cart-checkout-link" href="/checkout" hidden>Checkout now →</a>
            </div>
          </div>

          <p class="quantity-summary" id="quantity-summary" aria-live="polite" aria-atomic="true">1 unit · {{ unit_price_cents | money }} per unit</p>
          <p class="stock-status" id="stock-status" role="status"{% if selected_variant.available %} hidden{% endif %}>{% unless selected_variant.available %}{{ 'product.general.sold_out_button' | t }}{% endunless %}</p>
          <a class="fit-help" href="#specs">Check specifications &amp; compatibility →</a>

          <div class="purchase-trust" aria-label="Payment and purchase support">
            <p class="payment-title">Pay securely with</p>
            <ul class="payment-icons" aria-label="Accepted payment methods">
              {%- for type in shop.enabled_payment_types -%}
                <li title="{{ type | replace: '_', ' ' | escape }}">{{ type | payment_type_svg_tag }}</li>
              {%- endfor -%}
            </ul>
            <div class="mobile-assurances-slot" id="mobile-assurances-slot"></div>
          </div>

          <div class="product-links">
            <a href="#manuals">B21AP manual ↗</a>
            <a href="/pages/support-b21ap" target="_blank" rel="noopener">Product support ↗</a>
          </div>
        </div>
      </section>

      <nav class="product-nav content" role="tablist" aria-label="Product sections">
        <a id="b21ap-tab-features" class="active" href="#features" role="tab" aria-selected="true" aria-controls="b21ap-panel-features" data-pdp-tab="features">Features</a>
        <a id="b21ap-tab-specs" href="#specs" role="tab" aria-selected="false" aria-controls="b21ap-panel-specs" tabindex="-1" data-pdp-tab="specs">Specs</a>
        <a id="b21ap-tab-box" href="#box" role="tab" aria-selected="false" aria-controls="b21ap-panel-box" tabindex="-1" data-pdp-tab="box">In the box</a>
        <a id="b21ap-tab-manuals" href="#manuals" role="tab" aria-selected="false" aria-controls="b21ap-panel-manuals" tabindex="-1" data-pdp-tab="manuals">Manual <span class="nav-badge">PDF</span></a>
        <a id="b21ap-tab-reviews" href="#reviews" role="tab" aria-selected="false" aria-controls="b21ap-panel-reviews" tabindex="-1" data-pdp-tab="reviews"><span class="nav-star" aria-hidden="true">★</span> Reviews{% if review_count > 0 %} <span class="nav-count">({{ review_count }})</span>{% endif %}</a>
        <a id="b21ap-tab-faq" href="#faq" role="tab" aria-selected="false" aria-controls="b21ap-panel-faq" tabindex="-1" data-pdp-tab="faq">FAQ</a>
      </nav>

      <div class="pdp-tab-panels" id="pdp-tab-panels">
        <!-- TAB 1: FEATURES -->
        <div class="pdp-tab-panel" id="b21ap-panel-features" role="tabpanel" aria-labelledby="b21ap-tab-features" data-tab-panel="features">
          <div class="intro content" id="features">
            <p class="eyebrow">B21AP / ALL-IN-ONE ROAD PROTECTION</p>
            <h2 class="features-title">Product Features</h2>
            <p class="lead">5,000A 12V jump-starting power and a 160 PSI auto-stop tire inflator together in one trunk-ready kit.</p>
          </div>

          <div id="feature-content">
            <!-- Hero Opening Banner -->
            <section data-group="01" id="feature-01" aria-label="B21AP product introduction" class="feature-opening">
              <div class="image-module">
                <button class="image-button" type="button" data-zoom-trigger data-zoom-src="https://cdn.shopify.com/s/files/1/0903/4815/9271/files/b21ap-aplus-01-hero.jpg?v=1795491350" data-zoom-title="B21AP 2-in-1 Jump Starter & Air Compressor" aria-label="Enlarge B21AP introduction image">
                  <img src="https://cdn.shopify.com/s/files/1/0903/4815/9271/files/b21ap-aplus-01-hero.jpg?v=1795491350&amp;width=1200" width="1464" height="600" loading="lazy" decoding="async" alt="SuntNeew B21AP 2-in-1 Jump Starter with 160 PSI Air Compressor" draggable="false">
                  <span class="zoom-label" aria-hidden="true">+</span>
                </button>
              </div>
            </section>

            <!-- 01 / GET A JUMP -->
            <section data-group="02" id="feature-02" aria-label="Start big 12V engines without waiting on a tow." class="feature-section">
              <div class="section-heading">
                <p class="eyebrow">01 / GET A JUMP</p>
                <h2>Start big 12V engines without waiting on a tow.</h2>
                <p>Built for sedans, SUVs, pickup trucks, motorcycles, and RVs. With 5,000A peak (2,500A starting) current and a −20°C to 75°C (−4°F to 167°F) operating range, B21AP cranks 12V engines up to 9.0L gas and 6.0L diesel in seconds.</p>
              </div>
              <div class="image-module">
                <button class="image-button" type="button" data-zoom-trigger data-zoom-src="https://cdn.shopify.com/s/files/1/0903/4815/9271/files/b21ap-aplus-02-5000a.jpg?v=1795491350" data-zoom-title="5000A Peak Jump Start Performance" aria-label="Enlarge 5000A peak starting performance image">
                  <img src="https://cdn.shopify.com/s/files/1/0903/4815/9271/files/b21ap-aplus-02-5000a.jpg?v=1795491350&amp;width=1200" width="1464" height="600" loading="lazy" decoding="async" alt="5000A Peak Jump Start for Large 12V Vehicles" draggable="false">
                  <span class="zoom-label" aria-hidden="true">+</span>
                </button>
              </div>
            </section>

            <!-- 02 / 160 PSI AIR COMPRESSOR (Interactive Sub-Feature Zone) -->
            <section data-group="03" id="feature-03" aria-label="Top off a flat tire—and let it stop itself." class="feature-section">
              <div class="section-heading">
                <p class="eyebrow">02 / 160 PSI AIR COMPRESSOR</p>
                <h2>Top off a flat tire—and let it stop itself.</h2>
                <p>A metal-cylinder compressor fills a standard car tire from 0 to 35 PSI in about 5 minutes. Pick from Car, Motorcycle, Bike, or Ball presets across PSI, BAR, KPA, and kg/cm²—B21AP stops automatically once it hits your target.</p>
              </div>
              <div class="feature-pair" data-carousel="pair-03">
                <div class="pair-tabs" aria-label="Choose a tire inflation feature">
                  <button type="button" data-carousel-tab="0" aria-controls="feature-03-a" aria-pressed="true">Metal-Cylinder Pump</button>
                  <button type="button" data-carousel-tab="1" aria-controls="feature-03-b" aria-pressed="false">3–160 PSI Presets</button>
                  <button type="button" data-carousel-tab="2" aria-controls="feature-03-c" aria-pressed="false">160 PSI All-Scenario</button>
                </div>
                <div class="pair-track" id="pair-03" tabindex="0" role="region" aria-label="Metal-Cylinder Pump, 3–160 PSI Presets, and 160 PSI All-Scenario">
                  <article class="feature-card" id="feature-03-a">
                    <h3 class="card-title"><span class="card-number">01</span>Metal-Cylinder Pump</h3>
                    <div class="image-module">
                      <button class="image-button" type="button" data-zoom-trigger data-zoom-src="https://cdn.shopify.com/s/files/1/0903/4815/9271/files/b21ap-aplus-03-compressor.jpg?v=1795491350" data-zoom-title="High-Speed Metal-Cylinder Compressor" aria-label="Enlarge Metal-Cylinder Air Compressor image">
                        <img src="https://cdn.shopify.com/s/files/1/0903/4815/9271/files/b21ap-aplus-03-compressor.jpg?v=1795491350&amp;width=1200" width="1464" height="600" loading="lazy" decoding="async" alt="Professional Grade Metal-Cylinder Air Compressor" draggable="false">
                        <span class="zoom-label" aria-hidden="true">+</span>
                      </button>
                    </div>
                  </article>
                  <article class="feature-card" id="feature-03-b">
                    <h3 class="card-title"><span class="card-number">02</span>3–160 PSI Presets</h3>
                    <div class="image-module">
                      <button class="image-button" type="button" data-zoom-trigger data-zoom-src="https://cdn.shopify.com/s/files/1/0903/4815/9271/files/b21ap-aplus-04-inflate-anything.jpg?v=1795491350" data-zoom-title="Inflate Anything from 3 to 160 PSI" aria-label="Enlarge 3 to 160 PSI Presets image">
