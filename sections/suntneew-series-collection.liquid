<section class="sn-series-page sn-series-page--{{ section.settings.catalog_state }}" id="{{ section.settings.anchor_id | escape }}" data-series-collection data-default-view="{{ section.settings.default_view | escape }}">
  <div class="sn-series-page__hero">
    <div class="sn-series-page__hero-media" aria-hidden="true">
      <picture>
        {%- if section.settings.hero_mobile_asset != blank -%}
          <source media="(max-width: 699px)" srcset="{{ section.settings.hero_mobile_asset | asset_url }}">
        {%- endif -%}
        <img src="{{ section.settings.hero_asset | asset_url }}" alt="" width="2400" height="1000" loading="eager">
      </picture>
    </div>
    <div class="sn-series-shell sn-series-page__hero-copy">
      <p class="sn-kicker">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.body }}</p>
      {%- if section.settings.back_link != blank -%}
        <a class="sn-series-button" href="{{ section.settings.back_link }}">{{ section.settings.back_label }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="sn-series-shell sn-series-page__content">
    {%- if section.settings.catalog_state == 'available' -%}
      <header class="sn-series-page__catalog-heading">
        <p class="sn-kicker">{{ section.settings.catalog_eyebrow }}</p>
        <h2>{{ section.settings.catalog_heading }}</h2>
        {%- if section.settings.catalog_body != blank -%}<p>{{ section.settings.catalog_body }}</p>{%- endif -%}
      </header>

      <div class="sn-series-page__catalog-controls">
        <div class="sn-series-page__capacity-filter" role="group" aria-label="{{ section.settings.capacity_filter_label | escape }}">
          <button type="button" class="sn-series-control is-selected" data-series-filter="" aria-pressed="true">{{ section.settings.all_capacity_label }}</button>
          {%- assign rendered_filters = '|' -%}
          {%- for block in section.blocks -%}
            {%- assign filter_value = block.settings.filter_value | handleize -%}
            {%- capture filter_token -%}|{{ filter_value }}|{%- endcapture -%}
            {%- if filter_value != blank -%}
              {%- unless rendered_filters contains filter_token -%}
                <button type="button" class="sn-series-control" data-series-filter="{{ filter_value | escape }}" aria-pressed="false">{{ block.settings.filter_label | default: block.settings.filter_value }}</button>
                {%- assign rendered_filters = rendered_filters | append: filter_value | append: '|' -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="sn-series-page__view-switcher" role="group" aria-label="{{ section.settings.view_label | escape }}">
          <button type="button" class="sn-series-control{% if section.settings.default_view == 'cards' %} is-selected{% endif %}" data-series-view="cards" aria-pressed="{% if section.settings.default_view == 'cards' %}true{% else %}false{% endif %}">{{ section.settings.cards_label }}</button>
          <button type="button" class="sn-series-control{% if section.settings.default_view == 'list' %} is-selected{% endif %}" data-series-view="list" aria-pressed="{% if section.settings.default_view == 'list' %}true{% else %}false{% endif %}">{{ section.settings.list_label }}</button>
        </div>
      </div>

      <div class="sn-series-product-grid sn-series-product-grid--count-{{ section.blocks.size }}{% if section.settings.default_view == 'list' %} sn-series-product-grid--list{% endif %}" data-series-products>
        {%- for block in section.blocks -%}
          <article class="sn-series-product-card" data-series-product data-filter-value="{{ block.settings.filter_value | handleize | escape }}" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: routes.collections_url }}" class="sn-series-product-card__link" aria-label="{{ block.settings.title | escape }}">
              <span class="sn-series-product-card__image">
                {%- if block.settings.image != blank -%}
                  {{- block.settings.image | image_url: width: 1200 | image_tag: widths: '420,600,900,1200', sizes: '(max-width: 699px) 100vw, (max-width: 999px) 50vw, 33vw', loading: 'lazy', alt: block.settings.image_alt -}}
                {%- else -%}
                  <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="1200" height="1200" loading="lazy">
                {%- endif -%}
                {%- if block.settings.badge != blank -%}<span class="sn-series-product-card__badge">{{ block.settings.badge }}</span>{%- endif -%}
              </span>
              <span class="sn-series-product-card__content">
                <span class="sn-series-product-card__eyebrow">{{ block.settings.eyebrow }}</span>
                <strong>{{ block.settings.title }}</strong>
                <span class="sn-series-product-card__copy">{{ block.settings.text }}</span>
                <span class="sn-series-product-card__facts">
                  {%- if block.settings.fact_one != blank -%}<span>{{ block.settings.fact_one }}</span>{%- endif -%}
                  {%- if block.settings.fact_two != blank -%}<span>{{ block.settings.fact_two }}</span>{%- endif -%}
                  {%- if block.settings.fact_three != blank -%}<span>{{ block.settings.fact_three }}</span>{%- endif -%}
                </span>
                <span class="sn-series-arrow">{{ block.settings.link_label }}</span>
              </span>
            </a>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="sn-series-empty" role="status">
        <p class="sn-kicker">{{ section.settings.empty_eyebrow }}</p>
        <h2>{{ section.settings.empty_heading }}</h2>
        <p>{{ section.settings.empty_body }}</p>
        {%- if section.settings.empty_link != blank -%}
          <a class="sn-series-button sn-series-button--light" href="{{ section.settings.empty_link }}">{{ section.settings.empty_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-series-collection]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const grid = root.querySelector('[data-series-products]');
    const cards = [...root.querySelectorAll('[data-series-product]')];
    const filterButtons = [...root.querySelectorAll('[data-series-filter]')];
    const viewButtons = [...root.querySelectorAll('[data-series-view]')];

    const selectView = (view) => {
      if (!grid) return;
      grid.classList.toggle('sn-series-product-grid--list', view === 'list');
      viewButtons.forEach((button) => {
        const selected = button.dataset.seriesView === view;
        button.classList.toggle('is-selected', selected);
        button.setAttribute('aria-pressed', String(selected));
      });
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.seriesFilter || '';
        filterButtons.forEach((item) => {
          const selected = item === button;
          item.classList.toggle('is-selected', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        cards.forEach((card) => {
          card.hidden = value !== '' && card.dataset.filterValue !== value;
        });
      });
    });

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => selectView(button.dataset.seriesView));
    });

    selectView(root.dataset.defaultView || 'cards');
  })();
</script>

{% schema %}
{
  "name": "SuntNeew series page",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anchor ID","default":"series"},
    {"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"PRODUCT SERIES"},
