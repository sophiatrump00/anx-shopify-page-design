    {"type":"textarea","id":"body","label":"Hero body","default":"Explore the products and configurations in this series."},
    {"type":"select","id":"hero_asset","label":"Hero asset","default":"suntneew-hero-a20-desktop.jpg","options":[{"value":"suntneew-rv-series-hero-desktop.jpg","label":"RV series hero"},{"value":"suntneew-hero-rv-desktop.jpg","label":"RV legacy hero"},{"value":"suntneew-hero-a20-desktop.jpg","label":"Jump starter hero"},{"value":"energy-star-home-hero-v1.png","label":"Home energy hero"}]},
    {"type":"select","id":"hero_mobile_asset","label":"Mobile hero asset","default":"suntneew-hero-a20-mobile.jpg","options":[{"value":"suntneew-rv-series-hero-mobile.jpg","label":"RV series mobile hero"},{"value":"suntneew-hero-rv-mobile.jpg","label":"RV legacy mobile hero"},{"value":"suntneew-hero-a20-mobile.jpg","label":"Jump starter mobile hero"},{"value":"energy-star-home-hero-v1.png","label":"Home energy hero"}]},
    {"type":"text","id":"hero_alt","label":"Hero alt text","default":"SuntNeew product series"},
    {"type":"text","id":"back_label","label":"Back link label","default":"All product series"},
    {"type":"url","id":"back_link","label":"Back link"},
    {"type":"select","id":"catalog_state","label":"Catalog state","default":"available","options":[{"value":"available","label":"Show product cards"},{"value":"preparing","label":"Show coming-soon panel"}]},
    {"type":"text","id":"catalog_eyebrow","label":"Catalog eyebrow","default":"CHOOSE A PRODUCT"},
    {"type":"text","id":"catalog_heading","label":"Catalog heading","default":"Products in this series."},
    {"type":"textarea","id":"catalog_body","label":"Catalog body","default":"Open a product page to compare variants, capacity and the details that matter."},
    {"type":"text","id":"capacity_filter_label","label":"Capacity filter label","default":"Filter by capacity"},
    {"type":"text","id":"all_capacity_label","label":"All capacities label","default":"All capacities"},
    {"type":"text","id":"view_label","label":"View switcher label","default":"Product view"},
    {"type":"text","id":"cards_label","label":"Cards label","default":"Cards"},
    {"type":"text","id":"list_label","label":"List label","default":"List"},
    {"type":"select","id":"default_view","label":"Default product view","default":"cards","options":[{"value":"cards","label":"Cards"},{"value":"list","label":"List"}]},
    {"type":"text","id":"empty_eyebrow","label":"Empty-state eyebrow","default":"SERIES IN PREPARATION"},
    {"type":"text","id":"empty_heading","label":"Empty-state heading","default":"This product series is being prepared."},
    {"type":"textarea","id":"empty_body","label":"Empty-state body","default":"The RV Batteries series remains part of SuntNeew. Product listings and individual product pages will be added when they are ready."},
    {"type":"text","id":"empty_label","label":"Empty-state link label","default":"Explore other product series"},
    {"type":"url","id":"empty_link","label":"Empty-state link"}
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image override"},
        {"type":"select","id":"fallback_asset","label":"Bundled fallback","default":"suntneew-product-a20.jpg","options":[{"value":"suntneew-product-a20.jpg","label":"A20"},{"value":"suntneew-product-a3.jpg","label":"A3"},{"value":"suntneew-rv-g31-gallery-main.jpg","label":"RV Group 31"},{"value":"suntneew-rv-g24-gallery-main.jpg","label":"RV Group 24"},{"value":"suntneew-rv-230ah-gallery-main.jpg","label":"RV 230Ah"},{"value":"suntneew-rv-314ah-gallery-main.jpg","label":"RV 314Ah"},{"value":"energy-star-wl5a-main-v1.jpg","label":"ENERGY STAR WL5A"},{"value":"energy-star-wl10b-main-v1.jpg","label":"ENERGY STAR WL10B"},{"value":"energy-star-vh10-vh15-main-v1.jpg","label":"ENERGY STAR VH"}]},
        {"type":"text","id":"image_alt","label":"Image alt text","default":"SuntNeew product"},
        {"type":"text","id":"badge","label":"Badge"},
        {"type":"text","id":"eyebrow","label":"Eyebrow","default":"PRODUCT"},
        {"type":"text","id":"title","label":"Title","default":"SuntNeew product"},
        {"type":"textarea","id":"text","label":"Description","default":"Explore product specifications, variants and use cases."},
        {"type":"text","id":"filter_value","label":"Capacity filter value","default":"100Ah"},
        {"type":"text","id":"filter_label","label":"Capacity filter label","default":"100Ah"},
        {"type":"text","id":"fact_one","label":"Fact one"},
        {"type":"text","id":"fact_two","label":"Fact two"},
        {"type":"text","id":"fact_three","label":"Fact three"},
        {"type":"text","id":"link_label","label":"Link label","default":"View product details"},
        {"type":"url","id":"link","label":"Product link"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{"name":"SuntNeew series collection","blocks":[{"type":"product_card"},{"type":"product_card"}]}]
}
{% endschema %}
