<section class="sn-section sn-section--chooser" id="{{ section.settings.anchor_id | escape }}">
  <div class="sn-shell">
    <div class="sn-chooser" data-sn-chooser>
      <div class="sn-chooser__intro">
        <p class="sn-kicker">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="sn-copy">{{ section.settings.body }}</p>
      </div>

      <div class="sn-chooser__panel">
        <div class="sn-chooser__step">
          <span class="sn-chooser__label">{{ section.settings.line_question }}</span>
          <div class="sn-chooser__choices sn-chooser__choices--3">
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="line" data-value="battery" aria-pressed="false">{{ 'suntneew_auto.see96fda589e6' | t }}</button>
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="line" data-value="jump" aria-pressed="false">{{ 'suntneew_auto.sf13a776f44d8' | t }}</button>
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="line" data-value="home" aria-pressed="false">{{ 'suntneew_auto.s968d118f5ef0' | t }}</button>
          </div>
        </div>

        <div class="sn-chooser__step" data-sn-need-group="battery" hidden>
          <span class="sn-chooser__label">{{ section.settings.battery_question }}</span>
          <div class="sn-chooser__choices sn-chooser__choices--3">
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="fit" aria-pressed="false">{{ 'suntneew_auto.s447d4ab771e5' | t }}</button>
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="runtime" aria-pressed="false">{{ 'suntneew_auto.scb6f82459c93' | t }}</button>
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="power" aria-pressed="false">{{ 'suntneew_auto.sa4128096c3b3' | t }}</button>
          </div>
        </div>

        <div class="sn-chooser__step" data-sn-need-group="jump" hidden>
          <span class="sn-chooser__label">{{ section.settings.jump_question }}</span>
          <div class="sn-chooser__choices sn-chooser__choices--3">
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="coverage" aria-pressed="false">{{ 'suntneew_auto.scf4c0afd2bc0' | t }}</button>
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="carry" aria-pressed="false">{{ 'suntneew_auto.s0b3eb79f5426' | t }}</button>
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="utility" aria-pressed="false">{{ 'suntneew_auto.s12896ae450cd' | t }}</button>
          </div>
        </div>

        <div class="sn-chooser__step" data-sn-need-group="home" hidden>
          <span class="sn-chooser__label">{{ section.settings.home_question }}</span>
          <div class="sn-chooser__choices sn-chooser__choices--3">
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="entry" aria-pressed="false">{{ 'suntneew_auto.s9b706ea2529e' | t }}</button>
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="capacity" aria-pressed="false">{{ 'suntneew_auto.s443e1d195ec9' | t }}</button>
            <button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="system" aria-pressed="false">{{ 'suntneew_auto.sef8aa41c0333' | t }}</button>
          </div>
        </div>

        <div class="sn-chooser__result" aria-live="polite">
          <strong data-sn-result-title>{{ 'suntneew_auto.sf8552cd882f4' | t }}</strong>
          <p data-sn-result-text>{{ 'suntneew_auto.sacb9ffad5d22' | t }}</p>
          <a class="sn-button" data-sn-result-link href="#" hidden>{{ 'suntneew_auto.sfc7ba741734b' | t }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SuntNeew power chooser",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anchor ID","default":"help-me-choose"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"START WITH THE JOB"},
    {"type":"text","id":"heading","label":"Heading","default":"Choose the job. Then the constraint."},
    {"type":"textarea","id":"body","label":"Body","default":"Three real power needs, followed by the few details that make the next step clearer. You will be sent to a collection or a planning path, not a generic product wall."},
    {"type":"text","id":"line_question","label":"First question","default":"1. WHAT ARE YOU POWERING?"},
    {"type":"text","id":"battery_question","label":"RV battery question","default":"2. WHAT MATTERS MOST FOR THE RV SYSTEM?"},
    {"type":"text","id":"jump_question","label":"Jump starter question","default":"2. WHAT MATTERS MOST FOR ROADSIDE USE?"},
    {"type":"text","id":"home_question","label":"Home energy question","default":"2. WHAT IS THE STARTING POINT FOR THE SYSTEM?"}
  ],
  "presets": [{"name":"SuntNeew power chooser"}]
}
{% endschema %}
