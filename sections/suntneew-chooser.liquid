<section class="sn-section" id="{{ section.settings.anchor_id | escape }}">
  <div class="sn-shell">
    <div class="sn-chooser" data-sn-chooser>
      <div class="sn-chooser__intro"><p class="sn-kicker">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p class="sn-copy">{{ section.settings.body }}</p></div>
      <div class="sn-chooser__panel">
        <div class="sn-chooser__step"><span class="sn-chooser__label">1. What are you powering?</span><div class="sn-chooser__choices"><button type="button" class="sn-chooser__choice" data-sn-choice data-group="line" data-value="battery" aria-pressed="false">An RV or off-grid system</button><button type="button" class="sn-chooser__choice" data-sn-choice data-group="line" data-value="jump" aria-pressed="false">A vehicle in an emergency</button></div></div>
        <div class="sn-chooser__step" data-sn-need-group="battery" hidden><span class="sn-chooser__label">2. What matters most?</span><div class="sn-chooser__choices"><button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="fit" aria-pressed="false">Physical fit first</button><button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="runtime" aria-pressed="false">Longer runtime</button><button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="power" aria-pressed="false">Higher output</button></div></div>
        <div class="sn-chooser__step" data-sn-need-group="jump" hidden><span class="sn-chooser__label">2. What matters most?</span><div class="sn-chooser__choices"><button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="compact" aria-pressed="false">Compact everyday backup</button><button type="button" class="sn-chooser__choice" data-sn-choice data-group="need" data-value="capacity" aria-pressed="false">More capacity and utility</button></div></div>
        <div class="sn-chooser__result"><strong data-sn-result-title>Choose a path to begin</strong><p data-sn-result-text>We will narrow the range using fit, runtime, output or roadside needs.</p><a class="sn-button" data-sn-result-link href="#" hidden>View recommendation</a></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"SuntNeew help me choose",
  "settings":[{"type":"text","id":"anchor_id","label":"Anchor ID","default":"help-me-choose"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Help me choose"},{"type":"text","id":"heading","label":"Heading","default":"Start with the job. End with the right product."},{"type":"textarea","id":"body","label":"Body","default":"A short decision path for customers who know what they need to do, but not which model gets them there."}],
  "presets":[{"name":"SuntNeew help me choose"}]
}
{% endschema %}
