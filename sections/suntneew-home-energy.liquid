<section class="sn-home-energy" aria-labelledby="sn-home-energy-heading-{{ section.id }}">
  <div class="sn-light-shell">
    <div class="sn-home-energy__panel">
      <div class="sn-home-energy__content">
        {%- if section.settings.eyebrow != blank -%}<p class="sn-light-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="sn-home-energy-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
        <p class="sn-home-energy__body">{{ section.settings.body }}</p>

        <div class="sn-home-energy__choices" aria-label="Home energy storage paths">
          {%- for block in section.blocks -%}
            {%- if block.settings.link != blank -%}
              <a class="sn-home-energy__choice sn-home-energy__choice--link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
                <p class="sn-home-energy__capacity">{{ block.settings.capacity }}</p>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
                <span>{{ block.settings.link_label | default: 'Explore product' }}</span>
              </a>
            {%- else -%}
              <div class="sn-home-energy__choice" {{ block.shopify_attributes }}>
                <p class="sn-home-energy__capacity">{{ block.settings.capacity }}</p>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="sn-home-energy__actions">
          <a class="sn-light-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
          {%- if section.settings.note != blank -%}<p>{{ section.settings.note }}</p>{%- endif -%}
        </div>
      </div>

      <div class="sn-home-energy__visual">
        <img src="{{ section.settings.image_asset | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="2100" height="750" loading="lazy">
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"SuntNeew home energy",
  "max_blocks":3,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"HOME ENERGY STORAGE"},
    {"type":"text","id":"heading","label":"Heading","default":"Power at home, built around real needs."},
    {"type":"textarea","id":"body","label":"Body","default":"Choose a usable starting capacity first, then match the system architecture and inverter requirements to the way your home uses power."},
    {"type":"text","id":"image_asset","label":"Theme image asset filename","default":"suntneew-home-hero-v2.webp"},
    {"type":"text","id":"image_alt","label":"Image alt text","default":"SuntNeew home energy storage system beside a modern home"},
    {"type":"text","id":"button_label","label":"Button label","default":"Explore home energy storage"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"textarea","id":"note","label":"Note","default":"Currently available for delivery in Germany. Confirm compatibility and installation requirements before ordering."}
  ],
  "blocks":[
    {"type":"path","name":"Capacity path","settings":[
      {"type":"text","id":"capacity","label":"Capacity","default":"5.12 kWh"},
      {"type":"text","id":"title","label":"Title","default":"Essential backup"},
      {"type":"textarea","id":"text","label":"Text","default":"A compact starting point for selected household backup needs."},
      {"type":"text","id":"link_label","label":"Product link label","default":"Explore product"},
      {"type":"url","id":"link","label":"Product link"}
    ]}
  ],
  "presets":[{"name":"SuntNeew home energy","blocks":[{"type":"path"},{"type":"path"},{"type":"path"}]}]
}
{% endschema %}
