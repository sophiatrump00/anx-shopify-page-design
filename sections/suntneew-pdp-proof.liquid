{{ 'suntneew-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suntneew-pdp.js' | asset_url }}" defer></script>

<section class="sn-pdp sn-pdp-proof" aria-label="{{ section.settings.accessibility_label | escape }}">
  <div class="sn-pdp__shell sn-pdp-proof__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'metric' -%}
      {%- assign metric_value_lower = block.settings.value | downcase -%}
      {%- assign metric_value_length = block.settings.value | size -%}
      <div class="sn-pdp-proof__item{% if metric_value_lower contains 'ip65' %} sn-pdp-proof__item--trust{% else %} sn-pdp-proof__item--metric{% endif %}" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>
        {%- if metric_value_lower contains 'ip65' -%}<span class="sn-pdp-proof__trust-mark" aria-hidden="true">✓</span>{%- endif -%}
        <strong class="sn-pdp-proof__value{% if metric_value_length > 7 %} sn-pdp-proof__value--compact{% endif %}">{{ block.settings.value }}</strong>
        <span class="sn-pdp-proof__label">{{ block.settings.label }}</span>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "SuntNeew PDP proof bar",
  "settings": [
    {"type":"text","id":"accessibility_label","label":"Accessibility label","default":"Product highlights"}
  ],
  "blocks": [
    {
      "type":"metric",
      "name":"Metric",
      "settings":[
        {"type":"text","id":"value","label":"Value","default":"1500A"},
        {"type":"text","id":"label","label":"Label","default":"Peak current"},
        {"type":"text","id":"variant_match","label":"Only show for variant","info":"Optional. Match capacity, color, title or SKU, for example 8000mAh."}
      ]
    }
  ],
  "max_blocks": 16,
  "presets":[{"name":"SuntNeew PDP proof bar","blocks":[{"type":"metric"},{"type":"metric"},{"type":"metric"},{"type":"metric"}]}]
}
{% endschema %}
