{{ 'suntneew-power-calculator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suntneew-power-calculator-core.js' | asset_url }}" defer></script>
<script src="{{ 'suntneew-power-calculator.js' | asset_url }}" defer></script>

<section
  class="sn-power-calculator"
  data-suntneew-calculator
  data-support-url="{{ section.settings.support_url | default: '/pages/request-for-quote' | escape }}"
  data-planner-step="scenario"
>
  <header class="sn-power-calculator__hero">
    <div class="sn-power-calculator__shell sn-power-calculator__hero-inner">
      <div class="sn-power-calculator__hero-copy-block">
        <p class="sn-power-calculator__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h1>{{ section.settings.heading | escape }}</h1>
        <p>{{ section.settings.intro | escape }}</p>
      </div>

      <ol class="sn-power-calculator__stepper" aria-label="Power planner progress">
        <li class="is-active" data-planner-step-item="scenario" aria-current="step">
          <span class="sn-power-calculator__step-number">1</span>
          <span class="sn-power-calculator__step-label"><small>Step 1</small><strong>Scenario</strong></span>
        </li>
        <li data-planner-step-item="setup">
          <span class="sn-power-calculator__step-number">2</span>
          <span class="sn-power-calculator__step-label"><small>Step 2</small><strong>Setup</strong></span>
        </li>
        <li data-planner-step-item="needs">
          <span class="sn-power-calculator__step-number">3</span>
          <span class="sn-power-calculator__step-label"><small>Step 3</small><strong>Needs</strong></span>
        </li>
        <li data-planner-step-item="recommendation">
          <span class="sn-power-calculator__step-number">4</span>
          <span class="sn-power-calculator__step-label"><small>Step 4</small><strong aria-label="Recommendation"><span class="sn-power-calculator__step-name--full" aria-hidden="true">Recommendation</span><span class="sn-power-calculator__step-name--short" aria-hidden="true">Result</span></strong></span>
        </li>
      </ol>
    </div>
  </header>

  <div class="sn-power-calculator__body">
    <div class="sn-power-calculator__shell">
      <section class="sn-power-calculator__scenario-stage" data-scenario-stage>
        <div class="sn-power-calculator__stage-heading sn-power-calculator__stage-heading--center">
          <p class="sn-power-calculator__step-kicker">{{ section.settings.scenario_eyebrow | escape }}</p>
          <h2>{{ section.settings.scenario_heading | escape }}</h2>
          <p>{{ section.settings.scenario_body | escape }}</p>
        </div>

        <div class="sn-power-calculator__scenario-grid" role="group" aria-label="Choose a power scenario">
          <button type="button" class="sn-power-calculator__scenario" data-scenario="rv" aria-pressed="false">
            <span class="sn-power-calculator__scenario-media">
              <img src="{{ 'suntneew-use-rv.jpg' | asset_url }}" alt="SuntNeew batteries powering an RV campsite" width="1200" height="1400" loading="eager">
              <span class="sn-power-calculator__scenario-check" aria-hidden="true">&#10003;</span>
            </span>
            <span class="sn-power-calculator__scenario-copy"><strong>RV Power</strong><small>Plan daily energy, voltage and installation space.</small></span>
          </button>

          <button type="button" class="sn-power-calculator__scenario" data-scenario="jump" aria-pressed="false">
            <span class="sn-power-calculator__scenario-media">
              <img src="{{ 'suntneew-use-jump.jpg' | asset_url }}" alt="SuntNeew jump starter connected in a vehicle engine bay" width="1200" height="1400" loading="eager">
              <span class="sn-power-calculator__scenario-check" aria-hidden="true">&#10003;</span>
            </span>
            <span class="sn-power-calculator__scenario-copy"><strong>Vehicle Starting</strong><small>Match fuel, engine size and operating conditions.</small></span>
          </button>

          <button type="button" class="sn-power-calculator__scenario" data-scenario="home" aria-pressed="false">
            <span class="sn-power-calculator__scenario-media">
              <img src="{{ 'suntneew-use-home-energy.jpg' | asset_url }}" alt="SuntNeew home energy storage beside a solar-powered home" width="1921" height="1080" loading="eager">
              <span class="sn-power-calculator__scenario-check" aria-hidden="true">&#10003;</span>
            </span>
            <span class="sn-power-calculator__scenario-copy"><strong>Home Backup</strong><small>Estimate essential loads and a practical backup window.</small></span>
          </button>
        </div>

        <div class="sn-power-calculator__scenario-actions">
          <button type="button" class="sn-power-calculator__button" data-scenario-continue disabled>Continue <span aria-hidden="true">&#8594;</span></button>
        </div>
      </section>

      <form class="sn-power-calculator__form" data-scenario-form="rv" hidden novalidate>
        <section class="sn-power-calculator__form-stage" data-form-stage="setup">
          <div class="sn-power-calculator__stage-heading">
            <p class="sn-power-calculator__step-kicker">STEP 2 &middot; RV SETUP</p>
            <h2>Start with the space and battery bank.</h2>
            <p>Choose a known tray or enter the usable enclosure space. Measurements check one battery enclosure and allow horizontal rotation.</p>
          </div>

          <div class="sn-power-calculator__setup-stack">
            <fieldset class="sn-power-calculator__setup-section">
              <legend>Installation space</legend>
              <div class="sn-power-calculator__option-grid sn-power-calculator__option-grid--4">
                <label class="sn-power-calculator__option-card"><input type="radio" name="sn-rv-space-{{ section.id }}" value="all" checked data-rv-space-mode><span><strong>Not sure</strong><small>Show every verified size</small></span></label>
                <label class="sn-power-calculator__option-card"><input type="radio" name="sn-rv-space-{{ section.id }}" value="group24" data-rv-space-mode><span><strong>Group 24 tray</strong><small>260 &times; 170 &times; 212mm</small></span></label>
                <label class="sn-power-calculator__option-card"><input type="radio" name="sn-rv-space-{{ section.id }}" value="group31" data-rv-space-mode><span><strong>Group 31 tray</strong><small>339 &times; 185 &times; 218mm</small></span></label>
                <label class="sn-power-calculator__option-card"><input type="radio" name="sn-rv-space-{{ section.id }}" value="measured" data-rv-space-mode><span><strong>Measured space</strong><small>Use your clear dimensions</small></span></label>
              </div>

              <div class="sn-power-calculator__measured-space" data-measured-space hidden>
                <div class="sn-power-calculator__range-control" data-range-control>
                  <div class="sn-power-calculator__range-head"><label for="sn-rv-space-long-{{ section.id }}">Usable long side</label><span class="sn-power-calculator__number-unit"><input id="sn-rv-space-long-{{ section.id }}" type="number" min="260" max="1000" step="1" value="400" inputmode="numeric" data-rv-space-long data-range-number><span>mm</span></span></div>
                  <input class="sn-power-calculator__range" type="range" min="260" max="1000" step="1" value="400" data-range-input aria-label="Usable battery space long side">
                  <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>260mm</span><span>1000mm</span></div>
                </div>
                <div class="sn-power-calculator__range-control" data-range-control>
                  <div class="sn-power-calculator__range-head"><label for="sn-rv-space-short-{{ section.id }}">Usable short side</label><span class="sn-power-calculator__number-unit"><input id="sn-rv-space-short-{{ section.id }}" type="number" min="170" max="600" step="1" value="220" inputmode="numeric" data-rv-space-short data-range-number><span>mm</span></span></div>
                  <input class="sn-power-calculator__range" type="range" min="170" max="600" step="1" value="220" data-range-input aria-label="Usable battery space short side">
                  <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>170mm</span><span>600mm</span></div>
                </div>
                <div class="sn-power-calculator__range-control" data-range-control>
                  <div class="sn-power-calculator__range-head"><label for="sn-rv-space-height-{{ section.id }}">Usable height</label><span class="sn-power-calculator__number-unit"><input id="sn-rv-space-height-{{ section.id }}" type="number" min="212" max="500" step="1" value="250" inputmode="numeric" data-rv-space-height data-range-number><span>mm</span></span></div>
                  <input class="sn-power-calculator__range" type="range" min="212" max="500" step="1" value="250" data-range-input aria-label="Usable battery space height">
                  <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>212mm</span><span>500mm</span></div>
                </div>
                <p class="sn-power-calculator__field-note" data-space-note></p>
              </div>
            </fieldset>

            <fieldset class="sn-power-calculator__setup-section">
              <legend>Battery-bank voltage</legend>
              <div class="sn-power-calculator__option-grid sn-power-calculator__option-grid--4">
                <label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-rv-series-{{ section.id }}" value="1" checked data-rv-series><span><strong>12.8V</strong><small>1 in series</small></span></label>
                <label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-rv-series-{{ section.id }}" value="2" data-rv-series><span><strong>25.6V</strong><small>2 in series</small></span></label>
                <label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-rv-series-{{ section.id }}" value="3" data-rv-series><span><strong>38.4V</strong><small>3 in series</small></span></label>
                <label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-rv-series-{{ section.id }}" value="4" data-rv-series><span><strong>51.2V</strong><small>4 in series</small></span></label>
              </div>
            </fieldset>

            <fieldset class="sn-power-calculator__setup-section">
              <legend>Backup period</legend>
              <div class="sn-power-calculator__range-control sn-power-calculator__range-control--wide" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-rv-backup-days-{{ section.id }}">Days without recharging</label><span class="sn-power-calculator__number-unit"><input id="sn-rv-backup-days-{{ section.id }}" type="number" min="1" max="30" step="1" value="1" inputmode="numeric" data-rv-backup-days data-range-number><span>days</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="1" max="30" step="1" value="1" data-range-input aria-label="RV backup period in days">
                <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>1 day</span><span>30 days</span></div>
              </div>
            </fieldset>
          </div>

          <div class="sn-power-calculator__stage-actions"><button type="button" class="sn-power-calculator__text-button" data-switch-scenario>&#8592; Scenarios</button><button type="button" class="sn-power-calculator__button" data-stage-continue>Choose appliances <span aria-hidden="true">&#8594;</span></button></div>
        </section>

        <section class="sn-power-calculator__form-stage" data-form-stage="needs" hidden>
          <div class="sn-power-calculator__workspace">
            <div class="sn-power-calculator__needs-panel">
              <div class="sn-power-calculator__stage-heading">
                <p class="sn-power-calculator__step-kicker">STEP 3 &middot; RV NEEDS</p>
                <h2>What will you power each day?</h2>
                <p>Turn on the appliances you use. Selected cards expand so you can adjust power and run time.</p>
              </div>
              <div class="sn-power-calculator__load-grid" data-load-list>
                {% render 'suntneew-calculator-load-card', scenario: 'rv', load_key: 'fridge', name: 'Refrigerator', icon: 'refrigerator', watts: 50, max_watts: 500, watts_step: 10, hours: 24, max_hours: 24, hours_step: 0.1, selected: true, simultaneous: true, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'rv', load_key: 'lighting', name: 'Lighting', icon: 'lightbulb', watts: 120, max_watts: 1000, watts_step: 10, hours: 5, max_hours: 12, hours_step: 0.1, selected: false, simultaneous: false, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'rv', load_key: 'pump', name: 'Water pump', icon: 'pump', watts: 60, max_watts: 1000, watts_step: 10, hours: 1, max_hours: 12, hours_step: 0.1, selected: false, simultaneous: true, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'rv', load_key: 'devices', name: 'Phone / laptop', icon: 'laptop', watts: 60, max_watts: 500, watts_step: 5, hours: 3, max_hours: 12, hours_step: 0.1, selected: false, simultaneous: false, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'rv', load_key: 'starlink', name: 'Starlink', icon: 'wifi', watts: 75, max_watts: 500, watts_step: 5, hours: 8, max_hours: 24, hours_step: 0.1, selected: false, simultaneous: false, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'rv', load_key: 'fan', name: 'Fan', icon: 'fan', watts: 30, max_watts: 500, watts_step: 5, hours: 4, max_hours: 24, hours_step: 0.1, selected: false, simultaneous: false, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'rv', load_key: 'tv', name: 'TV / entertainment', icon: 'tv', watts: 80, max_watts: 1000, watts_step: 10, hours: 2, max_hours: 12, hours_step: 0.1, selected: false, simultaneous: false, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'rv', load_key: 'microwave', name: 'Microwave', icon: 'microwave', watts: 1000, max_watts: 2500, watts_step: 50, hours: 0.2, max_hours: 4, hours_step: 0.1, selected: false, simultaneous: true, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'rv', load_key: 'air-conditioner', name: 'Air conditioner', icon: 'snowflake', watts: 1000, max_watts: 5000, watts_step: 50, hours: 1, max_hours: 12, hours_step: 0.5, selected: false, simultaneous: true, section_id: section.id %}
                <button type="button" class="sn-power-calculator__add-load-card" data-add-load><span>{% render 'suntneew-calculator-icon', icon: 'plus' %}</span><strong>Add custom device</strong></button>
              </div>
              <p class="sn-power-calculator__limit-note" data-limit-note role="status" aria-live="polite"></p>
              <p class="sn-power-calculator__error" data-form-error role="alert" hidden></p>
              <div class="sn-power-calculator__needs-back"><button type="button" class="sn-power-calculator__text-button" data-stage-back>&#8592; Edit setup</button></div>
            </div>
            <aside class="sn-power-calculator__summary" data-live-summary aria-label="Live power summary">
              <div><p class="sn-power-calculator__summary-eyebrow">YOUR CURRENT PLAN</p><h3>RV energy estimate</h3></div>
              <div class="sn-power-calculator__summary-primary"><span data-summary-primary-label>Daily energy</span><strong data-summary-primary>0.00<small>kWh</small></strong></div>
              <div class="sn-power-calculator__summary-progress" aria-hidden="true"><span data-summary-progress></span></div>
              <p class="sn-power-calculator__summary-capacity" data-summary-capacity></p>
              <dl class="sn-power-calculator__summary-stats"><div><dt>Peak power</dt><dd data-summary-peak>0W</dd></div><div><dt>Selected</dt><dd data-summary-count>0</dd></div></dl>
              <div class="sn-power-calculator__summary-list"><p>May run together</p><ul data-summary-loads><li>No appliances selected</li></ul></div>
              <button type="submit" class="sn-power-calculator__button sn-power-calculator__button--full" data-summary-submit>See recommendation <span aria-hidden="true">&#8594;</span></button>
            </aside>
          </div>
          <div class="sn-power-calculator__mobile-summary" data-mobile-summary><span><small data-mobile-primary-label>Daily energy</small><strong data-mobile-primary>0.00kWh</strong></span><span><small data-mobile-secondary-label>Peak</small><strong data-mobile-secondary>0W</strong></span><button type="submit" aria-label="See recommendation">&#8594;</button></div>
        </section>
      </form>

      <form class="sn-power-calculator__form" data-scenario-form="jump" hidden novalidate>
        <section class="sn-power-calculator__form-stage" data-form-stage="setup">
          <div class="sn-power-calculator__stage-heading"><p class="sn-power-calculator__step-kicker">STEP 2 &middot; VEHICLE SETUP</p><h2>Tell us about the vehicle.</h2><p>Coverage is matched against the verified SuntNeew starting range currently in the calculator catalog.</p></div>
          <div class="sn-power-calculator__setup-stack">
            <fieldset class="sn-power-calculator__setup-section"><legend>Fuel type</legend><div class="sn-power-calculator__option-grid sn-power-calculator__option-grid--2"><label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-jump-fuel-{{ section.id }}" value="gasoline" checked data-jump-fuel><span><strong>Gasoline</strong><small>Passenger and light-duty engines</small></span></label><label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-jump-fuel-{{ section.id }}" value="diesel" data-jump-fuel><span><strong>Diesel</strong><small>Higher starting demand</small></span></label></div></fieldset>
            <fieldset class="sn-power-calculator__setup-section"><legend>Engine displacement</legend><div class="sn-power-calculator__range-control sn-power-calculator__range-control--wide" data-range-control><div class="sn-power-calculator__range-head"><label for="sn-jump-engine-{{ section.id }}">Engine size</label><span class="sn-power-calculator__number-unit"><input id="sn-jump-engine-{{ section.id }}" type="number" min="0.1" max="8" step="0.1" value="3" inputmode="decimal" data-jump-engine data-range-number><span>L</span></span></div><input class="sn-power-calculator__range" type="range" min="0.1" max="8" step="0.1" value="3" data-range-input aria-label="Engine displacement in liters"><div class="sn-power-calculator__range-scale" aria-hidden="true"><span>0.1L</span><span>8L</span></div></div></fieldset>
            <fieldset class="sn-power-calculator__setup-section"><legend>Vehicle voltage</legend><div class="sn-power-calculator__option-grid sn-power-calculator__option-grid--2"><label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-jump-voltage-{{ section.id }}" value="12v" checked data-jump-voltage><span><strong>12V</strong><small>Standard vehicle system</small></span></label><label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-jump-voltage-{{ section.id }}" value="24v" data-jump-voltage><span><strong>24V</strong><small>Available when a verified product is added</small></span></label></div></fieldset>
          </div>
          <p class="sn-power-calculator__limit-note" data-limit-note role="status" aria-live="polite"></p>
          <div class="sn-power-calculator__stage-actions"><button type="button" class="sn-power-calculator__text-button" data-switch-scenario>&#8592; Scenarios</button><button type="button" class="sn-power-calculator__button" data-stage-continue>Operating needs <span aria-hidden="true">&#8594;</span></button></div>
        </section>

        <section class="sn-power-calculator__form-stage" data-form-stage="needs" hidden>
          <div class="sn-power-calculator__workspace">
            <div class="sn-power-calculator__needs-panel">
              <div class="sn-power-calculator__stage-heading"><p class="sn-power-calculator__step-kicker">STEP 3 &middot; STARTING NEEDS</p><h2>How will you use it?</h2><p>Choose the closest operating condition and the feature that matters most.</p></div>
              <fieldset class="sn-power-calculator__setup-section"><legend>Operating conditions</legend><div class="sn-power-calculator__option-grid sn-power-calculator__option-grid--3"><label class="sn-power-calculator__option-card"><input type="radio" name="sn-jump-environment-{{ section.id }}" value="standard" checked data-jump-environment><span><strong>Standard</strong><small>Occasional starting support</small></span></label><label class="sn-power-calculator__option-card"><input type="radio" name="sn-jump-environment-{{ section.id }}" value="cold" data-jump-environment><span><strong>Cold weather</strong><small>Add reserve for lower temperatures</small></span></label><label class="sn-power-calculator__option-card"><input type="radio" name="sn-jump-environment-{{ section.id }}" value="demanding" data-jump-environment><span><strong>Demanding use</strong><small>Frequent or harder starts</small></span></label></div></fieldset>
              <fieldset class="sn-power-calculator__setup-section"><legend>Product priority</legend><div class="sn-power-calculator__option-grid sn-power-calculator__option-grid--2"><label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-jump-priority-{{ section.id }}" value="compact" checked data-jump-priority><span><strong>Compact size</strong><small>Easier to carry and store</small></span></label><label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-jump-priority-{{ section.id }}" value="display" data-jump-priority><span><strong>Clear display</strong><small>At-a-glance controls</small></span></label><label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-jump-priority-{{ section.id }}" value="charging" data-jump-priority><span><strong>Charging utility</strong><small>More portable-device use</small></span></label><label class="sn-power-calculator__option-card sn-power-calculator__option-card--compact"><input type="radio" name="sn-jump-priority-{{ section.id }}" value="reserve" data-jump-priority><span><strong>More reserve</strong><small>Higher capacity first</small></span></label></div></fieldset>
              <p class="sn-power-calculator__error" data-form-error role="alert" hidden></p><div class="sn-power-calculator__needs-back"><button type="button" class="sn-power-calculator__text-button" data-stage-back>&#8592; Edit vehicle</button></div>
            </div>
            <aside class="sn-power-calculator__summary" data-live-summary aria-label="Live vehicle summary"><div><p class="sn-power-calculator__summary-eyebrow">YOUR CURRENT VEHICLE</p><h3>Starting reference</h3></div><div class="sn-power-calculator__summary-primary"><span data-summary-primary-label>Engine size</span><strong data-summary-primary>3.0<small>L</small></strong></div><dl class="sn-power-calculator__summary-stats"><div><dt>Fuel</dt><dd data-summary-peak>Gasoline</dd></div><div><dt>Voltage</dt><dd data-summary-count>12V</dd></div></dl><div class="sn-power-calculator__summary-list"><p>Selection</p><ul data-summary-loads><li>Standard conditions</li><li>Compact size priority</li></ul></div><button type="submit" class="sn-power-calculator__button sn-power-calculator__button--full">See recommendation <span aria-hidden="true">&#8594;</span></button></aside>
          </div>
          <div class="sn-power-calculator__mobile-summary" data-mobile-summary><span><small data-mobile-primary-label>Engine</small><strong data-mobile-primary>3.0L</strong></span><span><small data-mobile-secondary-label>Fuel</small><strong data-mobile-secondary>Gasoline</strong></span><button type="submit" aria-label="See recommendation">&#8594;</button></div>
        </section>
      </form>

      <form class="sn-power-calculator__form" data-scenario-form="home" hidden novalidate>
        <section class="sn-power-calculator__form-stage" data-form-stage="setup">
          <div class="sn-power-calculator__stage-heading"><p class="sn-power-calculator__step-kicker">STEP 2 &middot; HOME SETUP</p><h2>Set the backup window and architecture.</h2><p>This is a capacity starting point. Inverter compatibility, transfer equipment and installation still require a qualified review.</p></div>
          <div class="sn-power-calculator__setup-stack">
            <fieldset class="sn-power-calculator__setup-section"><legend>Battery architecture</legend><div class="sn-power-calculator__option-grid sn-power-calculator__option-grid--3"><label class="sn-power-calculator__option-card"><input type="radio" name="sn-home-architecture-{{ section.id }}" value="auto" checked data-home-architecture><span><strong>Planner choice</strong><small>Compare all configured systems</small></span></label><label class="sn-power-calculator__option-card"><input type="radio" name="sn-home-architecture-{{ section.id }}" value="low" data-home-architecture><span><strong>Low voltage</strong><small>WL5A and WL10B range</small></span></label><label class="sn-power-calculator__option-card"><input type="radio" name="sn-home-architecture-{{ section.id }}" value="high" data-home-architecture><span><strong>High voltage</strong><small>VH system range</small></span></label></div></fieldset>
            <fieldset class="sn-power-calculator__setup-section"><legend>Backup window</legend><div class="sn-power-calculator__range-control sn-power-calculator__range-control--wide" data-range-control><div class="sn-power-calculator__range-head"><label for="sn-home-backup-hours-{{ section.id }}">Hours of essential-load backup</label><span class="sn-power-calculator__number-unit"><input id="sn-home-backup-hours-{{ section.id }}" type="number" min="1" max="168" step="1" value="12" inputmode="numeric" data-home-backup-hours data-range-number><span>hours</span></span></div><input class="sn-power-calculator__range" type="range" min="1" max="168" step="1" value="12" data-range-input aria-label="Home backup window in hours"><div class="sn-power-calculator__range-scale" aria-hidden="true"><span>1 hour</span><span>7 days</span></div></div></fieldset>
          </div>
          <p class="sn-power-calculator__limit-note" data-limit-note role="status" aria-live="polite"></p>
          <div class="sn-power-calculator__stage-actions"><button type="button" class="sn-power-calculator__text-button" data-switch-scenario>&#8592; Scenarios</button><button type="button" class="sn-power-calculator__button" data-stage-continue>Choose essential loads <span aria-hidden="true">&#8594;</span></button></div>
        </section>

        <section class="sn-power-calculator__form-stage" data-form-stage="needs" hidden>
          <div class="sn-power-calculator__workspace">
            <div class="sn-power-calculator__needs-panel">
              <div class="sn-power-calculator__stage-heading"><p class="sn-power-calculator__step-kicker">STEP 3 &middot; HOME NEEDS</p><h2>What should stay powered?</h2><p>Choose only the essential loads you expect to use during an outage.</p></div>
              <div class="sn-power-calculator__load-grid" data-load-list>
                {% render 'suntneew-calculator-load-card', scenario: 'home', load_key: 'fridge', name: 'Refrigerator', icon: 'refrigerator', watts: 150, max_watts: 1000, watts_step: 10, hours: 12, max_hours: 24, hours_step: 0.1, selected: true, simultaneous: true, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'home', load_key: 'lighting', name: 'Essential lighting', icon: 'lightbulb', watts: 100, max_watts: 1500, watts_step: 10, hours: 5, max_hours: 24, hours_step: 0.1, selected: true, simultaneous: false, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'home', load_key: 'router', name: 'Internet / router', icon: 'router', watts: 25, max_watts: 300, watts_step: 5, hours: 24, max_hours: 24, hours_step: 0.1, selected: true, simultaneous: false, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'home', load_key: 'freezer', name: 'Freezer', icon: 'freezer', watts: 180, max_watts: 1200, watts_step: 10, hours: 12, max_hours: 24, hours_step: 0.1, selected: false, simultaneous: true, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'home', load_key: 'sump-pump', name: 'Sump pump', icon: 'pump', watts: 800, max_watts: 3000, watts_step: 50, hours: 1, max_hours: 12, hours_step: 0.1, selected: false, simultaneous: true, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'home', load_key: 'medical', name: 'Medical device', icon: 'medical', watts: 200, max_watts: 2000, watts_step: 10, hours: 8, max_hours: 24, hours_step: 0.1, selected: false, simultaneous: true, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'home', load_key: 'tv', name: 'TV / entertainment', icon: 'tv', watts: 100, max_watts: 1000, watts_step: 10, hours: 3, max_hours: 12, hours_step: 0.1, selected: false, simultaneous: false, section_id: section.id %}
                {% render 'suntneew-calculator-load-card', scenario: 'home', load_key: 'fan', name: 'Fan', icon: 'fan', watts: 50, max_watts: 500, watts_step: 5, hours: 8, max_hours: 24, hours_step: 0.1, selected: false, simultaneous: false, section_id: section.id %}
                <button type="button" class="sn-power-calculator__add-load-card" data-add-load><span>{% render 'suntneew-calculator-icon', icon: 'plus' %}</span><strong>Add custom load</strong></button>
              </div>
              <p class="sn-power-calculator__limit-note" data-limit-note role="status" aria-live="polite"></p><p class="sn-power-calculator__error" data-form-error role="alert" hidden></p><div class="sn-power-calculator__needs-back"><button type="button" class="sn-power-calculator__text-button" data-stage-back>&#8592; Edit setup</button></div>
            </div>
            <aside class="sn-power-calculator__summary" data-live-summary aria-label="Live home backup summary"><div><p class="sn-power-calculator__summary-eyebrow">YOUR CURRENT PLAN</p><h3>Home backup estimate</h3></div><div class="sn-power-calculator__summary-primary"><span data-summary-primary-label>Daily energy</span><strong data-summary-primary>0.00<small>kWh</small></strong></div><div class="sn-power-calculator__summary-progress" aria-hidden="true"><span data-summary-progress></span></div><p class="sn-power-calculator__summary-capacity" data-summary-capacity></p><dl class="sn-power-calculator__summary-stats"><div><dt>Peak power</dt><dd data-summary-peak>0W</dd></div><div><dt>Selected</dt><dd data-summary-count>0</dd></div></dl><div class="sn-power-calculator__summary-list"><p>May run together</p><ul data-summary-loads><li>No loads selected</li></ul></div><button type="submit" class="sn-power-calculator__button sn-power-calculator__button--full">See recommendation <span aria-hidden="true">&#8594;</span></button></aside>
          </div>
          <div class="sn-power-calculator__mobile-summary" data-mobile-summary><span><small data-mobile-primary-label>Daily energy</small><strong data-mobile-primary>0.00kWh</strong></span><span><small data-mobile-secondary-label>Peak</small><strong data-mobile-secondary>0W</strong></span><button type="submit" aria-label="See recommendation">&#8594;</button></div>
        </section>
      </form>

      <section class="sn-power-calculator__results" data-results hidden aria-live="polite" tabindex="-1">
        <div class="sn-power-calculator__results-header"><div><p class="sn-power-calculator__result-kicker" data-result-kicker>YOUR STARTING POINT</p><h2 data-result-title>Choose a scenario to see a starting point.</h2></div><p data-result-summary></p></div>
        <div class="sn-power-calculator__metric-grid" data-result-metrics></div>
        <div class="sn-power-calculator__product" data-result-product hidden>
          <div class="sn-power-calculator__product-media"><img data-result-image src="{{ 'suntneew-product-g31.jpg' | asset_url }}" alt="" width="600" height="600" loading="lazy"></div>
          <div class="sn-power-calculator__product-copy"><p class="sn-power-calculator__product-label" data-result-product-label>RECOMMENDED STARTING POINT</p><h3 data-result-product-title></h3><div class="sn-power-calculator__product-specs" data-result-product-specs></div><p data-result-product-copy></p><p class="sn-power-calculator__product-note" data-result-product-note hidden></p><div class="sn-power-calculator__result-actions"><a class="sn-power-calculator__result-link" data-result-product-link href="#">Open product details</a><a class="sn-power-calculator__result-link sn-power-calculator__result-link--secondary" data-result-secondary-link href="#" hidden>Compare another option</a></div></div>
        </div>
        <div class="sn-power-calculator__result-actions" data-result-support-actions hidden><a class="sn-power-calculator__result-link" data-result-support-link href="{{ section.settings.support_url | default: '/pages/request-for-quote' }}">Request technical support</a><button type="button" class="sn-power-calculator__result-link sn-power-calculator__result-link--secondary" data-result-reset>Start again</button></div>
        <p class="sn-power-calculator__fine-print">{{ section.settings.disclaimer | escape }}</p>
        <div class="sn-power-calculator__result-navigation"><button type="button" class="sn-power-calculator__text-button" data-edit-answers>Edit my answers</button><button type="button" class="sn-power-calculator__text-button" data-switch-scenario>Choose another scenario</button></div>
      </section>

      <p class="sn-power-calculator__privacy-note">{{ section.settings.privacy_note | escape }}</p>
    </div>
  </div>

  <div class="sn-power-calculator__catalog" hidden aria-hidden="true">
