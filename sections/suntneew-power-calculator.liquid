{%- assign product_rv_g24 = all_products['suntneew-12-8v-100ah-lifepo4-rv-battery-group-24'] -%}
{%- assign product_rv_g31 = all_products['suntneew-12-8v-100ah-lifepo4-rv-battery-group-31'] -%}
{%- assign product_rv_230 = all_products['suntneew-12-8v-230ah-lifepo4-rv-battery'] -%}
{%- assign product_rv_314 = all_products['suntneew-12-8v-314ah-lifepo4-rv-battery'] -%}
{%- assign product_a20 = all_products['suntneew-a20-jump-starter-8000mah'] -%}
{%- assign product_a3 = all_products['suntneew-a3-jump-starter-16000mah'] -%}
{%- assign product_u23 = all_products['suntneew-u23-portable-car-jump-starter-8-000mah'] -%}
{%- assign product_u32 = all_products['suntneew-u32-portable-car-jump-starter-10-000mah'] -%}
{%- assign product_wl5a = all_products['suntneew-wl5a-5-12-kwh-low-voltage-home-battery'] -%}
{%- assign product_wl10b = all_products['suntneew-wl10b-10-24-kwh-low-voltage-home-battery'] -%}
