</section>

{% schema %}
{
  "name": "SuntNeew power planner",
  "tag": "section",
  "class": "shopify-section--suntneew-power-calculator",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SUNTNEEW POWER PLANNER"},
    {"type":"text","id":"heading","label":"Heading","default":"Help Me Choose"},
    {"type":"textarea","id":"intro","label":"Intro","default":"Build a practical power plan around your setup, daily needs and the current SuntNeew product range."},
    {"type":"textarea","id":"privacy_note","label":"Privacy note","default":"Selections are stored in this browser session. Analytics events are emitted only when Shopify analytics consent is granted."},
    {"type":"text","id":"scenario_eyebrow","label":"Scenario eyebrow","default":"STEP 1 OF 4"},
    {"type":"text","id":"scenario_heading","label":"Scenario heading","default":"Choose Your Scenario"},
    {"type":"textarea","id":"scenario_body","label":"Scenario body","default":"Where do you need dependable power?"},
    {"type":"url","id":"support_url","label":"Technical support URL"},
    {"type":"textarea","id":"disclaimer","label":"Result disclaimer","default":"Planning estimates use the values entered here and verified product reference data. Confirm model specifications, compatibility, protection, wiring and installation requirements before purchase or installation."}
  ],
  "blocks": [
    {
      "type": "catalog_product",
      "name": "Calculator product",
      "settings": [
        {"type":"product","id":"product","label":"Product"},
        {"type":"text","id":"product_key","label":"Calculator key","info":"Unique key, for example rv-400ah or jump-new-12000."},
        {"type":"text","id":"product_id","label":"Variant ID"},
        {"type":"select","id":"scenario","label":"Scenario","options":[{"value":"rv","label":"RV power"},{"value":"jump","label":"Vehicle starting"},{"value":"home","label":"Home backup"}],"default":"rv"},
        {"type":"text","id":"model","label":"Display model"},
        {"type":"text","id":"variant","label":"Variant label"},
        {"type":"select","id":"fit","label":"RV footprint class","options":[{"value":"flexible","label":"Flexible"},{"value":"group24","label":"Group 24"},{"value":"group31","label":"Group 31"}],"default":"flexible"},
        {"type":"text","id":"length_mm","label":"RV enclosure length (mm)"},
        {"type":"text","id":"width_mm","label":"RV enclosure width (mm)"},
        {"type":"text","id":"height_mm","label":"RV enclosure height (mm)","info":"Use enclosure height excluding terminals unless the published dimension includes them."},
        {"type":"text","id":"capacity_wh","label":"Rated capacity (Wh)"},
        {"type":"text","id":"output_w","label":"RV continuous output (W)"},
        {"type":"text","id":"max_series","label":"Maximum batteries in series","default":"1"},
        {"type":"text","id":"max_parallel","label":"Maximum parallel strings","default":"1"},
        {"type":"text","id":"max_units","label":"Maximum units or sets","default":"1"},
        {"type":"select","id":"voltage","label":"Starting voltage","options":[{"value":"12v","label":"12V"},{"value":"24v","label":"24V"}],"default":"12v"},
        {"type":"text","id":"gasoline_liters","label":"Gasoline coverage (L)"},
        {"type":"text","id":"diesel_liters","label":"Diesel coverage (L)"},
        {"type":"text","id":"priority_compact","label":"Compact priority (0-9)","default":"3"},
        {"type":"text","id":"priority_display","label":"Display priority (0-9)","default":"3"},
        {"type":"text","id":"priority_charging","label":"Charging priority (0-9)","default":"3"},
        {"type":"text","id":"priority_reserve","label":"Reserve priority (0-9)","default":"3"},
        {"type":"select","id":"architecture","label":"Home architecture","options":[{"value":"low","label":"Low voltage"},{"value":"high","label":"High voltage"}],"default":"low"},
        {"type":"text","id":"max_system_output_w","label":"Maximum system output (W)","default":"12000"},
        {"type":"textarea","id":"description","label":"Calculator product note"}
      ]
    }
  ],
  "presets": [{"name":"SuntNeew power planner"}]
}
{% endschema %}
