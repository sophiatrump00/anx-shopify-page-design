{{ 'suntneew-power-calculator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suntneew-power-calculator-core.js' | asset_url }}" defer></script>
<script src="{{ 'suntneew-power-calculator.js' | asset_url }}" defer></script>

<section
  class="sn-power-calculator"
  data-suntneew-calculator
  data-support-url="{{ section.settings.support_url | default: '/pages/request-for-quote' | escape }}"
  data-planner-step="scenario"
>
  <div class="sn-power-calculator__hero">
    <div class="sn-power-calculator__shell">
      <div class="sn-power-calculator__hero-copy-block">
        <p class="sn-power-calculator__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h1>{{ section.settings.heading | escape }}</h1>
        <p class="sn-power-calculator__hero-copy">{{ section.settings.intro | escape }}</p>
      </div>

      <ol class="sn-power-calculator__stepper" aria-label="Power planner progress">
        <li class="is-active" data-planner-step-item="scenario" aria-current="step">
          <span class="sn-power-calculator__step-number">1</span>
          <span><small>Step 1</small><strong>Scenario</strong></span>
        </li>
        <li data-planner-step-item="details">
          <span class="sn-power-calculator__step-number">2</span>
          <span><small>Step 2</small><strong>Your needs</strong></span>
        </li>
        <li data-planner-step-item="recommendation">
          <span class="sn-power-calculator__step-number">3</span>
          <span><small>Step 3</small><strong>Recommendation</strong></span>
        </li>
      </ol>

      <p class="sn-power-calculator__privacy-note">{{ section.settings.privacy_note | escape }}</p>
    </div>
  </div>

  <div class="sn-power-calculator__body">
    <div class="sn-power-calculator__shell">
      <div class="sn-power-calculator__scenario-stage" data-scenario-stage>
        <div class="sn-power-calculator__scenario-header">
          <p class="sn-power-calculator__step-kicker">{{ section.settings.scenario_eyebrow | escape }}</p>
          <h2>{{ section.settings.scenario_heading | escape }}</h2>
          <p>{{ section.settings.scenario_body | escape }}</p>
        </div>

        <div class="sn-power-calculator__scenario-grid" role="group" aria-label="Choose a power scenario">
          <button type="button" class="sn-power-calculator__scenario" data-scenario="rv" aria-pressed="false">
            <span class="sn-power-calculator__scenario-media">
              <img src="{{ 'suntneew-use-rv.jpg' | asset_url }}" alt="SuntNeew batteries powering an RV campsite" width="1200" height="1400" loading="eager">
              <span class="sn-power-calculator__scenario-check" aria-hidden="true">&#10003;</span>
            </span>
            <span class="sn-power-calculator__scenario-copy">
              <strong>RV Power</strong>
              <small>Size a battery starting point around daily loads and available space.</small>
            </span>
          </button>

          <button type="button" class="sn-power-calculator__scenario" data-scenario="jump" aria-pressed="false">
            <span class="sn-power-calculator__scenario-media">
              <img src="{{ 'suntneew-use-jump.jpg' | asset_url }}" alt="SuntNeew jump starter connected in a vehicle engine bay" width="1200" height="1400" loading="eager">
              <span class="sn-power-calculator__scenario-check" aria-hidden="true">&#10003;</span>
            </span>
            <span class="sn-power-calculator__scenario-copy">
              <strong>Vehicle Starting</strong>
              <small>Match a 12V jump starter to fuel type, engine size and conditions.</small>
            </span>
          </button>

          <button type="button" class="sn-power-calculator__scenario" data-scenario="home" aria-pressed="false">
            <span class="sn-power-calculator__scenario-media">
              <img src="{{ 'suntneew-use-home-energy.jpg' | asset_url }}" alt="SuntNeew home energy storage beside a solar-powered home" width="1921" height="1080" loading="eager">
              <span class="sn-power-calculator__scenario-check" aria-hidden="true">&#10003;</span>
            </span>
            <span class="sn-power-calculator__scenario-copy">
              <strong>Home Backup</strong>
              <small>Estimate essential-load capacity before confirming system architecture.</small>
            </span>
          </button>
        </div>

        <div class="sn-power-calculator__scenario-actions">
          <button type="button" class="sn-power-calculator__button" data-scenario-continue disabled>Continue <span aria-hidden="true">&#8594;</span></button>
        </div>
      </div>

      <div class="sn-power-calculator__progress" data-progress hidden aria-live="polite">Choose a scenario to begin</div>

      <form class="sn-power-calculator__form" data-scenario-form="rv" hidden novalidate>
        <div class="sn-power-calculator__form-header">
          <div>
            <p class="sn-power-calculator__step-kicker">STEP 2 &middot; RV POWER</p>
            <h2>What needs power on the road?</h2>
          </div>
          <p>Use the loads you expect to run together. The result is a planning estimate, not a substitute for a complete RV electrical design.</p>
        </div>

        <fieldset class="sn-power-calculator__step">
          <legend class="sn-power-calculator__step-title">Daily appliance loads</legend>
          <p class="sn-power-calculator__step-caption">Select the appliances you want included, then mark Peak for loads expected to run at the same time.</p>
          <div class="sn-power-calculator__load-list" data-load-list>
            <div class="sn-power-calculator__load-row" data-load-row>
              <div class="sn-power-calculator__load-heading"><strong>Refrigerator</strong><div class="sn-power-calculator__load-options"><label class="sn-power-calculator__load-check"><input type="checkbox" checked data-load-selected> Include</label><label class="sn-power-calculator__load-check"><input type="checkbox" checked data-load-simultaneous> Peak</label></div></div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-rv-fridge-watts-{{ section.id }}">Power draw</label><span class="sn-power-calculator__range-value"><input id="sn-rv-fridge-watts-{{ section.id }}" type="number" min="1" max="5000" step="1" value="50" data-load-watts data-range-number inputmode="decimal" aria-label="Refrigerator watts"><span>W</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="10" max="500" step="10" value="50" data-range-input aria-label="Refrigerator power draw">
                <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>10W</span><span>500W</span></div>
              </div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-rv-fridge-hours-{{ section.id }}">Daily run time</label><span class="sn-power-calculator__range-value"><input id="sn-rv-fridge-hours-{{ section.id }}" type="number" min="0.1" max="24" step="0.1" value="24" data-load-hours data-range-number inputmode="decimal" aria-label="Refrigerator hours per day"><span>hours/day</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="0.1" max="24" step="0.1" value="24" data-range-input aria-label="Refrigerator daily run time">
                <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>0.1h</span><span>24h</span></div>
              </div>
            </div>
            <div class="sn-power-calculator__load-row" data-load-row>
              <div class="sn-power-calculator__load-heading"><strong>Microwave</strong><div class="sn-power-calculator__load-options"><label class="sn-power-calculator__load-check"><input type="checkbox" checked data-load-selected> Include</label><label class="sn-power-calculator__load-check"><input type="checkbox" checked data-load-simultaneous> Peak</label></div></div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-rv-microwave-watts-{{ section.id }}">Power draw</label><span class="sn-power-calculator__range-value"><input id="sn-rv-microwave-watts-{{ section.id }}" type="number" min="1" max="5000" step="1" value="800" data-load-watts data-range-number inputmode="decimal" aria-label="Microwave watts"><span>W</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="100" max="2500" step="50" value="800" data-range-input aria-label="Microwave power draw">
                <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>100W</span><span>2.5kW</span></div>
              </div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-rv-microwave-hours-{{ section.id }}">Daily run time</label><span class="sn-power-calculator__range-value"><input id="sn-rv-microwave-hours-{{ section.id }}" type="number" min="0.1" max="24" step="0.1" value="0.2" data-load-hours data-range-number inputmode="decimal" aria-label="Microwave hours per day"><span>hours/day</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="0.1" max="4" step="0.1" value="0.2" data-range-input aria-label="Microwave daily run time">
                <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>0.1h</span><span>4h</span></div>
              </div>
            </div>
            <div class="sn-power-calculator__load-row" data-load-row>
              <div class="sn-power-calculator__load-heading"><strong>Air conditioner</strong><div class="sn-power-calculator__load-options"><label class="sn-power-calculator__load-check"><input type="checkbox" checked data-load-selected> Include</label><label class="sn-power-calculator__load-check"><input type="checkbox" checked data-load-simultaneous> Peak</label></div></div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-rv-ac-watts-{{ section.id }}">Power draw</label><span class="sn-power-calculator__range-value"><input id="sn-rv-ac-watts-{{ section.id }}" type="number" min="1" max="10000" step="1" value="800" data-load-watts data-range-number inputmode="decimal" aria-label="Air conditioner watts"><span>W</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="200" max="5000" step="50" value="800" data-range-input aria-label="Air conditioner power draw">
                <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>200W</span><span>5kW</span></div>
              </div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-rv-ac-hours-{{ section.id }}">Daily run time</label><span class="sn-power-calculator__range-value"><input id="sn-rv-ac-hours-{{ section.id }}" type="number" min="0.1" max="24" step="0.1" value="1" data-load-hours data-range-number inputmode="decimal" aria-label="Air conditioner hours per day"><span>hours/day</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="0.5" max="12" step="0.5" value="1" data-range-input aria-label="Air conditioner daily run time">
                <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>0.5h</span><span>12h</span></div>
              </div>
            </div>
            <div class="sn-power-calculator__load-row" data-load-row>
              <div class="sn-power-calculator__load-heading"><strong>Lighting</strong><div class="sn-power-calculator__load-options"><label class="sn-power-calculator__load-check"><input type="checkbox" checked data-load-selected> Include</label><label class="sn-power-calculator__load-check"><input type="checkbox" data-load-simultaneous> Peak</label></div></div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-rv-lighting-watts-{{ section.id }}">Power draw</label><span class="sn-power-calculator__range-value"><input id="sn-rv-lighting-watts-{{ section.id }}" type="number" min="1" max="2000" step="1" value="120" data-load-watts data-range-number inputmode="decimal" aria-label="Lighting watts"><span>W</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="10" max="1000" step="10" value="120" data-range-input aria-label="Lighting power draw">
                <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>10W</span><span>1kW</span></div>
              </div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-rv-lighting-hours-{{ section.id }}">Daily run time</label><span class="sn-power-calculator__range-value"><input id="sn-rv-lighting-hours-{{ section.id }}" type="number" min="0.1" max="24" step="0.1" value="5" data-load-hours data-range-number inputmode="decimal" aria-label="Lighting hours per day"><span>hours/day</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="0.1" max="12" step="0.1" value="5" data-range-input aria-label="Lighting daily run time">
                <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>0.1h</span><span>12h</span></div>
              </div>
            </div>
          </div>
          <button type="button" class="sn-power-calculator__text-button" data-add-load>Add another load</button>
        </fieldset>

        <div class="sn-power-calculator__inline-fields">
          <div class="sn-power-calculator__step">
            <label class="sn-power-calculator__step-title" for="sn-rv-backup-days-{{ section.id }}">Backup period</label>
            <div class="sn-power-calculator__range-control" data-range-control>
              <div class="sn-power-calculator__range-head"><label for="sn-rv-backup-days-{{ section.id }}">Days</label><span class="sn-power-calculator__range-value"><input id="sn-rv-backup-days-{{ section.id }}" type="number" min="1" max="7" step="1" value="1" data-rv-backup-days data-range-number inputmode="numeric"><span>days</span></span></div>
              <input class="sn-power-calculator__range" type="range" min="1" max="7" step="1" value="1" data-range-input aria-label="RV backup period in days">
              <div class="sn-power-calculator__range-scale" aria-hidden="true"><span>1 day</span><span>7 days</span></div>
            </div>
          </div>
          <div class="sn-power-calculator__step">
            <label class="sn-power-calculator__step-title" for="sn-rv-fit-{{ section.id }}">Battery fit</label>
            <div class="sn-power-calculator__field"><span class="sn-power-calculator__field-label">Starting footprint</span><select id="sn-rv-fit-{{ section.id }}" data-rv-fit><option value="flexible">Flexible footprint</option><option value="group24">Group 24 compartment</option><option value="group31">Group 31 compartment</option></select></div>
          </div>
        </div>

        <div class="sn-power-calculator__actions">
          <button type="submit" class="sn-power-calculator__button">See my RV starting point</button>
          <button type="button" class="sn-power-calculator__text-button" data-switch-scenario>Choose another scenario</button>
        </div>
        <p class="sn-power-calculator__error" data-form-error role="alert" hidden></p>
      </form>

      <form class="sn-power-calculator__form" data-scenario-form="jump" hidden novalidate>
        <div class="sn-power-calculator__form-header">
          <div>
            <p class="sn-power-calculator__step-kicker">STEP 2 &middot; VEHICLE STARTING</p>
            <h2>Tell us about the vehicle.</h2>
          </div>
          <p>The coverage table is based on verified 12V starting references. Final fit depends on the vehicle, battery condition and operating conditions.</p>
        </div>

        <fieldset class="sn-power-calculator__step">
          <legend class="sn-power-calculator__step-title">Vehicle basics</legend>
          <div class="sn-power-calculator__inline-fields">
            <div class="sn-power-calculator__field"><label for="sn-jump-fuel-{{ section.id }}">Fuel</label><select id="sn-jump-fuel-{{ section.id }}" data-jump-fuel><option value="gasoline">Gasoline</option><option value="diesel">Diesel</option></select></div>
            <div class="sn-power-calculator__field"><div class="sn-power-calculator__range-control" data-range-control><div class="sn-power-calculator__range-head"><label for="sn-jump-engine-{{ section.id }}">Engine displacement</label><span class="sn-power-calculator__range-value"><input id="sn-jump-engine-{{ section.id }}" type="number" min="0.1" max="12" step="0.1" value="3" data-jump-engine data-range-number inputmode="decimal"><span>L</span></span></div><input class="sn-power-calculator__range" type="range" min="0.1" max="12" step="0.1" value="3" data-range-input aria-label="Engine displacement in liters"><div class="sn-power-calculator__range-scale" aria-hidden="true"><span>0.1L</span><span>12L</span></div></div></div>
          </div>
          <div class="sn-power-calculator__field"><label for="sn-jump-voltage-{{ section.id }}">Vehicle voltage</label><select id="sn-jump-voltage-{{ section.id }}" data-jump-voltage><option value="12v">12V</option><option value="24v">24V</option><option value="unknown">Not sure</option></select></div>
        </fieldset>

        <fieldset class="sn-power-calculator__step">
          <legend class="sn-power-calculator__step-title">Operating conditions</legend>
          <div class="sn-power-calculator__choice-grid sn-power-calculator__choice-grid--2">
            <label class="sn-power-calculator__choice"><input type="radio" name="sn-jump-environment-{{ section.id }}" value="standard" checked data-jump-environment>Standard conditions</label>
            <label class="sn-power-calculator__choice"><input type="radio" name="sn-jump-environment-{{ section.id }}" value="cold" data-jump-environment>Cold-weather reserve</label>
            <label class="sn-power-calculator__choice"><input type="radio" name="sn-jump-environment-{{ section.id }}" value="demanding" data-jump-environment>Frequent or demanding use</label>
          </div>
        </fieldset>

        <fieldset class="sn-power-calculator__step">
          <legend class="sn-power-calculator__step-title">What matters most?</legend>
          <div class="sn-power-calculator__field"><label for="sn-jump-priority-{{ section.id }}">Priority</label><select id="sn-jump-priority-{{ section.id }}" data-jump-priority><option value="compact">Smallest carry size</option><option value="display">Clear display and controls</option><option value="charging">Charging utility</option><option value="reserve">More reserve capacity</option></select></div>
        </fieldset>

        <div class="sn-power-calculator__actions">
          <button type="submit" class="sn-power-calculator__button">Find my jump starter</button>
          <button type="button" class="sn-power-calculator__text-button" data-switch-scenario>Choose another scenario</button>
        </div>
        <p class="sn-power-calculator__error" data-form-error role="alert" hidden></p>
      </form>

      <form class="sn-power-calculator__form" data-scenario-form="home" hidden novalidate>
        <div class="sn-power-calculator__form-header">
          <div>
            <p class="sn-power-calculator__step-kicker">STEP 2 &middot; HOME BACKUP</p>
            <h2>What should stay powered?</h2>
          </div>
          <p>Use only the loads you need during an outage. The result is a capacity starting point; inverter, transfer equipment and installation still need a qualified review.</p>
        </div>

        <fieldset class="sn-power-calculator__step">
          <legend class="sn-power-calculator__step-title">Essential loads</legend>
          <p class="sn-power-calculator__step-caption">Select the loads that should remain available, then mark Peak for loads expected to run at the same time.</p>
          <div class="sn-power-calculator__load-list" data-load-list>
            <div class="sn-power-calculator__load-row" data-load-row>
              <div class="sn-power-calculator__load-heading"><strong>Refrigerator</strong><div class="sn-power-calculator__load-options"><label class="sn-power-calculator__load-check"><input type="checkbox" checked data-load-selected> Include</label><label class="sn-power-calculator__load-check"><input type="checkbox" checked data-load-simultaneous> Peak</label></div></div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-home-fridge-watts-{{ section.id }}">Power draw</label><span class="sn-power-calculator__range-value"><input id="sn-home-fridge-watts-{{ section.id }}" type="number" min="1" max="5000" step="1" value="150" data-load-watts data-range-number inputmode="decimal" aria-label="Home refrigerator watts"><span>W</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="10" max="1000" step="10" value="150" data-range-input aria-label="Home refrigerator power draw"><div class="sn-power-calculator__range-scale" aria-hidden="true"><span>10W</span><span>1kW</span></div>
              </div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-home-fridge-hours-{{ section.id }}">Daily run time</label><span class="sn-power-calculator__range-value"><input id="sn-home-fridge-hours-{{ section.id }}" type="number" min="0.1" max="24" step="0.1" value="12" data-load-hours data-range-number inputmode="decimal" aria-label="Home refrigerator hours per day"><span>hours/day</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="0.1" max="24" step="0.1" value="12" data-range-input aria-label="Home refrigerator daily run time"><div class="sn-power-calculator__range-scale" aria-hidden="true"><span>0.1h</span><span>24h</span></div>
              </div>
            </div>
            <div class="sn-power-calculator__load-row" data-load-row>
              <div class="sn-power-calculator__load-heading"><strong>Lighting</strong><div class="sn-power-calculator__load-options"><label class="sn-power-calculator__load-check"><input type="checkbox" checked data-load-selected> Include</label><label class="sn-power-calculator__load-check"><input type="checkbox" data-load-simultaneous> Peak</label></div></div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-home-lighting-watts-{{ section.id }}">Power draw</label><span class="sn-power-calculator__range-value"><input id="sn-home-lighting-watts-{{ section.id }}" type="number" min="1" max="3000" step="1" value="100" data-load-watts data-range-number inputmode="decimal" aria-label="Home lighting watts"><span>W</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="10" max="1000" step="10" value="100" data-range-input aria-label="Home lighting power draw"><div class="sn-power-calculator__range-scale" aria-hidden="true"><span>10W</span><span>1kW</span></div>
              </div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-home-lighting-hours-{{ section.id }}">Daily run time</label><span class="sn-power-calculator__range-value"><input id="sn-home-lighting-hours-{{ section.id }}" type="number" min="0.1" max="24" step="0.1" value="5" data-load-hours data-range-number inputmode="decimal" aria-label="Home lighting hours per day"><span>hours/day</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="0.1" max="12" step="0.1" value="5" data-range-input aria-label="Home lighting daily run time"><div class="sn-power-calculator__range-scale" aria-hidden="true"><span>0.1h</span><span>12h</span></div>
              </div>
            </div>
            <div class="sn-power-calculator__load-row" data-load-row>
              <div class="sn-power-calculator__load-heading"><strong>Internet / router</strong><div class="sn-power-calculator__load-options"><label class="sn-power-calculator__load-check"><input type="checkbox" checked data-load-selected> Include</label><label class="sn-power-calculator__load-check"><input type="checkbox" data-load-simultaneous> Peak</label></div></div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-home-router-watts-{{ section.id }}">Power draw</label><span class="sn-power-calculator__range-value"><input id="sn-home-router-watts-{{ section.id }}" type="number" min="1" max="1000" step="1" value="25" data-load-watts data-range-number inputmode="decimal" aria-label="Internet router watts"><span>W</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="5" max="300" step="5" value="25" data-range-input aria-label="Internet router power draw"><div class="sn-power-calculator__range-scale" aria-hidden="true"><span>5W</span><span>300W</span></div>
              </div>
              <div class="sn-power-calculator__range-control" data-range-control>
                <div class="sn-power-calculator__range-head"><label for="sn-home-router-hours-{{ section.id }}">Daily run time</label><span class="sn-power-calculator__range-value"><input id="sn-home-router-hours-{{ section.id }}" type="number" min="0.1" max="24" step="0.1" value="24" data-load-hours data-range-number inputmode="decimal" aria-label="Internet router hours per day"><span>hours/day</span></span></div>
                <input class="sn-power-calculator__range" type="range" min="0.1" max="24" step="0.1" value="24" data-range-input aria-label="Internet router daily run time"><div class="sn-power-calculator__range-scale" aria-hidden="true"><span>0.1h</span><span>24h</span></div>
              </div>
            </div>
          </div>
          <button type="button" class="sn-power-calculator__text-button" data-add-load>Add another load</button>
        </fieldset>

        <div class="sn-power-calculator__inline-fields">
          <div class="sn-power-calculator__step">
            <label class="sn-power-calculator__step-title" for="sn-home-backup-hours-{{ section.id }}">Backup window</label>
            <div class="sn-power-calculator__range-control" data-range-control>
              <div class="sn-power-calculator__range-head"><label for="sn-home-backup-hours-{{ section.id }}">Hours</label><span class="sn-power-calculator__range-value"><input id="sn-home-backup-hours-{{ section.id }}" type="number" min="4" max="72" step="1" value="12" data-home-backup-hours data-range-number inputmode="numeric"><span>hours</span></span></div>
              <input class="sn-power-calculator__range" type="range" min="4" max="72" step="1" value="12" data-range-input aria-label="Home backup window in hours"><div class="sn-power-calculator__range-scale" aria-hidden="true"><span>4 hours</span><span>72 hours</span></div>
            </div>
          </div>
          <fieldset class="sn-power-calculator__step">
            <legend class="sn-power-calculator__step-title">Battery architecture</legend>
            <div class="sn-power-calculator__choice-grid sn-power-calculator__choice-grid--2">
              <label class="sn-power-calculator__choice"><input type="radio" name="sn-home-architecture-{{ section.id }}" value="low" checked data-home-architecture>Low voltage</label>
              <label class="sn-power-calculator__choice"><input type="radio" name="sn-home-architecture-{{ section.id }}" value="high" data-home-architecture>High voltage</label>
              <label class="sn-power-calculator__choice"><input type="radio" name="sn-home-architecture-{{ section.id }}" value="unsure" data-home-architecture>Need a system review</label>
            </div>
          </fieldset>
        </div>

        <div class="sn-power-calculator__actions">
          <button type="submit" class="sn-power-calculator__button">Find my home starting point</button>
          <button type="button" class="sn-power-calculator__text-button" data-switch-scenario>Choose another scenario</button>
        </div>
        <p class="sn-power-calculator__error" data-form-error role="alert" hidden></p>
      </form>

      <div class="sn-power-calculator__results" data-results hidden aria-live="polite" tabindex="-1">
        <div class="sn-power-calculator__results-header">
          <div>
            <p class="sn-power-calculator__result-kicker" data-result-kicker>YOUR STARTING POINT</p>
            <h2 data-result-title>Choose a scenario to see a starting point.</h2>
          </div>
          <p class="sn-power-calculator__result-summary" data-result-summary></p>
        </div>

        <div class="sn-power-calculator__metric-grid" data-result-metrics></div>

        <div class="sn-power-calculator__product" data-result-product hidden>
          <div class="sn-power-calculator__product-media"><img data-result-image src="{{ 'suntneew-product-g31.jpg' | asset_url }}" alt="" width="600" height="600" loading="lazy"></div>
          <div class="sn-power-calculator__product-copy">
            <h3 data-result-product-title></h3>
            <div class="sn-power-calculator__product-specs" data-result-product-specs></div>
            <p data-result-product-copy></p>
            <div class="sn-power-calculator__result-actions">
              <a class="sn-power-calculator__result-link" data-result-product-link href="#">Open product details</a>
              <a class="sn-power-calculator__result-link sn-power-calculator__result-link--secondary" data-result-secondary-link href="#" hidden>Compare another option</a>
            </div>
          </div>
        </div>

        <div class="sn-power-calculator__result-actions" data-result-support-actions hidden>
          <a class="sn-power-calculator__result-link" data-result-support-link href="{{ section.settings.support_url | default: '/pages/request-for-quote' }}">Request technical support</a>
          <button type="button" class="sn-power-calculator__result-link sn-power-calculator__result-link--secondary" data-result-reset>Start again</button>
        </div>

        <p class="sn-power-calculator__fine-print" data-result-fine-print>{{ section.settings.disclaimer | escape }}</p>

        <div class="sn-power-calculator__result-navigation">
          <button type="button" class="sn-power-calculator__text-button" data-edit-answers>Edit my answers</button>
          <button type="button" class="sn-power-calculator__text-button" data-switch-scenario>Choose another scenario</button>
        </div>
      </div>
    </div>
  </div>

  <div class="sn-power-calculator__catalog" hidden aria-hidden="true">
    <span data-product-record data-product-key="rv-g24" data-product-id="g24-100ah" data-product-model="Group 24 100Ah" data-product-url="{{ product_rv_g24.url | default: '/products/suntneew-12-8v-100ah-lifepo4-rv-battery-group-24' }}" data-product-image="{{ 'suntneew-product-g24.jpg' | asset_url }}" data-product-description="1,280Wh rated energy and 1,280W continuous output. Confirm the Group 24 compartment and complete RV system before ordering."></span>
    <span data-product-record data-product-key="rv-g31" data-product-id="g31-100ah" data-product-model="Group 31 100Ah" data-product-url="{{ product_rv_g31.url | default: '/products/suntneew-12-8v-100ah-lifepo4-rv-battery-group-31' }}" data-product-image="{{ 'suntneew-product-g31.jpg' | asset_url }}" data-product-description="1,280Wh rated energy and 1,280W continuous output. Confirm the Group 31 compartment and complete RV system before ordering."></span>
    <span data-product-record data-product-key="rv-230" data-product-id="230ah" data-product-model="230Ah" data-product-url="{{ product_rv_230.url | default: '/products/suntneew-12-8v-230ah-lifepo4-rv-battery' }}" data-product-image="{{ 'suntneew-product-230ah.jpg' | asset_url }}" data-product-description="2,944Wh rated energy and 2,560W continuous output in one higher-capacity RV battery."></span>
    <span data-product-record data-product-key="rv-314" data-product-id="314ah" data-product-model="314Ah" data-product-url="{{ product_rv_314.url | default: '/products/suntneew-12-8v-314ah-lifepo4-rv-battery' }}" data-product-image="{{ 'suntneew-product-314ah.jpg' | asset_url }}" data-product-description="4,019.2Wh rated energy and 2,010W continuous output. Confirm enclosure, restraint and service access."></span>
    <span data-product-record data-product-key="jump-a20" data-product-id="a20" data-product-model="A20 Jump Starter" data-product-url="{{ product_a20.url | default: '/products/suntneew-a20-jump-starter-8000mah' }}" data-product-image="{{ 'suntneew-product-a20.jpg' | asset_url }}" data-product-description="A20 is one product family with capacity and color variants. Select the exact variant on the product page."></span>
    <span data-product-record data-product-key="jump-a3" data-product-id="a3" data-product-model="A3 Jump Starter" data-product-url="{{ product_a3.url | default: '/products/suntneew-a3-jump-starter-16000mah' }}" data-product-image="{{ 'suntneew-product-a3.jpg' | asset_url }}" data-product-description="A3 is a 16,000mAh 12V starting option with model-specific coverage and charging features."></span>
    <span data-product-record data-product-key="jump-u23" data-product-id="u23" data-product-model="U23 Jump Starter" data-product-url="{{ product_u23.url | default: '/products/suntneew-u23-portable-car-jump-starter-8-000mah' }}" data-product-image="{{ 'suntneew-u23-gallery-01.jpg' | asset_url }}" data-product-description="Compact 12V starting option with a verified 8,000mAh reference. Check the exact vehicle fit on the product page."></span>
    <span data-product-record data-product-key="jump-u32" data-product-id="u32" data-product-model="U32 Jump Starter" data-product-url="{{ product_u32.url | default: '/products/suntneew-u32-portable-car-jump-starter-10-000mah' }}" data-product-image="{{ 'suntneew-u32-gallery-01.jpg' | asset_url }}" data-product-description="Large-display 12V starting option with a verified 10,000mAh reference. Check the exact vehicle fit on the product page."></span>
    <span data-product-record data-product-key="home-wl5a" data-product-id="wl5a" data-product-model="ENERGY STAR WL5A" data-product-url="{{ product_wl5a.url | default: '/products/suntneew-wl5a-5-12-kwh-low-voltage-home-battery' }}" data-product-image="{{ 'energy-star-wl5a-main-v1.jpg' | asset_url }}" data-product-description="5.12kWh low-voltage starting point for essential-load home backup. Confirm inverter compatibility and installation requirements."></span>
    <span data-product-record data-product-key="home-wl10b" data-product-id="wl10b" data-product-model="ENERGY STAR WL10B" data-product-url="{{ product_wl10b.url | default: '/products/suntneew-wl10b-10-24-kwh-low-voltage-home-battery' }}" data-product-image="{{ 'energy-star-wl10b-main-v1.jpg' | asset_url }}" data-product-description="10.24kWh low-voltage starting point for extended essential-load backup. Confirm inverter compatibility and installation requirements."></span>
    <span data-product-record data-product-key="home-vh" data-product-id="vh" data-product-model="ENERGY STAR VH" data-product-url="{{ product_vh.url | default: '/products/suntneew-vh-high-voltage-home-energy-storage-system' }}" data-product-image="{{ 'energy-star-vh10-vh15-main-v1.jpg' | asset_url }}" data-product-description="High-voltage system family with 10.24kWh and 15.36kWh configurations. Final architecture requires project review."></span>
  </div>
</section>

{% schema %}
{
  "name": "SuntNeew power planner",
  "tag": "section",
  "class": "shopify-section--suntneew-power-calculator",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SUNTNEEW POWER PLANNER"},
    {"type":"text","id":"heading","label":"Heading","default":"Help Me Choose"},
    {"type":"textarea","id":"intro","label":"Intro","default":"Answer a few practical questions and get a clear SuntNeew product starting point."},
    {"type":"textarea","id":"privacy_note","label":"Privacy note","default":"Your selections stay in this page session. No personal information or free-text device names are sent by this planner."},
    {"type":"text","id":"scenario_eyebrow","label":"Scenario eyebrow","default":"STEP 1 OF 3"},
    {"type":"text","id":"scenario_heading","label":"Scenario heading","default":"Choose Your Scenario"},
    {"type":"textarea","id":"scenario_body","label":"Scenario body","default":"Where do you need dependable power?"},
    {"type":"url","id":"support_url","label":"Technical support URL"},
    {"type":"textarea","id":"disclaimer","label":"Result disclaimer","default":"Planning estimates use the values entered here and verified product reference data. Confirm model specifications, compatibility, protection, wiring and installation requirements before purchase or installation."}
  ],
  "presets": [{"name":"SuntNeew power planner"}]
}
{% endschema %}
