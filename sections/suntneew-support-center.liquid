{{ 'suntneew-support.css' | asset_url | stylesheet_tag }}

{%- assign resources_url = pages['manuals-certifications'].url | default: '/pages/manuals-certifications' -%}

<section class="sn-support" aria-labelledby="sn-support-heading">
  <div class="sn-support__shell">
    <header class="sn-support__hero">
      <p class="sn-support__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 id="sn-support-heading">{{ page.title | default: section.settings.heading }}</h1>
      <p>{{ section.settings.intro }}</p>
    </header>

    <section class="sn-support__routes" aria-labelledby="sn-support-routes-heading">
      <div class="sn-support__section-heading">
        <p class="sn-support__eyebrow">{{ section.settings.routes_eyebrow }}</p>
        <h2 id="sn-support-routes-heading">{{ section.settings.routes_heading }}</h2>
      </div>

      <div class="sn-support__route-grid">
        <a id="product-resources" class="sn-support__route-card" href="{{ resources_url }}">
          <span class="sn-support__route-number" aria-hidden="true">01</span>
          <span class="sn-support__route-label">{{ section.settings.resources_route_label }}</span>
          <strong>{{ section.settings.resources_route_title }}</strong>
          <span>{{ section.settings.resources_route_description }}</span>
          <span class="sn-support__route-arrow" aria-hidden="true">&rarr;</span>
        </a>

        <a class="sn-support__route-card" href="{{ pages['shipping-policy'].url | default: '/pages/shipping-policy' }}">
          <span class="sn-support__route-number" aria-hidden="true">02</span>
          <span class="sn-support__route-label">{{ 'suntneew_auto.s90e602ceded8' | t }}</span>
          <strong>{{ 'suntneew_auto.sae99f545c2f6' | t }}</strong>
          <span>{{ 'suntneew_auto.sbffeb98651a0' | t }}</span>
          <span class="sn-support__route-arrow" aria-hidden="true">&rarr;</span>
        </a>

        <a class="sn-support__route-card" href="{{ pages['return-policy'].url | default: '/pages/return-policy' }}">
          <span class="sn-support__route-number" aria-hidden="true">03</span>
          <span class="sn-support__route-label">{{ 'suntneew_auto.sc539e2ed1a2a' | t }}</span>
          <strong>{{ 'suntneew_auto.s16dcaa923f16' | t }}</strong>
          <span>{{ 'suntneew_auto.se8ceed3d8fd2' | t }}</span>
          <span class="sn-support__route-arrow" aria-hidden="true">&rarr;</span>
        </a>

        <a class="sn-support__route-card" href="{{ pages['contact-us'].url | default: '/pages/contact-us' }}">
          <span class="sn-support__route-number" aria-hidden="true">04</span>
          <span class="sn-support__route-label">{{ 'suntneew_auto.sf82ecbb5e510' | t }}</span>
          <strong>{{ 'suntneew_auto.se37a2b808188' | t }}</strong>
          <span>{{ 'suntneew_auto.s9bfcc3e3fc40' | t }}</span>
          <span class="sn-support__route-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <section class="sn-support__prepare" aria-labelledby="sn-support-prepare-heading">
      <div>
        <p class="sn-support__eyebrow">{{ 'suntneew_auto.s2c2a95b8eb91' | t }}</p>
        <h2 id="sn-support-prepare-heading">{{ 'suntneew_auto.s1aced0448341' | t }}</h2>
      </div>
      <ol>
        <li>{{ 'suntneew_auto.s90325f989f68' | t }}</li>
        <li>{{ 'suntneew_auto.s2533a48eabf0' | t }}</li>
        <li>{{ 'suntneew_auto.sa50c5baa91c4' | t }}</li>
      </ol>
    </section>
  </div>
</section>

{% schema %}
{
  "name": "SuntNeew support center",
  "class": "shopify-section--suntneew-support-center",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SUPPORT CENTER"},
    {"type": "text", "id": "heading", "label": "Fallback heading", "default": "Support Center"},
    {"type": "textarea", "id": "intro", "label": "Introduction", "default": "Find the right resources for your SuntNeew product, order or technical question."},
    {"type": "text", "id": "routes_eyebrow", "label": "Routes eyebrow", "default": "CHOOSE A ROUTE"},
    {"type": "text", "id": "routes_heading", "label": "Routes heading", "default": "Get to the right answer faster."},
    {"type": "text", "id": "resources_route_label", "label": "Product resources label", "default": "PRODUCT RESOURCES"},
    {"type": "text", "id": "resources_route_title", "label": "Product resources title", "default": "Manuals & Certifications"},
    {"type": "textarea", "id": "resources_route_description", "label": "Product resources description", "default": "Search model-specific online manuals, downloadable files and compliance information."}
  ]
}
{% endschema %}
