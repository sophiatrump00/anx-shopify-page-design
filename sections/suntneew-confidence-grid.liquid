<section class="sn-confidence" aria-labelledby="sn-confidence-title-{{ section.id }}">
  <div class="sn-confidence__shell">
    <div class="sn-confidence__heading">
      <div>
        <p class="sn-light-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="sn-confidence-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      <p>{{ section.settings.body }}</p>
    </div>

    <div class="sn-confidence__grid">
      <article class="sn-confidence__card sn-confidence__card--product">
        <div class="sn-confidence__card-copy">
          <p class="sn-confidence__index">01</p>
          <h3>{{ section.settings.product_title }}</h3>
          <p>{{ section.settings.product_text }}</p>
          <div class="sn-confidence__badges" aria-label="Certification coverage">
            <span>Safety</span>
            <span>Transport</span>
            <span>Compliance</span>
          </div>
          <a class="sn-light-link" href="{{ section.settings.product_link | default: '#' }}">{{ section.settings.product_link_label }}</a>
        </div>
        <img src="{{ section.settings.product_asset | asset_url }}" alt="{{ section.settings.product_alt | escape }}" width="1000" height="1000" loading="lazy">
      </article>

      <div class="sn-confidence__small-grid">
        {%- for block in section.blocks -%}
          <article class="sn-confidence__card sn-confidence__card--small" {{ block.shopify_attributes }}>
            <span class="sn-confidence__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'warranty' -%}<svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>
                {%- when 'delivery' -%}<svg viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><path d="M5 9h5M5 12h4"/></svg>
                {%- when 'shipping' -%}<svg viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4zM4 7v10l8 4 8-4V7M12 11v10"/><path d="m8 5 8 4"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><path d="M7 7h11l-3-3M18 7l-3 3M17 17H6l3 3M6 17l3-3"/><path d="M20 11a8 8 0 0 1-1 4M4 13a8 8 0 0 1 1-4"/></svg>
              {%- endcase -%}
            </span>
            <p class="sn-confidence__index">{{ forloop.index | plus: 1 | prepend: '0' }}</p>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {%- endfor -%}
      </div>

      <article class="sn-confidence__card sn-confidence__card--guidance">
        <div>
          <p class="sn-confidence__index">06</p>
          <h3>{{ section.settings.guidance_title }}</h3>
          <p>{{ section.settings.guidance_text }}</p>
          <a class="sn-light-link" href="{{ section.settings.guidance_link | default: '#' }}">{{ section.settings.guidance_link_label }}</a>
        </div>
        <svg class="sn-confidence__route" viewBox="0 0 280 220" fill="none" aria-hidden="true">
          <path d="M22 188C78 166 66 100 131 111c55 9 44-63 118-76"/>
          <circle cx="22" cy="188" r="8"/><circle cx="131" cy="111" r="8"/><circle cx="249" cy="35" r="8"/>
        </svg>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"SuntNeew confidence grid",
  "max_blocks":4,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"BUY WITH CONFIDENCE"},
    {"type":"text","id":"heading","label":"Heading","default":"Buy with confidence. Power with confidence."},
    {"type":"textarea","id":"body","label":"Body","default":"Certified products, five-year limited warranty coverage, fast U.S. delivery, free shipping, 30-day returns and technical support beyond the purchase."},
    {"type":"text","id":"product_asset","label":"Product asset","default":"suntneew-product-g31.jpg"},
    {"type":"text","id":"product_alt","label":"Product alt","default":"SuntNeew Group 31 RV battery"},
    {"type":"text","id":"product_title","label":"Product card title","default":"All Products Certified"},
    {"type":"textarea","id":"product_text","label":"Product card text","default":"Every SuntNeew product is supported by applicable safety, transport and compliance documentation."},
    {"type":"text","id":"product_link_label","label":"Product card link label","default":"Explore our technology"},
    {"type":"url","id":"product_link","label":"Product card link"},
    {"type":"text","id":"guidance_title","label":"Guidance title","default":"Lifetime Technical Support"},
    {"type":"textarea","id":"guidance_text","label":"Guidance text","default":"Get product selection, setup guidance and troubleshooting support throughout product ownership."},
    {"type":"text","id":"guidance_link_label","label":"Guidance link label","default":"Get expert support"},
    {"type":"url","id":"guidance_link","label":"Guidance link"}
  ],
  "blocks":[{
    "type":"item","name":"Information card","settings":[
      {"type":"select","id":"icon","label":"Icon","default":"warranty","options":[{"value":"warranty","label":"Warranty"},{"value":"delivery","label":"Delivery"},{"value":"shipping","label":"Shipping"},{"value":"returns","label":"Returns"}]},
      {"type":"text","id":"title","label":"Title","default":"5-Year Limited Warranty"},
      {"type":"textarea","id":"text","label":"Text","default":"Long-term warranty protection backed by dedicated product support."}
    ]
  }],
  "presets":[{"name":"SuntNeew confidence grid","blocks":[{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}
