<section class="sn-confidence" aria-labelledby="sn-confidence-title-{{ section.id }}">
  <div class="sn-confidence__shell">
    <div class="sn-confidence__heading">
      <div>
        <p class="sn-light-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="sn-confidence-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      <p>{{ section.settings.body }}</p>
    </div>

    <div class="sn-confidence__grid">
      <article class="sn-confidence__card sn-confidence__card--product">
        <div class="sn-confidence__card-copy">
          <p class="sn-confidence__index">01</p>
          <h3>{{ section.settings.product_title }}</h3>
          <p>{{ section.settings.product_text }}</p>
          <a class="sn-light-link" href="{{ section.settings.product_link | default: '#' }}">{{ section.settings.product_link_label }}</a>
        </div>
        <img src="{{ section.settings.product_asset | asset_url }}" alt="{{ section.settings.product_alt | escape }}" width="1000" height="1000" loading="lazy">
      </article>

      <div class="sn-confidence__small-grid">
        {%- for block in section.blocks -%}
          <article class="sn-confidence__card sn-confidence__card--small" {{ block.shopify_attributes }}>
            <span class="sn-confidence__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'fit' -%}<svg viewBox="0 0 24 24"><rect x="3" y="7" width="17" height="11" rx="2"/><path d="M20 10h2v5h-2M7 12h9M11.5 8.5v7"/></svg>
                {%- when 'compare' -%}<svg viewBox="0 0 24 24"><path d="M4 18V9M10 18V5M16 18v-6M22 18V3"/><path d="M2 18h22"/></svg>
                {%- when 'document' -%}<svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M9 12h6M9 16h6"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><path d="M4 14v-2a8 8 0 0 1 16 0v2M4 14h3v5H5a1 1 0 0 1-1-1v-4ZM20 14h-3v5h2a1 1 0 0 0 1-1v-4ZM17 19c0 1.1-.9 2-2 2h-3"/></svg>
              {%- endcase -%}
            </span>
            <p class="sn-confidence__index">{{ forloop.index | plus: 1 | prepend: '0' }}</p>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {%- endfor -%}
      </div>

      <article class="sn-confidence__card sn-confidence__card--guidance">
        <div>
          <p class="sn-confidence__index">06</p>
          <h3>{{ section.settings.guidance_title }}</h3>
          <p>{{ section.settings.guidance_text }}</p>
          <a class="sn-light-link" href="{{ section.settings.guidance_link | default: '#' }}">{{ section.settings.guidance_link_label }}</a>
        </div>
        <svg class="sn-confidence__route" viewBox="0 0 280 220" fill="none" aria-hidden="true">
          <path d="M22 188C78 166 66 100 131 111c55 9 44-63 118-76"/>
          <circle cx="22" cy="188" r="8"/><circle cx="131" cy="111" r="8"/><circle cx="249" cy="35" r="8"/>
        </svg>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"SuntNeew confidence grid",
  "max_blocks":4,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"CLEAR BEFORE YOU CHOOSE"},
    {"type":"text","id":"heading","label":"Heading","default":"Choose with confidence."},
    {"type":"textarea","id":"body","label":"Body","default":"Clear specifications, model-specific documents and practical selection guidance—without making promises that depend on an unconfirmed order."},
    {"type":"text","id":"product_asset","label":"Product asset","default":"suntneew-product-g31.jpg"},
    {"type":"text","id":"product_alt","label":"Product alt","default":"SuntNeew Group 31 RV battery"},
    {"type":"text","id":"product_title","label":"Product card title","default":"Find the right RV battery"},
    {"type":"textarea","id":"product_text","label":"Product card text","default":"Compare case size, usable energy, continuous output and system voltage in one place."},
    {"type":"text","id":"product_link_label","label":"Product card link label","default":"Compare RV batteries"},
    {"type":"url","id":"product_link","label":"Product card link"},
    {"type":"text","id":"guidance_title","label":"Guidance title","default":"Plan before you order"},
    {"type":"textarea","id":"guidance_text","label":"Guidance text","default":"Confirm the application, system compatibility and available delivery options before an order is placed."},
    {"type":"text","id":"guidance_link_label","label":"Guidance link label","default":"Request guidance"},
    {"type":"url","id":"guidance_link","label":"Guidance link"}
  ],
  "blocks":[{
    "type":"item","name":"Information card","settings":[
      {"type":"select","id":"icon","label":"Icon","default":"fit","options":[{"value":"fit","label":"Fit"},{"value":"compare","label":"Compare"},{"value":"document","label":"Document"},{"value":"support","label":"Support"}]},
      {"type":"text","id":"title","label":"Title","default":"Fit first"},
      {"type":"textarea","id":"text","label":"Text","default":"Match case size, terminal layout and system voltage."}
    ]
  }],
  "presets":[{"name":"SuntNeew confidence grid","blocks":[{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}
