{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --rvg-ink: #111827;
    --rvg-navy: #182330;
    --rvg-muted: #374151;
    --rvg-line: #e2e8f0;
    --rvg-accent: #e95416;
    --rvg-accent-hover: #cf470f;
    --rvg-sale: #D92D20;
    --rvg-bg: #f1f3f6;
    background: var(--rvg-bg);
    color: var(--rvg-ink);
  }

  /* Compact Hero */
  #shopify-section-{{ section.id }} .sn-rvg-hero {
    position: relative;
    overflow: hidden;
    background: #0f172a;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-rvg-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .46;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(15 23 42 / .94) 0%, rgb(15 23 42 / .72) 55%, rgb(15 23 42 / .28) 100%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 180px;
    padding-block: clamp(24px, 3vw, 36px);
  }

  #shopify-section-{{ section.id }} .sn-rvg-hero__eyebrow {
    margin: 0 0 6px;
    color: #ff9463;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-rvg-hero h1 {
    max-width: 640px;
    margin: 0 0 6px;
    color: #fff;
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 800;
    letter-spacing: -.025em;
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .sn-rvg-hero__sub {
    max-width: 560px;
    margin: 0;
    color: rgb(255 255 255 / .86);
    font-size: 14px;
    line-height: 1.5;
  }

  /* Quick Category Navigation */
  #shopify-section-{{ section.id }} .sn-rvg-nav {
    background: #fff;
    border-bottom: 1px solid var(--rvg-line);
    scroll-margin-top: 72px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-nav__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding-block: 14px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-nav__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 8px 16px;
    border: 1px solid var(--rvg-line);
    border-radius: 999px;
    background: #f1f5f9;
    color: var(--rvg-navy);
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color .15s ease, border-color .15s ease, color .15s ease;
  }

  #shopify-section-{{ section.id }} .sn-rvg-nav__item:first-child {
    background: var(--rvg-navy);
    border-color: var(--rvg-navy);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-rvg-nav__item--compare {
    margin-left: auto;
  }

  #shopify-section-{{ section.id }} .sn-rvg-nav__item:hover,
  #shopify-section-{{ section.id }} .sn-rvg-nav__item:focus-visible {
    border-color: var(--rvg-accent);
    color: var(--rvg-accent);
    outline: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-nav__item:first-child:hover,
  #shopify-section-{{ section.id }} .sn-rvg-nav__item:first-child:focus-visible,
  #shopify-section-{{ section.id }} .sn-rvg-nav__item--compare:hover,
  #shopify-section-{{ section.id }} .sn-rvg-nav__item--compare:focus-visible {
    background: var(--rvg-accent);
    border-color: var(--rvg-accent);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-rvg-nav__txt--mob {
    display: none;
  }

  /* Main Body & Grouped 2+2 Shelves */
  #shopify-section-{{ section.id }} .sn-rvg-body {
    padding-block: clamp(24px, 3.2vw, 40px) clamp(56px, 6vw, 84px);
  }

  #shopify-section-{{ section.id }} .sn-rvg-shelves {
    display: grid;
    gap: clamp(32px, 4vw, 44px);
  }

  #shopify-section-{{ section.id }} .sn-rvg-shelf {
    scroll-margin-top: 84px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-shelf__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-shelf__head h2 {
    margin: 0;
    color: var(--rvg-ink);
    font-size: clamp(19px, 2.2vw, 23px);
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .sn-rvg-shelf__count {
    color: #9ca3af;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sn-rvg-grid--2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  /* LiTime-Calibrated Wide Product Card (Pure Version) */
  #shopify-section-{{ section.id }} .sn-rvg-card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid var(--rvg-line);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 2px 10px rgb(15 23 42 / .045);
    transition: box-shadow .18s ease, border-color .18s ease;
  }

  #shopify-section-{{ section.id }} .sn-rvg-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 12px 28px rgb(15 23 42 / .085);
  }

  #shopify-section-{{ section.id }} .sn-rvg-card__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 215px;
    min-width: 215px;
    min-height: 235px;
    padding: 28px 16px 16px;
    border-right: 1px solid #f3f4f6;
    background: #fff;
    overflow: hidden;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-card__media-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-card__stage img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 185px;
    object-fit: contain;
    transition: transform .24s ease;
  }

  #shopify-section-{{ section.id }} .sn-rvg-card:hover .sn-rvg-card__stage img {
    transform: scale(1.03);
  }

  #shopify-section-{{ section.id }} .sn-rvg-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    padding: 2px 7px;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    background: #f1f5f9;
    color: #334155;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
  }

  /* Live Store Style-A Red XX% OFF Badge (#D92D20) */
  #shopify-section-{{ section.id }} .sn-rvg-save {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--rvg-sale);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .02em;
    line-height: 1.3;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sn-rvg-save[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-quick-eye {
    position: absolute;
    right: 10px;
    bottom: 8px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    background: rgb(255 255 255 / .94);
    color: #334155;
    box-shadow: 0 2px 8px rgb(15 23 42 / .08);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity .16s ease, transform .16s ease, border-color .16s ease, color .16s ease;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-card:hover .sn-rvg-quick-eye,
  #shopify-section-{{ section.id }} .sn-rvg-quick-eye:focus-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .sn-rvg-quick-eye:hover {
    border-color: var(--rvg-accent);
    color: var(--rvg-accent);
  }

  #shopify-section-{{ section.id }} .sn-rvg-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 16px 18px;
  }

  /* Meta Strip Below/Inside Card: Circular Outline Feature Icons + Inline Feature Tag */
  #shopify-section-{{ section.id }} .sn-rvg-meta-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-feat-icons {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-inline-tag {
    padding: 2px 8px;
    border: 1px solid var(--rvg-line);
    border-radius: 4px;
    background: #f1f5f9;
    color: #334155;
    font-size: 10.5px;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sn-rvg-feat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    background: #fff;
    color: #334155;
    transition: border-color .15s ease, color .15s ease;
  }

  #shopify-section-{{ section.id }} .sn-rvg-feat-icon:hover {
    border-color: var(--rvg-accent);
    color: var(--rvg-accent);
  }

  /* Bold Title */
  #shopify-section-{{ section.id }} .sn-rvg-card__title {
    margin: 0;
    font-size: 16.5px;
    font-weight: 800;
    letter-spacing: -.015em;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .sn-rvg-card__title a {
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sn-rvg-card__title a:hover {
    color: var(--rvg-accent);
  }

  /* 3 Concise Muted Bullet Points */
  #shopify-section-{{ section.id }} .sn-rvg-bullets {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-bullets li {
    position: relative;
    padding-left: 12px;
    color: var(--rvg-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .sn-rvg-bullets li::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
    color: #64748b;
    font-weight: 700;
  }

  /* Footer Divider + Live Style-A Price + G31 Pack Selector / Details + Full-Width CTA */
  #shopify-section-{{ section.id }} .sn-rvg-card__footer {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--rvg-line);
  }

  #shopify-section-{{ section.id }} .sn-rvg-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-prices {
    display: flex;
    align-items: baseline;
    gap: 7px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-price {
    color: var(--rvg-sale);
    font-size: 19.5px;
    font-weight: 800;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .sn-rvg-price--regular {
    color: var(--rvg-navy);
  }

  #shopify-section-{{ section.id }} .sn-rvg-compare {
    color: #6b7280;
    font-size: 12.5px;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .sn-rvg-compare[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-price-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sn-rvg-packs {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-pack-btn {
    padding: 2px 7px;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    background: #f8fafc;
    color: #475569;
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    transition: background-color .14s ease, border-color .14s ease, color .14s ease;
  }

  #shopify-section-{{ section.id }} .sn-rvg-pack-btn:hover {
    border-color: var(--rvg-navy);
    color: var(--rvg-navy);
  }

  #shopify-section-{{ section.id }} .sn-rvg-pack-btn[aria-pressed="true"] {
    border-color: var(--rvg-navy);
    background: var(--rvg-navy);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-rvg-action-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-form {
    display: contents;
  }

  #shopify-section-{{ section.id }} .sn-rvg-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 38px;
    padding: 0 14px;
    border: 0;
    border-radius: 6px;
    background: var(--rvg-ink);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background-color .15s ease;
  }

  #shopify-section-{{ section.id }} .sn-rvg-btn-primary:hover:not(:disabled),
  #shopify-section-{{ section.id }} .sn-rvg-btn-primary:focus-visible:not(:disabled) {
    background: var(--rvg-accent);
    outline: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-btn-primary:disabled {
    opacity: .5;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .sn-rvg-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 0 14px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #fff;
    color: #1e293b;
    font: inherit;
    font-size: 12.5px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color .15s ease, color .15s ease;
  }

  #shopify-section-{{ section.id }} .sn-rvg-btn-secondary:hover,
  #shopify-section-{{ section.id }} .sn-rvg-btn-secondary:focus-visible {
    border-color: var(--rvg-ink);
    color: var(--rvg-ink);
    outline: none;
  }

  /* Collapsible Compare All 4 Table */
  #shopify-section-{{ section.id }} .sn-rvg-compare-box {
    scroll-margin-top: 84px;
    border: 1px solid var(--rvg-line);
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sn-rvg-compare-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    border: 0;
    background: #fff;
    color: var(--rvg-ink);
    text-align: left;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .sn-rvg-compare-toggle:hover {
    background: #f8fafc;
  }

  #shopify-section-{{ section.id }} .sn-rvg-compare-toggle__eyebrow {
    display: block;
    color: var(--rvg-accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-rvg-compare-toggle__title {
    display: block;
    margin-top: 2px;
    font-size: 16px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-rvg-compare-toggle__pill {
    flex: none;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--rvg-navy);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .sn-rvg-table-wrap {
    overflow-x: auto;
    border-top: 1px solid var(--rvg-line);
  }

  #shopify-section-{{ section.id }} .sn-rvg-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 12px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .sn-rvg-table th,
  #shopify-section-{{ section.id }} .sn-rvg-table td {
    padding: 12px 16px;
    border-bottom: 1px solid #f1f5f9;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sn-rvg-table th {
    background: #f8fafc;
    color: var(--rvg-muted);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-rvg-table tr:last-child td {
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .sn-rvg-table__sale {
    color: var(--rvg-sale);
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-rvg-table__link {
    display: inline-flex;
    align-items: center;
    padding: 6px 11px;
    border-radius: 6px;
    background: var(--rvg-navy);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-table__link:hover {
    background: var(--rvg-accent);
  }

  #shopify-section-{{ section.id }} .sn-rvg-footnote {
    margin: 0;
    padding: 12px 16px;
    border-top: 1px solid #f1f5f9;
    color: var(--rvg-muted);
    font-size: 11px;
    line-height: 1.5;
  }

  /* Cross-Device Floating Bottom-Center Quick-Return Pill + Popover */
  #shopify-section-{{ section.id }} .sn-rvg-float-wrap {
    position: fixed;
    bottom: 20px;
    left: 50%;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(14px);
    transition: opacity .2s ease, transform .2s ease;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-wrap.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-pop {
    width: 264px;
    padding: 8px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 18px 40px rgb(15 23 42 / .2);
    font-size: 12px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-pop__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
    padding: 4px 10px 6px;
    border-bottom: 1px solid #f1f5f9;
    color: var(--rvg-ink);
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-pop__close {
    padding: 2px 6px;
    border: 0;
    background: transparent;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-pop__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    border-radius: 10px;
    color: var(--rvg-ink);
    font-weight: 600;
    text-decoration: none;
    transition: background-color .14s ease;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-pop__link:hover,
  #shopify-section-{{ section.id }} .sn-rvg-float-pop__link:focus-visible {
    background: #fff7ed;
    outline: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-pop__num {
    margin-right: 4px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-pop__meta {
    color: #64748b;
    font-size: 11px;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-pop__top {
    display: block;
    margin-top: 4px;
    padding: 8px 10px;
    border-radius: 10px;
    background: var(--rvg-navy);
    color: #fff;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-pop__top:hover {
    background: var(--rvg-accent);
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid rgb(255 255 255 / .18);
    border-radius: 999px;
    background: rgb(24 35 48 / .95);
    color: #fff;
    font: inherit;
    font-size: 12.5px;
    font-weight: 700;
    box-shadow: 0 10px 28px rgb(15 23 42 / .28);
    cursor: pointer;
    transition: background-color .15s ease;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-btn:hover,
  #shopify-section-{{ section.id }} .sn-rvg-float-btn:focus-visible {
    background: var(--rvg-accent);
    outline: none;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-btn__arrow {
    color: #ff9463;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-btn:hover .sn-rvg-float-btn__arrow {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-rvg-float-btn__pill {
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / .16);
    color: #e2e8f0;
    font-size: 11px;
    font-weight: 600;
  }

  /* Tablet (700px - 999px): 2-col compact vertical cards so widths stay balanced */
  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .sn-rvg-card {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .sn-rvg-card__stage {
      width: 100%;
      min-width: 0;
      height: 190px;
      min-height: 190px;
      padding: 30px 16px 12px;
      border-right: 0;
    }

    #shopify-section-{{ section.id }} .sn-rvg-card__stage img {
      max-height: 148px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-card__body {
      padding: 8px 16px 16px;
    }
  }

  /* Mobile (<= 699px): 2-col balanced nav + 114px Left Image Horizontal Cards */
  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .sn-rvg-hero__inner {
      min-height: 165px;
      padding-block: 20px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-nav__txt--desk {
      display: none;
    }

    #shopify-section-{{ section.id }} .sn-rvg-nav__txt--mob {
      display: inline;
    }

    #shopify-section-{{ section.id }} .sn-rvg-nav__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      padding-block: 12px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-nav__item {
      min-height: 40px;
      padding: 9px 10px;
      border-radius: 10px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-nav__item--compare {
      grid-column: 1 / -1;
      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .sn-rvg-grid--2 {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-card {
      flex-direction: row;
      align-items: stretch;
      border-radius: 12px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-card__stage {
      width: 114px;
      min-width: 114px;
      height: auto;
      min-height: 162px;
      padding: 24px 8px 10px;
      border-right: 1px solid #f3f4f6;
    }

    #shopify-section-{{ section.id }} .sn-rvg-card__stage img {
      max-height: 128px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-quick-eye,
    #shopify-section-{{ section.id }} .sn-rvg-meta-strip,
    #shopify-section-{{ section.id }} .sn-rvg-bullets li:nth-child(2) {
      display: none;
    }

    #shopify-section-{{ section.id }} .sn-rvg-save {
      top: 6px;
      right: 6px;
      padding: 2px 6px;
      font-size: 10px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-card__body {
      padding: 11px 12px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-card__title {
      font-size: 14px;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .sn-rvg-card__title a {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      white-space: normal;
    }

    #shopify-section-{{ section.id }} .sn-rvg-bullets {
      gap: 2px;
      margin-top: 5px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-bullets li {
      font-size: 11.5px;
      line-height: 1.38;
    }

    #shopify-section-{{ section.id }} .sn-rvg-card__footer {
      margin-top: 8px;
      padding-top: 8px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-price {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-compare {
      font-size: 11.5px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-action-row {
      margin-top: 7px;
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-btn-primary,
    #shopify-section-{{ section.id }} .sn-rvg-btn-secondary {
      height: 32px;
      font-size: 12px;
      padding: 0 10px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-compare-toggle {
      padding: 14px 16px;
    }

    #shopify-section-{{ section.id }} .sn-rvg-float-wrap {
      bottom: 16px;
    }
  }
</style>

{%- liquid
  assign compact_count = 0
  assign reserve_count = 0
  for block in section.blocks
    if block.type != 'battery'
      continue
    endif
    if block.settings.group == 'compact'
      assign compact_count = compact_count | plus: 1
    elsif block.settings.group == 'reserve'
      assign reserve_count = reserve_count | plus: 1
    endif
  endfor
-%}

<section class="sn-rvg" id="{{ section.settings.anchor_id | default: 'rv-batteries' | escape }}" data-rv-guide>
  <header class="sn-rvg-hero">
    {%- if section.settings.hero_asset != blank -%}
      <picture>
        {%- if section.settings.hero_mobile_asset != blank -%}
          <source media="(max-width: 699px)" srcset="{{ section.settings.hero_mobile_asset | asset_url }}">
        {%- endif -%}
        <img
          class="sn-rvg-hero__bg"
          src="{{ section.settings.hero_asset | asset_url }}"
          alt="{{ section.settings.hero_alt | escape }}"
          width="2400"
          height="1200"
          loading="eager"
          fetchpriority="high"
        >
      </picture>
    {%- endif -%}
    <div class="sn-rvg-hero__scrim" aria-hidden="true"></div>
    <div class="container sn-rvg-hero__inner">
      <p class="sn-rvg-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p class="sn-rvg-hero__sub">{{ section.settings.intro | escape }}</p>
    </div>
  </header>

  <nav class="sn-rvg-nav" id="rv-categories" aria-label="RV battery categories">
    <div class="container">
      <div class="sn-rvg-nav__grid">
        <a class="sn-rvg-nav__item" href="#shelf-compact" data-rvg-anchor="#shelf-compact">
          <span class="sn-rvg-nav__txt--desk">100Ah Compact ({{ compact_count }})</span>
          <span class="sn-rvg-nav__txt--mob">100Ah Compact &middot; {{ compact_count }}</span>
        </a>
        <a class="sn-rvg-nav__item" href="#shelf-reserve" data-rvg-anchor="#shelf-reserve">
          <span class="sn-rvg-nav__txt--desk">High-Capacity ({{ reserve_count }})</span>
          <span class="sn-rvg-nav__txt--mob">High-Capacity &middot; {{ reserve_count }}</span>
        </a>
        <a class="sn-rvg-nav__item sn-rvg-nav__item--compare" href="#rv-compare" data-rvg-anchor="#rv-compare" data-rvg-open-compare>
          <span>Compare All {{ compact_count | plus: reserve_count }} &#8600;</span>
        </a>
      </div>
    </div>
  </nav>

  <div class="container sn-rvg-body">
    <div class="sn-rvg-shelves">
      {%- for shelf_num in (1..2) -%}
        {%- liquid
          if shelf_num == 1
            assign shelf_id = 'shelf-compact'
            assign shelf_key = 'compact'
            assign shelf_heading = section.settings.shelf1_heading
            assign shelf_count = compact_count
          else
            assign shelf_id = 'shelf-reserve'
            assign shelf_key = 'reserve'
            assign shelf_heading = section.settings.shelf2_heading
            assign shelf_count = reserve_count
          endif
        -%}

        <section class="sn-rvg-shelf" id="{{ shelf_id }}" data-rvg-shelf="{{ shelf_key }}">
          <header class="sn-rvg-shelf__head">
            <h2>{{ shelf_heading | escape }}</h2>
            <span class="sn-rvg-shelf__count">{{ shelf_count }} models</span>
          </header>

          <div class="sn-rvg-grid--2">
            {%- for block in section.blocks -%}
              {%- if block.type != 'battery' or block.settings.group != shelf_key -%}{% continue %}{%- endif -%}

              {%- assign family_product = all_products[block.settings.product_handle] -%}
              {%- if family_product != blank and family_product.url != blank -%}
                {%- assign family_url = family_product.url -%}
              {%- else -%}
                {%- assign family_url = '/products/' | append: block.settings.product_handle -%}
              {%- endif -%}

              {%- liquid
                assign default_variant = family_product.selected_or_first_available_variant
                assign active_price = default_variant.price | default: family_product.price
                assign active_compare = default_variant.compare_at_price | default: family_product.compare_at_price
                assign has_sale = false
                assign discount_pct = 0
                if active_compare > active_price and active_compare > 0
                  assign has_sale = true
                  assign diff_price = active_compare | minus: active_price
                  assign discount_pct = diff_price | times: 100.0 | divided_by: active_compare | round
                endif

                assign is_available = false
                if default_variant != blank and default_variant.available
                  assign is_available = true
                elsif family_product != blank and family_product.available and default_variant == blank
                  assign is_available = true
                endif

                assign img_url = block.settings.asset_name | asset_url
                assign model_upper = block.settings.model_code | upcase | strip
              -%}

              <article class="sn-rvg-card" data-rvg-card {{ block.shopify_attributes }}>
                <div class="sn-rvg-card__stage">
                  <span class="sn-rvg-save" data-rvg-sale-badge{% unless has_sale and discount_pct > 0 %} hidden{% endunless %}>
                    {{ discount_pct }}% OFF
                  </span>
                  <a class="sn-rvg-card__media-link" href="{{ family_url }}" data-rvg-product-link aria-label="{{ block.settings.title | default: family_product.title | escape }}">
                    <img
                      src="{{ img_url }}"
                      alt="{{ block.settings.image_alt | default: block.settings.title | escape }}"
                      width="1200"
                      height="1200"
                      loading="lazy"
                    >
                  </a>
                  <a class="sn-rvg-quick-eye" href="{{ family_url }}" data-rvg-product-link aria-label="View {{ block.settings.title | default: family_product.title | escape }} specs" title="View Product Specs">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                </div>

                <div class="sn-rvg-card__body">
                  <div class="sn-rvg-meta-strip">
                    <div class="sn-rvg-feat-icons">
                    {%- case model_upper -%}
                      {%- when 'G31' -%}
                        <span class="sn-rvg-feat-icon" title="Bluetooth 5.0" aria-label="Bluetooth 5.0">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5l11 11L12 23V1l5.5 5.5-11 11"/></svg>
                        </span>
                        <span class="sn-rvg-feat-icon" title="0°C Low-Temp Cut-Off" aria-label="0°C Low-Temp Cut-Off">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M4.93 7l14.14 10M19.07 7L4.93 17M9 4l3 2 3-2M9 20l3-2 3 2"/></svg>
                        </span>
                        <span class="sn-rvg-feat-icon" title="IP65 Rated" aria-label="IP65 Rated">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </span>
                      {%- when 'G24' -%}
                        <span class="sn-rvg-feat-icon" title="Bluetooth 5.0" aria-label="Bluetooth 5.0">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5l11 11L12 23V1l5.5 5.5-11 11"/></svg>
                        </span>
                        <span class="sn-rvg-feat-icon" title="0°C Low-Temp Cut-Off" aria-label="0°C Low-Temp Cut-Off">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M4.93 7l14.14 10M19.07 7L4.93 17M9 4l3 2 3-2M9 20l3-2 3 2"/></svg>
                        </span>
                        <span class="sn-rvg-feat-icon" title="Compact Group 24" aria-label="Compact Group 24">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="11" rx="2"/><path d="M7 7V5M17 7V5M8 12h8"/></svg>
                        </span>
                      {%- when '230AH' -%}
                        <span class="sn-rvg-feat-icon" title="200A / 2,560W Output" aria-label="200A / 2,560W Output">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                        </span>
                        <span class="sn-rvg-feat-icon" title="Bluetooth 5.0" aria-label="Bluetooth 5.0">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5l11 11L12 23V1l5.5 5.5-11 11"/></svg>
                        </span>
                        <span class="sn-rvg-feat-icon" title="4S4P Expandable" aria-label="4S4P Expandable">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
                        </span>
                      {%- when '314AH' -%}
                        <span class="sn-rvg-feat-icon" title="4,019Wh (+36.5%)" aria-label="4,019Wh (+36.5%)">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="6" width="15" height="12" rx="2"/><path d="M20 10v4M7 10h6v4H7z"/></svg>
                        </span>
                        <span class="sn-rvg-feat-icon" title="Bluetooth 5.0" aria-label="Bluetooth 5.0">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5l11 11L12 23V1l5.5 5.5-11 11"/></svg>
                        </span>
                        <span class="sn-rvg-feat-icon" title="4S4P Expandable" aria-label="4S4P Expandable">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
                        </span>
                      {%- else -%}
                        <span class="sn-rvg-feat-icon" title="Bluetooth 5.0" aria-label="Bluetooth 5.0">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5l11 11L12 23V1l5.5 5.5-11 11"/></svg>
                        </span>
                        <span class="sn-rvg-feat-icon" title="0°C Low-Temp Cut-Off" aria-label="0°C Low-Temp Cut-Off">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M4.93 7l14.14 10M19.07 7L4.93 17M9 4l3 2 3-2M9 20l3-2 3 2"/></svg>
                        </span>
                        <span class="sn-rvg-feat-icon" title="{{ block.settings.spec_energy | escape }}" aria-label="{{ block.settings.spec_energy | escape }}">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="6" width="15" height="12" rx="2"/><path d="M20 10v4M7 10h6v4H7z"/></svg>
                        </span>
                    {%- endcase -%}
                    </div>
                    {%- if block.settings.badge != blank -%}
                      <span class="sn-rvg-inline-tag">{{ block.settings.badge | escape }}</span>
                    {%- endif -%}
                  </div>

                  <h3 class="sn-rvg-card__title">
                    <a href="{{ family_url }}" data-rvg-product-link>{{ block.settings.title | default: family_product.title | escape }}</a>
                  </h3>

                  <ul class="sn-rvg-bullets" role="list">
                    <li>{{ block.settings.bullet_1 | escape }}</li>
                    <li>{{ block.settings.bullet_2 | escape }}</li>
                    <li>{{ block.settings.bullet_3 | escape }}</li>
                  </ul>

                  <div class="sn-rvg-card__footer">
                    <div class="sn-rvg-price-row">
                      <div class="sn-rvg-prices">
                        {%- if active_price != blank -%}
                          <span class="sn-rvg-price{% unless has_sale %} sn-rvg-price--regular{% endunless %}" data-rvg-price>{{ active_price | money }}</span>
                          <span class="sn-rvg-compare" data-rvg-compare{% unless has_sale %} hidden{% endunless %}>{{ active_compare | money }}</span>
                        {%- endif -%}
                      </div>

                      {%- if block.settings.enable_pack_selector and family_product != blank and family_product.variants.size > 1 -%}
                        <div class="sn-rvg-price-right">
                          <div class="sn-rvg-packs">
                            {%- for v in family_product.variants -%}
                              {%- liquid
                                assign v_title_lc = v.title | downcase
                                assign short_pack = v.title
                                if v_title_lc contains '4'
                                  assign short_pack = '4x'
                                elsif v_title_lc contains '2'
                                  assign short_pack = '2x'
                                elsif v_title_lc contains '1'
                                  assign short_pack = '1x'
                                endif
                                assign v_has_sale = false
                                assign v_pct = 0
                                if v.compare_at_price > v.price and v.compare_at_price > 0
                                  assign v_has_sale = true
                                  assign v_diff = v.compare_at_price | minus: v.price
                                  assign v_pct = v_diff | times: 100.0 | divided_by: v.compare_at_price | round
                                endif
                              -%}
                              <button
                                type="button"
                                class="sn-rvg-pack-btn"
                                aria-pressed="{% if v.id == default_variant.id %}true{% else %}false{% endif %}"
                                data-rvg-pack
                                data-variant-id="{{ v.id }}"
                                data-variant-price="{{ v.price | money | escape }}"
                                data-variant-compare="{{ v.compare_at_price | money | escape }}"
                                data-variant-has-sale="{{ v_has_sale }}"
                                data-variant-discount="{{ v_pct }}% OFF"
                                data-variant-available="{{ v.available }}"
                                data-variant-url="{{ v.url | default: family_url }}"
                                title="{{ v.title | escape }}"
                              >
                                {{ short_pack | escape }}
                              </button>
                            {%- endfor -%}
                          </div>
                        </div>
                      {%- endif -%}
                    </div>

                    <div class="sn-rvg-action-row">
                      {%- if family_product != blank and default_variant != blank -%}
                        {%- form 'product', family_product, is: 'product-form', class: 'sn-rvg-form' -%}
                          <input type="hidden" name="id" value="{{ default_variant.id }}" data-rvg-variant-input>
                          <button type="submit" class="sn-rvg-btn-primary" data-rvg-atc-btn{% unless is_available %} disabled{% endunless %}>
                            {%- if is_available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
                          </button>
                        {%- endform -%}
                      {%- else -%}
                        <a class="sn-rvg-btn-primary" href="{{ family_url }}">View Product</a>
                      {%- endif -%}
                      <a class="sn-rvg-btn-secondary" href="{{ family_url }}" data-rvg-product-link>Details</a>
                    </div>
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
        </section>
      {%- endfor -%}

      <!-- Collapsible Side-by-Side Spec Matrix -->
      <section class="sn-rvg-compare-box" id="rv-compare" data-rvg-shelf="compare">
        <button type="button" class="sn-rvg-compare-toggle" aria-expanded="false" aria-controls="rv-compare-panel" data-rvg-compare-toggle>
          <span>
            <span class="sn-rvg-compare-toggle__eyebrow">SPEC MATRIX</span>
            <span class="sn-rvg-compare-toggle__title">{{ section.settings.compare_heading | escape }}</span>
          </span>
          <span class="sn-rvg-compare-toggle__pill" data-rvg-compare-label>Show Table &#9662;</span>
        </button>

        <div id="rv-compare-panel" hidden data-rvg-compare-panel>
          <div class="sn-rvg-table-wrap">
            <table class="sn-rvg-table">
              <thead>
                <tr>
                  <th scope="col">Model</th>
                  <th scope="col">Price</th>
                  <th scope="col">Energy</th>
                  <th scope="col">Continuous Output</th>
                  <th scope="col">Dimensions</th>
                  <th scope="col">Weight</th>
                  <th scope="col">Protection / Bluetooth</th>
                  <th scope="col">Action</th>
                </tr>
              </thead>
              <tbody>
                {%- for block in section.blocks -%}
                  {%- if block.type != 'battery' -%}{% continue %}{%- endif -%}
                  {%- assign family_product = all_products[block.settings.product_handle] -%}
                  {%- if family_product != blank and family_product.url != blank -%}
                    {%- assign family_url = family_product.url -%}
                  {%- else -%}
                    {%- assign family_url = '/products/' | append: block.settings.product_handle -%}
                  {%- endif -%}
                  {%- assign row_variant = family_product.selected_or_first_available_variant -%}
                  <tr>
                    <td><strong>{{ block.settings.title | default: block.settings.model_code | escape }}</strong></td>
                    <td>
                      {%- if row_variant.price != blank -%}
                        {%- if row_variant.compare_at_price > row_variant.price -%}
                          <strong class="sn-rvg-table__sale">{{ row_variant.price | money }}</strong>
                          <span class="sn-rvg-compare">{{ row_variant.compare_at_price | money }}</span>
                        {%- else -%}
                          <strong>{{ row_variant.price | money }}</strong>
                        {%- endif -%}
                      {%- else -%}
                        —
                      {%- endif -%}
                    </td>
                    <td>{{ block.settings.spec_energy | escape }}</td>
                    <td>{{ block.settings.spec_output | escape }}</td>
                    <td>{{ block.settings.spec_dimensions | escape }}</td>
                    <td>{{ block.settings.spec_weight | escape }}</td>
                    <td>{{ block.settings.spec_protection | escape }}</td>
                    <td><a class="sn-rvg-table__link" href="{{ family_url }}">View</a></td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {%- if section.settings.table_note != blank -%}
            <p class="sn-rvg-footnote">{{ section.settings.table_note | escape }}</p>
          {%- endif -%}
        </div>
      </section>
    </div>
  </div>

  <!-- Cross-Device Bottom-Center Floating Quick-Return Pill + Upward Popover -->
  <div class="sn-rvg-float-wrap" data-rvg-float-wrap>
    <div class="sn-rvg-float-pop" id="rvg-float-pop" hidden data-rvg-float-pop role="menu" aria-label="Jump to RV battery group">
      <div class="sn-rvg-float-pop__head">
        <span>Jump to Group</span>
        <button type="button" class="sn-rvg-float-pop__close" data-rvg-float-close aria-label="Close category menu">&#10005;</button>
      </div>
      <a class="sn-rvg-float-pop__link" href="#shelf-compact" data-rvg-anchor="#shelf-compact" role="menuitem">
        <span><span class="sn-rvg-float-pop__num" style="color:#e95416">01</span>100Ah Compact</span>
        <span class="sn-rvg-float-pop__meta">{{ compact_count }}</span>
      </a>
      <a class="sn-rvg-float-pop__link" href="#shelf-reserve" data-rvg-anchor="#shelf-reserve" role="menuitem">
        <span><span class="sn-rvg-float-pop__num" style="color:#0d9488">02</span>High-Capacity Reserve</span>
        <span class="sn-rvg-float-pop__meta">{{ reserve_count }}</span>
      </a>
      <a class="sn-rvg-float-pop__link" href="#rv-compare" data-rvg-anchor="#rv-compare" data-rvg-open-compare role="menuitem">
        <span>Compare All {{ compact_count | plus: reserve_count }}</span>
        <span class="sn-rvg-float-pop__meta">&#8600;</span>
      </a>
      <a class="sn-rvg-float-pop__top" href="#rv-categories" data-rvg-float-top role="menuitem">&uarr; Back to Top</a>
    </div>

    <button
      type="button"
      class="sn-rvg-float-btn"
      aria-expanded="false"
      aria-controls="rvg-float-pop"
      data-rvg-float-toggle
    >
      <span class="sn-rvg-float-btn__arrow" aria-hidden="true">&uarr;</span>
      <span>Categories</span>
      <span class="sn-rvg-float-btn__pill" data-rvg-float-current>100Ah</span>
    </button>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-rv-guide]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    // Multi-pack selector (Group 31 1x / 2x / 4x)
    root.querySelectorAll('[data-rvg-card]').forEach((card) => {
      const packs = [...card.querySelectorAll('[data-rvg-pack]')];
      if (!packs.length) return;
      const priceEl = card.querySelector('[data-rvg-price]');
      const compareEl = card.querySelector('[data-rvg-compare]');
      const saleBadgeEl = card.querySelector('[data-rvg-sale-badge]');
      const variantInput = card.querySelector('[data-rvg-variant-input]');
      const atcBtn = card.querySelector('[data-rvg-atc-btn]');
      const links = [...card.querySelectorAll('[data-rvg-product-link]')];

      packs.forEach((btn) => {
        btn.addEventListener('click', () => {
          packs.forEach((item) => item.setAttribute('aria-pressed', item === btn ? 'true' : 'false'));
          const hasSale = btn.dataset.variantHasSale === 'true';
          const isAvailable = btn.dataset.variantAvailable === 'true';

          if (priceEl && btn.dataset.variantPrice) {
            priceEl.textContent = btn.dataset.variantPrice;
            priceEl.classList.toggle('sn-rvg-price--regular', !hasSale);
          }
          if (compareEl) {
            compareEl.textContent = btn.dataset.variantCompare || '';
            compareEl.hidden = !hasSale;
          }
          if (saleBadgeEl) {
            const pctText = btn.dataset.variantDiscount || '';
            saleBadgeEl.textContent = pctText;
            saleBadgeEl.hidden = !hasSale || !pctText;
          }
          if (variantInput && btn.dataset.variantId) {
            variantInput.value = btn.dataset.variantId;
          }
          if (atcBtn) {
            atcBtn.disabled = !isAvailable;
            atcBtn.textContent = isAvailable ? 'Add to Cart' : 'Sold Out';
          }
          if (btn.dataset.variantUrl) {
            links.forEach((link) => { link.href = btn.dataset.variantUrl; });
          }
        });
      });
    });

    // Collapsible comparison matrix
    const compareToggle = root.querySelector('[data-rvg-compare-toggle]');
    const comparePanel = root.querySelector('[data-rvg-compare-panel]');
    const compareLabel = root.querySelector('[data-rvg-compare-label]');

    const setCompareOpen = (open) => {
      if (!compareToggle || !comparePanel) return;
      compareToggle.setAttribute('aria-expanded', String(open));
      comparePanel.hidden = !open;
      if (compareLabel) compareLabel.innerHTML = open ? 'Hide Table &#9652;' : 'Show Table &#9662;';
    };

    if (compareToggle) {
      compareToggle.addEventListener('click', () => {
        const isOpen = compareToggle.getAttribute('aria-expanded') === 'true';
        setCompareOpen(!isOpen);
      });
    }

    // Bottom-center floating quick-return popover
    const nav = root.querySelector('#rv-categories');
    const floatWrap = root.querySelector('[data-rvg-float-wrap]');
    const floatPop = root.querySelector('[data-rvg-float-pop]');
    const floatToggle = root.querySelector('[data-rvg-float-toggle]');
    const floatClose = root.querySelector('[data-rvg-float-close]');
    const floatTop = root.querySelector('[data-rvg-float-top]');
    const floatCurrent = root.querySelector('[data-rvg-float-current]');
    const shelves = [...root.querySelectorAll('[data-rvg-shelf]')];
    const shelfLabels = {
      compact: '100Ah',
      reserve: '230/314Ah',
      compare: 'Compare'
    };

    const setFloatOpen = (open) => {
      if (!floatPop || !floatToggle) return;
      floatPop.hidden = !open;
      floatToggle.setAttribute('aria-expanded', String(open));
    };

    if (floatToggle) {
      floatToggle.addEventListener('click', (event) => {
        event.stopPropagation();
        setFloatOpen(floatPop ? floatPop.hidden : false);
      });
    }

    if (floatClose) {
      floatClose.addEventListener('click', () => setFloatOpen(false));
    }

    if (floatTop && nav) {
      floatTop.addEventListener('click', (event) => {
        event.preventDefault();
        setFloatOpen(false);
        nav.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    root.querySelectorAll('[data-rvg-anchor]').forEach((anchor) => {
      anchor.addEventListener('click', (event) => {
        const targetSelector = anchor.dataset.rvgAnchor;
        const target = targetSelector ? root.querySelector(targetSelector) : null;
        if (!target) return;
        event.preventDefault();
        setFloatOpen(false);
        if (anchor.hasAttribute('data-rvg-open-compare')) {
          setCompareOpen(true);
        }
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    document.addEventListener('click', (event) => {
      if (floatWrap && !floatWrap.contains(event.target)) {
        setFloatOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setFloatOpen(false);
      }
    });

    const syncFloatState = () => {
      if (!nav || !floatWrap) return;
      const navRect = nav.getBoundingClientRect();
      const passedNav = navRect.bottom < 12;
      floatWrap.classList.toggle('is-visible', passedNav);
      if (!passedNav) {
        setFloatOpen(false);
      }

      if (floatCurrent && shelves.length) {
        const midpoint = window.innerHeight * 0.42;
        let activeKey = 'compact';
        for (const shelf of shelves) {
          if (shelf.getBoundingClientRect().top <= midpoint) {
            activeKey = shelf.dataset.rvgShelf || activeKey;
          }
        }
        floatCurrent.textContent = shelfLabels[activeKey] || '100Ah';
      }
    };

    window.addEventListener('scroll', syncFloatState, { passive: true });
    window.addEventListener('resize', syncFloatState);
    syncFloatState();
  })();
</script>

