{%- liquid
  assign hero_id = 'sn-hero-' | append: section.id
-%}

<section id="{{ hero_id }}" class="sn-hero" data-sn-hero data-autoplay="{{ section.settings.hero_autoplay }}" data-delay="{{ section.settings.hero_delay }}">
  <div class="sn-hero__viewport">
    {%- for block in section.blocks -%}
      {%- liquid
        assign selected_product = block.settings.hero_product
        assign primary_link = block.settings.primary_link
        if selected_product != blank and primary_link == blank
          assign primary_link = selected_product.url
        endif
        assign image_loading = 'lazy'
        assign image_priority = 'auto'
        if forloop.first
          assign image_loading = 'eager'
          assign image_priority = 'high'
        endif
      -%}
      <article class="sn-hero__slide" data-sn-slide aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" {{ block.shopify_attributes }}>
        <div class="sn-hero__media">
          <picture>
            {%- if block.settings.mobile_image != blank -%}
              <source media="(max-width: 699px)" srcset="{{ block.settings.mobile_image | image_url: width: 1200 }}">
            {%- elsif block.settings.mobile_asset != blank -%}
              <source media="(max-width: 699px)" srcset="{{ block.settings.mobile_asset | asset_url }}">
            {%- endif -%}
            {%- if block.settings.desktop_image != blank -%}
              {{- block.settings.desktop_image | image_url: width: 2800 | image_tag: widths: '900,1400,1800,2400,2800', sizes: '100vw', loading: image_loading, fetchpriority: image_priority, alt: block.settings.image_alt -}}
            {%- else -%}
              <img src="{{ block.settings.desktop_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="2800" height="1000" loading="{{ image_loading }}" fetchpriority="{{ image_priority }}">
            {%- endif -%}
          </picture>
        </div>
        <div class="sn-hero__shade" style="opacity: {{ block.settings.overlay_strength | divided_by: 100.0 }}"></div>
        <div class="sn-hero__content">
          <div class="sn-hero__inner">
            {%- if block.settings.badge != blank -%}<span class="sn-hero__badge">{{ block.settings.badge }}</span>{%- endif -%}
            {%- if forloop.first -%}
              <h1>{{ block.settings.heading }}</h1>
            {%- else -%}
              <h2>{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.body != blank -%}<div class="sn-hero__text">{{ block.settings.body }}</div>{%- endif -%}
            <div class="sn-button-row">
              {%- if block.settings.primary_label != blank -%}
                <a class="sn-button" href="{{ primary_link | default: '#' }}">{{ block.settings.primary_label }}</a>
              {%- endif -%}
              {%- if block.settings.secondary_label != blank -%}
                <a class="sn-button sn-button--ghost" href="{{ block.settings.secondary_link | default: '#' }}">{{ block.settings.secondary_label }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="sn-hero__controls" aria-label="Hero controls">
      <button class="sn-hero__arrow" type="button" data-sn-prev aria-label="Previous slide">←</button>
      <div class="sn-hero__dots">
        {%- for block in section.blocks -%}
          <button class="sn-hero__dot" type="button" data-sn-dot aria-label="Go to slide {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
        {%- endfor -%}
      </div>
      <button class="sn-hero__arrow" type="button" data-sn-next aria-label="Next slide">→</button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "SuntNeew product hero",
  "max_blocks": 5,
  "settings": [
    {"type":"checkbox","id":"hero_autoplay","label":"Auto rotate","default":true},
    {"type":"range","id":"hero_delay","label":"Seconds per slide","min":4,"max":10,"step":1,"default":6}
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Product slide",
      "settings": [
        {"type":"image_picker","id":"desktop_image","label":"Desktop image override"},
        {"type":"select","id":"desktop_asset","label":"Bundled desktop fallback","default":"suntneew-hero-rv-desktop.jpg","options":[{"value":"suntneew-hero-rv-desktop.jpg","label":"RV battery"},{"value":"suntneew-hero-a20-desktop.jpg","label":"A20"},{"value":"suntneew-hero-a3-desktop.jpg","label":"A3"}]},
        {"type":"image_picker","id":"mobile_image","label":"Mobile image override"},
        {"type":"select","id":"mobile_asset","label":"Bundled mobile fallback","default":"suntneew-hero-rv-mobile.jpg","options":[{"value":"suntneew-hero-rv-mobile.jpg","label":"RV battery"},{"value":"suntneew-hero-a20-mobile.jpg","label":"A20"},{"value":"suntneew-hero-a3-mobile.jpg","label":"A3"}]},
        {"type":"text","id":"image_alt","label":"Image alt text","default":"SuntNeew power product in use"},
        {"type":"product","id":"hero_product","label":"Linked product (optional)"},
        {"type":"text","id":"badge","label":"Badge","default":"Engineered adventure"},
        {"type":"text","id":"heading","label":"Heading","default":"Power Your RV. Stay Off-Grid Longer."},
        {"type":"textarea","id":"body","label":"Body","default":"Purpose-built power for RV travel, off-grid living and the road ahead."},
        {"type":"text","id":"primary_label","label":"Primary button label","default":"Shop now"},
        {"type":"url","id":"primary_link","label":"Primary button link"},
        {"type":"text","id":"secondary_label","label":"Secondary button label","default":"Help me choose"},
        {"type":"url","id":"secondary_link","label":"Secondary button link"},
        {"type":"range","id":"overlay_strength","label":"Text overlay strength","min":20,"max":100,"step":5,"default":90}
      ]
    }
  ],
  "presets": [{"name":"SuntNeew product hero","blocks":[{"type":"slide"},{"type":"slide"},{"type":"slide"}]}]
}
{% endschema %}
