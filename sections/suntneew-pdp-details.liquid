<section class="sn-pdp sn-pdp-details sn-pdp__section" data-pdp-panel-host>
  <div class="sn-pdp__shell">
    <div id="{{ section.settings.anchor_id | handleize }}" class="sn-pdp-details__panel" role="tabpanel" data-pdp-panel="{{ section.settings.anchor_id | handleize }}">
      {%- if section.settings.eyebrow != blank -%}<p class="sn-pdp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sn-pdp__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<div class="sn-pdp__lede">{{ section.settings.lede }}</div>{%- endif -%}

      <div class="sn-pdp-spec-groups">
        {%- assign group_keys = 'primary,system,installation' | split: ',' -%}
        {%- for group_key in group_keys -%}
          {%- assign group_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'spec' and block.settings['group'] == group_key -%}
              {%- assign group_count = group_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if group_count > 0 -%}
            {%- case group_key -%}
              {%- when 'system' -%}{%- assign group_heading = section.settings.system_group_heading -%}
              {%- when 'installation' -%}{%- assign group_heading = section.settings.installation_group_heading -%}
              {%- else -%}{%- assign group_heading = section.settings.primary_group_heading -%}
            {%- endcase -%}

            <details class="sn-pdp-spec-group"{% if forloop.first %} open{% endif %}>
              <summary>
                <span>{{ group_heading }}</span>
                <span class="sn-pdp-spec-group__count">{{ 'suntneew_auto.sd1bf045bb524' | t }}</span>
              </summary>
              <dl class="sn-pdp-specs">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'spec' and block.settings['group'] == group_key -%}
                    <div class="sn-pdp-specs__row" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>
                      <dt>{{ block.settings.label }}</dt>
                      <dd>{{ block.settings.value }}</dd>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </dl>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- assign included_blocks = section.blocks | where: 'type', 'included' -%}
    {%- if included_blocks.size > 0 -%}
      <div id="in-the-box" class="sn-pdp-details__panel" role="tabpanel" data-pdp-panel="in-the-box">
        <p class="sn-pdp__eyebrow">{{ section.settings.included_eyebrow }}</p>
        <h2 class="sn-pdp__heading">{{ section.settings.included_heading }}</h2>
        <ul class="sn-pdp-list sn-pdp-list--cards">
          {%- for block in included_blocks -%}
            <li {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.item }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- render 'suntneew-pdp-downloads',
      section: section,
      product: product,
      template: template,
      qr_support_enabled: qr_support_enabled,
      qr_support_model: qr_support_model,
      qr_support_intro: qr_support_intro,
      qr_support_install_intro: qr_support_install_intro,
      qr_support_fact_one_value: qr_support_fact_one_value,
      qr_support_fact_one_label: qr_support_fact_one_label,
      qr_support_fact_two_value: qr_support_fact_two_value,
      qr_support_fact_two_label: qr_support_fact_two_label,
      qr_support_fact_three_value: qr_support_fact_three_value,
      qr_support_fact_three_label: qr_support_fact_three_label,
      qr_support_fact_four_value: qr_support_fact_four_value,
      qr_support_fact_four_label: qr_support_fact_four_label
    -%}
  </div>
</section>

