{{ 'suntneew-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suntneew-pdp.js' | asset_url }}" defer></script>

<section class="sn-pdp sn-pdp-details sn-pdp__section" data-pdp-panel-host>
  <div class="sn-pdp__shell">
    <div id="{{ section.settings.anchor_id | handleize }}" class="sn-pdp-details__panel" role="tabpanel" data-pdp-panel="{{ section.settings.anchor_id | handleize }}">
      {%- if section.settings.eyebrow != blank -%}<p class="sn-pdp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sn-pdp__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<div class="sn-pdp__lede">{{ section.settings.lede }}</div>{%- endif -%}

      <div class="sn-pdp-spec-groups">
        {%- assign group_keys = 'primary,system,installation' | split: ',' -%}
        {%- for group_key in group_keys -%}
          {%- assign group_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'spec' and block.settings['group'] == group_key -%}
              {%- assign group_count = group_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if group_count > 0 -%}
            {%- case group_key -%}
              {%- when 'system' -%}{%- assign group_heading = section.settings.system_group_heading -%}
              {%- when 'installation' -%}{%- assign group_heading = section.settings.installation_group_heading -%}
              {%- else -%}{%- assign group_heading = section.settings.primary_group_heading -%}
            {%- endcase -%}

            <details class="sn-pdp-spec-group"{% if forloop.first %} open{% endif %}>
              <summary>
                <span>{{ group_heading }}</span>
                <span class="sn-pdp-spec-group__count">View details</span>
              </summary>
              <dl class="sn-pdp-specs">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'spec' and block.settings['group'] == group_key -%}
                    <div class="sn-pdp-specs__row" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>
                      <dt>{{ block.settings.label }}</dt>
                      <dd>{{ block.settings.value }}</dd>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </dl>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- assign included_blocks = section.blocks | where: 'type', 'included' -%}
    {%- if included_blocks.size > 0 -%}
      <div id="in-the-box" class="sn-pdp-details__panel" role="tabpanel" data-pdp-panel="in-the-box">
        <p class="sn-pdp__eyebrow">{{ section.settings.included_eyebrow }}</p>
        <h2 class="sn-pdp__heading">{{ section.settings.included_heading }}</h2>
        <ul class="sn-pdp-list sn-pdp-list--cards">
          {%- for block in included_blocks -%}
            <li {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.item }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- assign download_blocks = section.blocks | where: 'type', 'download' -%}
    {%- assign manual_count = 0 -%}
    {%- assign compliance_count = 0 -%}
    {%- for block in download_blocks -%}
      {%- assign document_group = block.settings.document_group | default: 'manuals' -%}
      {%- if block.settings.document_group == blank -%}
        {%- assign label_lower = block.settings.label | downcase -%}
        {%- if label_lower contains 'fcc' or label_lower contains 'emc' or label_lower contains 'rohs' or label_lower contains 'ip65' or label_lower contains 'ul ' or label_lower contains 'un38' or label_lower contains 'sds' or label_lower contains 'msds' or label_lower contains 'tdg' or label_lower contains 'dgm' or label_lower contains 'certificate' or label_lower contains 'report' or label_lower contains 'grant' -%}
          {%- assign document_group = 'compliance' -%}
        {%- endif -%}
      {%- endif -%}
      {%- if document_group == 'compliance' -%}
        {%- assign compliance_count = compliance_count | plus: 1 -%}
      {%- else -%}
        {%- assign manual_count = manual_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if download_blocks.size > 0 -%}
      <div id="manuals" class="sn-pdp-details__panel" role="tabpanel" data-pdp-panel="manuals">
        <p class="sn-pdp__eyebrow">{{ section.settings.download_eyebrow }}</p>
        <h2 class="sn-pdp__heading">{{ section.settings.download_heading }}</h2>

        {%- if manual_count > 0 -%}
          <section class="sn-pdp-doc-group" aria-labelledby="{{ section.id }}-manuals-heading">
            <h3 id="{{ section.id }}-manuals-heading" class="sn-pdp-doc-group__heading">{{ section.settings.manuals_group_heading }}</h3>
            <div class="sn-pdp-downloads">
              {%- for block in download_blocks -%}
                {%- assign document_group = block.settings.document_group | default: 'manuals' -%}
                {%- if block.settings.document_group == blank -%}
                  {%- assign label_lower = block.settings.label | downcase -%}
                  {%- if label_lower contains 'fcc' or label_lower contains 'emc' or label_lower contains 'rohs' or label_lower contains 'ip65' or label_lower contains 'ul ' or label_lower contains 'un38' or label_lower contains 'sds' or label_lower contains 'msds' or label_lower contains 'tdg' or label_lower contains 'dgm' or label_lower contains 'certificate' or label_lower contains 'report' or label_lower contains 'grant' -%}
                    {%- assign document_group = 'compliance' -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if document_group != 'compliance' -%}
                  {%- if block.settings.link != blank -%}
                    <a class="sn-pdp-download" href="{{ block.settings.link }}" target="_blank" rel="noopener" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
                  {%- elsif block.settings.asset_name != blank -%}
                    <a class="sn-pdp-download" href="{{ block.settings.asset_name | asset_url }}" target="_blank" rel="noopener" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
                  {%- else -%}
                    <span class="sn-pdp-download" aria-disabled="true" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}

        {%- if compliance_count > 0 -%}
          {%- liquid
            assign compliance_library_anchor = ''
            case template.suffix
              when 'a20'
                assign compliance_library_anchor = 'jump-a20'
              when 'a3'
                assign compliance_library_anchor = 'jump-a3'
              when 'kb700'
                assign compliance_library_anchor = 'jump-kb700'
              when 'u23'
                assign compliance_library_anchor = 'jump-u23'
              when 'u32'
                assign compliance_library_anchor = 'jump-u32'
              when 'rv-g24', 'rv-g31'
                assign compliance_library_anchor = 'rv-g24-g31'
              when 'rv-230ah', 'rv-314ah'
                assign compliance_library_anchor = 'rv-230-314'
            endcase

            assign compliance_library_url = '/pages/technology'
            if compliance_library_anchor != blank
              assign compliance_library_url = compliance_library_url | append: '#' | append: compliance_library_anchor
            endif
          -%}
          <section class="sn-pdp-doc-group" aria-labelledby="{{ section.id }}-compliance-heading">
            <h3 id="{{ section.id }}-compliance-heading" class="sn-pdp-doc-group__heading">{{ section.settings.compliance_group_heading }}</h3>
            <div class="sn-pdp-compliance-overview">
              <div class="sn-pdp-compliance-badges" aria-label="{{ section.settings.compliance_group_heading | escape }}">
                {%- assign compliance_standards_seen = '|' -%}
              {%- for block in download_blocks -%}
                {%- assign document_group = block.settings.document_group | default: 'manuals' -%}
                {%- if block.settings.document_group == blank -%}
                  {%- assign label_lower = block.settings.label | downcase -%}
                  {%- if label_lower contains 'fcc' or label_lower contains 'emc' or label_lower contains 'rohs' or label_lower contains 'ip65' or label_lower contains 'ul ' or label_lower contains 'un38' or label_lower contains 'sds' or label_lower contains 'msds' or label_lower contains 'tdg' or label_lower contains 'dgm' or label_lower contains 'certificate' or label_lower contains 'report' or label_lower contains 'grant' -%}
                    {%- assign document_group = 'compliance' -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if document_group == 'compliance' -%}
                  {%- assign compliance_standard = block.settings.standard | default: block.settings.label -%}
                  {%- assign compliance_standard_lower = compliance_standard | downcase -%}
                  {%- assign compliance_standard_token = '|' | append: compliance_standard_lower | append: '|' -%}
                  {%- unless compliance_standards_seen contains compliance_standard_token -%}
                    <a class="sn-pdp-compliance-badge{% if compliance_standard_lower contains 'ul 2743' or compliance_standard_lower contains 'ul listed' or compliance_standard_lower contains 'ul certified' %} sn-pdp-compliance-badge--ul{% endif %}" href="{{ compliance_library_url }}" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ compliance_standard }}</a>
                    {%- assign compliance_standards_seen = compliance_standards_seen | append: compliance_standard_lower | append: '|' -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
              </div>
              <a class="sn-pdp-compliance-library-link" href="{{ compliance_library_url }}">
                <span>{{ section.settings.compliance_library_label }}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </section>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name":"SuntNeew PDP details",
  "settings":[
    {"type":"text","id":"anchor_id","label":"Anchor ID","default":"specifications"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Product details"},
    {"type":"text","id":"heading","label":"Heading","default":"Specifications at a glance"},
    {"type":"richtext","id":"lede","label":"Introduction","default":"<p>Choose a category to inspect the technical details.</p>"},
    {"type":"text","id":"primary_group_heading","label":"Primary specs group","default":"Energy & performance"},
    {"type":"text","id":"system_group_heading","label":"System specs group","default":"Electrical & system"},
    {"type":"text","id":"installation_group_heading","label":"Installation specs group","default":"Installation & environment"},
    {"type":"text","id":"included_eyebrow","label":"Included eyebrow","default":"What is included"},
    {"type":"text","id":"included_heading","label":"Included heading","default":"In the box"},
    {"type":"text","id":"download_eyebrow","label":"Downloads eyebrow","default":"Reference material"},
    {"type":"text","id":"download_heading","label":"Downloads heading","default":"Manuals & Documents"},
    {"type":"text","id":"manuals_group_heading","label":"Manuals group heading","default":"User Manuals"},
    {"type":"text","id":"compliance_group_heading","label":"Compliance group heading","default":"Safety & Compliance"},
    {"type":"text","id":"compliance_library_label","label":"Compliance library link label","default":"View public documents"},
    {"type":"textarea","id":"compliance_note","label":"Compliance note","default":"Only model-matched public copies should be uploaded here. Check the model, report number and scope before relying on a document."},
    {"type":"text","id":"compliance_scope_label","label":"Compliance scope label","default":"View scope and document status"},
    {"type":"text","id":"compliance_link_label","label":"Compliance link label","default":"View public copy"},
    {"type":"text","id":"compliance_pending_label","label":"Pending compliance label","default":"Public copy pending"},
    {"type":"text","id":"compliance_request_label","label":"Compliance request label","default":"Request a model-matched copy"},
    {"type":"url","id":"compliance_request_url","label":"Compliance request URL"}
  ],
  "blocks":[
    {"type":"spec","name":"Specification","settings":[
      {"type":"text","id":"label","label":"Label","default":"Capacity"},
      {"type":"text","id":"value","label":"Value","default":"8,000mAh"},
      {"type":"select","id":"group","label":"Specification group","default":"primary","options":[{"value":"primary","label":"Energy & performance"},{"value":"system","label":"Electrical & system"},{"value":"installation","label":"Installation & environment"}]},
      {"type":"text","id":"variant_match","label":"Only show for variant","info":"Optional capacity, color, title or SKU match."}
    ]},
    {"type":"included","name":"Included item","settings":[
      {"type":"text","id":"item","label":"Item","default":"Product unit"},
      {"type":"text","id":"variant_match","label":"Only show for variant"}
    ]},
    {"type":"download","name":"Download","settings":[
      {"type":"text","id":"label","label":"Label","default":"User manual — pending upload"},
      {"type":"url","id":"link","label":"File or page link"},
      {"type":"text","id":"asset_name","label":"Bundled asset filename","info":"Optional theme asset, for example energy-star-wl5a-spec-v1.jpg."},
      {"type":"text","id":"variant_match","label":"Only show for variant"},
      {"type":"select","id":"document_group","label":"Document group","default":"manuals","options":[{"value":"manuals","label":"User manuals"},{"value":"compliance","label":"Safety & compliance"}]},
      {"type":"text","id":"standard","label":"Standard or badge text","info":"Optional. Used on safety and compliance cards."},
      {"type":"textarea","id":"description","label":"Scope or description","info":"Optional. Explain the model, report scope or document purpose."},
      {"type":"checkbox","id":"public_copy_ready","label":"Public copy is redacted and approved","default":false}
    ]}
  ],
  "max_blocks": 40,
  "presets":[{"name":"SuntNeew PDP details","blocks":[{"type":"spec"},{"type":"spec"},{"type":"included"},{"type":"download"}]}]
}
{% endschema %}
