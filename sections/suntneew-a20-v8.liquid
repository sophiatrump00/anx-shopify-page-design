{% comment %}A20 v8 approved release. Live Shopify variants, native cart form and review app; assets selected by the merchant.{% endcomment %}
{{ 'suntneew-a20-v8.css' | asset_url | stylesheet_tag }}
{{ 'suntneew-pdp-media-hub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suntneew-pdp-media-hub.js' | asset_url }}" defer></script>
<script src="{{ 'suntneew-a20-v8.js' | asset_url }}" defer></script>
<script src="{{ 'suntneew-purchase-panel.js' | asset_url }}" defer></script>
<script src="{{ 'suntneew-progressive-faq.js' | asset_url }}" defer></script>
{% liquid
 assign selected_variant = product.selected_or_first_available_variant
 if product.selected_variant == blank
  for candidate in product.variants
   if candidate.option1 == '8000mAh' and candidate.option2 == 'Red' and candidate.option3 == '1 unit' and candidate.available
    assign selected_variant = candidate
    break
   endif
  endfor
 endif
 if selected_variant.option3 == 'Any quantity'
  for candidate in product.variants
   if candidate.option1 == selected_variant.option1 and candidate.option2 == selected_variant.option2 and candidate.option3 != 'Any quantity'
    assign selected_variant = candidate
    break
   endif
  endfor
 endif
 assign a20_ssr_g01 = 'sn-a20-v8-orange-gallery-01.webp'
 assign a20_ssr_g01_thumb = 'sn-a20-v8-orange-gallery-01-thumb.webp'
 if selected_variant.option2 == 'Red'
  if selected_variant.option3 == '2 units'
   assign a20_ssr_g01 = 'sn-a20-v8-red-pack-2.webp'
   assign a20_ssr_g01_thumb = 'sn-a20-v8-red-pack-2-thumb.webp'
  elsif selected_variant.option3 == '4 units'
   assign a20_ssr_g01 = 'sn-a20-v8-red-pack-4.webp'
   assign a20_ssr_g01_thumb = 'sn-a20-v8-red-pack-4-thumb.webp'
  else
   assign a20_ssr_g01 = 'sn-a20-v8-red-gallery-01.webp'
   assign a20_ssr_g01_thumb = 'sn-a20-v8-red-gallery-01-thumb.webp'
  endif
 else
  if selected_variant.option3 == '2 units'
   assign a20_ssr_g01 = 'sn-a20-v8-orange-pack-2.webp'
   assign a20_ssr_g01_thumb = 'sn-a20-v8-orange-pack-2-thumb.webp'
  elsif selected_variant.option3 == '4 units'
   assign a20_ssr_g01 = 'sn-a20-v8-orange-pack-4.webp'
   assign a20_ssr_g01_thumb = 'sn-a20-v8-orange-pack-4-thumb.webp'
  endif
 endif
 assign product_form_id = 'a20-product-form-' | append: section.id
%}
<div class="sn-a20-pdp" data-a20-pdp data-form="{{ product_form_id }}"><script type="application/json" data-a20-product>{"currency":{{ cart.currency.iso_code | default: shop.currency | json }},"selectedId":{{ selected_variant.id | append: '' | json }},"options":[{% for option in product.options_with_values %}{"name":{{ option.name | json }},"values":{{ option.values | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}],"variants":[{% for variant in product.variants %}{% liquid
 assign variant_min = variant.quantity_rule.min | default: 1
 assign variant_max = variant.quantity_rule.max | default: 999
 if variant.inventory_management != blank and variant.inventory_policy == 'deny'
  assign variant_max = variant_max | at_most: variant.inventory_quantity
 endif
%}{"id":{{ variant.id | append: '' | json }},"sku":{{ variant.sku | json }},"capacity":{{ variant.option1 | json }},"colour":{{ variant.option2 | downcase | json }},"pack":{{ variant.option3 | json }},"available":{{ variant.available | json }},"priceCents":{{ variant.price | json }},"compareAtCents":{{ variant.compare_at_price | default: 0 | json }},"min":{{ variant_min | json }},"max":{{ variant_max | json }},"step":{{ variant.quantity_rule.increment | default: 1 | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}</script>
