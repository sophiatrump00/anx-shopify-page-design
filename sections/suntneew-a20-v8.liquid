      <p class="eyebrow" id="model-eyebrow">A20 / 8,000mAh</p><h1 id="product-title">A20 Portable Jump Starter</h1>
      <p class="product-spec-line" id="product-specs">12V · 1,500A peak · 8,000mAh</p>
      {%- assign rating = product.metafields.reviews.rating.value -%}{%- assign review_count = product.metafields.reviews.rating_count.value | default: 0 -%}{%- if rating != blank and review_count > 0 -%}<a class="rating-link" href="#reviews"><span class="stars" aria-label="{{ rating.rating }} out of {{ rating.scale_max }} stars">★★★★★</span><strong>{{ rating.rating | round: 1 }}</strong><span>{{ 'product.rating_count' | t: count: review_count }}</span></a>{%- endif -%}
      <p class="product-description">Choose your capacity. Keep starting power, USB charging and a light close at hand.</p>
