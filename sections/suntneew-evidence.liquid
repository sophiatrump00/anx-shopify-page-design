<section class="sn-evidence" id="{{ section.settings.anchor_id | escape }}" aria-labelledby="sn-evidence-heading-{{ section.id }}">
  <div class="sn-evidence__shell">
    <header class="sn-evidence__heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="sn-light-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 id="sn-evidence-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.body != blank -%}
        <p>{{ section.settings.body }}</p>
      {%- endif -%}
    </header>

    <div class="sn-evidence__grid">
      {%- for block in section.blocks -%}
        <article class="sn-evidence__item" {{ block.shopify_attributes }}>
          <span class="sn-evidence__number">0{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.link_label != blank -%}
            <a class="sn-light-link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SuntNeew evidence",
  "max_blocks": 4,
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anchor ID","default":"before-you-buy"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"BEFORE YOU COMMIT"},
    {"type":"text","id":"heading","label":"Heading","default":"What you can check before you buy."},
    {"type":"textarea","id":"body","label":"Body","default":"The homepage defines the job. Model information and the support path make the purchase decision specific."}
  ],
  "blocks": [
    {
      "type": "evidence",
      "name": "Evidence item",
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"Specs tied to a model"},
        {"type":"textarea","id":"text","label":"Text","default":"Review dimensions, capacity and electrical details on the model or collection page."},
        {"type":"text","id":"link_label","label":"Link label","default":"Explore products"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [{"name":"SuntNeew decision evidence","blocks":[{"type":"evidence"},{"type":"evidence"},{"type":"evidence"},{"type":"evidence"}]}]
}
{% endschema %}
