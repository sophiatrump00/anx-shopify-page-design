{%- if section.blocks.size > 0 -%}
  {%- render 'section-spacing-collapsing' -%}

  <style>
    #shopify-section-{{ section.id }} {
      {% if section.settings.remove_vertical_spacing %}--section-spacing-block: 0px;{% endif %}
      {% if section.settings.remove_horizontal_spacing %}--section-spacing-inline: 0px;{% endif %}
    }
  </style>

  <div {% render 'section-properties' %}>
    {%- assign pdp_panel = section.settings.pdp_tab_panel | handleize -%}
    {%- if pdp_panel != blank -%}
      <section id="{{ pdp_panel }}" class="sn-pdp sn-pdp-reviews sn-pdp__section" role="tabpanel" data-pdp-panel="{{ pdp_panel }}">
        <div class="sn-pdp__shell">
          {%- if section.settings.pdp_eyebrow != blank or section.settings.pdp_heading != blank -%}
            <div class="sn-pdp-reviews__head">
              {%- if section.settings.pdp_eyebrow != blank -%}<p class="sn-pdp__eyebrow">{{ section.settings.pdp_eyebrow | escape }}</p>{%- endif -%}
              {%- if section.settings.pdp_heading != blank -%}<h2 class="sn-pdp__heading">{{ section.settings.pdp_heading | escape }}</h2>{%- endif -%}
            </div>
          {%- endif -%}
          <div class="sn-pdp-reviews__widget">
            {%- for block in section.blocks -%}
              {%- render block -%}
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- render block -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Apps",
  "class": "shopify-section--apps",
  "tag": "section",
  "disabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "remove_vertical_spacing",
      "label": "Remove vertical spacing",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_horizontal_spacing",
      "label": "Remove horizontal spacing",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors",
      "info": "Gradient replaces solid colors when set."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "pdp_tab_panel",
      "label": "PDP tab panel ID (optional)"
    },
    {
      "type": "text",
      "id": "pdp_eyebrow",
      "label": "PDP panel eyebrow (optional)"
    },
    {
      "type": "text",
      "id": "pdp_heading",
      "label": "PDP panel heading (optional)"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Apps"
    }
  ]
}
{% endschema %}
