<section class="sn-series-intro">
  <div class="sn-series-shell sn-series-intro__grid">
    <p class="sn-kicker">{{ section.settings.eyebrow }}</p>
    <div>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p>{{ section.settings.body }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SuntNeew series intro",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"PRODUCT SERIES"},
    {"type":"text","id":"heading","label":"Heading","default":"Find the power system that fits."},
    {"type":"textarea","id":"body","label":"Body","default":"Browse by the way you use power, then open the relevant collection to compare the available models."}
  ],
  "presets": [{"name":"SuntNeew series intro"}]
}
{% endschema %}
