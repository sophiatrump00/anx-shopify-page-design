<section class="sn-section {% if section.settings.dark_background %}sn-section--dark{% endif %}" id="{{ section.settings.anchor_id | escape }}">
  <div class="sn-shell">
    <header class="sn-heading">
      <div><p class="sn-heading__eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
      <div><p class="sn-heading__text">{{ section.settings.body }}</p>{% if section.settings.link_label != blank %}<p><a class="sn-link" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a></p>{% endif %}</div>
    </header>
    <div class="sn-paths" style="--sn-columns: {{ section.settings.columns }}; --sn-card-height: {{ section.settings.card_height }}px">
      {%- for block in section.blocks -%}
        <article class="sn-path" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a class="sn-path__card-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | escape }}">
          {%- else -%}
            <div class="sn-path__card-link">
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            {{- block.settings.image | image_url: width: 1400 | image_tag: widths: '500,800,1100,1400', sizes: '(max-width: 699px) 100vw, 33vw', loading: 'lazy', alt: block.settings.image_alt -}}
          {%- else -%}
            <picture>
              {%- if block.settings.mobile_fallback_asset != blank -%}
                <source media="(max-width: 699px)" srcset="{{ block.settings.mobile_fallback_asset | asset_url }}">
              {%- endif -%}
              <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="1200" height="1400" loading="lazy">
            </picture>
          {%- endif -%}
          <span class="sn-path__shade"></span>
          <div class="sn-path__content">
            <p class="sn-kicker">{{ block.settings.eyebrow }}</p>
            {%- if block.settings.product_label != blank -%}<p class="sn-path__product-label">{{ block.settings.product_label }}</p>{%- endif -%}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            <span class="sn-link">{{ block.settings.link_label }}</span>
          </div>
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"SuntNeew image paths",
  "max_blocks":6,
  "settings":[
    {"type":"text","id":"anchor_id","label":"Anchor ID","default":"shop-by-use"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by use"},
    {"type":"text","id":"heading","label":"Heading","default":"Power for the way you move."},
    {"type":"textarea","id":"body","label":"Body","default":"Start with the job you need done, then move to the right product and configuration."},
    {"type":"text","id":"link_label","label":"Header link label"},{"type":"url","id":"link_url","label":"Header link"},
    {"type":"range","id":"columns","label":"Desktop columns","min":2,"max":4,"step":1,"default":3},
    {"type":"range","id":"card_height","label":"Card height","min":320,"max":620,"step":20,"default":460},
    {"type":"checkbox","id":"dark_background","label":"Dark background","default":false}
  ],
  "blocks":[{"type":"path","name":"Image path","settings":[
    {"type":"image_picker","id":"image","label":"Image override"},
    {"type":"select","id":"fallback_asset","label":"Bundled fallback","default":"suntneew-use-rv.jpg","options":[{"value":"suntneew-use-home-energy.jpg","label":"Home energy"},{"value":"suntneew-use-home.jpg","label":"Home"},{"value":"suntneew-use-rv.jpg","label":"RV"},{"value":"suntneew-rv-230ah-feature-lifestyle-desktop.jpg","label":"RV Group 230Ah lifestyle"},{"value":"suntneew-use-marine.jpg","label":"Marine"},{"value":"suntneew-use-camping.jpg","label":"Camping"},{"value":"suntneew-use-jump.jpg","label":"Jump start"},{"value":"suntneew-use-light.jpg","label":"Emergency light"},{"value":"suntneew-hero-rv-desktop.jpg","label":"RV hero"},{"value":"suntneew-hero-a20-desktop.jpg","label":"A20 hero"},{"value":"energy-star-home-hero-v1.png","label":"ENERGY STAR home hero"}]},
    {"type":"text","id":"mobile_fallback_asset","label":"Bundled mobile fallback","info":"Optional mobile asset used below 700px when no image override is selected."},
    {"type":"text","id":"image_alt","label":"Image alt text","default":"SuntNeew power solution in use"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"RV power"},{"type":"text","id":"product_label","label":"Product line label","default":"Product line"},{"type":"text","id":"title","label":"Title","default":"Stay off-grid longer"},{"type":"textarea","id":"text","label":"Text","default":"Match capacity, fit and output to the way your RV is used."},{"type":"text","id":"link_label","label":"Link label","default":"Explore solution"},{"type":"url","id":"link","label":"Link"}
  ]}],
  "presets":[{"name":"SuntNeew image paths","blocks":[{"type":"path"},{"type":"path"},{"type":"path"}]}]
}
{% endschema %}
