<section class="sn-series-hub" id="product-series">
  <div class="sn-series-shell">
    <header class="sn-series-hub__heading">
      <p class="sn-kicker">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.body }}</p>
    </header>

    <div class="sn-series-hub__grid" role="list">
      {%- for block in section.blocks -%}
        <article class="sn-series-hub__card" role="listitem" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: routes.collections_url }}" class="sn-series-hub__card-link" aria-label="{{ block.settings.title | escape }}">
            <span class="sn-series-hub__media">
              {%- if block.settings.image != blank -%}
                {{- block.settings.image | image_url: width: 1800 | image_tag: widths: '600,900,1200,1600,1800', sizes: '(max-width: 699px) 100vw, (max-width: 1099px) 50vw, 33vw', loading: 'lazy', alt: block.settings.image_alt -}}
              {%- else -%}
                <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="1600" height="1200" loading="lazy">
              {%- endif -%}
              <span class="sn-series-hub__shade" aria-hidden="true"></span>
            </span>
            <span class="sn-series-hub__card-content">
              <span class="sn-series-hub__meta">
                <span class="sn-series-hub__index" aria-hidden="true">0{{ forloop.index }}</span>
                <span class="sn-kicker">{{ block.settings.eyebrow }}</span>
                {%- if block.settings.status != blank -%}<span class="sn-series-status">{{ block.settings.status }}</span>{%- endif -%}
              </span>
              <strong>{{ block.settings.title }}</strong>
              <span class="sn-series-hub__copy">{{ block.settings.text }}</span>
              <span class="sn-series-arrow">{{ block.settings.link_label }}</span>
            </span>
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SuntNeew series hub",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"PRODUCT SERIES"},
    {"type":"text","id":"heading","label":"Heading","default":"Choose the power system first."},
    {"type":"textarea","id":"body","label":"Body","default":"Start with the way you use power. Each series has its own products, guidance and product detail pages."}
  ],
  "blocks": [
    {
      "type": "series",
      "name": "Product series",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image override"},
        {"type":"select","id":"fallback_asset","label":"Bundled fallback","default":"suntneew-hero-rv-desktop.jpg","options":[{"value":"suntneew-hero-rv-desktop.jpg","label":"RV hero"},{"value":"suntneew-hero-a20-desktop.jpg","label":"Jump starter hero"},{"value":"suntneew-home-hero-v2.webp","label":"Home energy hero"}]},
        {"type":"text","id":"image_alt","label":"Image alt text","default":"SuntNeew product series"},
        {"type":"text","id":"eyebrow","label":"Eyebrow","default":"PRODUCT SERIES"},
        {"type":"text","id":"status","label":"Status label"},
        {"type":"text","id":"title","label":"Title","default":"Product series"},
        {"type":"textarea","id":"text","label":"Text","default":"Explore this SuntNeew product series."},
        {"type":"text","id":"link_label","label":"Link label","default":"Explore series"},
        {"type":"url","id":"link","label":"Series link"}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{"name":"SuntNeew series hub","blocks":[{"type":"series"},{"type":"series"},{"type":"series"}]}]
}
{% endschema %}
