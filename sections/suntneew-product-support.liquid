{{ 'suntneew-support.css' | asset_url | stylesheet_tag }}

{%- assign support_url = pages['support'].url | default: '/pages/support' -%}
{%- assign resources_url = pages['manuals-certifications'].url | default: '/pages/manuals-certifications' -%}

<section class="sn-support sn-product-support" aria-labelledby="sn-product-support-heading">
  <div class="sn-support__shell sn-product-support__shell">
    <nav class="sn-product-support__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ support_url }}">{{ section.settings.support_label }}</a>
      <span aria-hidden="true">/</span>
      <a href="{{ resources_url }}">{{ section.settings.resources_label }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ section.settings.model }}</span>
    </nav>

    <header class="sn-product-support__hero">
      <div>
        <p class="sn-support__eyebrow">{{ section.settings.eyebrow }}</p>
        <p class="sn-support__model">{{ section.settings.model }}</p>
        <h1 id="sn-product-support-heading">{{ section.settings.heading }}</h1>
        <p>{{ section.settings.intro }}</p>
      </div>
      {%- if section.settings.product_url != blank -%}
        <a class="sn-support__text-link" href="{{ section.settings.product_url }}">{{ section.settings.product_label }} <span aria-hidden="true">&rarr;</span></a>
      {%- endif -%}
    </header>

    <nav class="sn-product-support__resource-grid" aria-label="{{ section.settings.resource_nav_label | escape }}">
      <a class="sn-product-support__resource-card sn-product-support__resource-card--primary" href="#manual">
        <span>{{ section.settings.online_card_eyebrow }}</span>
        <strong>{{ section.settings.online_card_label }}</strong>
        <small>{{ section.settings.online_card_description }}</small>
        <b>{{ section.settings.online_card_action }} <span aria-hidden="true">&darr;</span></b>
      </a>

      {%- if section.settings.manual_asset_name != blank -%}
        <a id="download" class="sn-product-support__resource-card" href="{{ section.settings.manual_asset_name | asset_url }}" target="_blank" rel="noopener">
          <span>{{ section.settings.pdf_card_eyebrow }}</span>
          <strong>{{ section.settings.pdf_label }}</strong>
          <small>{{ section.settings.pdf_card_description }}</small>
          <b>{{ section.settings.pdf_card_action }} <span aria-hidden="true">&darr;</span></b>
        </a>
      {%- endif -%}

      <a class="sn-product-support__resource-card sn-product-support__resource-card--compliance" href="#certifications">
        <span>{{ section.settings.certifications_card_eyebrow }}</span>
        <strong>{{ section.settings.certifications_label }}</strong>
        <small>{{ section.settings.certifications_card_description }}</small>
        <b>{{ section.settings.certifications_card_action }} <span aria-hidden="true">&darr;</span></b>
      </a>
    </nav>

    <dl class="sn-support__facts" aria-label="{{ section.settings.model | escape }} key specifications">
      {%- for block in section.blocks -%}
        {%- if block.type == 'quick_fact' -%}
          <div {{ block.shopify_attributes }}>
            <dt>{{ block.settings.label }}</dt>
            <dd>{{ block.settings.value }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>

    <article id="manual" class="sn-support__manual" aria-labelledby="sn-product-support-manual-heading">
      <header class="sn-support__manual-header">
        <div>
          <p class="sn-support__eyebrow">{{ section.settings.manual_eyebrow }}</p>
          <h2 id="sn-product-support-manual-heading">{{ section.settings.manual_heading }}</h2>
          <p>{{ section.settings.manual_intro }}</p>
          <small>{{ section.settings.manual_version }}</small>
        </div>
        <div class="sn-support__manual-actions">
          {%- if section.settings.manual_asset_name != blank -%}
            <a class="sn-support__button" href="{{ section.settings.manual_asset_name | asset_url }}" target="_blank" rel="noopener">{{ section.settings.pdf_label }}</a>
          {%- endif -%}
          {%- if section.settings.product_url != blank -%}
            <a class="sn-support__text-link" href="{{ section.settings.product_url }}">{{ section.settings.product_label }} <span aria-hidden="true">&rarr;</span></a>
          {%- endif -%}
        </div>
      </header>

      <nav class="sn-support__manual-nav" aria-label="{{ section.settings.manual_heading | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'manual_section' -%}
            <a href="#manual-{{ block.id }}">{{ block.settings.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      <div class="sn-support__manual-sections">
        {%- assign manual_section_number = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'manual_section' -%}
            {%- assign manual_section_number = manual_section_number | plus: 1 -%}
            <section id="manual-{{ block.id }}" class="sn-support__manual-section{% if block.settings.asset_name == blank %} sn-support__manual-section--text{% endif %}" aria-labelledby="manual-title-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="sn-support__manual-copy">
                <span class="sn-support__section-number" aria-hidden="true">{{ manual_section_number | prepend: '0' | slice: -2, 2 }}</span>
                <h3 id="manual-title-{{ block.id }}">{{ block.settings.title }}</h3>
                <div class="sn-support__rte">{{ block.settings.body }}</div>
              </div>
              {%- if block.settings.asset_name != blank -%}
                <figure class="sn-support__manual-figure">
                  <img src="{{ block.settings.asset_name | asset_url }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy" width="1464" height="600">
                  {%- if block.settings.image_caption != blank -%}<figcaption>{{ block.settings.image_caption }}</figcaption>{%- endif -%}
                </figure>
              {%- endif -%}
            </section>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </article>

    <section id="certifications" class="sn-support__compliance" aria-labelledby="sn-product-support-certifications-heading">
      <header>
        <p class="sn-support__eyebrow">{{ section.settings.compliance_eyebrow }}</p>
        <h2 id="sn-product-support-certifications-heading">{{ section.settings.compliance_heading }}</h2>
        <p>{{ section.settings.compliance_intro }}</p>
      </header>

      <div class="sn-support__compliance-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'compliance_item' -%}
            <article class="sn-support__compliance-card" {{ block.shopify_attributes }}>
              <span>{{ block.settings.standard }}</span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.description }}</p>
              <small>{{ block.settings.status }}</small>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="sn-support__compliance-note">
        <p>{{ section.settings.compliance_note }}</p>
        <a class="sn-support__text-link" href="{{ pages['contact-us'].url | default: '/pages/contact-us' }}">{{ section.settings.compliance_contact_label }} <span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>
  </div>
</section>

{% schema %}
{
  "name": "SuntNeew product support",
  "class": "shopify-section--suntneew-product-support",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "support_label", "label": "Support breadcrumb label", "default": "Support"},
    {"type": "text", "id": "resources_label", "label": "Resources breadcrumb label", "default": "Product Resources"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PRODUCT SUPPORT"},
    {"type": "text", "id": "model", "label": "Product model", "default": "KB700 / KP-700"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "KB700 Support & Manuals"},
    {"type": "textarea", "id": "intro", "label": "Introduction", "default": "Read the mobile-friendly manual online, keep the original PDF, or review model-matched safety and compliance information."},
    {"type": "text", "id": "resource_nav_label", "label": "Resource navigation label", "default": "KB700 manuals and compliance"},
    {"type": "text", "id": "online_card_eyebrow", "label": "Online manual eyebrow", "default": "MOBILE & MULTILINGUAL"},
    {"type": "text", "id": "online_card_label", "label": "Online manual label", "default": "Read the online manual"},
    {"type": "textarea", "id": "online_card_description", "label": "Online manual description", "default": "Responsive instructions that follow the language selected on the store."},
    {"type": "text", "id": "online_card_action", "label": "Online manual action", "default": "Start reading"},
    {"type": "text", "id": "manual_asset_name", "label": "PDF asset filename", "default": "suntneew-kb700-user-manual-en.pdf"},
    {"type": "text", "id": "pdf_card_eyebrow", "label": "PDF eyebrow", "default": "ORIGINAL ENGLISH FILE"},
    {"type": "text", "id": "pdf_label", "label": "PDF label", "default": "Download English PDF"},
    {"type": "textarea", "id": "pdf_card_description", "label": "PDF description", "default": "Keep the original seven-page file for printing or offline reference."},
    {"type": "text", "id": "pdf_card_action", "label": "PDF action", "default": "Download PDF"},
    {"type": "text", "id": "certifications_card_eyebrow", "label": "Certifications eyebrow", "default": "MODEL-MATCHED INFORMATION"},
    {"type": "text", "id": "certifications_label", "label": "Certifications label", "default": "View certifications"},
    {"type": "textarea", "id": "certifications_card_description", "label": "Certifications description", "default": "Review four safety and compliance categories associated with KB700 / KP-700."},
    {"type": "text", "id": "certifications_card_action", "label": "Certifications action", "default": "View information"},
    {"type": "text", "id": "product_label", "label": "Product link label", "default": "View KB700 product"},
    {"type": "url", "id": "product_url", "label": "Product page"},
    {"type": "header", "content": "Online manual"},
    {"type": "text", "id": "manual_eyebrow", "label": "Manual eyebrow", "default": "ONLINE USER MANUAL"},
    {"type": "text", "id": "manual_heading", "label": "Manual heading", "default": "KB700 Fan Jump Starter"},
    {"type": "textarea", "id": "manual_intro", "label": "Manual introduction", "default": "Use this online guide for setup, vehicle starting, air-duster operation, charging and safety."},
    {"type": "text", "id": "manual_version", "label": "Manual version note", "default": "Online edition based on the English manual dated May 7, 2026."},
    {"type": "header", "content": "Compliance"},
    {"type": "text", "id": "compliance_eyebrow", "label": "Compliance eyebrow", "default": "MODEL-MATCHED INFORMATION"},
    {"type": "text", "id": "compliance_heading", "label": "Compliance heading", "default": "Safety & Compliance"},
    {"type": "textarea", "id": "compliance_intro", "label": "Compliance introduction", "default": "These labels describe the four safety and compliance categories associated with KB700 / KP-700."},
    {"type": "textarea", "id": "compliance_note", "label": "Compliance note", "default": "Match every document to the model printed on the product label. Safety testing, transport records and safety data serve different purposes."},
    {"type": "text", "id": "compliance_contact_label", "label": "Compliance contact label", "default": "Contact product support"}
  ],
  "blocks": [
    {
      "type": "quick_fact",
      "name": "Quick fact",
      "settings": [
        {"type": "text", "id": "label", "label": "Label", "default": "Rated capacity"},
        {"type": "text", "id": "value", "label": "Value", "default": "7,200mAh"}
      ]
    },
    {
      "type": "manual_section",
      "name": "Manual section",
      "settings": [
        {"type": "text", "id": "title", "label": "Section title", "default": "Before you begin"},
        {"type": "richtext", "id": "body", "label": "Section content", "default": "<p>Read the complete safety information before using the product.</p>"},
        {"type": "text", "id": "asset_name", "label": "Optional theme image filename"},
        {"type": "text", "id": "image_alt", "label": "Image alt text"},
        {"type": "text", "id": "image_caption", "label": "Image caption"}
      ]
    },
    {
      "type": "compliance_item",
      "name": "Compliance item",
      "settings": [
        {"type": "text", "id": "standard", "label": "Standard", "default": "FCC"},
        {"type": "text", "id": "title", "label": "Title", "default": "Model-matched document"},
        {"type": "textarea", "id": "description", "label": "Description"},
        {"type": "text", "id": "status", "label": "Evidence type", "default": "Product information"}
      ]
    }
  ],
  "max_blocks": 24
}
{% endschema %}
