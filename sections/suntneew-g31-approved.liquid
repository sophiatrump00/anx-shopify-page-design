{%- endif -%}<p class="product-description">{{ section.settings.introduction | escape }}</p><ul class="product-highlights product-highlights-detailed" aria-label="Product highlights">{%- for block in section.blocks -%}{%- if block.type == 'selling_point' -%}<li {{ block.shopify_attributes }}><svg class="icon" aria-hidden="true"><use href="#sn-g31-icon-check"/></svg><span><strong>{{ block.settings.heading | escape }}.</strong> {{ block.settings.text | escape }}</span></li>{%- endif -%}{%- endfor -%}</ul><div class="product-price" id="main-price"><strong data-g31-price>{{ g31_variant.price | money }}</strong><del data-g31-compare {% unless g31_variant.compare_at_price > g31_variant.price %}hidden{% endunless %}>{{ g31_variant.compare_at_price | money }}</del><span data-g31-saving {% unless g31_variant.compare_at_price > g31_variant.price %}hidden{% endunless %}>Save {{ g31_variant.compare_at_price | minus: g31_variant.price | money }}</span></div><p class="g31-price-quantity" data-g31-price-quantity hidden></p><p class="tax-note">Taxes calculated at checkout.</p><div class="configuration"><span>Your battery</span><strong>12.8V · 100Ah · Bluetooth</strong></div>
{% render 'suntneew-g31-quantity-options', product: product, section_id: section.id %}
<div class="buy-row">
<div class="quantity"><button type="button" data-g31-quantity="-1" aria-label="Decrease quantity" disabled>−</button><label class="sr-only" for="g31-quantity-{{ section.id }}">Quantity</label><input id="g31-quantity-{{ section.id }}" name="quantity" type="number" value="{{ g31_min_quantity }}" min="{{ g31_min_quantity }}" max="{{ g31_max_quantity }}" step="{{ g31_quantity_step }}" inputmode="numeric" form="{{ product_form_id }}" aria-label="Quantity"><button type="button" data-g31-quantity="1" aria-label="Increase quantity" {% unless g31_variant.available %}disabled{% endunless %}>+</button></div>
