        <div class="product-gallery"><div class="gallery-stage"><span class="gallery-tag">G31 / 12.8V 100Ah</span><img class="main-image" src="{{ 'sn-g31-v3-main.webp' | asset_url }}" alt="SuntNeew Group 31 12.8V 100Ah LiFePO4 battery" fetchpriority="high" decoding="async" srcset="{{ 'sn-g31-v3-main-320.webp' | asset_url }} 320w, {{ 'sn-g31-v3-main-640.webp' | asset_url }} 640w, {{ 'sn-g31-v3-main.webp' | asset_url }} 1200w" sizes="(max-width: 650px) 100vw, 50vw" width="1200" height="981"><button class="zoom-button" data-zoom="" type="button" aria-label="Enlarge product image"><svg class="icon" aria-hidden="true"><use href="#sn-g31-icon-zoom"></use></svg></button><span class="image-count"><b id="gallery-index">01</b> / 05</span></div><div class="gallery-thumbnails" aria-label="Product images"><button type="button" data-gallery="0" aria-label="View Group 31" aria-pressed="true" data-full="{{ 'sn-g31-v3-main.webp' | asset_url }}" data-srcset="{{ 'sn-g31-v3-main-320.webp' | asset_url }} 320w, {{ 'sn-g31-v3-main-640.webp' | asset_url }} 640w, {{ 'sn-g31-v3-main.webp' | asset_url }} 1200w" data-alt="SuntNeew Group 31 12.8V 100Ah LiFePO4 battery"><img class="" src="{{ 'sn-g31-v3-main.webp' | asset_url }}" alt="" fetchpriority="high" decoding="async" srcset="{{ 'sn-g31-v3-main-320.webp' | asset_url }} 320w, {{ 'sn-g31-v3-main-640.webp' | asset_url }} 640w, {{ 'sn-g31-v3-main.webp' | asset_url }} 1200w" sizes="80px" width="1200" height="981"><span>Group 31</span></button><button type="button" data-gallery="1" aria-label="View Installation" aria-pressed="false" data-full="{{ 'sn-g31-v3-install.webp' | asset_url }}" data-srcset="{{ 'sn-g31-v3-install-320.webp' | asset_url }} 320w, {{ 'sn-g31-v3-install-640.webp' | asset_url }} 640w, {{ 'sn-g31-v3-install.webp' | asset_url }} 1600w" data-alt="Group 31 battery shown in an RV battery compartment"><img class="" src="{{ 'sn-g31-v3-install.webp' | asset_url }}" alt="" fetchpriority="high" decoding="async" srcset="{{ 'sn-g31-v3-install-320.webp' | asset_url }} 320w, {{ 'sn-g31-v3-install-640.webp' | asset_url }} 640w, {{ 'sn-g31-v3-install.webp' | asset_url }} 1600w" sizes="80px" width="1600" height="1067"><span>Installation</span></button><button type="button" data-gallery="2" aria-label="View Bluetooth" aria-pressed="false" data-full="{{ 'sn-g31-v3-bluetooth.webp' | asset_url }}" data-srcset="{{ 'sn-g31-v3-bluetooth-320.webp' | asset_url }} 320w, {{ 'sn-g31-v3-bluetooth-640.webp' | asset_url }} 640w, {{ 'sn-g31-v3-bluetooth.webp' | asset_url }} 1600w" data-alt="Group 31 battery and Bluetooth phone monitoring illustration"><img class="" src="{{ 'sn-g31-v3-bluetooth.webp' | asset_url }}" alt="" loading="lazy" decoding="async" srcset="{{ 'sn-g31-v3-bluetooth-320.webp' | asset_url }} 320w, {{ 'sn-g31-v3-bluetooth-640.webp' | asset_url }} 640w, {{ 'sn-g31-v3-bluetooth.webp' | asset_url }} 1600w" sizes="80px" width="1600" height="1067"><span>Bluetooth</span></button><button type="button" data-gallery="3" aria-label="View Easy to handle" aria-pressed="false" data-full="{{ 'sn-g31-v3-lightweight.webp' | asset_url }}" data-srcset="{{ 'sn-g31-v3-lightweight-320.webp' | asset_url }} 320w, {{ 'sn-g31-v3-lightweight-640.webp' | asset_url }} 640w, {{ 'sn-g31-v3-lightweight.webp' | asset_url }} 1600w" data-alt="Group 31 battery handle and lifting illustration"><img class="" src="{{ 'sn-g31-v3-lightweight.webp' | asset_url }}" alt="" loading="lazy" decoding="async" srcset="{{ 'sn-g31-v3-lightweight-320.webp' | asset_url }} 320w, {{ 'sn-g31-v3-lightweight-640.webp' | asset_url }} 640w, {{ 'sn-g31-v3-lightweight.webp' | asset_url }} 1600w" sizes="80px" width="1600" height="1067"><span>Easy to handle</span></button><button type="button" data-gallery="4" aria-label="View In the box" aria-pressed="false" data-full="{{ 'sn-g31-v3-kit.webp' | asset_url }}" data-srcset="{{ 'sn-g31-v3-kit-320.webp' | asset_url }} 320w, {{ 'sn-g31-v3-kit-640.webp' | asset_url }} 640w, {{ 'sn-g31-v3-kit.webp' | asset_url }} 1200w" data-alt="Group 31 battery and included terminal hardware"><img class="" src="{{ 'sn-g31-v3-kit.webp' | asset_url }}" alt="" loading="lazy" decoding="async" srcset="{{ 'sn-g31-v3-kit-320.webp' | asset_url }} 320w, {{ 'sn-g31-v3-kit-640.webp' | asset_url }} 640w, {{ 'sn-g31-v3-kit.webp' | asset_url }} 1200w" sizes="80px" width="1200" height="1200"><span>In the box</span></button></div><p class="gallery-caption">Group 31 · 12.8V 100Ah · LiFePO4</p></div>
        <div class="purchase-panel"><p class="eyebrow">POWER FOR RV LIFE</p><h1>{{ section.settings.heading | default: product.title | escape | newline_to_br }}</h1>{%- assign g31_rating = product.metafields.reviews.rating.value -%}
