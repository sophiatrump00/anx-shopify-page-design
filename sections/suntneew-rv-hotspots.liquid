<section class="sn-rv-tech-section">
  <div class="sn-rv-tech" id="{{ section.settings.anchor_id | escape }}" data-sn-rv-hotspots>
    <picture class="sn-rv-tech__background" aria-hidden="true">
      <source media="(max-width: 699px)" srcset="{{ section.settings.mobile_background_asset | asset_url }}">
      <img src="{{ section.settings.desktop_background_asset | asset_url }}" alt="" width="2500" height="1200" loading="lazy">
    </picture>
    <div class="sn-rv-tech__veil" aria-hidden="true"></div>

    <div class="sn-rv-tech__shell">
      <div class="sn-rv-tech__intro">
        <p class="sn-kicker">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="sn-rv-tech__body">{{ section.settings.body }}</p>

        <div class="sn-rv-tech__stats" aria-label="RV battery range highlights">
          <span><strong>{{ section.settings.stat_1 }}</strong></span>
          <span><strong>{{ section.settings.stat_2 }}</strong></span>
          <span><strong>{{ section.settings.stat_3 }}</strong></span>
          <span><strong>{{ section.settings.stat_4 }}</strong></span>
        </div>

        <p class="sn-rv-tech__footnote">{{ section.settings.footnote }}</p>
        <a class="sn-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
      </div>

      <div class="sn-rv-tech__visual">
        <img class="sn-rv-tech__product" src="{{ section.settings.product_asset | asset_url }}" alt="{{ section.settings.product_alt | escape }}" width="1800" height="1220" loading="lazy">

        <div class="sn-rv-tech__hotspots" aria-label="Explore RV battery features">
          {%- for block in section.blocks -%}
            <button
              class="sn-rv-tech__hotspot"
              type="button"
              style="--sn-hotspot-x: {{ block.settings.x_position }}%; --sn-hotspot-y: {{ block.settings.y_position }}%;"
              aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="sn-rv-detail-{{ block.id }}"
              data-sn-rv-trigger
              {{ block.shopify_attributes }}
            >
              <span aria-hidden="true">{{ forloop.index }}</span>
              <span class="sr-only">{{ block.settings.title }}</span>
            </button>
          {%- endfor -%}
        </div>

        <div class="sn-rv-tech__details" aria-live="polite">
          {%- for block in section.blocks -%}
            <article class="sn-rv-tech__detail" id="sn-rv-detail-{{ block.id }}" data-sn-rv-detail {% unless forloop.first %}hidden{% endunless %}>
              <p>{{ forloop.index | prepend: '0' }} / {{ section.blocks.size | prepend: '0' }}</p>
              <h3>{{ block.settings.title }}</h3>
              <div>{{ block.settings.text }}</div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SuntNeew RV hotspots",
  "max_blocks": 4,
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anchor ID","default":"rv-long-life-power"},
    {"type":"text","id":"desktop_background_asset","label":"Desktop background asset","default":"suntneew-rv-tech-bg-desktop.jpg"},
    {"type":"text","id":"mobile_background_asset","label":"Mobile background asset","default":"suntneew-rv-tech-bg-mobile.jpg"},
    {"type":"text","id":"product_asset","label":"Product cutout asset","default":"suntneew-rv-g31-cutout.webp"},
    {"type":"text","id":"product_alt","label":"Product image alt","default":"SuntNeew Group 31 100Ah LiFePO4 RV battery"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"LONG-LIFE SMART RV POWER"},
    {"type":"text","id":"heading","label":"Heading","default":"Power you can see. Protection you can trust."},
    {"type":"textarea","id":"body","label":"Body","default":"Built for RV living with long cycle life, Bluetooth 5.0 monitoring, built-in BMS protection and low-temperature charge protection."},
    {"type":"text","id":"stat_1","label":"Stat 1","default":"Up to 15,000 Cycles*"},
    {"type":"text","id":"stat_2","label":"Stat 2","default":"Bluetooth 5.0 Monitoring"},
    {"type":"text","id":"stat_3","label":"Stat 3","default":"Low-Temperature Charge Protection"},
    {"type":"text","id":"stat_4","label":"Stat 4","default":"-4°F to 140°F Discharge"},
    {"type":"textarea","id":"footnote","label":"Footnote","default":"*Up to 15,000 cycles under laboratory conditions. Actual cycle life varies by model, depth of discharge, charge/discharge rate, temperature and usage."},
    {"type":"text","id":"button_label","label":"Button label","default":"Explore RV batteries"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "blocks": [
    {
      "type":"feature",
      "name":"Hotspot",
      "settings":[
        {"type":"range","id":"x_position","label":"Horizontal position","min":5,"max":95,"step":1,"unit":"%","default":50},
        {"type":"range","id":"y_position","label":"Vertical position","min":5,"max":95,"step":1,"unit":"%","default":50},
        {"type":"text","id":"title","label":"Title","default":"Long-life LiFePO4 power"},
        {"type":"richtext","id":"text","label":"Text","default":"<p>Explore a key feature of the RV battery range.</p>"}
      ]
    }
  ],
  "presets":[{"name":"SuntNeew RV hotspots","blocks":[{"type":"feature"},{"type":"feature"},{"type":"feature"}]}]
}
{% endschema %}
