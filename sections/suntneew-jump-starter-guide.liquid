                  </h3>

                  <ul class="sn-jg-bullets" role="list">
                    <li>{{ block.settings.spec_peak | escape }} Peak / {{ block.settings.spec_start | escape }} Start &middot; {{ block.settings.spec_capacity | escape }}</li>
                    <li>Up to {{ block.settings.spec_fit | escape }} (12V)</li>
                    <li>{{ block.settings.bullet_3 | default: block.settings.meta_note | escape }}</li>
                  </ul>

                  <div class="sn-jg-card__footer">
                    <div class="sn-jg-price-row">
                      <div class="sn-jg-prices">
                        {%- if active_price != blank -%}
                          <span class="sn-jg-price{% unless has_sale %} sn-jg-price--regular{% endunless %}">{{ active_price | money }}</span>
                          {%- if has_sale -%}
                            <span class="sn-jg-compare">{{ active_compare | money }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      </div>

                      <div class="sn-jg-price-right">
                        {%- if block.settings.enable_color_swatches and red_variant != nil and orange_variant != nil -%}
                          <div class="sn-jg-swatches">
                            <button
                              type="button"
                              class="sn-jg-swatch"
                              aria-label="Red"
                              title="Red"
                              aria-pressed="true"
                              data-jg-swatch
                              data-variant-id="{{ red_variant.id }}"
                              data-variant-img="{{ primary_img_url }}"
                              data-variant-url="{{ red_variant.url | default: family_url }}"
                              style="background:#dc2626"
                            ></button>
                            <button
                              type="button"
                              class="sn-jg-swatch"
                              aria-label="Orange"
                              title="Orange"
                              aria-pressed="false"
                              data-jg-swatch
                              data-variant-id="{{ orange_variant.id }}"
                              data-variant-img="{{ alt_img_url }}"
                              data-variant-url="{{ orange_variant.url | default: family_url }}"
                              style="background:#f97316"
                            ></button>
                          </div>
                        {%- endif -%}
                        <a class="sn-jg-details-link" href="{{ family_url }}" data-jg-product-link>Details &rarr;</a>
                      </div>
                    </div>

                    {%- if family_product != blank and default_variant != blank -%}
                      {%- form 'product', family_product, is: 'product-form', class: 'sn-jg-form' -%}
                        <input type="hidden" name="id" value="{{ default_variant.id }}" data-jg-variant-input>
                        <button type="submit" class="sn-jg-btn-primary"{% unless is_available %} disabled{% endunless %}>
                          {%- if is_available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
                        </button>
                      {%- endform -%}
                    {%- else -%}
                      <a class="sn-jg-btn-primary sn-jg-btn-primary--link" href="{{ family_url }}">View Details</a>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
        </section>
      {%- endfor -%}

      <!-- Collapsible Side-by-Side Spec Compare Table -->
      <section class="sn-jg-compare-box" id="jump-compare" data-jg-shelf="compare">
        <button type="button" class="sn-jg-compare-toggle" aria-expanded="false" aria-controls="jump-compare-panel" data-jg-compare-toggle>
          <span>
            <span class="sn-jg-compare-toggle__eyebrow">SPEC MATRIX</span>
            <span class="sn-jg-compare-toggle__title">{{ section.settings.compare_heading | escape }}</span>
          </span>
          <span class="sn-jg-compare-toggle__pill" data-jg-compare-label>Show Table &#9662;</span>
        </button>

        <div id="jump-compare-panel" hidden data-jg-compare-panel>
          <div class="sn-jg-table-wrap">
            <table class="sn-jg-table">
              <thead>
                <tr>
                  <th scope="col">Model</th>
                  <th scope="col">Price</th>
                  <th scope="col">Peak / Start</th>
                  <th scope="col">Capacity</th>
                  <th scope="col">Max Engine</th>
                  <th scope="col">Extra</th>
                  <th scope="col">Action</th>
                </tr>
              </thead>
              <tbody>
                {%- for block in section.blocks -%}
                  {%- if block.type != 'family' -%}{% continue %}{%- endif -%}
                  {%- assign family_product = all_products[block.settings.product_handle] -%}
                  {%- if block.settings.preview_only and family_product == blank and request.design_mode == false -%}{% continue %}{%- endif -%}
                  {%- assign family_url = family_product.url | default: '/products/' | append: block.settings.product_handle -%}
                  {%- assign row_variant = family_product.selected_or_first_available_variant -%}
                  <tr>
                    <td><strong>{{ block.settings.model_code | default: block.settings.title | escape }}</strong></td>
                    <td>
                      {%- if row_variant.price != blank -%}
                        {%- if row_variant.compare_at_price > row_variant.price -%}
                          <strong class="sn-jg-table__sale">{{ row_variant.price | money }}</strong>
                          <span class="sn-jg-compare">{{ row_variant.compare_at_price | money }}</span>
                        {%- else -%}
                          <strong>{{ row_variant.price | money }}</strong>
                        {%- endif -%}
                      {%- else -%}
                        —
                      {%- endif -%}
                    </td>
                    <td>{{ block.settings.spec_peak | escape }} / {{ block.settings.spec_start | escape }}</td>
                    <td>{{ block.settings.spec_capacity | escape }}</td>
                    <td>{{ block.settings.spec_fit | escape }}</td>
                    <td>{{ block.settings.spec_highlight | escape }}</td>
                    <td><a class="sn-jg-table__link" href="{{ family_url }}">View</a></td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {%- if section.settings.table_note != blank -%}
            <p class="sn-jg-footnote">{{ section.settings.table_note | escape }}</p>
          {%- endif -%}
        </div>
      </section>
    </div>
  </div>

  <!-- Cross-Device Bottom-Center Floating Quick-Return Pill + Upward Popover -->
  <div class="sn-jg-float-wrap" data-jg-float-wrap>
    <div class="sn-jg-float-pop" id="jg-float-pop" hidden data-jg-float-pop role="menu" aria-label="Jump to jump starter group">
      <div class="sn-jg-float-pop__head">
        <span>Jump to Shelf</span>
        <button type="button" class="sn-jg-float-pop__close" data-jg-float-close aria-label="Close category menu">&#10005;</button>
      </div>
      <a class="sn-jg-float-pop__link" href="#shelf-everyday" data-jg-anchor="#shelf-everyday" role="menuitem">
        <span><span class="sn-jg-float-pop__num" style="color:#e95416">01</span>Everyday Cars</span>
        <span class="sn-jg-float-pop__meta">{{ everyday_count }}</span>
      </a>
      <a class="sn-jg-float-pop__link" href="#shelf-multitool" data-jg-anchor="#shelf-multitool" role="menuitem">
        <span><span class="sn-jg-float-pop__num" style="color:#0d9488">02</span>2-in-1 Multi-Tool</span>
        <span class="sn-jg-float-pop__meta">{{ multitool_count }}</span>
      </a>
      <a class="sn-jg-float-pop__link" href="#shelf-heavy" data-jg-anchor="#shelf-heavy" role="menuitem">
        <span><span class="sn-jg-float-pop__num" style="color:#334155">03</span>Heavy-Duty Diesel</span>
        <span class="sn-jg-float-pop__meta">{{ heavy_count }}</span>
      </a>
      <a class="sn-jg-float-pop__link" href="#jump-compare" data-jg-anchor="#jump-compare" data-jg-open-compare role="menuitem">
        <span>Compare All 7</span>
        <span class="sn-jg-float-pop__meta">&#8600;</span>
      </a>
      <a class="sn-jg-float-pop__top" href="#jump-categories" data-jg-float-top role="menuitem">&uarr; Back to Top</a>
    </div>

    <button
      type="button"
      class="sn-jg-float-btn"
      aria-expanded="false"
      aria-controls="jg-float-pop"
      data-jg-float-toggle
    >
      <span class="sn-jg-float-btn__arrow" aria-hidden="true">&uarr;</span>
      <span>Categories</span>
      <span class="sn-jg-float-btn__pill" data-jg-float-current>Everyday</span>
    </button>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-jump-guide]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    // Color swatch switcher (e.g. A20 Red / Orange)
    root.querySelectorAll('[data-jg-card]').forEach((card) => {
      const swatches = [...card.querySelectorAll('[data-jg-swatch]')];
      if (!swatches.length) return;
      const img = card.querySelector('[data-jg-card-img]');
      const variantInput = card.querySelector('[data-jg-variant-input]');
      const links = [...card.querySelectorAll('[data-jg-product-link]')];

      swatches.forEach((btn) => {
        btn.addEventListener('click', () => {
          swatches.forEach((item) => item.setAttribute('aria-pressed', item === btn ? 'true' : 'false'));
          if (img && btn.dataset.variantImg) img.src = btn.dataset.variantImg;
          if (variantInput && btn.dataset.variantId) variantInput.value = btn.dataset.variantId;
          if (btn.dataset.variantUrl) {
            links.forEach((link) => { link.href = btn.dataset.variantUrl; });
          }
        });
      });
    });

    // Collapsible comparison table
    const compareToggle = root.querySelector('[data-jg-compare-toggle]');
    const comparePanel = root.querySelector('[data-jg-compare-panel]');
    const compareLabel = root.querySelector('[data-jg-compare-label]');

    const setCompareOpen = (open) => {
      if (!compareToggle || !comparePanel) return;
      compareToggle.setAttribute('aria-expanded', String(open));
      comparePanel.hidden = !open;
      if (compareLabel) compareLabel.innerHTML = open ? 'Hide Table &#9652;' : 'Show Table &#9662;';
    };

    if (compareToggle) {
      compareToggle.addEventListener('click', () => {
        const isOpen = compareToggle.getAttribute('aria-expanded') === 'true';
        setCompareOpen(!isOpen);
      });
    }

    // Cross-device Bottom-Center Floating Categories Popover
    const nav = root.querySelector('#jump-categories');
    const floatWrap = root.querySelector('[data-jg-float-wrap]');
    const floatPop = root.querySelector('[data-jg-float-pop]');
    const floatToggle = root.querySelector('[data-jg-float-toggle]');
    const floatClose = root.querySelector('[data-jg-float-close]');
    const floatTop = root.querySelector('[data-jg-float-top]');
    const floatCurrent = root.querySelector('[data-jg-float-current]');
    const shelves = [...root.querySelectorAll('[data-jg-shelf]')];
    const shelfLabels = {
      everyday: 'Everyday',
      multitool: 'Multi-Tool',
      heavy: 'Heavy-Duty',
      compare: 'Compare'
    };

    const setFloatOpen = (open) => {
      if (!floatPop || !floatToggle) return;
      floatPop.hidden = !open;
      floatToggle.setAttribute('aria-expanded', String(open));
    };

    if (floatToggle) {
      floatToggle.addEventListener('click', (event) => {
        event.stopPropagation();
        setFloatOpen(floatPop ? floatPop.hidden : false);
      });
    }

    if (floatClose) {
      floatClose.addEventListener('click', () => setFloatOpen(false));
    }

    if (floatTop && nav) {
      floatTop.addEventListener('click', (event) => {
        event.preventDefault();
        setFloatOpen(false);
        nav.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    // Quick-jump links (and auto-expand compare table when clicking Compare All 7)
    root.querySelectorAll('[data-jg-anchor]').forEach((anchor) => {
      anchor.addEventListener('click', (event) => {
        const targetSelector = anchor.dataset.jgAnchor;
        const target = targetSelector ? root.querySelector(targetSelector) : null;
        if (!target) return;
        event.preventDefault();
        setFloatOpen(false);
        if (anchor.hasAttribute('data-jg-open-compare')) {
          setCompareOpen(true);
        }
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    document.addEventListener('click', (event) => {
      if (floatWrap && !floatWrap.contains(event.target)) {
        setFloatOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setFloatOpen(false);
      }
    });

    const syncFloatState = () => {
      if (!nav || !floatWrap) return;
      const navRect = nav.getBoundingClientRect();
      const passedNav = navRect.bottom < 12;
      floatWrap.classList.toggle('is-visible', passedNav);
      if (!passedNav) {
        setFloatOpen(false);
      }

      if (floatCurrent && shelves.length) {
        let activeKey = 'everyday';
        for (const shelf of shelves) {
          if (shelf.getBoundingClientRect().top <= 200) {
            activeKey = shelf.dataset.jgShelf || activeKey;
          }
        }
        floatCurrent.textContent = shelfLabels[activeKey] || 'Everyday';
      }
    };

    window.addEventListener('scroll', syncFloatState, { passive: true });
    window.addEventListener('resize', syncFloatState);
    syncFloatState();
  })();
</script>

