{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --jg-ink: #111827;
    --jg-navy: #182330;
    --jg-muted: #4b5563;
    --jg-line: #e5e7eb;
    --jg-accent: #e95416;
    --jg-accent-hover: #cf470f;
    --jg-sale: #D92D20;
    --jg-bg: #f8fafc;
    background: var(--jg-bg);
    color: var(--jg-ink);
  }

  /* Compact Hero */
  #shopify-section-{{ section.id }} .sn-jg-hero {
    position: relative;
    overflow: hidden;
    background: #0f172a;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-jg-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .45;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(15 23 42 / .94) 0%, rgb(15 23 42 / .72) 55%, rgb(15 23 42 / .28) 100%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 180px;
    padding-block: clamp(24px, 3vw, 36px);
  }

  #shopify-section-{{ section.id }} .sn-jg-hero__eyebrow {
    margin: 0 0 6px;
    color: #ff9463;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-jg-hero h1 {
    max-width: 640px;
    margin: 0 0 6px;
    color: #fff;
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 800;
    letter-spacing: -.025em;
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .sn-jg-hero__sub {
    max-width: 520px;
    margin: 0;
    color: rgb(255 255 255 / .86);
    font-size: 14px;
    line-height: 1.5;
  }

  /* Category Navigation: Desktop single-row pills, Mobile 2x2 single-line grid */
  #shopify-section-{{ section.id }} .sn-jg-nav {
    background: #fff;
    border-bottom: 1px solid var(--jg-line);
    scroll-margin-top: 72px;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding-block: 14px;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 8px 16px;
    border: 1px solid var(--jg-line);
    border-radius: 999px;
    background: #f1f5f9;
    color: var(--jg-navy);
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color .15s ease, border-color .15s ease, color .15s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__item:first-child {
    background: var(--jg-navy);
    border-color: var(--jg-navy);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__item--compare {
    margin-left: auto;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__item:hover,
  #shopify-section-{{ section.id }} .sn-jg-nav__item:focus-visible {
    border-color: var(--jg-accent);
    color: var(--jg-accent);
    outline: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__item:first-child:hover,
  #shopify-section-{{ section.id }} .sn-jg-nav__item:first-child:focus-visible,
  #shopify-section-{{ section.id }} .sn-jg-nav__item--compare:hover,
  #shopify-section-{{ section.id }} .sn-jg-nav__item--compare:focus-visible {
    background: var(--jg-accent);
    border-color: var(--jg-accent);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__txt--mob {
    display: none;
  }

  /* Main Body & Clean Single-Row Shelf Headers */
  #shopify-section-{{ section.id }} .sn-jg-body {
    padding-block: clamp(24px, 3.2vw, 40px) clamp(56px, 6vw, 84px);
  }

  #shopify-section-{{ section.id }} .sn-jg-shelves {
    display: grid;
    gap: clamp(32px, 4vw, 48px);
  }

  #shopify-section-{{ section.id }} .sn-jg-shelf {
    scroll-margin-top: 84px;
  }

  #shopify-section-{{ section.id }} .sn-jg-shelf__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .sn-jg-shelf__head h2 {
    margin: 0;
    color: var(--jg-ink);
    font-size: clamp(19px, 2.2vw, 24px);
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .sn-jg-shelf__count {
    color: #9ca3af;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Grids */
  #shopify-section-{{ section.id }} .sn-jg-grid {
    display: grid;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .sn-jg-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #shopify-section-{{ section.id }} .sn-jg-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* LiTime-Calibrated Product Card */
  #shopify-section-{{ section.id }} .sn-jg-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--jg-line);
    border-radius: 12px;
    background: #fff;
    transition: box-shadow .18s ease, border-color .18s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 10px 26px rgb(15 23 42 / .07);
  }

  #shopify-section-{{ section.id }} .sn-jg-card__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 175px;
    padding: 28px 16px 8px;
    background: #fff;
    overflow: hidden;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-card__stage img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform .24s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-card:hover .sn-jg-card__stage img {
    transform: scale(1.03);
  }

  #shopify-section-{{ section.id }} .sn-jg-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    padding: 2px 7px;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    background: #f1f5f9;
    color: #334155;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
  }

  /* Live Store Style-A Red XX% OFF Badge (#D92D20) */
  #shopify-section-{{ section.id }} .sn-jg-save {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--jg-sale);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .02em;
    line-height: 1.3;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sn-jg-quick-eye {
    position: absolute;
    right: 10px;
    bottom: 8px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    background: rgb(255 255 255 / .94);
    color: #334155;
    box-shadow: 0 2px 8px rgb(15 23 42 / .08);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity .16s ease, transform .16s ease, border-color .16s ease, color .16s ease;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-card:hover .sn-jg-quick-eye,
  #shopify-section-{{ section.id }} .sn-jg-quick-eye:focus-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .sn-jg-quick-eye:hover {
    border-color: var(--jg-accent);
    color: var(--jg-accent);
  }

  #shopify-section-{{ section.id }} .sn-jg-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 8px 16px 16px;
  }

  /* Wide Card on Heavy-Duty Row (Desktop >= 1000px) */
  #shopify-section-{{ section.id }} .sn-jg-card--wide {
    flex-direction: row;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .sn-jg-card--wide .sn-jg-card__stage {
    width: 210px;
    min-width: 210px;
    height: auto;
    min-height: 225px;
    padding: 28px 16px 16px;
    border-right: 1px solid #f3f4f6;
  }

  #shopify-section-{{ section.id }} .sn-jg-card--wide .sn-jg-card__body {
    padding: 16px 18px;
  }

  /* Circular Outline Feature Icons */
  #shopify-section-{{ section.id }} .sn-jg-feat-icons {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .sn-jg-feat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    background: #fff;
    color: #334155;
    transition: border-color .15s ease, color .15s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-feat-icon:hover {
    border-color: var(--jg-accent);
    color: var(--jg-accent);
  }

  /* 1-Line Bold Title */
  #shopify-section-{{ section.id }} .sn-jg-card__title {
    margin: 0;
    font-size: 15.5px;
    font-weight: 800;
    letter-spacing: -.015em;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .sn-jg-card__title a {
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sn-jg-card__title a:hover {
    color: var(--jg-accent);
  }

  /* 3 Concise Bullet Points */
  #shopify-section-{{ section.id }} .sn-jg-bullets {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-bullets li {
    position: relative;
    padding-left: 11px;
    color: var(--jg-muted);
    font-size: 12px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .sn-jg-bullets li::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
    color: #9ca3af;
    font-weight: 700;
  }

  /* Card Footer: Divider + Style-A Price + Swatches/Details + Full-Width CTA */
  #shopify-section-{{ section.id }} .sn-jg-card__footer {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--jg-line);
  }

  #shopify-section-{{ section.id }} .sn-jg-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .sn-jg-prices {
    display: flex;
    align-items: baseline;
    gap: 7px;
  }

  #shopify-section-{{ section.id }} .sn-jg-price {
    color: var(--jg-sale);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .sn-jg-price--regular {
    color: var(--jg-navy);
  }

  #shopify-section-{{ section.id }} .sn-jg-compare {
    color: #6b7280;
    font-size: 12.5px;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .sn-jg-price-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sn-jg-swatches {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .sn-jg-swatch {
    width: 16px;
    height: 16px;
    padding: 0;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    cursor: pointer;
    transition: box-shadow .14s ease, border-color .14s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-swatch[aria-pressed="true"] {
    border-color: #fff;
    box-shadow: 0 0 0 2px var(--jg-accent);
  }

  #shopify-section-{{ section.id }} .sn-jg-details-link {
    color: #64748b;
    font-size: 11.5px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sn-jg-details-link:hover {
    color: var(--jg-accent);
  }

  #shopify-section-{{ section.id }} .sn-jg-form {
    display: block;
    width: 100%;
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .sn-jg-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 38px;
    padding: 0 14px;
    border: 0;
    border-radius: 6px;
    background: var(--jg-ink);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background-color .15s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-btn-primary--link {
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .sn-jg-btn-primary:hover:not(:disabled),
  #shopify-section-{{ section.id }} .sn-jg-btn-primary:focus-visible:not(:disabled) {
    background: var(--jg-accent);
    outline: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-btn-primary:disabled {
    opacity: .5;
    cursor: not-allowed;
  }

  /* Collapsible Compare All 7 Spec Matrix */
  #shopify-section-{{ section.id }} .sn-jg-compare-box {
    scroll-margin-top: 84px;
    border: 1px solid var(--jg-line);
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sn-jg-compare-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    border: 0;
    background: #fff;
    color: var(--jg-ink);
    text-align: left;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .sn-jg-compare-toggle:hover {
    background: #f8fafc;
  }

  #shopify-section-{{ section.id }} .sn-jg-compare-toggle__eyebrow {
    display: block;
    color: var(--jg-accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-jg-compare-toggle__title {
    display: block;
    margin-top: 2px;
    font-size: 16px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-jg-compare-toggle__pill {
    flex: none;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--jg-navy);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .sn-jg-table-wrap {
    overflow-x: auto;
    border-top: 1px solid var(--jg-line);
  }

  #shopify-section-{{ section.id }} .sn-jg-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 12px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .sn-jg-table th,
  #shopify-section-{{ section.id }} .sn-jg-table td {
    padding: 12px 16px;
    border-bottom: 1px solid #f1f5f9;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sn-jg-table th {
    background: #f8fafc;
    color: var(--jg-muted);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-jg-table tr:last-child td {
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .sn-jg-table__sale {
    color: var(--jg-sale);
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-jg-table__link {
    display: inline-flex;
    align-items: center;
    padding: 6px 11px;
    border-radius: 6px;
    background: var(--jg-navy);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-table__link:hover {
    background: var(--jg-accent);
  }

  #shopify-section-{{ section.id }} .sn-jg-footnote {
    margin: 0;
    padding: 12px 16px;
    border-top: 1px solid #f1f5f9;
    color: var(--jg-muted);
    font-size: 11px;
    line-height: 1.5;
  }

  /* Cross-Device Floating Bottom-Center Quick-Return Pill + Popover */
  #shopify-section-{{ section.id }} .sn-jg-float-wrap {
    position: fixed;
    bottom: 20px;
    left: 50%;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(14px);
    transition: opacity .2s ease, transform .2s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-wrap.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  #shopify-section-{{ section.id }} .sn-jg-float-pop {
    width: 264px;
    padding: 8px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 18px 40px rgb(15 23 42 / .2);
    font-size: 12px;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-pop__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
    padding: 4px 10px 6px;
    border-bottom: 1px solid #f1f5f9;
    color: var(--jg-ink);
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-pop__close {
    padding: 2px 6px;
    border: 0;
    background: transparent;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-pop__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    border-radius: 10px;
    color: var(--jg-ink);
    font-weight: 600;
    text-decoration: none;
    transition: background-color .14s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-pop__link:hover,
  #shopify-section-{{ section.id }} .sn-jg-float-pop__link:focus-visible {
    background: #fff7ed;
    outline: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-pop__num {
    margin-right: 4px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-pop__meta {
    color: #64748b;
    font-size: 11px;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-pop__top {
    display: block;
    margin-top: 4px;
    padding: 8px 10px;
    border-radius: 10px;
    background: var(--jg-navy);
    color: #fff;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-pop__top:hover {
    background: var(--jg-accent);
  }

  #shopify-section-{{ section.id }} .sn-jg-float-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid rgb(255 255 255 / .18);
    border-radius: 999px;
    background: rgb(24 35 48 / .95);
    color: #fff;
    font: inherit;
    font-size: 12.5px;
    font-weight: 700;
    box-shadow: 0 10px 28px rgb(15 23 42 / .28);
    cursor: pointer;
    transition: background-color .15s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-btn:hover,
  #shopify-section-{{ section.id }} .sn-jg-float-btn:focus-visible {
    background: var(--jg-accent);
    outline: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-btn__arrow {
    color: #ff9463;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-btn:hover .sn-jg-float-btn__arrow {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-jg-float-btn__pill {
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / .16);
    color: #e2e8f0;
    font-size: 11px;
    font-weight: 600;
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .sn-jg-grid--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .sn-jg-card--wide {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .sn-jg-card--wide .sn-jg-card__stage {
      width: 100%;
      min-width: 0;
      height: 175px;
      min-height: 175px;
      padding: 28px 16px 8px;
      border-right: 0;
    }

    #shopify-section-{{ section.id }} .sn-jg-card--wide .sn-jg-card__body {
      padding: 8px 16px 16px;
    }
  }

  /* Mobile Horizontal Cards & 2x2 Quick Tap Grid */
  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .sn-jg-hero__inner {
      min-height: 165px;
      padding-block: 20px;
    }

    #shopify-section-{{ section.id }} .sn-jg-nav__txt--desk {
      display: none;
    }

    #shopify-section-{{ section.id }} .sn-jg-nav__txt--mob {
      display: inline;
    }

    #shopify-section-{{ section.id }} .sn-jg-nav__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      padding-block: 12px;
    }

    #shopify-section-{{ section.id }} .sn-jg-nav__item {
      min-height: 40px;
      padding: 9px 10px;
      border-radius: 10px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .sn-jg-nav__item--compare {
      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .sn-jg-grid,
    #shopify-section-{{ section.id }} .sn-jg-grid--3,
    #shopify-section-{{ section.id }} .sn-jg-grid--2 {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .sn-jg-card,
    #shopify-section-{{ section.id }} .sn-jg-card--wide {
      flex-direction: row;
      align-items: stretch;
      border-radius: 12px;
    }

    #shopify-section-{{ section.id }} .sn-jg-card__stage,
    #shopify-section-{{ section.id }} .sn-jg-card--wide .sn-jg-card__stage {
      width: 114px;
      min-width: 114px;
      height: auto;
      min-height: 162px;
      padding: 24px 8px 10px;
      border-right: 1px solid #f3f4f6;
    }

    #shopify-section-{{ section.id }} .sn-jg-badge,
    #shopify-section-{{ section.id }} .sn-jg-quick-eye,
    #shopify-section-{{ section.id }} .sn-jg-feat-icons,
    #shopify-section-{{ section.id }} .sn-jg-bullets li:nth-child(2) {
      display: none;
    }

    #shopify-section-{{ section.id }} .sn-jg-save {
      top: 6px;
      right: 6px;
      padding: 2px 6px;
      font-size: 10px;
    }

    #shopify-section-{{ section.id }} .sn-jg-card__body,
    #shopify-section-{{ section.id }} .sn-jg-card--wide .sn-jg-card__body {
      padding: 11px 12px;
    }

    #shopify-section-{{ section.id }} .sn-jg-card__title {
      font-size: 13.5px;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .sn-jg-card__title a {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      white-space: normal;
    }

    #shopify-section-{{ section.id }} .sn-jg-bullets {
      gap: 2px;
      margin-top: 5px;
    }

    #shopify-section-{{ section.id }} .sn-jg-bullets li {
      font-size: 11px;
      line-height: 1.35;
    }

    #shopify-section-{{ section.id }} .sn-jg-card__footer {
      margin-top: 8px;
      padding-top: 8px;
    }

    #shopify-section-{{ section.id }} .sn-jg-price {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .sn-jg-compare {
      font-size: 11.5px;
    }

    #shopify-section-{{ section.id }} .sn-jg-form,
    #shopify-section-{{ section.id }} .sn-jg-btn-primary--link {
      margin-top: 7px;
    }

    #shopify-section-{{ section.id }} .sn-jg-btn-primary {
      height: 32px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .sn-jg-compare-toggle {
      padding: 14px 16px;
    }

    #shopify-section-{{ section.id }} .sn-jg-float-wrap {
      bottom: 16px;
    }
  }
</style>

{%- liquid
  assign everyday_count = 0
  assign multitool_count = 0
  assign heavy_count = 0
  for block in section.blocks
    if block.type != 'family'
      continue
    endif
    assign fp = all_products[block.settings.product_handle]
    if block.settings.preview_only and fp == blank and request.design_mode == false
      continue
    endif
    if block.settings.group == 'everyday'
      assign everyday_count = everyday_count | plus: 1
    endif
    if block.settings.group == 'multitool'
      assign multitool_count = multitool_count | plus: 1
    endif
    if block.settings.group == 'heavy' or block.settings.also_heavy_duty
      assign heavy_count = heavy_count | plus: 1
    endif
  endfor
-%}

<section class="sn-jg" id="jump-starters-top" data-jump-guide>
  <header class="sn-jg-hero">
    {%- if section.settings.hero_asset != blank -%}
      <img
        class="sn-jg-hero__bg"
        src="{{ section.settings.hero_asset | asset_url }}"
        alt=""
        width="2098"
        height="749"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
    <div class="sn-jg-hero__scrim" aria-hidden="true"></div>
    <div class="container sn-jg-hero__inner">
      <p class="sn-jg-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p class="sn-jg-hero__sub">{{ section.settings.intro | escape }}</p>
    </div>
  </header>

  <nav class="sn-jg-nav" id="jump-categories" aria-label="Jump starter categories">
    <div class="container">
      <div class="sn-jg-nav__grid">
        <a class="sn-jg-nav__item" href="#shelf-everyday" data-jg-anchor="#shelf-everyday">
          <span class="sn-jg-nav__txt--desk">Everyday Cars ({{ everyday_count }})</span>
          <span class="sn-jg-nav__txt--mob">Everyday Cars &middot; {{ everyday_count }}</span>
        </a>
        <a class="sn-jg-nav__item" href="#shelf-multitool" data-jg-anchor="#shelf-multitool">
          <span class="sn-jg-nav__txt--desk">2-in-1 Multi-Tool ({{ multitool_count }})</span>
          <span class="sn-jg-nav__txt--mob">2-in-1 Tools &middot; {{ multitool_count }}</span>
        </a>
        <a class="sn-jg-nav__item" href="#shelf-heavy" data-jg-anchor="#shelf-heavy">
          <span class="sn-jg-nav__txt--desk">Heavy-Duty ({{ heavy_count }})</span>
          <span class="sn-jg-nav__txt--mob">Heavy-Duty &middot; {{ heavy_count }}</span>
        </a>
        <a class="sn-jg-nav__item sn-jg-nav__item--compare" href="#jump-compare" data-jg-anchor="#jump-compare" data-jg-open-compare>
          <span>Compare All 7 &#8600;</span>
        </a>
      </div>
    </div>
  </nav>

  <div class="container sn-jg-body">
    <div class="sn-jg-shelves">
      {%- for shelf_num in (1..3) -%}
        {%- liquid
          case shelf_num
            when 1
              assign shelf_id = 'shelf-everyday'
              assign shelf_key = 'everyday'
              assign shelf_heading = section.settings.shelf1_heading
              assign shelf_count = everyday_count
              assign grid_modifier = 'sn-jg-grid--3'
              assign is_wide = false
            when 2
              assign shelf_id = 'shelf-multitool'
              assign shelf_key = 'multitool'
              assign shelf_heading = section.settings.shelf2_heading
              assign shelf_count = multitool_count
              assign grid_modifier = 'sn-jg-grid--3'
              assign is_wide = false
            else
              assign shelf_id = 'shelf-heavy'
              assign shelf_key = 'heavy'
              assign shelf_heading = section.settings.shelf3_heading
              assign shelf_count = heavy_count
              assign grid_modifier = 'sn-jg-grid--2'
              assign is_wide = true
          endcase
        -%}

        <section class="sn-jg-shelf" id="{{ shelf_id }}" data-jg-shelf="{{ shelf_key }}">
          <header class="sn-jg-shelf__head">
            <h2>{{ shelf_heading | escape }}</h2>
            <span class="sn-jg-shelf__count">{{ shelf_count }} models</span>
          </header>

          <div class="sn-jg-grid {{ grid_modifier }}">
            {%- for block in section.blocks -%}
              {%- if block.type != 'family' -%}{% continue %}{%- endif -%}
              {%- liquid
                assign show_in_shelf = false
                if shelf_key == 'heavy'
                  if block.settings.group == 'heavy' or block.settings.also_heavy_duty
                    assign show_in_shelf = true
                  endif
                elsif block.settings.group == shelf_key
                  assign show_in_shelf = true
                endif
              -%}
              {%- unless show_in_shelf -%}{% continue %}{%- endunless -%}

              {%- assign family_product = all_products[block.settings.product_handle] -%}
              {%- if block.settings.preview_only and family_product == blank and request.design_mode == false -%}{% continue %}{%- endif -%}
              {%- assign family_url = family_product.url | default: '/products/' | append: block.settings.product_handle -%}

              {%- liquid
                assign default_variant = family_product.selected_or_first_available_variant
                assign red_variant = nil
                assign orange_variant = nil
                if block.settings.enable_color_swatches and family_product != blank
                  for v in family_product.variants
                    if v.option1 == '8000mAh' and v.option3 == '1 unit' and v.available
                      if v.option2 == 'Red' and red_variant == nil
                        assign red_variant = v
                      elsif v.option2 == 'Orange' and orange_variant == nil
                        assign orange_variant = v
                      endif
                    endif
                  endfor
                  if red_variant != nil
                    assign default_variant = red_variant
                  elsif orange_variant != nil
                    assign default_variant = orange_variant
                  endif
                endif

                assign active_price = default_variant.price | default: family_product.price
                assign active_compare = default_variant.compare_at_price | default: family_product.compare_at_price
                assign has_sale = false
                assign discount_pct = 0
                if active_compare > active_price and active_compare > 0
                  assign has_sale = true
                  assign diff_price = active_compare | minus: active_price
                  assign discount_pct = diff_price | times: 100.0 | divided_by: active_compare | round
                endif

                assign is_available = false
                if default_variant != blank and default_variant.available
                  assign is_available = true
                elsif family_product != blank and family_product.available and default_variant == blank
                  assign is_available = true
                endif

                assign primary_img_url = block.settings.asset_name | asset_url
                assign alt_img_url = block.settings.alt_asset_name | asset_url
                assign model_upper = block.settings.model_code | upcase | strip
              -%}

              <article class="sn-jg-card{% if is_wide %} sn-jg-card--wide{% endif %}" data-jg-card {{ block.shopify_attributes }}>
                <div class="sn-jg-card__stage">
                  {%- if block.settings.badge != blank -%}
                    <span class="sn-jg-badge">{{ block.settings.badge | escape }}</span>
                  {%- endif -%}
                  {%- if has_sale and discount_pct > 0 -%}
                    <span class="sn-jg-save">{{ discount_pct }}% OFF</span>
                  {%- endif -%}
                  <a href="{{ family_url }}" data-jg-product-link aria-label="{{ block.settings.title | default: family_product.title | escape }}">
                    <img
                      src="{{ primary_img_url }}"
                      alt="{{ block.settings.image_alt | default: block.settings.title | escape }}"
                      width="800"
                      height="800"
                      loading="lazy"
                      data-jg-card-img
                    >
                  </a>
                  <a class="sn-jg-quick-eye" href="{{ family_url }}" data-jg-product-link aria-label="View {{ block.settings.title | default: family_product.title | escape }} specs" title="View Product Specs">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                </div>

                <div class="sn-jg-card__body">
                  <div class="sn-jg-feat-icons">
                    {%- case model_upper -%}
                      {%- when 'A20' -%}
                        <span class="sn-jg-feat-icon" title="1,500A Peak" aria-label="1,500A Peak">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                        </span>
                        <span class="sn-jg-feat-icon" title="USB Output" aria-label="USB Output">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="4" width="10" height="7" rx="1"/><path d="M9 11v4a3 3 0 0 0 6 0v-4M12 18v3"/></svg>
                        </span>
                        <span class="sn-jg-feat-icon" title="LED Flashlight" aria-label="LED Flashlight">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                        </span>
                      {%- when 'U23' -%}
                        <span class="sn-jg-feat-icon" title="1,500A Peak" aria-label="1,500A Peak">
