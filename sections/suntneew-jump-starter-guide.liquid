{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --jg-ink: #182330;
    --jg-muted: #5a6674;
    --jg-line: rgb(24 35 48 / .11);
    --jg-accent: #e95416;
    --jg-accent-hover: #cf470f;
    --jg-sale: #d92d20;
    --jg-bg: #f5f6f8;
    background: var(--jg-bg);
    color: var(--jg-ink);
  }

  #shopify-section-{{ section.id }} .sn-jg-hero {
    position: relative;
    overflow: hidden;
    background: #101c2b;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-jg-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .42;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(14 23 36 / .95) 0%, rgb(14 23 36 / .78) 55%, rgb(14 23 36 / .32) 100%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(24px, 3.2vw, 42px);
  }

  #shopify-section-{{ section.id }} .sn-jg-hero__eyebrow {
    margin: 0 0 8px;
    color: #ff9463;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-jg-hero h1 {
    max-width: 680px;
    margin: 0 0 10px;
    color: #fff;
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 850;
    letter-spacing: -.03em;
    line-height: 1.06;
  }

  #shopify-section-{{ section.id }} .sn-jg-hero__sub {
    max-width: 620px;
    margin: 0;
    color: rgb(255 255 255 / .84);
    font-size: 14px;
    line-height: 1.55;
  }

  /* Quick Nav: desktop single-row bar, mobile 2x2 zero-scroll tap grid */
  #shopify-section-{{ section.id }} .sn-jg-nav {
    background: #fff;
    border-bottom: 1px solid var(--jg-line);
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding-block: 14px;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 16px;
    border: 1px solid var(--jg-line);
    border-radius: 999px;
    background: #f4f6f8;
    color: var(--jg-ink);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition: background .16s ease, border-color .16s ease, color .16s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__item:first-child {
    background: var(--jg-ink);
    border-color: var(--jg-ink);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__item:hover,
  #shopify-section-{{ section.id }} .sn-jg-nav__item:focus-visible {
    border-color: var(--jg-accent);
    color: var(--jg-accent);
    outline: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__item:first-child:hover,
  #shopify-section-{{ section.id }} .sn-jg-nav__item:first-child:focus-visible {
    background: var(--jg-accent);
    border-color: var(--jg-accent);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__sub {
    color: var(--jg-muted);
    font-size: 11px;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .sn-jg-nav__item:first-child .sn-jg-nav__sub {
    color: rgb(255 255 255 / .78);
  }

  /* Main body & shelves */
  #shopify-section-{{ section.id }} .sn-jg-body {
    padding-block: clamp(28px, 3.8vw, 48px) clamp(44px, 5vw, 72px);
  }

  #shopify-section-{{ section.id }} .sn-jg-shelves {
    display: grid;
    gap: clamp(34px, 4.5vw, 52px);
  }

  #shopify-section-{{ section.id }} .sn-jg-shelf {
    scroll-margin-top: 88px;
  }

  #shopify-section-{{ section.id }} .sn-jg-shelf__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 24px;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .sn-jg-shelf__kicker {
    margin: 0 0 4px;
    color: var(--jg-accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-jg-shelf__head h2 {
    margin: 0;
    color: var(--jg-ink);
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 850;
    letter-spacing: -.03em;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .sn-jg-shelf__desc {
    max-width: 440px;
    margin: 0;
    color: var(--jg-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .sn-jg-grid {
    display: grid;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .sn-jg-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #shopify-section-{{ section.id }} .sn-jg-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* Equal-height Product Card */
  #shopify-section-{{ section.id }} .sn-jg-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--jg-line);
    border-radius: 14px;
    background: #fff;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-card:hover {
    transform: translateY(-2px);
    border-color: rgb(24 35 48 / .24);
    box-shadow: 0 12px 28px rgb(24 35 48 / .08);
  }

  #shopify-section-{{ section.id }} .sn-jg-card--wide {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
  }

  #shopify-section-{{ section.id }} .sn-jg-card__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    padding: 16px;
    background: #fff;
    border-bottom: 1px solid rgb(24 35 48 / .07);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-card--wide .sn-jg-card__stage {
    height: 100%;
    border-bottom: 0;
    border-right: 1px solid rgb(24 35 48 / .07);
  }

  #shopify-section-{{ section.id }} .sn-jg-card__stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .sn-jg-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .02em;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .sn-jg-badge--amber { background: #fef3c7; border-color: #fde68a; color: #78350f; }
  #shopify-section-{{ section.id }} .sn-jg-badge--slate { background: #f1f5f9; border-color: #e2e8f0; color: #1e293b; }
  #shopify-section-{{ section.id }} .sn-jg-badge--navy { background: #182330; border-color: #182330; color: #fff; }
  #shopify-section-{{ section.id }} .sn-jg-badge--teal { background: #e0f2fe; border-color: #bae6fd; color: #0c4a6e; }
  #shopify-section-{{ section.id }} .sn-jg-badge--orange { background: #fff1eb; border-color: #f9c9b6; color: #c84300; }

  #shopify-section-{{ section.id }} .sn-jg-save {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--jg-sale);
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .sn-jg-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 16px 18px 18px;
  }

  #shopify-section-{{ section.id }} .sn-jg-card__eyebrow {
    margin: 0 0 4px;
    color: var(--jg-accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-jg-card__title {
    display: -webkit-box;
    min-height: 40px;
    margin: 0 0 5px;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -.015em;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .sn-jg-card--wide .sn-jg-card__title {
    min-height: 0;
    font-size: 17px;
  }

  #shopify-section-{{ section.id }} .sn-jg-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-card__title a:hover {
    color: var(--jg-accent);
  }

  #shopify-section-{{ section.id }} .sn-jg-card__summary {
    display: -webkit-box;
    min-height: 36px;
    margin: 0 0 12px;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    color: var(--jg-muted);
    font-size: 12px;
    line-height: 1.48;
  }

  #shopify-section-{{ section.id }} .sn-jg-card--wide .sn-jg-card__summary {
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .sn-jg-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    margin: 0 0 10px;
    padding: 8px 6px;
    border-radius: 8px;
    background: #f4f6f8;
    list-style: none;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sn-jg-metrics li {
    padding-inline: 4px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .sn-jg-metrics li:nth-child(2) {
    border-inline: 1px solid rgb(24 35 48 / .1);
  }

  #shopify-section-{{ section.id }} .sn-jg-metrics span {
    display: block;
    color: var(--jg-muted);
    font-size: 10px;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .sn-jg-metrics strong {
    display: block;
    margin-top: 2px;
    overflow: hidden;
    color: var(--jg-ink);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sn-jg-meta-row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 26px;
    margin-bottom: 8px;
    color: var(--jg-muted);
    font-size: 11px;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .sn-jg-swatch {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border: 1px solid rgb(24 35 48 / .16);
    border-radius: 999px;
    background: #fff;
    color: var(--jg-muted);
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .sn-jg-swatch[aria-pressed="true"] {
    border-color: var(--jg-ink);
    background: #f1f5f9;
    color: var(--jg-ink);
  }

  #shopify-section-{{ section.id }} .sn-jg-swatch__dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .sn-jg-card__footer {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid rgb(24 35 48 / .08);
  }

  #shopify-section-{{ section.id }} .sn-jg-price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .sn-jg-prices {
    display: flex;
    align-items: baseline;
    gap: 7px;
  }

  #shopify-section-{{ section.id }} .sn-jg-price {
    color: var(--jg-ink);
    font-size: 19px;
    font-weight: 900;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .sn-jg-compare {
    color: #8a94a0;
    font-size: 12px;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .sn-jg-stock {
    color: #047857;
    font-size: 11px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .sn-jg-stock--out {
    color: #b91c1c;
  }

  #shopify-section-{{ section.id }} .sn-jg-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .sn-jg-form {
    display: contents;
  }

  #shopify-section-{{ section.id }} .sn-jg-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 9px 14px;
    border: 0;
    border-radius: 8px;
    background: var(--jg-ink);
    color: #fff;
    font: inherit;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    transition: background .16s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-btn-primary:hover:not(:disabled),
  #shopify-section-{{ section.id }} .sn-jg-btn-primary:focus-visible:not(:disabled) {
    background: var(--jg-accent);
    outline: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-btn-primary:disabled {
    opacity: .5;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .sn-jg-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 9px 13px;
    border: 1px solid rgb(24 35 48 / .2);
    border-radius: 8px;
    background: #fff;
    color: var(--jg-ink);
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
    transition: border-color .16s ease;
  }

  #shopify-section-{{ section.id }} .sn-jg-btn-secondary:hover,
  #shopify-section-{{ section.id }} .sn-jg-btn-secondary:focus-visible {
    border-color: var(--jg-ink);
    outline: none;
  }

  /* Collapsible Bottom Spec Matrix */
  #shopify-section-{{ section.id }} .sn-jg-compare-box {
    scroll-margin-top: 88px;
    border: 1px solid var(--jg-line);
    border-radius: 14px;
    background: #fff;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sn-jg-compare-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    border: 0;
    background: #fff;
    color: var(--jg-ink);
    text-align: left;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .sn-jg-compare-toggle:hover {
    background: #f8fafc;
  }

  #shopify-section-{{ section.id }} .sn-jg-compare-toggle__eyebrow {
    display: block;
    color: var(--jg-accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-jg-compare-toggle__title {
    display: block;
    margin-top: 2px;
    font-size: 16px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-jg-compare-toggle__pill {
    flex: none;
    padding: 7px 13px;
    border-radius: 999px;
    background: #f1f5f9;
    font-size: 12px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sn-jg-table-wrap {
    overflow-x: auto;
    border-top: 1px solid var(--jg-line);
  }

  #shopify-section-{{ section.id }} .sn-jg-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 12px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .sn-jg-table th,
  #shopify-section-{{ section.id }} .sn-jg-table td {
    padding: 12px 16px;
    border-bottom: 1px solid rgb(24 35 48 / .07);
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sn-jg-table th {
    background: #f8fafc;
    color: var(--jg-muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-jg-table tr:last-child td {
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .sn-jg-table__link {
    display: inline-flex;
    align-items: center;
    padding: 6px 11px;
    border-radius: 6px;
    background: var(--jg-ink);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sn-jg-table__link:hover {
    background: var(--jg-accent);
  }

  #shopify-section-{{ section.id }} .sn-jg-footnote {
    margin: 0;
    padding: 12px 16px;
    border-top: 1px solid rgb(24 35 48 / .07);
    color: var(--jg-muted);
    font-size: 11px;
    line-height: 1.5;
  }

  /* Floating mobile back-to-categories helper */
  #shopify-section-{{ section.id }} .sn-jg-back-top {
    display: none;
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .sn-jg-grid--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .sn-jg-card--wide {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .sn-jg-card--wide .sn-jg-card__stage {
      border-right: 0;
      border-bottom: 1px solid rgb(24 35 48 / .07);
    }
  }

  @media screen and (max-width: 699px) {
    /* 2x2 full-width mobile tap grid: zero horizontal scroll */
    #shopify-section-{{ section.id }} .sn-jg-nav__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      padding-block: 12px;
    }

    #shopify-section-{{ section.id }} .sn-jg-nav__item {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 2px;
      min-height: 54px;
      padding: 9px 12px;
      border-radius: 10px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .sn-jg-nav__sub {
      display: block;
      font-size: 11px;
    }

    #shopify-section-{{ section.id }} .sn-jg-grid--3,
    #shopify-section-{{ section.id }} .sn-jg-grid--2 {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #shopify-section-{{ section.id }} .sn-jg-card__stage {
      aspect-ratio: 4 / 3;
      padding: 12px;
    }

    #shopify-section-{{ section.id }} .sn-jg-card__title,
    #shopify-section-{{ section.id }} .sn-jg-card__summary {
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .sn-jg-compare-toggle {
      padding: 14px 16px;
    }

    #shopify-section-{{ section.id }} .sn-jg-back-top.is-visible {
      position: fixed;
      right: 16px;
      bottom: 20px;
      z-index: 30;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      min-height: 40px;
      padding: 8px 14px;
      border: 1px solid rgb(255 255 255 / .2);
      border-radius: 999px;
      background: rgb(24 35 48 / .92);
      color: #fff;
      font-size: 12px;
      font-weight: 800;
      text-decoration: none;
      box-shadow: 0 8px 24px rgb(0 0 0 / .24);
    }
  }
</style>

<section class="sn-jg" id="jump-starters-top" data-jump-guide>
  <header class="sn-jg-hero">
    {%- if section.settings.hero_asset != blank -%}
      <img
        class="sn-jg-hero__bg"
        src="{{ section.settings.hero_asset | asset_url }}"
        alt=""
        width="2098"
        height="749"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
    <div class="sn-jg-hero__scrim" aria-hidden="true"></div>
    <div class="container sn-jg-hero__inner">
      <p class="sn-jg-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p class="sn-jg-hero__sub">{{ section.settings.intro | escape }}</p>
    </div>
  </header>

  <nav class="sn-jg-nav" id="jump-categories" aria-label="Jump starter categories">
    <div class="container">
      <div class="sn-jg-nav__grid">
        <a class="sn-jg-nav__item" href="#shelf-everyday" data-jg-anchor="#shelf-everyday">
          <span>Everyday Cars</span>
          <span class="sn-jg-nav__sub">3 models · From $39.99</span>
        </a>
        <a class="sn-jg-nav__item" href="#shelf-multitool" data-jg-anchor="#shelf-multitool">
          <span>2-in-1 Multi-Tool</span>
          <span class="sn-jg-nav__sub">3 models · Air / OBD2</span>
        </a>
        <a class="sn-jg-nav__item" href="#shelf-heavy" data-jg-anchor="#shelf-heavy">
          <span>Heavy-Duty Diesel</span>
          <span class="sn-jg-nav__sub">2 models · 4000A–5000A</span>
        </a>
        <a class="sn-jg-nav__item" href="#jump-compare" data-jg-anchor="#jump-compare" data-jg-open-compare>
          <span>Compare All 7</span>
          <span class="sn-jg-nav__sub">Side-by-side specs</span>
        </a>
      </div>
    </div>
  </nav>

  <div class="container sn-jg-body">
    <div class="sn-jg-shelves">
      {%- for shelf_num in (1..3) -%}
        {%- liquid
          case shelf_num
            when 1
              assign shelf_id = 'shelf-everyday'
              assign shelf_key = 'everyday'
              assign shelf_kicker = section.settings.shelf1_kicker
              assign shelf_heading = section.settings.shelf1_heading
              assign shelf_desc = section.settings.shelf1_desc
              assign grid_modifier = 'sn-jg-grid--3'
              assign is_wide = false
            when 2
              assign shelf_id = 'shelf-multitool'
              assign shelf_key = 'multitool'
              assign shelf_kicker = section.settings.shelf2_kicker
              assign shelf_heading = section.settings.shelf2_heading
              assign shelf_desc = section.settings.shelf2_desc
              assign grid_modifier = 'sn-jg-grid--3'
              assign is_wide = false
            else
              assign shelf_id = 'shelf-heavy'
              assign shelf_key = 'heavy'
              assign shelf_kicker = section.settings.shelf3_kicker
              assign shelf_heading = section.settings.shelf3_heading
              assign shelf_desc = section.settings.shelf3_desc
              assign grid_modifier = 'sn-jg-grid--2'
              assign is_wide = true
          endcase
        -%}

        <section class="sn-jg-shelf" id="{{ shelf_id }}">
          <header class="sn-jg-shelf__head">
            <div>
              <p class="sn-jg-shelf__kicker">{{ shelf_kicker | escape }}</p>
              <h2>{{ shelf_heading | escape }}</h2>
            </div>
            {%- if shelf_desc != blank -%}
              <p class="sn-jg-shelf__desc">{{ shelf_desc | escape }}</p>
            {%- endif -%}
          </header>

          <div class="sn-jg-grid {{ grid_modifier }}">
            {%- for block in section.blocks -%}
              {%- if block.type != 'family' -%}{% continue %}{%- endif -%}
              {%- liquid
                assign show_in_shelf = false
                if shelf_key == 'heavy'
                  if block.settings.group == 'heavy' or block.settings.also_heavy_duty
                    assign show_in_shelf = true
                  endif
                elsif block.settings.group == shelf_key
                  assign show_in_shelf = true
                endif
              -%}
              {%- unless show_in_shelf -%}{% continue %}{%- endunless -%}

              {%- assign family_product = all_products[block.settings.product_handle] -%}
              {%- if block.settings.preview_only and family_product == blank and request.design_mode == false -%}{% continue %}{%- endif -%}
              {%- assign family_url = family_product.url | default: '/products/' | append: block.settings.product_handle -%}

              {%- liquid
                assign default_variant = family_product.selected_or_first_available_variant
                assign red_variant = nil
                assign orange_variant = nil
                if block.settings.enable_color_swatches and family_product != blank
                  for v in family_product.variants
                    if v.option1 == '8000mAh' and v.option3 == '1 unit' and v.available
                      if v.option2 == 'Red' and red_variant == nil
                        assign red_variant = v
                      elsif v.option2 == 'Orange' and orange_variant == nil
                        assign orange_variant = v
                      endif
                    endif
                  endfor
                  if red_variant != nil
                    assign default_variant = red_variant
                  elsif orange_variant != nil
                    assign default_variant = orange_variant
                  endif
                endif

                assign active_price = default_variant.price | default: family_product.price
                assign active_compare = default_variant.compare_at_price | default: family_product.compare_at_price
                assign discount_pct = 0
                if active_compare > active_price and active_compare > 0
                  assign diff_price = active_compare | minus: active_price
                  assign discount_pct = diff_price | times: 100 | divided_by: active_compare
                endif

                assign is_available = false
                if default_variant != blank and default_variant.available
                  assign is_available = true
                elsif family_product != blank and family_product.available and default_variant == blank
                  assign is_available = true
                endif

                assign primary_img_url = block.settings.asset_name | asset_url
                assign alt_img_url = block.settings.alt_asset_name | asset_url
              -%}

              <article class="sn-jg-card{% if is_wide %} sn-jg-card--wide{% endif %}" data-jg-card {{ block.shopify_attributes }}>
                <a class="sn-jg-card__stage" href="{{ family_url }}" data-jg-product-link>
                  {%- if block.settings.badge != blank -%}
                    <span class="sn-jg-badge sn-jg-badge--{{ block.settings.badge_tone | default: 'slate' }}">{{ block.settings.badge | escape }}</span>
                  {%- endif -%}
                  {%- if discount_pct > 0 -%}
                    <span class="sn-jg-save">-{{ discount_pct }}%</span>
                  {%- endif -%}
                  <img
                    src="{{ primary_img_url }}"
                    alt="{{ block.settings.image_alt | default: block.settings.title | escape }}"
                    width="800"
                    height="800"
                    loading="lazy"
                    data-jg-card-img
                  >
                </a>

                <div class="sn-jg-card__body">
                  <p class="sn-jg-card__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                  <h3 class="sn-jg-card__title">
                    <a href="{{ family_url }}" data-jg-product-link>{{ block.settings.title | default: family_product.title | escape }}</a>
                  </h3>
                  <p class="sn-jg-card__summary">{{ block.settings.summary | escape }}</p>

                  <ul class="sn-jg-metrics" role="list">
                    <li><span>Peak</span><strong>{{ block.settings.spec_peak | escape }}</strong></li>
                    <li><span>Gas / Diesel</span><strong>{{ block.settings.spec_fit | escape }}</strong></li>
                    <li><span>Feature</span><strong>{{ block.settings.spec_highlight | escape }}</strong></li>
                  </ul>

                  <div class="sn-jg-meta-row">
                    {%- if block.settings.enable_color_swatches and red_variant != nil and orange_variant != nil -%}
                      <span>Color:</span>
                      <button
                        type="button"
                        class="sn-jg-swatch"
                        aria-pressed="true"
                        data-jg-swatch
                        data-variant-id="{{ red_variant.id }}"
                        data-variant-img="{{ primary_img_url }}"
                        data-variant-url="{{ red_variant.url | default: family_url }}"
                      >
                        <span class="sn-jg-swatch__dot" style="background:#d92d20"></span>Red
                      </button>
                      <button
                        type="button"
                        class="sn-jg-swatch"
                        aria-pressed="false"
                        data-jg-swatch
                        data-variant-id="{{ orange_variant.id }}"
                        data-variant-img="{{ alt_img_url }}"
                        data-variant-url="{{ orange_variant.url | default: family_url }}"
                      >
                        <span class="sn-jg-swatch__dot" style="background:#e95416"></span>Orange
                      </button>
                    {%- else -%}
                      <span>{{ block.settings.meta_note | escape }}</span>
                    {%- endif -%}
                  </div>

                  <div class="sn-jg-card__footer">
                    {%- if active_price != blank -%}
                      <div class="sn-jg-price-row">
                        <div class="sn-jg-prices">
                          <span class="sn-jg-price">{{ active_price | money }}</span>
                          {%- if active_compare > active_price -%}
                            <span class="sn-jg-compare">{{ active_compare | money }}</span>
                          {%- endif -%}
                        </div>
                        <span class="sn-jg-stock{% unless is_available %} sn-jg-stock--out{% endunless %}">
                          {%- if is_available -%}In Stock{%- else -%}Sold Out{%- endif -%}
                        </span>
                      </div>
                    {%- endif -%}

                    <div class="sn-jg-actions">
                      {%- if family_product != blank and default_variant != blank -%}
                        {%- form 'product', family_product, is: 'product-form', class: 'sn-jg-form' -%}
                          <input type="hidden" name="id" value="{{ default_variant.id }}" data-jg-variant-input>
                          <button type="submit" class="sn-jg-btn-primary"{% unless is_available %} disabled{% endunless %}>
                            {%- if is_available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
                          </button>
                        {%- endform -%}
                        <a class="sn-jg-btn-secondary" href="{{ family_url }}" data-jg-product-link>Details</a>
                      {%- else -%}
                        <a class="sn-jg-btn-primary" href="{{ family_url }}">View Details</a>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
        </section>
      {%- endfor -%}

      <!-- Collapsible Side-by-Side Spec Compare Table -->
      <section class="sn-jg-compare-box" id="jump-compare">
        <button type="button" class="sn-jg-compare-toggle" aria-expanded="false" aria-controls="jump-compare-panel" data-jg-compare-toggle>
          <span>
            <span class="sn-jg-compare-toggle__eyebrow">SPEC MATRIX</span>
            <span class="sn-jg-compare-toggle__title">{{ section.settings.compare_heading | escape }}</span>
          </span>
          <span class="sn-jg-compare-toggle__pill" data-jg-compare-label>Expand Table +</span>
        </button>

        <div id="jump-compare-panel" hidden data-jg-compare-panel>
          <div class="sn-jg-table-wrap">
            <table class="sn-jg-table">
              <thead>
                <tr>
                  <th scope="col">Model</th>
                  <th scope="col">Price</th>
                  <th scope="col">Capacity</th>
                  <th scope="col">Start / Peak</th>
                  <th scope="col">Max Engine</th>
                  <th scope="col">Key Feature</th>
                  <th scope="col">Action</th>
                </tr>
              </thead>
              <tbody>
                {%- for block in section.blocks -%}
                  {%- if block.type != 'family' -%}{% continue %}{%- endif -%}
                  {%- assign family_product = all_products[block.settings.product_handle] -%}
                  {%- if block.settings.preview_only and family_product == blank and request.design_mode == false -%}{% continue %}{%- endif -%}
                  {%- assign family_url = family_product.url | default: '/products/' | append: block.settings.product_handle -%}
                  {%- assign row_variant = family_product.selected_or_first_available_variant -%}
                  <tr>
                    <td><strong>{{ block.settings.model_code | default: block.settings.title | escape }}</strong></td>
                    <td>
                      {%- if row_variant.price != blank -%}
                        <strong>{{ row_variant.price | money }}</strong>
                        {%- if row_variant.compare_at_price > row_variant.price -%}
                          <span class="sn-jg-compare">{{ row_variant.compare_at_price | money }}</span>
                        {%- endif -%}
                      {%- else -%}
                        —
                      {%- endif -%}
                    </td>
                    <td>{{ block.settings.spec_capacity | escape }}</td>
                    <td>{{ block.settings.spec_start | escape }} / {{ block.settings.spec_peak | escape }}</td>
                    <td>{{ block.settings.spec_fit | escape }}</td>
                    <td>{{ block.settings.spec_highlight | escape }}</td>
                    <td><a class="sn-jg-table__link" href="{{ family_url }}">View</a></td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {%- if section.settings.table_note != blank -%}
            <p class="sn-jg-footnote">{{ section.settings.table_note | escape }}</p>
          {%- endif -%}
        </div>
      </section>
    </div>
  </div>

  <a class="sn-jg-back-top" href="#jump-categories" data-jg-back-top aria-label="Back to jump starter categories">&uarr; Categories</a>
</section>

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-jump-guide]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    // Color swatch switcher (e.g. A20 Red / Orange)
    root.querySelectorAll('[data-jg-card]').forEach((card) => {
      const swatches = [...card.querySelectorAll('[data-jg-swatch]')];
      if (!swatches.length) return;
      const img = card.querySelector('[data-jg-card-img]');
      const variantInput = card.querySelector('[data-jg-variant-input]');
      const links = [...card.querySelectorAll('[data-jg-product-link]')];

      swatches.forEach((btn) => {
        btn.addEventListener('click', () => {
          swatches.forEach((item) => item.setAttribute('aria-pressed', item === btn ? 'true' : 'false'));
          if (img && btn.dataset.variantImg) img.src = btn.dataset.variantImg;
          if (variantInput && btn.dataset.variantId) variantInput.value = btn.dataset.variantId;
          if (btn.dataset.variantUrl) {
            links.forEach((link) => { link.href = btn.dataset.variantUrl; });
          }
        });
      });
    });

    // Collapsible comparison table
    const compareToggle = root.querySelector('[data-jg-compare-toggle]');
    const comparePanel = root.querySelector('[data-jg-compare-panel]');
    const compareLabel = root.querySelector('[data-jg-compare-label]');

    const setCompareOpen = (open) => {
      if (!compareToggle || !comparePanel) return;
      compareToggle.setAttribute('aria-expanded', String(open));
      comparePanel.hidden = !open;
      if (compareLabel) compareLabel.textContent = open ? 'Hide Table −' : 'Expand Table +';
    };

    if (compareToggle) {
      compareToggle.addEventListener('click', () => {
        const isOpen = compareToggle.getAttribute('aria-expanded') === 'true';
        setCompareOpen(!isOpen);
      });
    }

    // Quick-jump links (and auto-expand compare table when clicking Compare All 7)
    root.querySelectorAll('[data-jg-anchor]').forEach((anchor) => {
      anchor.addEventListener('click', (event) => {
        const targetSelector = anchor.dataset.jgAnchor;
        const target = targetSelector ? root.querySelector(targetSelector) : null;
        if (!target) return;
        event.preventDefault();
        if (anchor.hasAttribute('data-jg-open-compare')) {
          setCompareOpen(true);
        }
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // Floating mobile back-to-categories helper
    const nav = root.querySelector('#jump-categories');
    const backTop = root.querySelector('[data-jg-back-top]');
    if (nav && backTop) {
      backTop.addEventListener('click', (event) => {
        event.preventDefault();
        nav.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const passedTop = !entry.isIntersecting && entry.boundingClientRect.top < 0;
            backTop.classList.toggle('is-visible', passedTop);
          });
        }, { threshold: 0 });
        observer.observe(nav);
      }
    }
  })();
</script>

