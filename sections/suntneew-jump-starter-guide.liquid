{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --jump-guide-ink: #182330;
    --jump-guide-muted: #66727e;
    --jump-guide-line: rgb(24 35 48 / .14);
    --jump-guide-accent: #e9653b;
    background: #f4f6f7;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide {
    padding-block: clamp(34px, 5vw, 76px);
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__intro {
    display: grid;
    gap: 12px;
    max-width: 760px;
    margin-bottom: clamp(24px, 4vw, 48px);
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__eyebrow {
    margin: 0;
    color: var(--jump-guide-accent);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .16em;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__intro h2 {
    max-width: 740px;
    margin: 0;
    color: var(--jump-guide-ink);
    font-size: clamp(30px, 4vw, 56px);
    letter-spacing: -.045em;
    line-height: .98;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__intro p:last-child {
    max-width: 660px;
    margin: 0;
    color: var(--jump-guide-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__tool {
    display: grid;
    gap: clamp(24px, 3vw, 40px);
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--jump-guide-line);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 12px 32px rgb(24 35 48 / .06);
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    color: var(--jump-guide-ink);
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__table th,
  #shopify-section-{{ section.id }} .suntneew-jump-guide__table td {
    padding: 14px 16px;
    border-bottom: 1px solid rgb(24 35 48 / .09);
    text-align: start;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__table th {
    color: var(--jump-guide-muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .11em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__table tr:last-child td {
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__table tr[data-selected="true"] {
    background: #fff6f1;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__table td:first-child {
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__fit-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 7px 11px;
    border: 1px solid rgb(233 101 59 / .42);
    border-radius: 999px;
    background: #fff;
    color: var(--jump-guide-accent);
    font: inherit;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__fit-button:hover,
  #shopify-section-{{ section.id }} .suntneew-jump-guide__fit-button:focus-visible,
  #shopify-section-{{ section.id }} .suntneew-jump-guide__fit-button[aria-pressed="true"] {
    border-color: var(--jump-guide-accent);
    background: var(--jump-guide-accent);
    color: #fff;
    outline: none;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__table-note {
    margin: 0;
    padding: 12px 16px 14px;
    border-top: 1px solid rgb(24 35 48 / .09);
    color: var(--jump-guide-muted);
    font-size: 11px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__catalog-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__catalog-head h3 {
    margin: 0;
    color: var(--jump-guide-ink);
    font-size: clamp(24px, 3vw, 38px);
    letter-spacing: -.04em;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__catalog-head p {
    max-width: 560px;
    margin: 8px 0 0;
    color: var(--jump-guide-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__view-switcher {
    display: inline-flex;
    flex: none;
    gap: 3px;
    padding: 3px;
    border: 1px solid var(--jump-guide-line);
    border-radius: 999px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__view-button {
    min-height: 32px;
    padding: 6px 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--jump-guide-muted);
    font: inherit;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__view-button[aria-pressed="true"] {
    background: var(--jump-guide-ink);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__cards.is-list {
    grid-template-columns: 1fr;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--jump-guide-line);
    border-radius: 14px;
    background: #fff;
    color: var(--jump-guide-ink);
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__media {
    display: grid;
    min-height: 220px;
    place-items: center;
    overflow: hidden;
    background: #eef1f3;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__body {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 18px;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__eyebrow {
    margin: 0;
    color: var(--jump-guide-accent);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .12em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card h4 {
    margin: 0;
    font-size: 19px;
    letter-spacing: -.025em;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__summary {
    min-height: 42px;
    margin: 0;
    color: var(--jump-guide-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__specs li {
    display: grid;
    gap: 2px;
    padding: 9px;
    border-radius: 8px;
    background: #f4f6f7;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__specs strong {
    font-size: 13px;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__specs span {
    color: var(--jump-guide-muted);
    font-size: 10px;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__variants {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__variant {
    padding: 5px 7px;
    border: 1px solid var(--jump-guide-line);
    border-radius: 5px;
    color: var(--jump-guide-muted);
    font-size: 10px;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 42px;
    padding: 10px 13px;
    border-radius: 7px;
    background: var(--jump-guide-ink);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-card__link:hover,
  #shopify-section-{{ section.id }} .suntneew-jump-card__link:focus-visible {
    background: var(--jump-guide-accent);
    outline: none;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__empty {
    display: none;
    margin: 14px 0 0;
    color: var(--jump-guide-muted);
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-guide__empty.is-visible {
    display: block;
  }

  #shopify-section-{{ section.id }} .suntneew-jump-catalog--list .suntneew-jump-card {
    grid-template-columns: 180px minmax(0, 1fr);
  }

  #shopify-section-{{ section.id }} .suntneew-jump-catalog--list .suntneew-jump-card__media {
    min-height: 100%;
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .suntneew-jump-guide__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .suntneew-jump-guide__catalog-head {
      align-items: start;
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .suntneew-jump-guide__cards {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .suntneew-jump-catalog--list .suntneew-jump-card {
      grid-template-columns: 120px minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .suntneew-jump-catalog--list .suntneew-jump-card__media {
      min-height: 100%;
    }

    #shopify-section-{{ section.id }} .suntneew-jump-card__body {
      padding: 14px;
    }
  }
</style>

<section class="suntneew-jump-guide" data-jump-guide>
  <div class="container">
    <div class="suntneew-jump-guide__intro">
      <p class="suntneew-jump-guide__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.intro | escape }}</p>
    </div>

    <div class="suntneew-jump-guide__tool">
      <div class="suntneew-jump-guide__table-wrap">
        <table class="suntneew-jump-guide__table">
          <thead>
            <tr>
              <th scope="col">Capacity</th>
              <th scope="col">Starting current</th>
              <th scope="col">Peak current</th>
              <th scope="col">Gasoline reference</th>
              <th scope="col">Diesel reference</th>
              <th scope="col">Compare</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type != 'guide_row' -%}{% continue %}{%- endif -%}
              <tr data-guide-row data-capacity="{{ block.settings.capacity | escape }}">
                <td>{{ block.settings.capacity | escape }}mAh</td>
                <td>{{ block.settings.start_current | escape }}A</td>
                <td>{{ block.settings.peak_current | escape }}A</td>
                <td>up to {{ block.settings.gasoline | escape }}L</td>
                <td>up to {{ block.settings.diesel | escape }}L</td>
                <td>
                  <button type="button" class="suntneew-jump-guide__fit-button" data-capacity-filter="{{ block.settings.capacity | escape }}" aria-pressed="false">
                    {{ section.settings.compare_label | escape }}
                  </button>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
        <p class="suntneew-jump-guide__table-note">{{ section.settings.table_note | escape }}</p>
      </div>

      <div class="suntneew-jump-catalog" data-jump-catalog>
        <div class="suntneew-jump-guide__catalog-head">
          <div>
            <h3>{{ section.settings.catalog_heading | escape }}</h3>
            <p>{{ section.settings.catalog_intro | escape }}</p>
          </div>
          <div class="suntneew-jump-guide__view-switcher" role="group" aria-label="Product display mode">
            <button type="button" class="suntneew-jump-guide__view-button" data-view-switch="cards" aria-pressed="true">{{ section.settings.cards_label | escape }}</button>
            <button type="button" class="suntneew-jump-guide__view-button" data-view-switch="list" aria-pressed="false">{{ section.settings.list_label | escape }}</button>
          </div>
        </div>

        <div class="suntneew-jump-guide__cards" data-jump-cards>
          {%- for block in section.blocks -%}
            {%- if block.type != 'family' -%}{% continue %}{%- endif -%}
            {%- assign family_product = all_products[block.settings.product_handle] -%}
            {%- if block.settings.preview_only and family_product == blank and request.design_mode == false -%}{% continue %}{%- endif -%}
            {%- assign family_url = block.settings.product_url | default: family_product.url -%}
            {%- if family_url == blank and block.settings.product_handle != blank -%}
              {%- assign family_url = routes.root_url | append: 'products/' | append: block.settings.product_handle -%}
            {%- endif -%}
            {%- assign family_image = block.settings.asset_name -%}
            {%- if family_product.featured_media != blank -%}
              {%- assign family_image = family_product.featured_media -%}
            {%- endif -%}
            <article class="suntneew-jump-card" data-jump-card data-capacities="{{ block.settings.capacities | escape }}" {{ block.shopify_attributes }}>
              <a class="suntneew-jump-card__media" href="{{ family_url }}">
                {%- if family_image != blank -%}
                  {%- if family_product.featured_media != blank -%}
                    {{- family_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 1000px) 24vw, (min-width: 700px) 42vw, 92vw', alt: block.settings.image_alt -}}
                  {%- else -%}
                    <img src="{{ family_image | asset_url }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy" width="900" height="900">
                  {%- endif -%}
                {%- endif -%}
              </a>
              <div class="suntneew-jump-card__body">
                <p class="suntneew-jump-card__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                <h4>{{ block.settings.title | default: family_product.title | escape }}</h4>
                <p class="suntneew-jump-card__summary">{{ block.settings.summary | escape }}</p>
                <ul class="suntneew-jump-card__specs" role="list">
                  <li><strong>{{ block.settings.spec_capacity | escape }}</strong><span>Capacity</span></li>
                  <li><strong>{{ block.settings.spec_start | escape }}</strong><span>Starting current</span></li>
                  <li><strong>{{ block.settings.spec_peak | escape }}</strong><span>Peak current</span></li>
                  <li><strong>{{ block.settings.spec_fit | escape }}</strong><span>Fit reference</span></li>
                </ul>
                {%- if family_product.options_with_values != blank -%}
                  <div class="suntneew-jump-card__variants" aria-label="Available variants">
                    {%- for option in family_product.options_with_values -%}
                      <span class="suntneew-jump-card__variant">{{ option.name }}: {{ option.values | join: ' 路 ' }}</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <a class="suntneew-jump-card__link" href="{{ family_url }}">
                  <span>{{ block.settings.link_label | escape }}</span><span aria-hidden="true">鈫?/span>
                </a>
              </div>
            </article>
          {%- endfor -%}
        </div>
        <p class="suntneew-jump-guide__empty" data-jump-empty>{{ section.settings.empty_label | escape }}</p>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-jump-guide]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const cards = [...root.querySelectorAll('[data-jump-card]')];
    const rows = [...root.querySelectorAll('[data-guide-row]')];
    const filters = [...root.querySelectorAll('[data-capacity-filter]')];
    const empty = root.querySelector('[data-jump-empty]');
    const catalog = root.querySelector('[data-jump-catalog]');
    const cardGrid = root.querySelector('[data-jump-cards]');

    const reset = () => {
      cards.forEach((card) => { card.hidden = false; });
      rows.forEach((row) => { row.dataset.selected = 'false'; });
      filters.forEach((button) => { button.setAttribute('aria-pressed', 'false'); });
      if (empty) empty.classList.remove('is-visible');
    };

    filters.forEach((button) => {
      button.addEventListener('click', () => {
        const capacity = button.dataset.capacityFilter;
        const isSelected = button.getAttribute('aria-pressed') === 'true';
        if (isSelected) {
          reset();
          return;
        }

        filters.forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
        rows.forEach((row) => { row.dataset.selected = row.dataset.capacity === capacity ? 'true' : 'false'; });
        let visible = 0;
        cards.forEach((card) => {
          const matches = (card.dataset.capacities || '').split(',').map((value) => value.trim()).includes(capacity);
          card.hidden = !matches;
          if (matches) visible += 1;
        });
        if (empty) empty.classList.toggle('is-visible', visible === 0);
      });
    });

    root.querySelectorAll('[data-view-switch]').forEach((button) => {
      button.addEventListener('click', () => {
        const view = button.dataset.viewSwitch;
        root.querySelectorAll('[data-view-switch]').forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
        if (cardGrid) cardGrid.classList.toggle('is-list', view === 'list');
        if (catalog) catalog.classList.toggle('suntneew-jump-catalog--list', view === 'list');
      });
    });
  })();
</script>

