{{ 'suntneew-a3-pdp.css' | asset_url | stylesheet_tag }}

{%- assign feature_layout = section.settings.layout_mode | default: 'stories' -%}

<section id="{{ section.settings.anchor_id | handleize }}" class="sn-a3-pdp{% if template.suffix != blank %} sn-a3-pdp--{{ template.suffix | handleize }}{% endif %}" role="tabpanel" data-pdp-panel="{{ section.settings.anchor_id | handleize }}" aria-labelledby="rv-experience-heading-{{ section.id }}">
  <div class="sn-a3-pdp__shell sn-a3-pdp__section">
    {%- if section.settings.eyebrow != blank -%}<p class="sn-a3-pdp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="sn-a3-pdp__heading" id="rv-experience-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.lede != blank -%}<p class="sn-a3-pdp__lede">{{ section.settings.lede | strip_html }}</p>{%- endif -%}

    <div class="sn-a3-pdp__wide-stack{% if feature_layout == 'editorial_grid' %} sn-a3-pdp__wide-stack--editorial{% endif %}">
      {%- for block in section.blocks -%}
        {%- assign desktop_asset = block.settings.image_asset | default: block.settings.mobile_image_asset -%}
        {%- assign feature_card_size = block.settings.card_size | default: 'tile' -%}
        {%- assign feature_media_style = block.settings.media_style | default: 'cover' -%}
        <article class="sn-a3-pdp__wide{% if feature_layout == 'editorial_grid' %} sn-a3-pdp__wide--{{ feature_card_size }} sn-a3-pdp__wide--{{ feature_media_style }}{% endif %}" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{- block.settings.image | image_url: width: 2000 | image_tag: widths: '700,1000,1400,1700,2000', sizes: '(max-width: 599px) calc(100vw - 28px), 1240px', loading: 'lazy', alt: block.settings.image_alt -}}
          {%- elsif desktop_asset != blank -%}
            {%- assign bundled_asset_width = 2400 -%}
            {%- assign bundled_asset_height = 1600 -%}
            {%- if desktop_asset contains 'g31-amazon-aplus' -%}
              {%- assign bundled_asset_width = 1464 -%}
              {%- assign bundled_asset_height = 600 -%}
            {%- elsif desktop_asset contains '314ah-feature-low-solar-output' -%}
              {%- assign bundled_asset_width = 1024 -%}
              {%- assign bundled_asset_height = 1024 -%}
            {%- elsif desktop_asset contains '314ah-feature-remote-work-output' -%}
              {%- assign bundled_asset_width = 1448 -%}
              {%- assign bundled_asset_height = 1086 -%}
            {%- elsif desktop_asset contains '314ah-feature-family-overnight-output' -%}
              {%- assign bundled_asset_width = 1024 -%}
              {%- assign bundled_asset_height = 687 -%}
            {%- elsif desktop_asset contains '314ah-feature-bluetooth-output' or desktop_asset contains '314ah-feature-installation-output' or desktop_asset contains '314ah-feature-expansion-4s4p-output' or desktop_asset contains '314ah-feature-documents-support-output' -%}
              {%- assign bundled_asset_width = 1536 -%}
              {%- assign bundled_asset_height = 1024 -%}
            {%- endif -%}
            <picture style="display: block">
              {%- if block.settings.mobile_image_asset != blank -%}
                <source media="(max-width: 599px)" srcset="{{ block.settings.mobile_image_asset | asset_url }}">
              {%- endif -%}
              <img src="{{ desktop_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="{{ bundled_asset_width }}" height="{{ bundled_asset_height }}" loading="lazy">
            </picture>
          {%- endif -%}

          <div class="sn-a3-pdp__wide-copy">
            <div>
              {%- if block.settings.eyebrow != blank -%}<p class="sn-a3-pdp__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
              <h3>{{ block.settings.heading }}</h3>
              {%- if block.settings.body != blank -%}<div>{{ block.settings.body }}</div>{%- endif -%}
            </div>

            <div class="sn-a3-pdp__metrics" aria-label="{{ block.settings.heading | escape }} highlights">
              {%- if block.settings.metric_1_value != blank -%}<div class="sn-a3-pdp__metric"><strong>{{ block.settings.metric_1_value }}</strong><span>{{ block.settings.metric_1_label }}</span></div>{%- endif -%}
              {%- if block.settings.metric_2_value != blank -%}<div class="sn-a3-pdp__metric"><strong>{{ block.settings.metric_2_value }}</strong><span>{{ block.settings.metric_2_label }}</span></div>{%- endif -%}
              {%- if block.settings.metric_3_value != blank -%}<div class="sn-a3-pdp__metric"><strong>{{ block.settings.metric_3_value }}</strong><span>{{ block.settings.metric_3_label }}</span></div>{%- endif -%}
              {%- if block.settings.metric_4_value != blank -%}<div class="sn-a3-pdp__metric"><strong>{{ block.settings.metric_4_value }}</strong><span>{{ block.settings.metric_4_label }}</span></div>{%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SuntNeew RV experience",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anchor ID","default":"features"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"FEATURES"},
    {"type":"text","id":"heading","label":"Heading","default":"RV power designed around the way you travel."},
    {"type":"richtext","id":"lede","label":"Introduction","default":"<p>Clear product benefits, practical system information and the details that distinguish this battery.</p>"},
    {"type":"select","id":"layout_mode","label":"Feature layout","default":"stories","options":[{"value":"stories","label":"Wide stories"},{"value":"editorial_grid","label":"Editorial grid"}]}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image override"},
        {"type":"text","id":"image_asset","label":"Bundled desktop image"},
        {"type":"text","id":"mobile_image_asset","label":"Bundled mobile image"},
        {"type":"text","id":"image_alt","label":"Image alt text","default":"SuntNeew RV battery feature"},
        {"type":"select","id":"card_size","label":"Editorial card size","default":"tile","options":[{"value":"tile","label":"Tile"},{"value":"wide","label":"Full width"},{"value":"wide-short","label":"Full width, compact image"}]},
        {"type":"select","id":"media_style","label":"Bundled image fit","default":"cover","options":[{"value":"cover","label":"Cover"},{"value":"contain_light","label":"Contain on light background"},{"value":"contain_dark","label":"Contain on dark background"}]},
        {"type":"text","id":"eyebrow","label":"Eyebrow","default":"RV POWER"},
        {"type":"text","id":"heading","label":"Heading","default":"Power for the road ahead."},
        {"type":"richtext","id":"body","label":"Body","default":"<p>Describe the product benefit in clear customer language.</p>"},
        {"type":"text","id":"metric_1_value","label":"Metric 1 value"},
        {"type":"text","id":"metric_1_label","label":"Metric 1 label"},
        {"type":"text","id":"metric_2_value","label":"Metric 2 value"},
        {"type":"text","id":"metric_2_label","label":"Metric 2 label"},
        {"type":"text","id":"metric_3_value","label":"Metric 3 value"},
        {"type":"text","id":"metric_3_label","label":"Metric 3 label"},
        {"type":"text","id":"metric_4_value","label":"Metric 4 value"},
        {"type":"text","id":"metric_4_label","label":"Metric 4 label"},
        {"type":"text","id":"variant_match","label":"Only show for variant","info":"Optional capacity, color, title or SKU match."}
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{"name":"SuntNeew RV experience","blocks":[{"type":"feature"},{"type":"feature"}]}]
}
{% endschema %}
