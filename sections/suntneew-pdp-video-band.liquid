{{ 'suntneew-a20-pdp.css' | asset_url | stylesheet_tag }}

{%- assign demo_video_id = section.settings.video_url.id -%}
{%- assign demo_video_host = section.settings.video_url.type -%}
{%- assign demo_hosted_url = section.settings.hosted_video_url -%}
{%- assign demo_hosted_url_mobile = section.settings.hosted_video_url_mobile | default: demo_hosted_url -%}
{%- assign demo_poster_asset = section.settings.poster_asset | default: 'suntneew-a20-2026-pdp-demo-poster.webp' -%}
{%- assign demo_has_youtube = false -%}
{%- if demo_video_id != blank and demo_video_host == 'youtube' -%}{%- assign demo_has_youtube = true -%}{%- endif -%}
{%- assign demo_has_hosted = false -%}
{%- if demo_hosted_url != blank -%}{%- assign demo_has_hosted = true -%}{%- endif -%}
{%- assign demo_has_video = false -%}
{%- if demo_has_youtube or demo_has_hosted -%}{%- assign demo_has_video = true -%}{%- endif -%}
<section
  id="{{ section.settings.anchor_id | default: 'demo' | handleize }}"
  class="sn-a20-pdp sn-a20-pdp-video"
  aria-labelledby="a20-video-heading-{{ section.id }}"
>
  <div class="sn-a20-pdp__shell sn-a20-pdp__section">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sn-a20-pdp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="sn-a20-pdp__heading" id="a20-video-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.lede != blank -%}
      <p class="sn-a20-pdp__lede">{{ section.settings.lede | escape }}</p>
    {%- endif -%}

    <div class="sn-a20-pdp-video__frame">
      {%- if demo_has_video -%}
        <button
          type="button"
          class="sn-a20-pdp-video__facade"
          data-a20-video-play
          {%- if demo_has_youtube -%}
            data-a20-video-id="{{ demo_video_id | escape }}"
          {%- else -%}
            data-a20-video-src="{{ demo_hosted_url | escape }}"
            {%- if demo_hosted_url_mobile != blank %} data-a20-video-src-mobile="{{ demo_hosted_url_mobile | escape }}"{% endif %}
          {%- endif -%}
          aria-label="{{ section.settings.play_label | default: 'Play the demo video' | escape }}"
        >
          {%- if section.settings.poster != blank -%}
            {{-
              section.settings.poster
              | image_url: width: 1600
              | image_tag:
                widths: '600,900,1200,1600',
                sizes: '(max-width: 999px) 100vw, 1240px',
                loading: 'lazy',
                alt: section.settings.poster_alt
            -}}
          {%- else -%}
            <img
              src="{{ demo_poster_asset | asset_url }}"
              alt="{{ section.settings.poster_alt | escape }}"
              width="1600"
              height="900"
              loading="lazy"
            >
          {%- endif -%}
          <span class="sn-a20-pdp-video__play" aria-hidden="true"></span>
          {%- if section.settings.caption != blank -%}
            <span class="sn-a20-pdp-video__caption">{{ section.settings.caption | escape }}</span>
          {%- endif -%}
        </button>
      {%- else -%}
        <p class="sn-a20-pdp-video__empty">Add a YouTube URL or a hosted MP4 URL in the section settings to show the demo video.</p>
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <div class="sn-button-row sn-a20-pdp-video__cta">
        <a class="sn-button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
        {%- if section.settings.cta_note != blank -%}
          <p class="sn-a20-pdp-video__note">{{ section.settings.cta_note | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .sn-a20-pdp-video__frame {
    position: relative;
    margin-top: clamp(28px, 4vw, 52px);
    overflow: hidden;
    border-radius: 22px;
    background: #0f1620;
    box-shadow: 0 24px 60px rgba(17, 24, 39, .16);
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__facade,
  #shopify-section-{{ section.id }} .sn-a20-pdp-video__embed {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    aspect-ratio: 16 / 9;
    background: #0f1620;
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__facade {
    position: relative;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__facade img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__embed iframe,
  #shopify-section-{{ section.id }} .sn-a20-pdp-video__embed video {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #0f1620;
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__facade::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 22, 32, 0) 42%, rgba(15, 22, 32, .66));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(64px, 8vw, 96px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(255, 255, 255, .94);
    box-shadow: 0 12px 34px rgba(0, 0, 0, .3);
    transition: transform .18s ease;
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__play::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 12px 0 12px 20px;
    border-color: transparent transparent transparent #17202b;
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__facade:hover .sn-a20-pdp-video__play,
  #shopify-section-{{ section.id }} .sn-a20-pdp-video__facade:focus-visible .sn-a20-pdp-video__play {
    transform: translate(-50%, -50%) scale(1.06);
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__caption {
    position: absolute;
    left: clamp(16px, 2.4vw, 30px);
    bottom: clamp(14px, 2vw, 26px);
    z-index: 1;
    color: #fff;
    font-size: 12px;
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__empty {
    margin: 0;
    padding: clamp(30px, 6vw, 70px);
    color: #fff;
    font-size: 15px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__cta {
    margin-top: clamp(22px, 3vw, 36px);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .sn-a20-pdp-video__note {
    margin: 0;
    color: var(--a20-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .sn-a20-pdp-video__play { transition: none; }
  }
</style>

<script>
  (() => {
    if (window.__suntneewPdpVideoBand) return;
    window.__suntneewPdpVideoBand = true;

    document.addEventListener('click', (event) => {
      const facade = event.target.closest('[data-a20-video-play]');
      if (!facade) return;

      const hostedSrc = facade.dataset.a20VideoSrc;
      const videoId = facade.dataset.a20VideoId;
      if (!hostedSrc && !videoId) return;

      const embed = document.createElement('div');
      embed.className = 'sn-a20-pdp-video__embed';

      if (hostedSrc) {
        const video = document.createElement('video');
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.preload = 'metadata';
        video.setAttribute('aria-label', facade.getAttribute('aria-label') || 'Product demo video');
        const mobileSrc = facade.dataset.a20VideoSrcMobile;
        if (mobileSrc) {
          const desktopSource = document.createElement('source');
          desktopSource.src = hostedSrc;
          desktopSource.media = '(min-width: 750px)';
          const mobileSource = document.createElement('source');
          mobileSource.src = mobileSrc;
          mobileSource.media = '(max-width: 749px)';
          video.appendChild(desktopSource);
          video.appendChild(mobileSource);
        } else {
          video.src = hostedSrc;
        }
        embed.appendChild(video);
      } else {
        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube.com/embed/' + encodeURIComponent(videoId) + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
        iframe.title = facade.getAttribute('aria-label') || 'Product demo video';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        embed.appendChild(iframe);
      }

      facade.replaceWith(embed);
    });
  })();
</script>

{% schema %}
{
  "name": "SuntNeew PDP video band",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Real footage"},
    {"type":"text","id":"heading","label":"Heading","default":"See how the A20 clamps on to a real car battery"},
    {"type":"textarea","id":"lede","label":"Intro text","default":"Filmed on camera, start to finish: clamps on red first, the smart-clamp indicator already lit, the 12V readout and the USB output. No studio, no staged rescue."},
    {"type":"video_url","id":"video_url","label":"YouTube URL","accept":["youtube"],"info":"Optional. Takes priority over the hosted MP4 when both are set. The player loads on click, so the page stays fast."},
    {"type":"text","id":"hosted_video_url","label":"Hosted MP4 URL","info":"Optional. Use for SuntNeew's own product films uploaded to Files; plays in a native player with no YouTube branding."},
    {"type":"text","id":"hosted_video_url_mobile","label":"Hosted MP4 URL (mobile)","info":"Optional. Lower-bitrate rendition served below 750px."},
    {"type":"image_picker","id":"poster","label":"Poster image","info":"Optional. Defaults to the bundled A20 demo still."},
    {"type":"text","id":"poster_asset","label":"Poster asset filename","default":"suntneew-a20-2026-pdp-demo-poster.webp","info":"Theme asset used when no poster image is picked."},
    {"type":"text","id":"poster_alt","label":"Poster alt text","default":"SuntNeew A20 jump starter connected to a car battery in an engine bay"},
    {"type":"text","id":"caption","label":"Caption on the poster","default":"Canyon Life on Amazon Live"},
    {"type":"text","id":"play_label","label":"Play button label","default":"Play the A20 demo video"},
    {"type":"text","id":"cta_label","label":"Button label","default":"Shop the A20 — 15% off with code ANX15"},
    {"type":"url","id":"cta_link","label":"Button link"},
    {"type":"textarea","id":"cta_note","label":"Note under the button","default":"The code is applied automatically through this link."},
    {"type":"text","id":"anchor_id","label":"Section ID","default":"demo"}
  ],
  "presets":[{"name":"SuntNeew PDP video band"}]
}
{% endschema %}
