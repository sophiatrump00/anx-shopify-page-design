{{ 'suntneew-technology.css' | asset_url | stylesheet_tag }}

<section class="sn-tech-center">
  <div class="sn-tech-center__hero">
    <div class="sn-tech-center__shell sn-tech-center__hero-content">
      <p class="sn-tech-center__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="sn-tech-center__intro">{{ section.settings.intro }}</p>
    </div>
  </div>

  <div class="sn-tech-center__shell sn-tech-center__content">
    <div class="sn-tech-center__note">
      <span class="sn-tech-center__note-mark" aria-hidden="true">i</span>
      <div>
        <strong>{{ section.settings.note_title }}</strong>
        <p>{{ section.settings.note }}</p>
      </div>
    </div>

    <div class="sn-tech-center__grid">
      {%- for block in section.blocks -%}
        <article class="sn-tech-center__card" {{ block.shopify_attributes }}>
          <header class="sn-tech-center__card-header">
            <span class="sn-tech-center__icon" aria-hidden="true">
              {%- render 'suntneew-series-icon', icon: block.settings.icon -%}
            </span>
            <div>
              <p class="sn-tech-center__family">{{ block.settings.family }}</p>
              <h2>{{ block.settings.title }}</h2>
            </div>
          </header>

          <p class="sn-tech-center__description">{{ block.settings.description }}</p>

          <ul class="sn-tech-center__resources" role="list">
            {%- if block.settings.resource_one_label != blank -%}
              <li class="sn-tech-center__resource">
                <span class="sn-tech-center__resource-index">01</span>
                <div>
                  {%- if block.settings.resource_one_url != blank -%}<a href="{{ block.settings.resource_one_url }}">{%- endif -%}
                    <strong>{{ block.settings.resource_one_label }}</strong>
                    <p>{{ block.settings.resource_one_text }}</p>
                  {%- if block.settings.resource_one_url != blank -%}</a>{%- endif -%}
                </div>
              </li>
            {%- endif -%}

            {%- if block.settings.resource_two_label != blank -%}
              <li class="sn-tech-center__resource">
                <span class="sn-tech-center__resource-index">02</span>
                <div>
                  {%- if block.settings.resource_two_url != blank -%}<a href="{{ block.settings.resource_two_url }}">{%- endif -%}
                    <strong>{{ block.settings.resource_two_label }}</strong>
                    <p>{{ block.settings.resource_two_text }}</p>
                  {%- if block.settings.resource_two_url != blank -%}</a>{%- endif -%}
                </div>
              </li>
            {%- endif -%}

            {%- if block.settings.resource_three_label != blank -%}
              <li class="sn-tech-center__resource">
                <span class="sn-tech-center__resource-index">03</span>
                <div>
                  {%- if block.settings.resource_three_url != blank -%}<a href="{{ block.settings.resource_three_url }}">{%- endif -%}
                    <strong>{{ block.settings.resource_three_label }}</strong>
                    <p>{{ block.settings.resource_three_text }}</p>
                  {%- if block.settings.resource_three_url != blank -%}</a>{%- endif -%}
                </div>
              </li>
            {%- endif -%}
          </ul>

          {%- if block.settings.link != blank and block.settings.link_label != blank -%}
            <a href="{{ block.settings.link }}" class="sn-tech-center__link">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SuntNeew Tech Center",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"TECHNICAL RESOURCES"},
    {"type":"text","id":"heading","label":"Heading","default":"Technology, made useful."},
    {"type":"textarea","id":"intro","label":"Intro","default":"Choose a product family to find practical guidance, model-specific resources and the technical support path that fits your system."},
    {"type":"text","id":"note_title","label":"Information title","default":"Use the exact model before relying on a document."},
    {"type":"textarea","id":"note","label":"Information text","default":"Manuals, safety records and compliance documents are published by product model. Match the model on your product label before downloading or installing."}
  ],
  "blocks": [
    {
      "type": "family",
      "name": "Product family",
      "settings": [
        {"type":"select","id":"icon","label":"Icon","default":"rv","options":[{"value":"rv","label":"RV battery"},{"value":"jump","label":"Jump starter"},{"value":"home","label":"Home energy"}]},
        {"type":"text","id":"family","label":"Family label","default":"RV BATTERIES"},
        {"type":"text","id":"title","label":"Title","default":"Manuals and fitment"},
        {"type":"textarea","id":"description","label":"Description","default":"Find guidance matched to the product family and its intended use."},
        {"type":"text","id":"resource_one_label","label":"Resource 1 title","default":"Product manuals"},
        {"type":"textarea","id":"resource_one_text","label":"Resource 1 text","default":"Match the guide to the model number on your product label."},
        {"type":"url","id":"resource_one_url","label":"Resource 1 URL"},
        {"type":"text","id":"resource_two_label","label":"Resource 2 title","default":"Safety and transport"},
        {"type":"textarea","id":"resource_two_text","label":"Resource 2 text","default":"Review the model-specific handling, storage and transport information."},
        {"type":"url","id":"resource_two_url","label":"Resource 2 URL"},
        {"type":"text","id":"resource_three_label","label":"Resource 3 title","default":"Technical support"},
        {"type":"textarea","id":"resource_three_text","label":"Resource 3 text","default":"Get help before choosing accessories or installing a system."},
        {"type":"url","id":"resource_three_url","label":"Resource 3 URL"},
        {"type":"text","id":"link_label","label":"Family link label","default":"Explore product family"},
        {"type":"url","id":"link","label":"Family link"}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "SuntNeew Tech Center",
      "blocks": [
        {"type":"family"},
        {"type":"family"},
        {"type":"family"}
      ]
    }
  ]
}
{% endschema %}
