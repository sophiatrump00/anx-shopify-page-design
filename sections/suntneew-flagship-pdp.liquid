{% comment %}SuntNeew Flagship 6-Tab PDP section shared across G24, 230Ah, 314Ah, A3, KP700, U32, U23, and OJ02.{% endcomment %}
{{ 'suntneew-a20-v8.css' | asset_url | stylesheet_tag }}
{{ 'suntneew-pdp-media-hub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suntneew-pdp-media-hub.js' | asset_url }}" defer></script>
<script src="{{ 'suntneew-flagship-pdp.js' | asset_url }}" defer></script>
<script src="{{ 'suntneew-purchase-panel.js' | asset_url }}" defer></script>
<script src="{{ 'suntneew-progressive-faq.js' | asset_url }}" defer></script>
<style>
  .sn-flagship-pdp .pair-tabs { flex-wrap: wrap; gap: 6px 20px; }
  .sn-flagship-pdp .sn-flagship-fit-note {
    margin: 12px 0 0;
    padding: 9px 12px;
    border-radius: 5px;
    background: #f7f7f7;
    border: 1px solid #e7e7e7;
    font-size: 12px;
    line-height: 1.5;
    color: #4f4f4f;
  }
  .sn-flagship-pdp .sn-planner-band {
    margin: 0 auto 40px;
    padding: 24px 28px;
    border: 1px solid #e4e4e4;
    border-radius: 8px;
    background: #fafafa;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
  }
  .sn-flagship-pdp .sn-planner-band h3 {
    margin: 6px 0 6px;
    font-size: 20px;
    color: #1f1f1f;
  }
  .sn-flagship-pdp .sn-planner-band p:not(.eyebrow) {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: #555555;
    max-width: 640px;
  }
  .sn-flagship-pdp .sn-compliance-heading {
    margin: 26px 0 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #4a4a4a;
  }
</style>

{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'flagship-product-form-' | append: section.id
  assign rating = product.metafields.reviews.rating.value
  assign review_count = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
  assign gallery_images = product.media | where: 'media_type', 'image'
  assign max_qty = 999
  if selected_variant.inventory_management != blank and selected_variant.inventory_policy == 'deny'
    assign max_qty = selected_variant.inventory_quantity | default: 1 | at_least: 1
  endif
  assign unit_price_cents = selected_variant.price | default: 0
  assign compare_price_cents = selected_variant.compare_at_price | default: 0
  assign has_saving = false
  if compare_price_cents > unit_price_cents
    assign has_saving = true
    assign saving_cents = compare_price_cents | minus: unit_price_cents
  endif

  assign feature_blocks = section.blocks | where: 'type', 'feature_single'
  assign video_blocks = section.blocks | where: 'type', 'video_clip'
  assign faq_blocks = section.blocks | where: 'type', 'faq_item'
  assign has_gallery_video = false
  if section.settings.gallery_video_url != blank
    assign has_gallery_video = true
  endif
  assign support_href = section.settings.support_url | default: '/pages/support'
%}

<div class="sn-a20-pdp sn-flagship-pdp" data-flagship-pdp data-form="{{ product_form_id }}" data-model-label="{{ section.settings.model_code | escape }}" data-sticky-sub="{{ section.settings.sticky_subtitle | escape }}">
  <script type="application/json" data-flagship-variant>
    {
      "id": {{ selected_variant.id | append: '' | json }},
      "sku": {{ selected_variant.sku | default: section.settings.model_code | json }},
      "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "priceCents": {{ unit_price_cents | json }},
      "compareAtCents": {{ compare_price_cents | json }},
      "available": {{ selected_variant.available | json }},
      "maxQty": {{ max_qty | json }}
    }
  </script>

  <div class="preview-frame" id="frame">
    <div class="storefront" id="top">
      <div class="breadcrumb content" role="navigation" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">›</span>
        <a href="{{ section.settings.category_url | default: '/pages/shop' }}">{{ section.settings.category_label | default: 'Products' | escape }}</a>
        <span aria-hidden="true">›</span>
        <a href="#sales-summary" aria-current="page">{{ section.settings.model_code | default: product.title | escape }}</a>
      </div>

      <section id="gallery" class="product-hero" aria-labelledby="product-title">
        <div class="product-gallery">
          {%- if has_gallery_video -%}
            <div class="sn-media-tabs-wrap" data-sn-gallery-tabs>
              <div class="sn-media-tabs" role="tablist" aria-label="Product media type">
                <button type="button" class="sn-media-tab active" data-sn-gallery-mode="images">📷 Images ({{ gallery_images.size | at_least: 1 }})</button>
                <button type="button" class="sn-media-tab" data-sn-gallery-mode="videos">▶ Videos (1)</button>
              </div>
            </div>
          {%- endif -%}

          <div id="gallery-content" aria-busy="false">
            <div class="feature-pair gallery-pair" data-carousel="gallery">
              <div class="pair-track" id="pair-gallery" tabindex="0" role="region" aria-label="{{ section.settings.model_code | escape }} product images">
                {%- if gallery_images.size > 0 -%}
                  {%- for media in gallery_images -%}
                    {%- assign slide_label = media.alt | default: product.title -%}
                    {%- assign slide_src = media | image_url: width: 1200 -%}
                    {%- assign slide_zoom_src = media | image_url: width: 2000 -%}
                    <article class="feature-card" id="feature-gallery-{{ forloop.index }}">
                      <h3 class="card-title"><span class="card-number">{{ forloop.index }}</span>{{ slide_label | escape }}</h3>
                      <div class="image-module">
                        <button class="image-button" type="button" data-zoom-trigger data-zoom-src="{{ slide_zoom_src }}" data-zoom-title="{{ slide_label | escape }}" data-zoom-gallery-index="{{ forloop.index0 }}" aria-label="Enlarge image {{ forloop.index }}: {{ slide_label | escape }}">
                          {%- if forloop.first -%}
                            <img src="{{ slide_src }}" width="1000" height="1000" alt="{{ media.alt | default: product.title | escape }}" loading="eager" fetchpriority="high" decoding="async" draggable="false">
                          {%- else -%}
                            <img src="{{ slide_src }}" width="1000" height="1000" alt="{{ media.alt | default: product.title | escape }}" loading="lazy" decoding="async" draggable="false">
                          {%- endif -%}
                          <span class="zoom-label" aria-hidden="true">+</span>
                        </button>
                      </div>
                    </article>
                  {%- endfor -%}
                {%- endif -%}
              </div>

              {%- assign slide_count = gallery_images.size | at_least: 1 -%}
              <p class="gallery-current">{{ gallery_images.first.alt | default: product.title | escape }}</p>
              <div class="pair-controls">
                <p class="pair-hint">
                  <span class="pair-hint-desktop">Drag or use the arrows</span>
                  <span class="pair-hint-mobile">Swipe to explore</span>
                </p>
                <span class="pair-counter" aria-live="polite" aria-atomic="true">1 / {{ slide_count }}</span>
                <div class="pair-arrows">
                  <button type="button" data-carousel-prev aria-label="Previous product image" aria-controls="pair-gallery" disabled>←</button>
                  <button type="button" data-carousel-next aria-label="Next product image" aria-controls="pair-gallery"{% if slide_count <= 1 %} disabled{% endif %}>→</button>
                </div>
              </div>

              {%- if gallery_images.size > 1 -%}
                <div class="pair-tabs gallery-thumbnails" aria-label="Product image thumbnails">
                  {%- for media in gallery_images -%}
                    {%- assign slide_label = media.alt | default: product.title -%}
                    <button type="button" data-carousel-tab="{{ forloop.index0 }}" data-slide-label="{{ slide_label | escape }}" aria-controls="feature-gallery-{{ forloop.index }}" aria-label="Show image {{ forloop.index }}: {{ slide_label | escape }}" title="{{ slide_label | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                      <img src="{{ media | image_url: width: 176 }}" alt="" width="88" height="88" loading="lazy" decoding="async" draggable="false">
                    </button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </div>

          {%- if has_gallery_video -%}
            {%- assign gv_poster_url = '' -%}
            {%- if section.settings.gallery_video_poster_asset != blank -%}
              {%- assign gv_poster_url = section.settings.gallery_video_poster_asset | asset_url -%}
            {%- endif -%}
            <div class="sn-gallery-video-pane" hidden>
              <div class="sn-gallery-video-switcher">
                <button type="button" class="sn-gallery-video-pill active" data-vid-src="{{ section.settings.gallery_video_url | escape }}" data-vid-poster="{{ gv_poster_url | escape }}" data-vid-caption="{{ section.settings.gallery_video_caption | default: 'Official Product Film' | escape }}">
                  {{ section.settings.gallery_video_label | default: 'Official Film' | escape }}
                </button>
              </div>
              <div class="sn-vp-box sn-vp-box--gallery">
                <video preload="none" playsinline webkit-playsinline controlslist="nodownload noplaybackrate noremoteplayback" disablepictureinpicture data-sn-custom-video{% if gv_poster_url != blank %} poster="{{ gv_poster_url }}"{% endif %} src="{{ section.settings.gallery_video_url | escape }}"></video>
              </div>
              <p class="sn-gallery-video-meta">{{ section.settings.gallery_video_caption | escape }}</p>
            </div>
          {%- endif -%}

          <p class="gallery-help">
            <span class="gallery-help-desktop">Move over the image to browse photos. Click to enlarge.</span>
            <span class="gallery-help-mobile">Swipe to explore · Tap an image to enlarge.</span>
          </p>

          <div class="gallery-assurances-slot" id="gallery-assurances-slot">
            <div class="assurances" id="purchase-assurances" role="group" aria-label="Storefront assurances">
              <details data-assurance-key="shipping" data-priority="1">
                <summary>
                  <svg viewBox="0 0 24 24" class="assurance-icon" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"></path><circle cx="7.5" cy="17.5" r="1.5"></circle><circle cx="17.5" cy="17.5" r="1.5"></circle></svg>
                  <span><strong>Free U.S. shipping</strong><small>Contiguous 48 states + DC · 2–5 business days.</small></span>
                  <span class="assurance-chevron" aria-hidden="true"></span>
                </summary>
                <div class="assurance-panel">
                  <div class="assurance-panel-heading"><strong>Free U.S. standard shipping</strong><button type="button" class="assurance-close" aria-label="Close Free U.S. shipping details">×</button></div>
                  <p>Ships to the contiguous 48 U.S. states and Washington, DC. Orders process in 2 business days with 2–5 business days transit (Monday–Friday).</p>
                  <a href="/pages/shipping-policy" target="_blank" rel="noopener">Shipping policy ↗</a>
                </div>
              </details>
              <details data-assurance-key="warranty" data-priority="2">
                <summary>
                  <svg viewBox="0 0 24 24" class="assurance-icon" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-2.9 8.2-7 10-4.1-1.8-7-5.5-7-10V6l7-3z"></path></svg>
                  <span><strong>{{ section.settings.assurance_warranty_label | default: '5-year warranty' | escape }}</strong><small>Backed by SuntNeew support.</small></span>
                  <span class="assurance-chevron" aria-hidden="true"></span>
                </summary>
                <div class="assurance-panel">
                  <div class="assurance-panel-heading"><strong>{{ section.settings.assurance_warranty_label | default: 'Warranty coverage' | escape }}</strong><button type="button" class="assurance-close" aria-label="Close Warranty details">×</button></div>
                  <p>{{ section.settings.warranty_copy | escape }}</p>
                  <a href="/pages/warranty" target="_blank" rel="noopener">Warranty policy ↗</a>
                </div>
              </details>
              <details data-assurance-key="returns" data-priority="3">
                <summary>
                  <svg viewBox="0 0 24 24" class="assurance-icon" aria-hidden="true"><path d="M9 14l-4-4 4-4"></path><path d="M5 10h9a5 5 0 1 1 0 10h-3"></path></svg>
                  <span><strong>30-day returns</strong><small>Return window for eligible items.</small></span>
                  <span class="assurance-chevron" aria-hidden="true"></span>
                </summary>
                <div class="assurance-panel">
                  <div class="assurance-panel-heading"><strong>30-day return policy</strong><button type="button" class="assurance-close" aria-label="Close 30-day return details">×</button></div>
                  <p>Request return approval within 30 days of delivery. Follow the return instructions for unused items or eligible defect claims.</p>
                  <a href="/pages/return-policy" target="_blank" rel="noopener">Return policy ↗</a>
                </div>
              </details>
              <details data-assurance-key="support" data-priority="4">
                <summary>
                  <svg viewBox="0 0 24 24" class="assurance-icon" aria-hidden="true"><path d="M4 5h16v12H8l-4 4zM8 9h8M8 13h5"></path></svg>
                  <span><strong>Product support</strong><small>Setup, sizing, and manuals.</small></span>
                  <span class="assurance-chevron" aria-hidden="true"></span>
                </summary>
                <div class="assurance-panel">
                  <div class="assurance-panel-heading"><strong>Direct model support</strong><button type="button" class="assurance-close" aria-label="Close Product Support details">×</button></div>
                  <p>Share your order number and question at info@suntneew.com or open the dedicated model support hub for PDF guides and troubleshooting.</p>
                  <a href="{{ support_href }}" target="_blank" rel="noopener">Open support page ↗</a>
                </div>
              </details>
            </div>
          </div>
        </div>

        <div class="product-summary" id="sales-summary">
          <p class="eyebrow" id="model-eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
          <h1 id="product-title">{{ product.title | escape }}</h1>
          <p class="product-spec-line" id="product-specs">{{ section.settings.spec_line | escape }}</p>

          {%- if rating != blank and review_count > 0 -%}
            <a class="rating-link" href="#reviews">
              <span class="stars" aria-label="{{ rating.rating }} out of {{ rating.scale_max }} stars">★★★★★</span>
              <strong>{{ rating.rating | round: 1 }}</strong>
              <span>({{ review_count }} {% if review_count == 1 %}review{% else %}reviews{% endif %})</span>
            </a>
          {%- endif -%}

          <div class="sn-pack-total" aria-live="polite" aria-atomic="true">
            <p class="sn-pack-total__label">Total price</p>
            <div class="sn-pack-total__amounts">
              <strong id="total-price">{{ unit_price_cents | money }}</strong>
              <del id="compare-price"{% unless has_saving %} hidden{% endunless %}>{% if has_saving %}{{ compare_price_cents | money }}{% endif %}</del>
              <span>{{ cart.currency.iso_code | default: shop.currency }}</span>
            </div>
            <p class="sn-pack-total__saving" id="total-saving"{% unless has_saving %} hidden{% endunless %}>
              {% if has_saving %}You save {{ saving_cents | money }} vs. regular price{% endif %}
            </p>
          </div>
          <p class="product-tax">Taxes calculated at checkout.</p>

          {%- render 'suntneew-promo-bar', context: 'pdp' -%}

          {%- if section.settings.fit_note != blank -%}
            <p class="sn-flagship-fit-note">{{ section.settings.fit_note | escape }}</p>
          {%- endif -%}

          {%- if section.settings.headline_sub != blank -%}
            <p class="product-description">{{ section.settings.headline_sub | escape }}</p>
          {%- endif -%}

          {%- assign highlight_lines = section.settings.highlights_lines | newline_to_br | split: '<br />' -%}
          {%- if highlight_lines.size > 0 -%}
            <ul class="product-highlights" id="product-highlights" data-collapsed="true" aria-label="Product highlights">
              {%- assign hl_idx = 0 -%}
              {%- for raw_line in highlight_lines -%}
                {%- assign clean_line = raw_line | strip -%}
                {%- if clean_line == blank -%}{% continue %}{%- endif -%}
                {%- assign hl_idx = hl_idx | plus: 1 -%}
                {%- assign parts = clean_line | split: '|' -%}
                {%- assign hl_head = parts[0] | strip -%}
                {%- assign hl_body = parts[1] | strip -%}
                <li{% if hl_idx > 3 %} class="sn-highlight-extra"{% endif %}>
                  <span><strong>{{ hl_head | escape }}</strong>{% if hl_body != blank %} {{ hl_body | escape }}{% endif %}</span>
                </li>
              {%- endfor -%}
            </ul>
            {%- if hl_idx > 3 -%}
              {%- assign extra_hl = hl_idx | minus: 3 -%}
              <button type="button" class="sn-highlights-toggle" id="highlights-toggle" aria-controls="product-highlights" aria-expanded="false">+ {{ extra_hl }} more highlights ▾</button>
            {%- endif -%}
          {%- endif -%}

          {% form 'product', product, is: 'product-form', id: product_form_id %}
            <p class="quantity-label"><label id="quantity-label" for="quantity">Number of units</label></p>
            <div class="purchase-row">
              <div class="quantity-control">
                <button id="quantity-minus" type="button" aria-label="Decrease quantity" disabled>−</button>
                <input id="quantity" name="quantity" type="number" min="1" max="{{ max_qty }}" step="1" value="1" inputmode="numeric" aria-describedby="quantity-summary">
                <button id="quantity-plus" type="button" aria-label="Increase quantity"{% if max_qty <= 1 %} disabled{% endif %}>+</button>
              </div>
              <button id="purchase-button" class="purchase-button" type="submit"{% unless selected_variant.available %} disabled{% endunless %}>
                <span id="purchase-label">{% if selected_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
              </button>
            </div>
            <button type="button" class="buy-now" data-suntneew-buy-now{% unless selected_variant.available %} disabled{% endunless %}>Buy now</button>
            <input type="hidden" name="id" id="selected-variant" value="{{ selected_variant.id }}">
          {% endform %}

          <div class="cart-feedback-bar">
            <p class="cart-feedback" role="status" aria-live="polite" hidden></p>
            <div class="cart-feedback-actions">
              <a class="cart-feedback-link" href="{{ routes.cart_url }}" hidden>View your cart</a>
              <a class="cart-checkout-link" href="/checkout" hidden>Checkout now →</a>
            </div>
          </div>

          <p class="quantity-summary" id="quantity-summary" aria-live="polite" aria-atomic="true">1 unit · {{ unit_price_cents | money }} per unit</p>
          <p class="stock-status" id="stock-status" role="status"{% if selected_variant.available %} hidden{% endif %}>Currently sold out.</p>
          <a class="fit-help" href="#specs">Check full specifications →</a>

          <div class="purchase-trust" aria-label="Payment and purchase support">
            <p class="payment-title">Accepted at checkout · Free U.S. 48-state shipping</p>
            <ul class="payment-icons" aria-label="Accepted payment methods">
              {% for type in shop.enabled_payment_types %}
                {% unless type == 'generic' %}
                  <li title="{{ type | replace: '_', ' ' | escape }}">{{ type | payment_type_svg_tag }}</li>
                {% endunless %}
              {% endfor %}
            </ul>
            <div class="mobile-assurances-slot" id="mobile-assurances-slot"></div>
          </div>

          <div class="product-links">
            <a href="#manuals">{{ section.settings.model_code | escape }} manual ↗</a>
            <a href="{{ support_href }}" target="_blank" rel="noopener">Product support ↗</a>
          </div>
        </div>
      </section>

      <nav class="product-nav content" role="tablist" aria-label="Product sections">
        <a id="flagship-tab-features" class="active" href="#features" role="tab" aria-selected="true" aria-controls="flagship-panel-features" data-pdp-tab="features">Features</a>
        <a id="flagship-tab-specs" href="#specs" role="tab" aria-selected="false" aria-controls="flagship-panel-specs" tabindex="-1" data-pdp-tab="specs">Specs</a>
        <a id="flagship-tab-box" href="#box" role="tab" aria-selected="false" aria-controls="flagship-panel-box" tabindex="-1" data-pdp-tab="box">{{ section.settings.box_tab_label | default: 'In the box' | escape }}</a>
        <a id="flagship-tab-manuals" href="#manuals" role="tab" aria-selected="false" aria-controls="flagship-panel-manuals" tabindex="-1" data-pdp-tab="manuals">Manual <span class="nav-badge">PDF</span></a>
        <a id="flagship-tab-reviews" href="#reviews" role="tab" aria-selected="false" aria-controls="flagship-panel-reviews" tabindex="-1" data-pdp-tab="reviews"><span class="nav-star" aria-hidden="true">★</span> Reviews{% if review_count > 0 %} <span class="nav-count">({{ review_count }})</span>{% endif %}</a>
        <a id="flagship-tab-faq" href="#faq" role="tab" aria-selected="false" aria-controls="flagship-panel-faq" tabindex="-1" data-pdp-tab="faq">FAQ</a>
      </nav>

      <div class="pdp-tab-panels" id="pdp-tab-panels">
        <!-- TAB 1: FEATURES -->
        <div class="pdp-tab-panel" id="flagship-panel-features" role="tabpanel" aria-labelledby="flagship-tab-features" data-tab-panel="features">
          <div class="intro content" id="features">
            <p class="eyebrow">{{ section.settings.features_eyebrow | escape }}</p>
            <h2 class="features-title">{{ section.settings.features_heading | escape }}</h2>
            <p class="lead">{{ section.settings.features_lead | escape }}</p>
          </div>

          <div id="feature-content" aria-busy="false">
            {%- if section.settings.show_planner_banner and section.settings.planner_heading != blank -%}
              <div class="content">
                <div class="sn-planner-band">
                  <div>
                    <p class="eyebrow">{{ section.settings.planner_eyebrow | default: 'COMPARE OUTPUT VS. RESERVE' | escape }}</p>
                    <h3>{{ section.settings.planner_heading | escape }}</h3>
                    <p>{{ section.settings.planner_body | escape }}</p>
                  </div>
                  <a class="sn-btn sn-btn--primary" href="{{ section.settings.planner_url | default: '/pages/power-calculator?scenario=rv' }}" target="_blank" rel="noopener">{{ section.settings.planner_cta | default: 'Open Power Planner ↗' | escape }}</a>
                </div>
              </div>
            {%- endif -%}

            {%- assign feat_idx = 0 -%}
            {%- assign cases_rendered = false -%}
            {%- assign cases_after = section.settings.cases_after_index | default: 2 | plus: 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature_single' -%}
                {%- assign feat_idx = feat_idx | plus: 1 -%}
                <section class="{% if feat_idx == 1 %}feature-opening{% else %}feature-section{% endif %}" id="feature-b-{{ forloop.index }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <div class="section-heading">
                      {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
                      <h2>{{ block.settings.heading | escape }}</h2>
                      {%- if block.settings.body != blank -%}<p>{{ block.settings.body | escape }}</p>{%- endif -%}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.image_asset != blank -%}
                    {%- assign f_img_url = block.settings.image_asset | asset_url -%}
                    <div class="image-module">
                      <button class="image-button" type="button" data-zoom-trigger data-zoom-src="{{ f_img_url }}" data-zoom-title="{{ block.settings.heading | default: block.settings.image_alt | escape }}" aria-label="Enlarge {{ block.settings.heading | default: block.settings.image_alt | escape }} image">
                        <img src="{{ f_img_url }}" alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}" width="1464" height="600" loading="lazy" decoding="async" draggable="false">
                        <span class="zoom-label" aria-hidden="true">+</span>
                      </button>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.support_text != blank -%}
                    <p class="support-text">{{ block.settings.support_text | escape }}</p>
                  {%- endif -%}
                </section>
              {%- elsif block.type == 'feature_pair' -%}
                {%- assign feat_idx = feat_idx | plus: 1 -%}
                {%- assign pair_count = 2 -%}
                {%- if block.settings.tab3_label != blank and block.settings.img3_asset != blank -%}
                  {%- assign pair_count = 3 -%}
                {%- endif -%}
                <section class="feature-section" id="feature-b-{{ forloop.index }}" {{ block.shopify_attributes }}>
                  <div class="section-heading">
                    {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
                    <h2>{{ block.settings.heading | escape }}</h2>
                    {%- if block.settings.body != blank -%}<p>{{ block.settings.body | escape }}</p>{%- endif -%}
                  </div>
                  <div class="feature-pair" data-carousel="pair-{{ forloop.index }}">
                    <div class="pair-tabs" aria-label="{{ block.settings.heading | escape }}">
                      <button type="button" data-carousel-tab="0" aria-controls="pair-{{ forloop.index }}-a" aria-pressed="true">{{ block.settings.tab1_label | escape }}</button>
                      <button type="button" data-carousel-tab="1" aria-controls="pair-{{ forloop.index }}-b" aria-pressed="false">{{ block.settings.tab2_label | escape }}</button>
                      {%- if pair_count == 3 -%}
                        <button type="button" data-carousel-tab="2" aria-controls="pair-{{ forloop.index }}-c" aria-pressed="false">{{ block.settings.tab3_label | escape }}</button>
                      {%- endif -%}
                    </div>
                    <div class="pair-track" id="pair-{{ forloop.index }}" tabindex="0" role="region" aria-label="{{ block.settings.heading | escape }}">
                      {%- assign img1_url = block.settings.img1_asset | asset_url -%}
                      <article class="feature-card" id="pair-{{ forloop.index }}-a">
                        <h3 class="card-title"><span class="card-number">01</span>{{ block.settings.tab1_label | escape }}</h3>
                        <div class="image-module">
                          <button class="image-button" type="button" data-zoom-trigger data-zoom-src="{{ img1_url }}" data-zoom-title="{{ block.settings.tab1_label | escape }}" aria-label="Enlarge {{ block.settings.tab1_label | escape }} image">
                            <img src="{{ img1_url }}" alt="{{ block.settings.img1_alt | default: block.settings.tab1_label | escape }}" width="1464" height="600" loading="lazy" decoding="async" draggable="false">
                            <span class="zoom-label" aria-hidden="true">+</span>
                          </button>
                        </div>
                      </article>
                      {%- assign img2_url = block.settings.img2_asset | asset_url -%}
                      <article class="feature-card" id="pair-{{ forloop.index }}-b">
                        <h3 class="card-title"><span class="card-number">02</span>{{ block.settings.tab2_label | escape }}</h3>
                        <div class="image-module">
                          <button class="image-button" type="button" data-zoom-trigger data-zoom-src="{{ img2_url }}" data-zoom-title="{{ block.settings.tab2_label | escape }}" aria-label="Enlarge {{ block.settings.tab2_label | escape }} image">
                            <img src="{{ img2_url }}" alt="{{ block.settings.img2_alt | default: block.settings.tab2_label | escape }}" width="1464" height="600" loading="lazy" decoding="async" draggable="false">
                            <span class="zoom-label" aria-hidden="true">+</span>
                          </button>
                        </div>
                      </article>
                      {%- if pair_count == 3 -%}
                        {%- assign img3_url = block.settings.img3_asset | asset_url -%}
                        <article class="feature-card" id="pair-{{ forloop.index }}-c">
                          <h3 class="card-title"><span class="card-number">03</span>{{ block.settings.tab3_label | escape }}</h3>
                          <div class="image-module">
                            <button class="image-button" type="button" data-zoom-trigger data-zoom-src="{{ img3_url }}" data-zoom-title="{{ block.settings.tab3_label | escape }}" aria-label="Enlarge {{ block.settings.tab3_label | escape }} image">
                              <img src="{{ img3_url }}" alt="{{ block.settings.img3_alt | default: block.settings.tab3_label | escape }}" width="1464" height="600" loading="lazy" decoding="async" draggable="false">
                              <span class="zoom-label" aria-hidden="true">+</span>
                            </button>
                          </div>
                        </article>
                      {%- endif -%}
                    </div>
                    <div class="pair-controls">
                      <p class="pair-hint"><span class="pair-hint-desktop">Drag or use the arrows</span><span class="pair-hint-mobile">Swipe to explore</span></p>
                      <span class="pair-counter" aria-live="polite" aria-atomic="true">1 / {{ pair_count }}</span>
                      <div class="pair-arrows">
                        <button type="button" data-carousel-prev aria-label="Previous feature" aria-controls="pair-{{ forloop.index }}" disabled>←</button>
                        <button type="button" data-carousel-next aria-label="Next feature" aria-controls="pair-{{ forloop.index }}">→</button>
                      </div>
                    </div>
                  </div>
                  {%- if block.settings.support_text != blank -%}
                    <p class="support-text">{{ block.settings.support_text | escape }}</p>
                  {%- endif -%}
                </section>
              {%- endif -%}

              {%- if video_blocks.size > 0 and cases_rendered == false and feat_idx >= cases_after -%}
                {%- assign cases_rendered = true -%}
                {%- assign default_vid = video_blocks.first -%}
                {%- assign default_poster = default_vid.settings.poster_asset | asset_url -%}
                <section id="sn-cases" class="sn-cases-band" aria-label="{{ section.settings.model_code | escape }} real-world tests">
                  <div class="sn-cases-head">
                    <div>
                      <p class="eyebrow">REAL-WORLD TESTS</p>
                      <h2>See {{ section.settings.model_code | escape }} in real-world starts.</h2>
                      <p>{{ section.settings.cases_sub | default: 'Unedited creator tests and hands-on owner clips.' | escape }}</p>
                    </div>
                  </div>
                  <div class="sn-video-stage" data-sn-video-stage="{{ section.settings.model_code | handleize }}-features">
                    <div class="sn-vs-layout">
                      <div class="sn-vs-stage-card" data-playing="false">
                        <div class="sn-vs-player-frame">
                          <img class="sn-vs-poster" src="{{ default_poster }}" alt="{{ default_vid.settings.title | escape }}" width="720" height="1280" decoding="async">
                          <video class="sn-vs-inline-video" playsinline webkit-playsinline preload="none" controlslist="nodownload noplaybackrate noremoteplayback" disablepictureinpicture data-sn-custom-video poster="{{ default_poster }}" src="{{ default_vid.settings.video_url | escape }}"></video>
                          <button class="sn-vs-play-overlay" type="button" aria-label="Play featured test video"><span class="sn-vs-play-circle">▶</span></button>
                        </div>
                        <div class="sn-vs-stage-info">
                          <div class="sn-vs-info-top">
                            <span class="sn-vs-tag{% if default_vid.settings.is_featured %} star{% endif %}">{{ default_vid.settings.tag | escape }} · {{ default_vid.settings.duration | escape }}</span>
                            <div class="sn-vs-meta-actions">
                              <span class="sn-vs-counter">1 / {{ video_blocks.size }}</span>
                              <button class="sn-vs-expand-btn" type="button" data-modal-video="{{ default_vid.settings.video_url | escape }}" data-modal-title="{{ default_vid.settings.modal_title | default: default_vid.settings.title | escape }}">⤢ Full view</button>
                            </div>
                          </div>
                          <h3 class="sn-vs-title">{{ default_vid.settings.title | escape }}</h3>
                          <p class="vs-desc sn-vs-desc">{{ default_vid.settings.description | escape }}</p>
                        </div>
                      </div>
                      {%- if video_blocks.size > 1 -%}
                        <div class="sn-vs-thumbs" role="tablist" aria-label="Choose {{ section.settings.model_code | escape }} video clip">
                          {%- for vb in video_blocks -%}
                            {%- assign vb_poster = vb.settings.poster_asset | asset_url -%}
                            <button class="sn-vs-thumb-btn" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-vs-idx="{{ forloop.index }}" data-vs-video="{{ vb.settings.video_url | escape }}" data-vs-poster="{{ vb_poster }}" data-vs-tag="{{ vb.settings.tag | escape }} · {{ vb.settings.duration | escape }}" data-vs-star="{{ vb.settings.is_featured | default: false }}" data-vs-title="{{ vb.settings.title | escape }}" data-vs-desc="{{ vb.settings.description | escape }}" data-vs-modal-title="{{ vb.settings.modal_title | default: vb.settings.title | escape }}" {{ vb.shopify_attributes }}>
                              <span class="sn-vs-thumb-media">
                                <img src="{{ vb_poster }}" alt="{{ vb.settings.short_label | escape }} clip thumbnail" width="720" height="1280" decoding="async">
                                <span class="sn-vs-thumb-dur">{{ vb.settings.duration | escape }}</span>
                              </span>
                              <span class="sn-vs-thumb-copy">
                                <span class="sn-vs-thumb-eyebrow">{{ vb.settings.tag | escape }}</span>
                                <span class="sn-vs-thumb-title">{{ vb.settings.title | escape }}</span>
                                <span class="sn-vs-thumb-sub">{{ vb.settings.thumb_sub | escape }}</span>
                              </span>
                              <span class="sn-vs-thumb-short">{{ vb.settings.short_label | escape }}</span>
                            </button>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </section>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <section class="support-section" id="support">
            <div class="pdp-section support-grid">
              <div>
                <p class="eyebrow">SUNTNEEW, AFTER THE SALE</p>
                {%- if section.settings.warranty_number != blank -%}
                  <span class="warranty-number">{{ section.settings.warranty_number | escape }}{% if section.settings.warranty_unit != blank %}<small>{{ section.settings.warranty_unit | escape }}</small>{% endif %}</span>
                {%- endif -%}
                <h2>Here for the road ahead.</h2>
                <p class="support-copy">{{ section.settings.warranty_copy | escape }}</p>
                <a class="text-link" href="/pages/warranty" target="_blank" rel="noopener">Warranty &amp; service details ↗</a>
              </div>
              <div class="support-links">
                <a href="/pages/shipping-policy" target="_blank" rel="noopener"><span><strong>Free U.S. standard shipping.</strong><small>Contiguous 48 states &amp; Washington, DC (2+2–5 business days).</small></span><span class="link-arrow">↗</span></a>
                <a href="/pages/return-policy" target="_blank" rel="noopener"><span><strong>30 days to request a return.</strong><small>Contact us for approval before returning eligible items.</small></span><span class="link-arrow">↗</span></a>
                <a href="{{ support_href }}" target="_blank" rel="noopener"><span><strong>Questions now. Support later.</strong><small>{{ section.settings.support_card_sub | default: 'Help with setup, sizing and compliance docs.' | escape }}</small></span><span class="link-arrow">↗</span></a>
                <a href="/pages/contact-us" target="_blank" rel="noopener"><strong>Talk to SuntNeew</strong><span class="link-arrow">↗</span></a>
              </div>
            </div>
          </section>

          <section class="closing-banner">
            <div>
              <p class="eyebrow">SUNTNEEW / {{ section.settings.model_code | escape }}</p>
              <h2>{{ section.settings.closing_heading | default: 'Ready for the road ahead.' | escape }}</h2>
            </div>
            <a class="orange-link" href="#gallery">Order your {{ section.settings.model_code | escape }} ↑</a>
          </section>
        </div>

        <!-- TAB 2: SPECS -->
        <div class="pdp-tab-panel" id="flagship-panel-specs" role="tabpanel" aria-labelledby="flagship-tab-specs" data-tab-panel="specs" hidden>
          <section class="pdp-section detail-grid" id="specs">
            <div>
              <p class="eyebrow">KNOW YOUR {{ section.settings.model_code | escape }}</p>
              <h2>Made clear. Down to the details.</h2>
              <p class="section-intro">{{ section.settings.specs_intro | escape }}</p>
              <a class="text-link" href="#manuals">View User Manual &amp; Docs →</a>
            </div>
            <div>
              <dl class="spec-table">
                {%- assign p_specs = section.settings.primary_specs | newline_to_br | split: '<br />' -%}
                {%- for line in p_specs -%}
                  {%- assign row = line | strip -%}
                  {%- if row == blank -%}{% continue %}{%- endif -%}
                  {%- assign kv = row | split: '|' -%}
                  <div><dt>{{ kv[0] | strip | escape }}</dt><dd>{{ kv[1] | strip | escape }}</dd></div>
                {%- endfor -%}
              </dl>
              {%- assign m_specs = section.settings.more_specs | newline_to_br | split: '<br />' -%}
              {%- if section.settings.more_specs != blank -%}
                <details class="more-details" open>
                  <summary>More specifications</summary>
                  <dl class="spec-table">
                    {%- for line in m_specs -%}
                      {%- assign row = line | strip -%}
                      {%- if row == blank -%}{% continue %}{%- endif -%}
                      {%- assign kv = row | split: '|' -%}
                      <div><dt>{{ kv[0] | strip | escape }}</dt><dd>{{ kv[1] | strip | escape }}</dd></div>
                    {%- endfor -%}
                  </dl>
                </details>
              {%- endif -%}
            </div>
          </section>
        </div>

        <!-- TAB 3: IN THE BOX -->
        <div class="pdp-tab-panel" id="flagship-panel-box" role="tabpanel" aria-labelledby="flagship-tab-box" data-tab-panel="box" hidden>
          <section class="pdp-section detail-grid" id="box">
            <div>
              <p class="eyebrow">YOUR KIT</p>
              <h2>{{ section.settings.box_heading | default: 'In the box' | escape }}</h2>
              <p class="section-intro">{{ section.settings.box_intro | default: 'Keep the supplied kit components and user manual together.' | escape }}</p>
              <a class="text-link" href="#manuals">User manual &amp; setup guide →</a>
            </div>
            <div>
              <ul class="package-list">
                {%- assign box_lines = section.settings.box_items | newline_to_br | split: '<br />' -%}
                {%- assign b_idx = 0 -%}
                {%- for line in box_lines -%}
                  {%- assign b_txt = line | strip -%}
                  {%- if b_txt == blank -%}{% continue %}{%- endif -%}
                  {%- assign b_idx = b_idx | plus: 1 -%}
                  <li><span class="item-number">{% if b_idx < 10 %}0{% endif %}{{ b_idx }}</span><span>{{ b_txt | escape }}</span></li>
                {%- endfor -%}
              </ul>
              <p class="package-note">{{ section.settings.box_note | default: 'Package contents listed per unit.' | escape }}</p>
              {%- if section.settings.box_diagram_asset != blank -%}
                {%- assign box_img_url = section.settings.box_diagram_asset | asset_url -%}
                <div class="sn-box-diagram-wrap">
                  <div class="image-module">
                    <button class="image-button" type="button" data-zoom-trigger data-zoom-src="{{ box_img_url }}" data-zoom-title="{{ section.settings.model_code | escape }} — In the Box" aria-label="Enlarge {{ section.settings.model_code | escape }} kit diagram">
                      <img id="sn-box-diagram" src="{{ box_img_url }}" alt="SuntNeew {{ section.settings.model_code | escape }} kit contents" width="1200" height="800" decoding="async" draggable="false">
                      <span class="zoom-label" aria-hidden="true">+</span>
                    </button>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </section>
        </div>

        <!-- TAB 4: MANUAL PDF -->
        <div class="pdp-tab-panel" id="flagship-panel-manuals" role="tabpanel" aria-labelledby="flagship-tab-manuals" data-tab-panel="manuals" hidden>
          <section class="pdp-section detail-grid manuals-section" id="manuals">
            <div>
              <p class="eyebrow">DOCUMENTS</p>
              <h2>Download your {{ section.settings.model_code | escape }} guide.</h2>
              <p class="section-intro">{{ section.settings.manuals_intro | escape }}</p>
              <a class="text-link" href="{{ support_href }}" target="_blank" rel="noopener">Visit {{ section.settings.model_code | escape }} Support Center ↗</a>
            </div>
            <div>
              <div class="sn-manual-cards">
                {%- if section.settings.manual_en_asset != blank -%}
                  {%- assign men_url = section.settings.manual_en_asset | asset_url -%}
                  <article class="sn-manual-card">
                    <div class="sn-manual-card__doc" aria-hidden="true"><span class="sn-manual-card__badge">PDF</span><span class="sn-manual-card__code">{{ section.settings.model_code | escape }}</span></div>
                    <div class="sn-manual-card__body">
                      <span class="sn-manual-card__meta">USER MANUAL · ENGLISH PDF</span>
                      <h3 class="sn-manual-card__title">SuntNeew {{ section.settings.model_code | escape }} — English User Manual</h3>
                      <p class="sn-manual-card__desc">{{ section.settings.manual_en_desc | default: 'Operating instructions, charging specs, safety safeguards, and troubleshooting.' | escape }}</p>
                      <div class="sn-manual-card__actions">
                        <a class="sn-btn sn-btn--secondary" href="{{ men_url }}" target="_blank" rel="noopener">View Online ↗</a>
                        <a class="sn-btn sn-btn--primary" href="{{ men_url }}" download="SuntNeew-{{ section.settings.model_code | handleize }}-Manual-EN.pdf">Download PDF ↓</a>
                      </div>
                    </div>
                  </article>
                {%- endif -%}

                {%- if section.settings.manual_multi_asset != blank -%}
                  {%- assign mm_url = section.settings.manual_multi_asset | asset_url -%}
                  <article class="sn-manual-card">
                    <div class="sn-manual-card__doc" aria-hidden="true"><span class="sn-manual-card__badge">PDF</span><span class="sn-manual-card__code">EN/FR/DE</span></div>
                    <div class="sn-manual-card__body">
                      <span class="sn-manual-card__meta">USER MANUAL · MULTILINGUAL PDF</span>
                      <h3 class="sn-manual-card__title">SuntNeew {{ section.settings.model_code | escape }} — EN / FR / DE Manual</h3>
                      <p class="sn-manual-card__desc">Full multilingual edition for reference and offline download.</p>
                      <div class="sn-manual-card__actions">
                        <a class="sn-btn sn-btn--secondary" href="{{ mm_url }}" target="_blank" rel="noopener">View Online ↗</a>
                        <a class="sn-btn sn-btn--primary" href="{{ mm_url }}" download="SuntNeew-{{ section.settings.model_code | handleize }}-Manual-EN-FR-DE.pdf">Download PDF ↓</a>
                      </div>
                    </div>
                  </article>
                {%- endif -%}

                {%- if section.settings.compliance_docs != blank -%}
                  {%- assign cdocs = section.settings.compliance_docs | newline_to_br | split: '<br />' -%}
                  {%- for raw_doc in cdocs -%}
                    {%- assign doc_row = raw_doc | strip -%}
                    {%- if doc_row == blank -%}{% continue %}{%- endif -%}
                    {%- assign dparts = doc_row | split: '|' -%}
                    {%- assign d_title = dparts[0] | strip -%}
                    {%- assign d_asset = dparts[1] | strip -%}
                    {%- assign d_desc = dparts[2] | strip -%}
                    {%- assign d_url = d_asset | asset_url -%}
                    <article class="sn-manual-card sn-manual-card--sub">
                      <div class="sn-manual-card__body">
                        <span class="sn-manual-card__meta">COMPLIANCE DOCUMENT · PDF</span>
                        <h3 class="sn-manual-card__title">{{ d_title | escape }}</h3>
                        {%- if d_desc != blank -%}<p class="sn-manual-card__desc">{{ d_desc | escape }}</p>{%- endif -%}
                        <div class="sn-manual-card__actions">
                          <a class="sn-btn sn-btn--secondary" href="{{ d_url }}" target="_blank" rel="noopener">View Public Copy ↗</a>
                        </div>
                      </div>
                    </article>
                  {%- endfor -%}
                {%- endif -%}

                <article class="sn-manual-card sn-manual-card--sub">
                  <div class="sn-manual-card__body">
                    <span class="sn-manual-card__meta">PRODUCT SUPPORT</span>
                    <h3 class="sn-manual-card__title">{{ section.settings.model_code | escape }} Support &amp; Safety References</h3>
                    <p class="sn-manual-card__desc">Step-by-step troubleshooting, safety notices, and warranty guidance.</p>
                    <div class="sn-manual-card__actions">
                      <a class="sn-btn sn-btn--secondary" href="{{ support_href }}" target="_blank" rel="noopener">Open Support Guide ↗</a>
                    </div>
                  </div>
                </article>
              </div>
            </div>
          </section>
        </div>

        <!-- TAB 5: REVIEWS -->
        <div class="pdp-tab-panel" id="flagship-panel-reviews" role="tabpanel" aria-labelledby="flagship-tab-reviews" data-tab-panel="reviews" hidden>
          <section class="pdp-section" id="reviews">
            <p class="eyebrow">CUSTOMER REVIEWS</p>
            <h2>From our customers.</h2>
            <p class="section-intro">Verified customer feedback for the SuntNeew {{ section.settings.model_code | escape }}.</p>
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                {%- render block -%}
              {%- endif -%}
            {%- endfor -%}
          </section>
        </div>

        <!-- TAB 6: FAQ -->
        <div class="pdp-tab-panel" id="flagship-panel-faq" role="tabpanel" aria-labelledby="flagship-tab-faq" data-tab-panel="faq" hidden>
          <section class="pdp-section sn-faq-section" id="faq">
            <div class="sn-faq-head">
              <p class="eyebrow">BEFORE YOU GO</p>
              <h2>Questions before you order.</h2>
              <p class="section-intro">{{ section.settings.faq_intro | escape }}</p>
              <a class="text-link" href="{{ support_href }}" target="_blank" rel="noopener">Full {{ section.settings.model_code | escape }} support guide ↗</a>
            </div>
            <div class="sn-faq-list-wrap">
              <div class="faq-group" data-progressive-faq>
                {%- for fb in faq_blocks -%}
                  <details{% unless fb.settings.is_primary %} class="faq-related" hidden{% endunless %} {{ fb.shopify_attributes }}>
                    <summary>{{ fb.settings.question | escape }}</summary>
                    <div class="faq-answer">{{ fb.settings.answer }}</div>
                  </details>
                {%- endfor -%}
              </div>
              <div class="faq-more-row" hidden>
                <button type="button" class="faq-more-toggle" data-faq-toggle-all aria-expanded="false"></button>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>

  <aside class="sticky-buy" id="sticky-buy" aria-label="Quick purchase bar" hidden>
    <div class="sticky-buy-inner">
      <div class="sticky-meta">
        <span class="sticky-product"><strong>{{ section.settings.model_code | escape }}</strong><small id="sticky-options">{{ section.settings.sticky_subtitle | escape }}</small></span>
        <div class="sticky-pricing">
          <strong class="sticky-price" id="sticky-total">{{ unit_price_cents | money }}</strong>
          <a class="sticky-change-link" href="#sales-summary">Options ↑</a>
        </div>
      </div>
      <div class="sticky-actions">
        <button id="sticky-purchase-button" class="purchase-button sticky-atc-button" type="submit" form="{{ product_form_id }}"{% unless selected_variant.available %} disabled{% endunless %}>
          <span id="sticky-purchase-label">{% if selected_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
        </button>
        <button id="sticky-buy-now" type="button" class="buy-now sticky-buy-now-button" form="{{ product_form_id }}"{% unless selected_variant.available %} disabled{% endunless %} data-suntneew-buy-now>Buy now</button>
        <a class="sticky-checkout-link" href="/checkout" hidden>Checkout →</a>
      </div>
    </div>
    <p class="sticky-feedback" id="sticky-feedback" role="status" aria-live="polite" hidden></p>
  </aside>

  <dialog id="image-dialog" aria-labelledby="image-title">
    <div class="dialog-bar">
      <h2 id="image-title">{{ section.settings.model_code | escape }} product image</h2>
      <button type="button" data-close aria-label="Close image">×</button>
    </div>
    <div class="zoom-scroll">
      <img id="zoom-image" alt="" width="1464" height="600" draggable="false">
    </div>
    <div class="zoom-gallery-controls" hidden>
      <button id="zoom-previous" type="button" aria-label="Previous enlarged image">←</button>
      <span id="zoom-counter" aria-live="polite" aria-atomic="true"></span>
      <button id="zoom-next" type="button" aria-label="Next enlarged image">→</button>
      <button id="zoom-size" type="button" aria-label="View at original size" aria-pressed="false">+</button>
    </div>
    <p class="zoom-hint">Click image or + to view full resolution. Press Esc to close.</p>
  </dialog>

  {%- if video_blocks.size > 0 -%}
    <div id="sn-video-modal" class="sn-video-modal" role="dialog" aria-modal="true" aria-labelledby="sn-video-modal-title">
      <div class="sn-video-modal-dialog">
        <div class="sn-video-modal-head">
          <strong class="sn-video-modal-title" id="sn-video-modal-title">Customer Video</strong>
          <button id="sn-video-modal-close" class="sn-video-modal-close" type="button" aria-label="Close video">✕</button>
        </div>
        <div class="sn-video-modal-body">
          <div class="sn-vp-box sn-vp-box--modal">
            <video id="sn-video-modal-player" playsinline webkit-playsinline preload="none" controlslist="nodownload noplaybackrate noremoteplayback" disablepictureinpicture data-sn-custom-video></video>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <noscript>
    <style>.sn-flagship-pdp .pdp-tab-panel[hidden] { display: block !important; }</style>
    <p>Enable JavaScript to browse product sections and switch tabs.</p>
  </noscript>
</div>

