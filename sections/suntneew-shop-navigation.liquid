{{ 'suntneew-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suntneew-shop.js' | asset_url }}" defer></script>

<suntneew-shop-navigation class="sn-shop-nav" aria-labelledby="sn-shop-title-{{ section.id }}">
  <nav class="sn-shop-nav__bar" aria-label="Shop categories">
    <div class="sn-shop-nav__bar-inner">
      <span class="sn-shop-nav__current" aria-current="page">{{ section.settings.all_label | escape }}</span>
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank -%}
          <a href="{{ block.settings.collection.url }}">{{ block.settings.label | default: block.settings.collection.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </nav>

  <div class="sn-shop-nav__catalog" id="sn-shop-catalog-{{ section.id }}">
    <div class="sn-shop-nav__tiles-wrap">
      <div class="sn-shop-nav__tiles">
        {%- for block in section.blocks -%}
          {%- assign shop_collection = block.settings.collection -%}
          {%- if shop_collection != blank -%}
            {%- assign tile_image = block.settings.image | default: shop_collection.featured_image | default: shop_collection.products.first.featured_media -%}
            <a class="sn-shop-nav__tile" href="{{ shop_collection.url }}" {{ block.shopify_attributes }}>
              <span class="sn-shop-nav__tile-media">
                {%- if tile_image != blank -%}
                  {{- tile_image | image_url: width: 520 | image_tag: loading: 'eager', sizes: '(max-width: 699px) 42vw, 240px', widths: '200,300,400,520' -}}
                {%- endif -%}
              </span>
              <span class="sn-shop-nav__tile-label">{{ block.settings.label | default: shop_collection.title | escape }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="sn-shop-nav__intro" id="sn-shop-products-{{ section.id }}">
      {%- if section.settings.eyebrow != blank -%}<p class="sn-shop-nav__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="sn-shop-nav__title" id="sn-shop-title-{{ section.id }}">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.copy != blank -%}<div class="sn-shop-nav__copy">{{ section.settings.copy }}</div>{%- endif -%}
    </div>
  </div>
</suntneew-shop-navigation>

{% schema %}
{
  "name": "SuntNeew shop navigation",
  "tag": "section",
  "class": "shopify-section--suntneew-shop-navigation",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "all_label", "label": "All products label", "default": "All Products" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Power for real life" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop SuntNeew" },
    { "type": "richtext", "id": "copy", "label": "Introduction", "default": "<p>Find dependable power for the road, the vehicle and the home.</p>" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Display label" },
        { "type": "image_picker", "id": "image", "label": "Category image", "info": "Defaults to the collection image or first product image." }
      ]
    }
  ],
  "presets": [{ "name": "SuntNeew shop navigation" }]
}
{% endschema %}
