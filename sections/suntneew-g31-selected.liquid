 assign variant_min = variant.quantity_rule.min | default: 1
 assign variant_max = variant.quantity_rule.max | default: 999
 if variant.requires_components or variant.inventory_management != blank and variant.inventory_policy == 'deny'
  assign variant_max = variant_max | at_most: variant.inventory_quantity
 endif
%}{"id":{{ variant.id | append: '' | json }},"sku":{{ variant.sku | json }},"pack":{{ variant.option1 | json }},"available":{{ variant.available | json }},"priceCents":{{ variant.price | json }},"compareAtCents":{{ variant.compare_at_price | default: 0 | json }},"min":{{ variant_min | json }},"max":{{ variant_max | json }},"step":{{ variant.quantity_rule.increment | default: 1 | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}</script>
<script type="application/json" data-g31-assets>{"assets":[{"id":"A02","purpose":"G31 features at a glance","asset_id":"A02","group":"01","option":"01","src":{{ 'sn-g31-selected-a02.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-a02-full.jpg' | asset_url | json }},"width":1464,"height":600},{"id":"A03","purpose":"LiFePO4 cells and cycle life","asset_id":"A03","group":"02","option":"01","src":{{ 'sn-g31-selected-a03.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-a03-full.jpg' | asset_url | json }},"width":1464,"height":600},{"id":"A04","purpose":"Bluetooth battery monitoring","asset_id":"A04","group":"03","option":"01","src":{{ 'sn-g31-selected-a04.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-a04-full.jpg' | asset_url | json }},"width":1464,"height":600},{"id":"A05","purpose":"100A BMS protections","asset_id":"A05","group":"04","option":"01","src":{{ 'sn-g31-selected-a05.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-a05-full.jpg' | asset_url | json }},"width":1464,"height":600},{"id":"A08","purpose":"Temperature limits and IP65 enclosure","asset_id":"A08","group":"04","option":"02","src":{{ 'sn-g31-selected-a08.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-a08-full.jpg' | asset_url | json }},"width":1464,"height":600},{"id":"A06","purpose":"Series and parallel battery banks","asset_id":"A06","group":"05","option":"01","src":{{ 'sn-g31-selected-a06.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-a06-full.jpg' | asset_url | json }},"width":1464,"height":600},{"id":"A09","purpose":"Weight and lead-acid comparison","asset_id":"A09","group":"06","option":"01","src":{{ 'sn-g31-selected-a09.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-a09-full.jpg' | asset_url | json }},"width":1464,"height":600},{"id":"A10","purpose":"Three compatible charging methods","asset_id":"A10","group":"07","option":"01","src":{{ 'sn-g31-selected-a10.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-a10-full.jpg' | asset_url | json }},"width":1464,"height":600},{"id":"A11","purpose":"RV and trolling motor applications","asset_id":"A11","group":"08","option":"01","src":{{ 'sn-g31-selected-a11.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-a11-full.jpg' | asset_url | json }},"width":1464,"height":600},{"id":"A12","purpose":"Solar storage and outdoor power","asset_id":"A12","group":"08","option":"02","src":{{ 'sn-g31-selected-a12.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-a12-full.jpg' | asset_url | json }},"width":1464,"height":600},{"id":"A15","purpose":"G31 product document references","asset_id":"A15","group":"09","option":"01","src":{{ 'sn-g31-selected-a15.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-a15-full.jpg' | asset_url | json }},"width":1464,"height":600}],"gallery_assets":[{"id":"G01","purpose":"Group 31 battery with Bluetooth monitoring","asset_id":"G01","group":"gallery","option":"01","src":{{ 'sn-g31-selected-g01.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-g01-full.jpg' | asset_url | json }},"thumb_src":{{ 'sn-g31-selected-g01-thumb.webp' | asset_url | json }},"width":1100,"height":887},{"id":"G02","purpose":"Battery status on your phone","asset_id":"G02","group":"gallery","option":"02","src":{{ 'sn-g31-selected-g02.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-g02-full.jpg' | asset_url | json }},"thumb_src":{{ 'sn-g31-selected-g02-thumb.webp' | asset_url | json }},"width":1100,"height":1100},{"id":"G03","purpose":"LiFePO4 cycle life","asset_id":"G03","group":"gallery","option":"03","src":{{ 'sn-g31-selected-g03.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-g03-full.jpg' | asset_url | json }},"thumb_src":{{ 'sn-g31-selected-g03-thumb.webp' | asset_url | json }},"width":1100,"height":1100},{"id":"G04","purpose":"Low-temperature charge protection","asset_id":"G04","group":"gallery","option":"04","src":{{ 'sn-g31-selected-g04.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-g04-full.jpg' | asset_url | json }},"thumb_src":{{ 'sn-g31-selected-g04-thumb.webp' | asset_url | json }},"width":1100,"height":1100},{"id":"G05","purpose":"Series and parallel expansion","asset_id":"G05","group":"gallery","option":"05","src":{{ 'sn-g31-selected-g05.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-g05-full.jpg' | asset_url | json }},"thumb_src":{{ 'sn-g31-selected-g05-thumb.webp' | asset_url | json }},"width":1097,"height":1100},{"id":"G06","purpose":"Trolling motor power","asset_id":"G06","group":"gallery","option":"06","src":{{ 'sn-g31-selected-g06.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-g06-full.jpg' | asset_url | json }},"thumb_src":{{ 'sn-g31-selected-g06-thumb.webp' | asset_url | json }},"width":1100,"height":1100},{"id":"G08","purpose":"Dimensions and weight","asset_id":"G08","group":"gallery","option":"07","src":{{ 'sn-g31-selected-g08.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-g08-full.jpg' | asset_url | json }},"thumb_src":{{ 'sn-g31-selected-g08-thumb.webp' | asset_url | json }},"width":1079,"height":1100},{"id":"G07","purpose":"Three ways to recharge your G31","asset_id":"G07","group":"gallery","option":"08","src":{{ 'sn-g31-selected-g07.webp' | asset_url | json }},"zoom_src":{{ 'sn-g31-selected-g07-full.jpg' | asset_url | json }},"thumb_src":{{ 'sn-g31-selected-g07-thumb.webp' | asset_url | json }},"width":1100,"height":1059}],"config":[{"group":"01","kind":"opening"},{"group":"02","eyebrow":"01 / MADE FOR REPEAT TRIPS","heading":"More trips between battery replacements.","body":"From weekend camping to days on the water, G31 is built for repeated deep-cycle use. Its LiFePO4 cells are rated for 4,000+ cycles at 100% depth of discharge.","note":"Cycle-life references: 4,000+ cycles at 100% DoD, 6,000 at 80% DoD and 15,000 at 60% DoD. Actual life depends on charging, temperature and use."},{"group":"03","eyebrow":"02 / CHECK FROM YOUR PHONE","heading":"Know what’s left before you head out.","body":"Check charge level, voltage, current and temperature through the Bluetooth connection. A quick look at your phone helps you plan the next leg of the trip."},{"group":"04","kind":"pair","eyebrow":"03 / BUILT-IN PROTECTION","heading":"Ready for changing conditions.","body":"The 100A BMS monitors charging and discharge, with protection against overcharge, over-discharge, overcurrent and short circuits. Low-temperature charge protection helps protect the cells when the weather turns cold.","note":"IP65 protects against dust and water jets; it is not an immersion rating. Charging: 32°F–131°F (0°C–55°C). Discharging: −4°F–140°F (−20°C–60°C)."},{"group":"05","eyebrow":"04 / ROOM TO GROW","heading":"Build the battery bank your setup needs.","body":"Start with one 12.8V 100Ah battery, then expand with matched batteries as your power needs grow. G31 supports up to four in series and four in parallel, with a maximum 4P4S configuration.","note":"Use matched batteries and follow the manual for balancing, wiring and system protection. Maximum 4P4S bank: 51.2V 400Ah (20.48kWh)."},{"group":"06","eyebrow":"05 / EASIER TO HANDLE","heading":"Less weight in the battery bay.","body":"At about 21.2 lb, G31 is easier to lift, position and install. Check the 13.34 × 7.28 × 8.58 in case dimensions, terminal clearance and hold-down before ordering."},{"group":"07","eyebrow":"06 / RECHARGE YOUR WAY","heading":"Plug in. Drive on. Catch some sun.","body":"Recharge through a compatible LiFePO4 charger, solar charge controller or DC-to-DC charging setup. Choose the right equipment and charging profile for your system.","note":"Use 14.4–14.6V LiFePO4 charging. Solar panels and a vehicle alternator require suitable charging equipment; do not connect them directly to the battery."},{"group":"08","kind":"pair","eyebrow":"07 / TAKE YOUR POWER FURTHER","heading":"For the campsite, the lake and beyond.","body":"Keep RV house loads, a compatible trolling motor or an off-grid solar setup supplied. G31 provides 1,280Wh of nominal stored energy in each battery.","note":"For auxiliary and energy-storage use. G31 is not an engine-starting battery. Runtime depends on the load and system losses."},{"group":"09","eyebrow":"08 / BEFORE YOU INSTALL","heading":"Get to know your G31.","body":"Check the model documents, charging requirements and installation instructions before building your system. Our product support team can help with setup questions."}]}</script>

