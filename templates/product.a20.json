        "faq_q1": {
          "type": "question",
          "settings": {
            "question": "How many A20 variants are there?",
            "answer": "<p>Choose from 8,000mAh Orange or Red, 12,000mAh Orange and 16,000mAh Orange. The price and stock status follow your selection.</p>"
          }
        },
        "faq_q2": {
          "type": "question",
          "settings": {
            "question": "How should I choose an A20 capacity?",
            "answer": "<p>Start with the selected capacity's rated energy and peak current, then confirm 12V vehicle fit in the product manual. Do not choose from a generic engine-size promise alone.</p>"
          }
        },
        "faq_q3": {
          "type": "question",
          "settings": {
            "question": "Can the A20 charge a phone?",
            "answer": "<p>Yes. The A20 has two USB-A outputs for everyday device charging, in addition to its USB-C input.</p>"
          }
        },
        "faq_q4": {
          "type": "question",
          "settings": {
            "question": "What should I do before jump-starting?",
            "answer": "<p>Read the product manual, confirm correct clamp polarity, and follow the vehicle manufacturer's instructions. Product condition and vehicle battery condition affect results.</p>"
          }
