        "faq_q1": {
          "type": "question",
          "settings": {
            "question": "Which vehicles is OJ02 designed to support?",
            "answer": "<p>OJ02 is for compatible 12V vehicles, with a stated reference of up to 6.0L gasoline or 3.0L diesel engines. Confirm the vehicle, battery condition and manual before use.</p>"
          }
        },
        "faq_q2": {
          "type": "question",
          "settings": {
            "question": "What do the 700A and 1,500A figures mean?",
            "answer": "<p>OJ02 is specified with 700A starting current and 1,500A peak current. Actual results vary with vehicle type, battery condition, engine condition and temperature.</p>"
          }
        },
        "faq_q3": {
          "type": "question",
          "settings": {
            "question": "What can the OBD2 function do?",
            "answer": "<p>OJ02 provides 9 diagnostic functions, including reading and clearing fault codes, live data, I/M readiness and supported sensor checks. It supports 9 major protocols and 12 languages; vehicle compatibility should be confirmed before use.</p>"
          }
        },
        "faq_q4": {
          "type": "question",
          "settings": {
            "question": "What does the smart clamp include?",
            "answer": "<p>The EC5 clamp uses a 10AWG, 50cm cable with status lights and audible guidance. Connect red to positive and black to negative, then follow the indicator and manual sequence.</p>"
          }
        },
        "faq_q5": {
          "type": "question",
          "settings": {
            "question": "Can OJ02 charge a phone or small device?",
            "answer": "<p>Yes. The USB output supports 5V/3A, 9V/3A and 12V/3A, up to 36W maximum for compatible devices.</p>"
          }
        },
        "faq_q6": {
          "type": "question",
          "settings": {
            "question": "What light modes does OJ02 have?",
            "answer": "<p>The built-in LED supports steady illumination, red warning flashes and SOS signaling for roadside and outdoor emergencies.</p>"
          }
        },
