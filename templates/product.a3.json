    "features": {
      "type": "suntneew-pdp-story",
      "settings": {
        "anchor_id": "features",
        "eyebrow": "A3 in everyday use",
        "heading": "Ready for the unexpected",
        "lede": "<p>Emergency starting, device power and a practical light in one portable kit.</p>",
        "layout_mode": "split"
      },
      "blocks": {
        "starting": {
          "type": "feature",
          "settings": {
            "image_asset": "sn-pdp-20261105-a3-starting-1254.webp",
            "image_alt": "A3 jump starter connected in an engine bay",
            "image_fit": "contain",
            "eyebrow": "12V emergency starting",
            "heading": "Power for an unexpected stop.",
            "body": "<p>A3 is designed for compatible 12V vehicles, with an engine reference of up to 8.0L gas / 5.5L diesel. Battery condition, temperature and engine condition affect starting. Follow the product and vehicle instructions.</p>"
          }
        },
        "clamp": {
          "type": "feature",
          "settings": {
            "image_asset": "sn-pdp-20261105-a3-clamp-1254.webp",
            "image_alt": "A3 intelligent jumper clamp and connectors",
            "image_fit": "contain",
            "eyebrow": "Smart clamp",
            "heading": "Make every connection count.",
            "body": "<p>Status indicators, reverse-polarity and short-circuit protection help you follow the starting sequence. Check the clamp indicators and the manual before every attempt.</p>"
          }
        },
        "charging": {
          "type": "feature",
          "settings": {
            "image_asset": "sn-pdp-20261105-a3-usbc-1254.webp",
            "image_alt": "A3 USB-C charging port and cable",
            "image_fit": "contain",
            "eyebrow": "USB-C PD60W",
            "heading": "Power for your devices, too.",
            "body": "<p>The USB-C port supports PD60W input and output. Use a compatible USB-C PD cable and check the power requirements of the connected device. USB-A device-charging outputs are also included.</p>"
          }
        },
        "light": {
          "type": "feature",
          "settings": {
            "image_asset": "sn-pdp-20261105-a3-light-1254.webp",
            "image_alt": "A3 emergency light detail",
            "image_fit": "contain",
            "eyebrow": "Emergency light",
            "heading": "A useful light when plans change.",
            "body": "<p>The 150 lm light offers steady, strobe and SOS modes for roadside visibility. Keep the unit charged and stored within the stated operating limits.</p>"
          }
        },
        "display": {
          "type": "feature",
          "settings": {
            "image_asset": "sn-pdp-20261105-a3-display-1254.webp",
            "image_alt": "A3 display and controls",
            "image_fit": "contain",
            "eyebrow": "Ready to carry",
            "heading": "A clear view of the essentials.",
            "body": "<p>The ABS and aluminum-alloy body measures 21 × 9 × 3.5cm and weighs 0.77kg. Keep the unit, clamps and USB-C cable together in the included EVA case.</p>"
          }
        }
      },
