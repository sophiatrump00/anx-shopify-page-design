    "faq": {
      "type": "suntneew-pdp-faq",
      "settings": {
        "anchor_id": "faq",
        "eyebrow": "Need to know",
        "heading": "A3 questions, answered"
      },
      "blocks": {
        "q0": {
          "type": "question",
          "settings": {
            "question": "Will A3 work with my vehicle?",
            "answer": "<p>A3 is for compatible 12V vehicle systems, with an engine reference of up to 8.0L Gas / 5.5L Diesel. Battery condition, temperature and engine condition affect starting. Use the <a href=\"/pages/power-calculator?scenario=jump&amp;product=a3-16000\">Vehicle Fit Check</a> and follow the product and vehicle instructions.</p>"
          }
        },
        "q1": {
          "type": "question",
          "settings": {
            "question": "What do 2500A Peak and 800A Starting mean?",
            "answer": "<p>2500A Peak is the brief maximum output. 800A Starting is the rated starting current. Peak current is not continuous output; the vehicle and battery condition still affect the result.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How many starts can I expect from one charge?",
            "answer": "<p>50+ starts is the stated capability per full charge. Your actual number of starts depends on the engine, vehicle battery, temperature, remaining charge and connection setup.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What if the vehicle still won’t start?",
            "answer": "<p>Wait at least one minute between attempts and stop after three unsuccessful attempts. Follow the manual for disconnection and check the vehicle battery. See <a href=\"/pages/support-a3\">starting help</a> or contact us with your vehicle details and clamp status.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Can A3 charge my USB-C devices?",
            "answer": "<p>The USB-C port supports PD60W input and output. Check your device’s power requirements and use a compatible USB-C PD cable. USB-A outputs are also included.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "What happens if my order arrives damaged or incorrect?",
            "answer": "<p>Email info@suntneew.com with your order number and clear photos so we can review the issue and provide instructions. Under our return policy, we cover return shipping for items that arrive damaged, defective or incorrect. <a href=\"/pages/return-policy\">Read the return policy</a>.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "What comes in the case?",
            "answer": "<p>The kit includes the A3 unit, intelligent jumper clamps, a PD60W USB-C cable, an EVA carry case and a user manual. See <a href=\"#in-the-box\">In the box</a> for the full list.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "question": "Why do the documents say CY-A3?",
            "answer": "<p>A3 is the product name. CY-A3 is its model designation in the product and test documents.</p>"
          }
        }
      },
