      "settings": {
        "anchor_id": "features",
        "eyebrow": "SUGAR MINI LY-AD19",
        "heading": "See the temperature pattern",
        "lede": "<p>A compact inspection tool for everyday visual checks.</p>",
        "layout_mode": "split"
      },
      "blocks": {
        "feature0": {
          "type": "feature",
          "settings": {
            "heading": "Check everyday equipment.",
            "body": "<p>Use the infrared view for basic checks of circuit boards, underfloor heating patterns, cooking temperatures and vehicle troubleshooting. AD19 is not a substitute for professional diagnostic equipment.</p>",
            "image_fit": "contain",
            "image": "shopify://shop_images/5_c6cdc066-2e1e-40f5-9883-f5c23134bf20.jpg",
            "image_alt": "SUGAR MINI LY-AD19 thermal camera and imaging display"
          }
        },
        "feature1": {
          "type": "feature",
          "settings": {
            "heading": "Choose the view that helps.",
            "body": "<p>The 1.83-inch IPS touchscreen offers 18 selectable color palettes, alongside an 80 × 60 infrared sensor and a 1600 × 1200 visible-light camera.</p>",
            "image_fit": "contain",
            "image": "shopify://shop_images/2_0a605139-8580-46f8-8687-968327ce17be.jpg",
            "image_alt": "SUGAR MINI LY-AD19 thermal camera and imaging display"
          }
        }
      },
