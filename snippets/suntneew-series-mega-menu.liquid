{%- comment -%}
  A compact Product Series menu intentionally uses no campaign imagery. The
  Shopify navigation remains the source of truth for collection URLs and titles.
{%- endcomment -%}

<style>
  #suntneew-series-mega-menu {
    --mega-menu-justify-content: flex-start;
    --mega-menu-gap: 0;
    width: min(360px, calc(100vw - 48px));
    max-height: none;
    padding: 10px;
    overflow: visible;
    border: 1px solid rgb(24 35 48 / .14);
    border-radius: 0 0 16px 16px;
    background: #fff;
    color: #182330;
    box-shadow: 0 18px 44px rgb(18 29 41 / .18);
    mix-blend-mode: normal;
    top: calc(100% + 38px);
    left: 0;
  }

  #suntneew-series-mega-menu .suntneew-series-mega-menu__grid {
    display: grid;
    width: 100%;
    gap: 2px;
  }

  #suntneew-series-mega-menu .suntneew-series-mega-menu__item {
    display: grid;
    min-height: 78px;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    gap: 13px;
    align-items: center;
    padding: 12px;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease;
  }

  #suntneew-series-mega-menu .suntneew-series-mega-menu__item:hover,
  #suntneew-series-mega-menu .suntneew-series-mega-menu__item:focus-visible {
    background: #f4f7f9;
    color: #e9653b;
    outline: none;
  }

  #suntneew-series-mega-menu .suntneew-series-mega-menu__icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgb(233 101 59 / .18);
    border-radius: 10px;
    background: #fff5f0;
    color: #e9653b;
  }

  #suntneew-series-mega-menu .suntneew-series-mega-menu__icon svg {
    width: 23px;
    height: 23px;
  }

  #suntneew-series-mega-menu .suntneew-series-mega-menu__copy {
    display: grid;
    gap: 3px;
  }

  #suntneew-series-mega-menu .suntneew-series-mega-menu__title {
    color: #17212e;
    font-size: .8125rem;
    font-weight: 800;
    line-height: 1.2;
  }

  #suntneew-series-mega-menu .suntneew-series-mega-menu__description {
    color: #697582;
    font-size: .75rem;
    line-height: 1.4;
  }

  #suntneew-series-mega-menu .suntneew-series-mega-menu__arrow {
    align-self: center;
    color: #e9653b;
    font-size: 1.125rem;
    line-height: 1;
    transition: transform 160ms ease;
  }

  #suntneew-series-mega-menu .suntneew-series-mega-menu__item:hover .suntneew-series-mega-menu__arrow,
  #suntneew-series-mega-menu .suntneew-series-mega-menu__item:focus-visible .suntneew-series-mega-menu__arrow {
    transform: translateX(3px);
  }

  @media screen and (max-width: 1149px) {
    #suntneew-series-mega-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #suntneew-series-mega-menu .suntneew-series-mega-menu__item,
    #suntneew-series-mega-menu .suntneew-series-mega-menu__arrow {
      transition: none;
    }
  }
</style>

<div id="suntneew-series-mega-menu" class="mega-menu suntneew-series-mega-menu">
  <div class="suntneew-series-mega-menu__grid">
    {%- for sub_link in link.links -%}
      {%- assign collection_handle = sub_link.object.handle | default: '' -%}
      {%- assign icon = '' -%}
      {%- assign description = '' -%}

      {%- case collection_handle -%}
        {%- when 'rv-batteries' -%}
          {%- assign icon = 'rv' -%}
          {%- assign description = 'RV, marine and off-grid power.' -%}
        {%- when 'jump-starters' -%}
          {%- assign icon = 'jump' -%}
          {%- assign description = 'Portable starting power for the road.' -%}
        {%- when 'home-energy-storage' -%}
          {%- assign icon = 'home' -%}
          {%- assign description = 'Plan resilient power for essential home loads.' -%}
      {%- endcase -%}

      {%- if icon != blank -%}
        <a href="{{ sub_link.url }}" class="suntneew-series-mega-menu__item" aria-label="Explore {{ sub_link.title | escape }}">
          <span class="suntneew-series-mega-menu__icon" aria-hidden="true">
            {%- render 'suntneew-series-icon', icon: icon -%}
          </span>
          <span class="suntneew-series-mega-menu__copy">
            <span class="suntneew-series-mega-menu__title">{{ sub_link.title }}</span>
            <span class="suntneew-series-mega-menu__description">{{ description }}</span>
          </span>
          <span class="suntneew-series-mega-menu__arrow" aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
