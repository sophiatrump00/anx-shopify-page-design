{% comment %}
Auto-generated by Shogun.
This file can be re-written at any time.
{% endcomment %}

{% assign template_suffix = template.suffix %}
{% assign shogun_content = blank %}

{% if article %}
  {% assign shogun_content = article %}
{% elsif page %}
  {% assign shogun_content = page %}
{% elsif product %}
  {% assign shogun_content = product %}
{% elsif collection %}
  {% assign shogun_content = collection %}
{% endif %}

{% capture shogun_content_for_header %}
  {% # theme-check-disable-next-line ContentForHeaderModification %}
  {{ content_for_header }}
  {% render 'shogun-products', content: shogun_content %}
{% endcapture %}

{% capture shogun_content_for_layout %}
  {{ content_for_layout }}
{% endcapture %}

{% if shogun_content.metafields.shogun.json_template_snippets %}
  {% capture shogun_content_for_header %}
    {{ shogun_content_for_header }}
    {{ shogun_content.metafields.shogun.json_template_snippets.value['head'][template_suffix] }}
  {% endcapture %}

  {% capture shogun_content_for_layout %}
    {{ shogun_content_for_layout }}
    {{ shogun_content.metafields.shogun.json_template_snippets.value['body'][template_suffix] }}
  {% endcapture %}
{% endif %}

{% if shogun_content.metafields.shogun.json_template_html_wrapper %}
  {% assign shogun_json_template_config = shogun_content.metafields.shogun.json_template_html_wrapper.value %}
  {% capture shogun_content_for_layout %}
    {{
        shogun_json_template_config.html
        | replace: shogun_json_template_config.content_for_layout_placeholder, shogun_content_for_layout
        | replace: shogun_json_template_config.page_variant_id_placeholder, shogun_json_template_config.template_suffix_to_variant_id_map[template_suffix]
    }}
  {% endcapture %}
{% endif %}

{% if shogun_content.metafields.shogun.json_template_optimizer %}
     {% capture shogun_content_for_header %}
        <template id="shogun-variant-head">
          {{ shogun_content_for_header }}
        </template>
        <script type="text/javascript">
          {% if customer %}
            window.SHG_CUSTOMER = { "id": "{{ customer.id }}" }
          {% else %}
            window.SHG_CUSTOMER = null;
          {% endif %}
        </script>
         {{ shogun_content.metafields.shogun.json_template_optimizer.value['head'] }}
      {% endcapture %}

      {% capture shogun_content_for_layout %}
         <template id="shogun-variant-body">
           {{ shogun_content_for_layout }}
         </template>
         {{ shogun_content.metafields.shogun.json_template_optimizer.value['body'] }}
      {% endcapture %}
{% endif %}
