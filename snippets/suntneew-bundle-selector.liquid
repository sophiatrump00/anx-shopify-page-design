{% doc %}
Renders preset multi-pack quantities that update the product form quantity.

@param {product} product - Product rendered by the product form.
@param {string} product_form_id - Product form ID.
@param {block} block - Multi-pack block settings.
{% enddoc %}

{%- if block.settings.enabled and product.available -%}
  {%- liquid
    assign selected_variant = product.selected_or_first_available_variant
    assign savings_enabled = block.settings.show_savings
    assign discount_step = block.settings.discount_percent | default: 3
    assign middle_discount = discount_step | times: 2
    assign maximum_discount = discount_step | times: 3
    assign preset_quantities = '1,2,5,10' | split: ','
    assign minimum_quantity = selected_variant.quantity_rule.min | default: 1
    assign initial_quantity = minimum_quantity
    assign quantity_increment = selected_variant.quantity_rule.increment | default: 1
    assign initial_quantity_text = initial_quantity | append: ''
    assign initial_is_preset = false

    if selected_variant.available and preset_quantities contains initial_quantity_text
      assign initial_is_preset = true
    endif
  -%}

  <div
    class="suntneew-bundle-selector"
    data-suntneew-bundle-selector
    data-form-id="{{ product_form_id }}"
    data-currency="{{ localization.country.currency.iso_code | escape }}"
    data-unavailable-label="{{ 'product.general.unavailable_button' | t | escape }}"
    data-sold-out-label="{{ 'product.general.sold_out_button' | t | escape }}"
    data-selection-state="{% if selected_variant.available %}available{% elsif selected_variant %}sold-out{% else %}unavailable{% endif %}"
  >
    <div class="suntneew-bundle-selector__heading">
      <div>
        <p class="suntneew-bundle-selector__eyebrow">
          {%- if savings_enabled -%}
            {{ 'product.quantity.multi_pack_eyebrow' | t }}
          {%- else -%}
            {{ 'product.quantity.multi_pack_quantity_eyebrow' | t }}
          {%- endif -%}
        </p>
        <h3>{{ block.settings.heading }}</h3>
      </div>
      {%- if savings_enabled -%}
        <span class="suntneew-bundle-selector__badge" data-bundle-savings{% unless selected_variant.available %} hidden{% endunless %}>{{ 'product.quantity.save_up_to' | t: percent: maximum_discount }}</span>
      {%- endif -%}
    </div>

    {%- if block.settings.body != blank -%}
      <p class="suntneew-bundle-selector__body">{{ block.settings.body }}</p>
    {%- endif -%}

    <div class="suntneew-bundle-selector__options" role="group" aria-label="{{ 'product.quantity.multi_pack_aria' | t | escape }}">
      {%- for quantity_text in preset_quantities -%}
        {%- liquid
          assign quantity = quantity_text | plus: 0
          assign pack_discount = 0

          if savings_enabled
            if quantity >= 4
              assign pack_discount = maximum_discount
            elsif quantity >= 3
              assign pack_discount = middle_discount
            elsif quantity >= 2
              assign pack_discount = discount_step
            endif
          endif

          assign undiscounted_price = selected_variant.price | times: quantity
          assign bundle_multiplier = 100 | minus: pack_discount
          assign pack_price = undiscounted_price | times: bundle_multiplier | divided_by: 100.0 | round
          assign preset_available = selected_variant.available

          if quantity < minimum_quantity
            assign preset_available = false
          endif

          if selected_variant.quantity_rule.max != nil and quantity > selected_variant.quantity_rule.max
            assign preset_available = false
          endif

          assign quantity_offset = quantity | minus: minimum_quantity
          assign quantity_remainder = quantity_offset | modulo: quantity_increment

          if quantity_offset < 0 or quantity_remainder != 0
            assign preset_available = false
          endif
        -%}

        <button
          type="button"
          class="suntneew-bundle-selector__option{% if preset_available and quantity == initial_quantity %} is-selected{% endif %}"
          data-bundle-quantity="{{ quantity }}"
          data-bundle-discount="{{ pack_discount }}"
          aria-pressed="{% if preset_available and quantity == initial_quantity %}true{% else %}false{% endif %}"
          {% unless preset_available %}disabled{% endunless %}
        >
          <span class="suntneew-bundle-selector__option-copy">
            <strong>{{ 'product.quantity.unit_count' | t: count: quantity }}</strong>
            <small data-bundle-savings{% unless selected_variant.available %} hidden{% endunless %}>{% if pack_discount > 0 %}{{ 'product.quantity.save_percent' | t: percent: pack_discount }}{% else %}{{ 'product.quantity.standard_price' | t }}{% endif %}</small>
          </span>
          <span class="suntneew-bundle-selector__price-wrap">
            <span class="suntneew-bundle-selector__price" data-bundle-price>{% if selected_variant.available %}{{ pack_price | money }}{% elsif selected_variant %}{{ 'product.general.sold_out_button' | t }}{% else %}{{ 'product.general.unavailable_button' | t }}{% endif %}</span>
            <s class="suntneew-bundle-selector__compare" data-bundle-compare{% if pack_discount == 0 or selected_variant.available != true %} hidden{% endif %}>{% if selected_variant.available %}{{ undiscounted_price | money }}{% endif %}</s>
          </span>
        </button>
      {%- endfor -%}
    </div>

    <button
      type="button"
      class="suntneew-bundle-selector__custom{% if selected_variant.available and initial_is_preset == false %} is-selected{% endif %}"
      data-bundle-custom
      aria-controls="{{ product_form_id }}-quantity"
      aria-pressed="{% if selected_variant.available and initial_is_preset == false %}true{% else %}false{% endif %}"
      {% unless selected_variant.available %}disabled{% endunless %}
    >
      <span>{{ 'product.quantity.custom_quantity' | t }}</span>
      <small>{{ 'product.quantity.custom_quantity_hint' | t }}</small>
    </button>

    {%- if savings_enabled -%}
      <p class="suntneew-bundle-selector__note" data-bundle-savings{% unless selected_variant.available %} hidden{% endunless %}>{{ 'product.quantity.discount_ladder_note' | t: two: discount_step, three: middle_discount, four: maximum_discount }}</p>
    {%- endif -%}

    <p class="suntneew-bundle-selector__note" data-bundle-status role="status" aria-live="polite"{% if selected_variant.available %} hidden{% endif %}>{% unless selected_variant.available %}{% if selected_variant %}{{ 'product.general.sold_out_button' | t }}{% else %}{{ 'product.general.unavailable_button' | t }}{% endif %}{% endunless %}</p>

    <script type="application/json" data-suntneew-bundle-variants>{{ product.variants | json }}</script>
  </div>
{%- endif -%}
