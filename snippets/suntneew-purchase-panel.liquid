<div class="suntneew-purchase-panel" aria-label="Payment and purchase support">
  {%- if shop.enabled_payment_types.size > 0 -%}
    <div class="suntneew-purchase-panel__payments">
      <p>{{ 'suntneew_auto.s19ad36cd8256' | t }}</p>

      <ul role="list" aria-label="Accepted payment methods">
        {%- for payment_type in shop.enabled_payment_types -%}
          <li title="{{ payment_type | replace: '_', ' ' | capitalize }}">
            {{- payment_type | payment_type_svg_tag -}}
          </li>
        {%- endfor -%}
      </ul>
    </div>
