    {%- assign download_blocks = section.blocks | where: 'type', 'download' -%}
    {%- assign manual_count = 0 -%}
    {%- assign compliance_count = 0 -%}
    {%- assign qr_primary_document_url = '' -%}
    {%- for block in download_blocks -%}
      {%- assign document_group = block.settings.document_group | default: 'manuals' -%}
      {%- if block.settings.document_group == blank -%}
        {%- assign label_lower = block.settings.label | downcase -%}
        {%- if label_lower contains 'fcc' or label_lower contains 'emc' or label_lower contains 'rohs' or label_lower contains 'ip65' or label_lower contains 'ul ' or label_lower contains 'un38' or label_lower contains 'sds' or label_lower contains 'msds' or label_lower contains 'tdg' or label_lower contains 'dgm' or label_lower contains 'certificate' or label_lower contains 'report' or label_lower contains 'grant' -%}
          {%- assign document_group = 'compliance' -%}
        {%- endif -%}
      {%- endif -%}
      {%- if document_group == 'compliance' -%}
        {%- assign compliance_count = compliance_count | plus: 1 -%}
      {%- else -%}
        {%- assign manual_count = manual_count | plus: 1 -%}
        {%- if qr_primary_document_url == blank -%}
          {%- if block.settings.link != blank -%}
            {%- assign qr_primary_document_url = block.settings.link -%}
          {%- elsif block.settings.asset_name != blank -%}
            {%- assign qr_primary_document_url = block.settings.asset_name | asset_url -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if download_blocks.size > 0 -%}
      <div id="manuals" class="sn-pdp-details__panel" role="tabpanel" data-pdp-panel="manuals"{% if qr_support_enabled and template.suffix != 'kb700' %} data-qr-mobile="{{ template.suffix }}"{% endif %}>
        <p class="sn-pdp__eyebrow">{{ section.settings.download_eyebrow }}</p>
        <h2 class="sn-pdp__heading">{{ section.settings.download_heading }}</h2>

        {%- render 'suntneew-pdp-qr-mobile',
          section: section,
          product: product,
          template: template,
          download_blocks: download_blocks,
          manual_count: manual_count,
          compliance_count: compliance_count,
          qr_primary_document_url: qr_primary_document_url,
          qr_support_enabled: qr_support_enabled,
          qr_support_model: qr_support_model,
          qr_support_intro: qr_support_intro,
          qr_support_install_intro: qr_support_install_intro,
          qr_support_fact_one_value: qr_support_fact_one_value,
          qr_support_fact_one_label: qr_support_fact_one_label,
          qr_support_fact_two_value: qr_support_fact_two_value,
          qr_support_fact_two_label: qr_support_fact_two_label,
          qr_support_fact_three_value: qr_support_fact_three_value,
          qr_support_fact_three_label: qr_support_fact_three_label,
          qr_support_fact_four_value: qr_support_fact_four_value,
          qr_support_fact_four_label: qr_support_fact_four_label
        -%}

        {%- if template.suffix == 'kb700' -%}
          {%- liquid
            assign support_product_url = pages['support-kb700'].url | default: '/pages/support-kb700'
            assign online_manual_url = support_product_url | append: '#manual'
            assign certifications_url = support_product_url | append: '#certifications'
          -%}

          <div class="sn-pdp-resource-grid" aria-label="{{ section.settings.download_heading | escape }}">
            {%- for block in download_blocks -%}
              {%- assign document_group = block.settings.document_group | default: 'manuals' -%}
              {%- if document_group != 'compliance' -%}
                {%- assign manual_document_url = '' -%}
                {%- if block.settings.link != blank -%}
                  {%- assign manual_document_url = block.settings.link -%}
                {%- elsif block.settings.asset_name != blank -%}
                  {%- assign manual_document_url = block.settings.asset_name | asset_url -%}
                {%- endif -%}
                {%- if manual_document_url != blank -%}
                  <a class="sn-pdp-resource-card" href="{{ manual_document_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
                    <span class="sn-pdp-resource-card__eyebrow">{{ section.settings.pdf_card_eyebrow }}</span>
                    <strong>{{ block.settings.label }}</strong>
                    <span>{{ section.settings.pdf_card_description }}</span>
                    <small>{{ section.settings.pdf_card_action }} <span aria-hidden="true">&darr;</span></small>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            <a class="sn-pdp-resource-card sn-pdp-resource-card--primary" href="{{ online_manual_url }}">
              <span class="sn-pdp-resource-card__eyebrow">{{ section.settings.online_manual_eyebrow }}</span>
              <strong>{{ section.settings.online_manual_label }}</strong>
              <span>{{ section.settings.online_manual_description }}</span>
              <small>{{ section.settings.online_manual_action }} <span aria-hidden="true">&rarr;</span></small>
            </a>

            <a class="sn-pdp-resource-card sn-pdp-resource-card--compliance" href="{{ certifications_url }}">
              <span class="sn-pdp-resource-card__eyebrow">{{ section.settings.certifications_eyebrow }}</span>
              <strong>{{ section.settings.certifications_label }}</strong>
              <span>{{ section.settings.certifications_description }}</span>
              <small>{{ section.settings.certifications_action }} <span aria-hidden="true">&rarr;</span></small>
            </a>
          </div>

          <section class="sn-pdp-evidence" aria-labelledby="{{ section.id }}-compliance-heading">
            <div class="sn-pdp-evidence__heading">
              <div>
                <p class="sn-pdp__eyebrow">{{ section.settings.compliance_eyebrow }}</p>
                <h3 id="{{ section.id }}-compliance-heading">{{ section.settings.compliance_group_heading }}</h3>
              </div>
              {%- if section.settings.compliance_note != blank -%}<p>{{ section.settings.compliance_note }}</p>{%- endif -%}
            </div>
            <div class="sn-pdp-evidence__grid">
              {%- for block in download_blocks -%}
                {%- if block.settings.document_group == 'compliance' -%}
                  <div class="sn-pdp-evidence__item" {{ block.shopify_attributes }}>
                    <strong>{{ block.settings.standard | default: block.settings.label }}</strong>
                    {%- if block.settings.description != blank -%}<span>{{ block.settings.description }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- else -%}
        {%- if manual_count > 0 -%}
          <section class="sn-pdp-doc-group" aria-labelledby="{{ section.id }}-manuals-heading">
            <h3 id="{{ section.id }}-manuals-heading" class="sn-pdp-doc-group__heading">{{ section.settings.manuals_group_heading }}</h3>
            <div class="sn-pdp-downloads">
              {%- for block in download_blocks -%}
                {%- assign document_group = block.settings.document_group | default: 'manuals' -%}
                {%- if block.settings.document_group == blank -%}
                  {%- assign label_lower = block.settings.label | downcase -%}
                  {%- if label_lower contains 'fcc' or label_lower contains 'emc' or label_lower contains 'rohs' or label_lower contains 'ip65' or label_lower contains 'ul ' or label_lower contains 'un38' or label_lower contains 'sds' or label_lower contains 'msds' or label_lower contains 'tdg' or label_lower contains 'dgm' or label_lower contains 'certificate' or label_lower contains 'report' or label_lower contains 'grant' -%}
                    {%- assign document_group = 'compliance' -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if document_group != 'compliance' -%}
                  {%- if block.settings.link != blank -%}
                    <a class="sn-pdp-download" href="{{ block.settings.link }}" target="_blank" rel="noopener" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
                  {%- elsif block.settings.asset_name != blank -%}
                    <a class="sn-pdp-download" href="{{ block.settings.asset_name | asset_url }}" target="_blank" rel="noopener" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
                  {%- else -%}
                    <span class="sn-pdp-download" aria-disabled="true" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}

        {%- if compliance_count > 0 -%}
          {%- liquid
            assign compliance_library_anchor = ''
            case template.suffix
              when 'a20'
                assign compliance_library_anchor = 'jump-a20'
              when 'a3'
                assign compliance_library_anchor = 'jump-a3'
              when 'kb700'
                assign compliance_library_anchor = 'jump-kb700'
              when 'u23'
                assign compliance_library_anchor = 'jump-u23'
              when 'u32'
                assign compliance_library_anchor = 'jump-u32'
              when 'rv-g24', 'rv-g31'
                assign compliance_library_anchor = 'rv-g24-g31'
              when 'rv-230ah', 'rv-314ah'
                assign compliance_library_anchor = 'rv-230-314'
            endcase

            assign compliance_library_url = pages['technology'].url | default: '/pages/technology'
            if compliance_library_anchor != blank
              assign compliance_library_url = compliance_library_url | append: '#' | append: compliance_library_anchor
            endif
          -%}
          <section class="sn-pdp-doc-group" aria-labelledby="{{ section.id }}-compliance-heading">
            <h3 id="{{ section.id }}-compliance-heading" class="sn-pdp-doc-group__heading">{{ section.settings.compliance_group_heading }}</h3>
            {%- if template.suffix == 'rv-230ah' or template.suffix == 'oj02' -%}
              {%- if section.settings.compliance_note != blank -%}<p class="sn-pdp-doc-group__note">{{ section.settings.compliance_note | escape }}</p>{%- endif -%}
              <div class="sn-pdp-compliance-docs" aria-label="{{ section.settings.compliance_group_heading | escape }}">
                {%- for block in download_blocks -%}
                  {%- assign document_group = block.settings.document_group | default: 'manuals' -%}
                  {%- if block.settings.document_group == blank -%}
                    {%- assign label_lower = block.settings.label | downcase -%}
                    {%- if label_lower contains 'fcc' or label_lower contains 'emc' or label_lower contains 'rohs' or label_lower contains 'ip65' or label_lower contains 'ul ' or label_lower contains 'un38' or label_lower contains 'sds' or label_lower contains 'msds' or label_lower contains 'tdg' or label_lower contains 'dgm' or label_lower contains 'certificate' or label_lower contains 'report' or label_lower contains 'grant' -%}
                      {%- assign document_group = 'compliance' -%}
                    {%- endif -%}
                  {%- endif -%}
                  {%- if document_group == 'compliance' -%}
                    {%- assign compliance_standard = block.settings.standard | default: block.settings.label -%}
                    {%- assign compliance_document_url = '' -%}
                    {%- if block.settings.link != blank -%}
                      {%- assign compliance_document_url = block.settings.link -%}
                    {%- elsif block.settings.asset_name != blank and block.settings.public_copy_ready -%}
                      {%- assign compliance_document_url = block.settings.asset_name | asset_url -%}
                    {%- endif -%}
                    {%- if block.settings.public_copy_ready and compliance_document_url != blank -%}
                      <a class="sn-pdp-compliance-doc" href="{{ compliance_document_url }}" target="_blank" rel="noopener" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>
                        <strong>{{ compliance_standard }}</strong>
                        <span>{{ block.settings.label }}</span>
                        {%- if block.settings.description != blank -%}<small>{{ block.settings.description | escape }}</small>{%- endif -%}
                        <small>{{ section.settings.compliance_link_label }}</small>
                      </a>
                    {%- else -%}
                      <span class="sn-pdp-compliance-doc sn-pdp-compliance-doc--pending" aria-disabled="true" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>
                        <strong>{{ compliance_standard }}</strong>
                        <span>{{ block.settings.label }}</span>
                        {%- if block.settings.description != blank -%}<small>{{ block.settings.description | escape }}</small>{%- endif -%}
                        <small>{{ section.settings.compliance_pending_label }}</small>
                      </span>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- unless template.suffix == 'oj02' -%}
                <a class="sn-pdp-compliance-library-link" href="{{ compliance_library_url }}">
                  <span>{{ section.settings.compliance_library_label }}</span>
                  <span aria-hidden="true">→</span>
                </a>
              {%- endunless -%}
            {%- else -%}
              <div class="sn-pdp-compliance-overview">
                <div class="sn-pdp-compliance-badges" aria-label="{{ section.settings.compliance_group_heading | escape }}">
                  {%- assign compliance_standards_seen = '|' -%}
                {%- for block in download_blocks -%}
                  {%- assign document_group = block.settings.document_group | default: 'manuals' -%}
                  {%- if block.settings.document_group == blank -%}
                    {%- assign label_lower = block.settings.label | downcase -%}
                    {%- if label_lower contains 'fcc' or label_lower contains 'emc' or label_lower contains 'rohs' or label_lower contains 'ip65' or label_lower contains 'ul ' or label_lower contains 'un38' or label_lower contains 'sds' or label_lower contains 'msds' or label_lower contains 'tdg' or label_lower contains 'dgm' or label_lower contains 'certificate' or label_lower contains 'report' or label_lower contains 'grant' -%}
                      {%- assign document_group = 'compliance' -%}
                    {%- endif -%}
                  {%- endif -%}
                  {%- if document_group == 'compliance' -%}
                    {%- assign compliance_standard = block.settings.standard | default: block.settings.label -%}
                    {%- assign compliance_standard_lower = compliance_standard | downcase -%}
                    {%- assign compliance_standard_token = '|' | append: compliance_standard_lower | append: '|' -%}
                    {%- unless compliance_standards_seen contains compliance_standard_token -%}
                      <a class="sn-pdp-compliance-badge{% if compliance_standard_lower contains 'ul 2743' or compliance_standard_lower contains 'cell safety' %} sn-pdp-compliance-badge--ul{% endif %}" href="{{ compliance_library_url }}" {% if block.settings.variant_match != blank %}data-variant-match="{{ block.settings.variant_match | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ compliance_standard }}</a>
                      {%- assign compliance_standards_seen = compliance_standards_seen | append: compliance_standard_lower | append: '|' -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
                </div>
                <a class="sn-pdp-compliance-library-link" href="{{ compliance_library_url }}">
                  <span>{{ section.settings.compliance_library_label }}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            {%- endif -%}
          </section>
        {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
