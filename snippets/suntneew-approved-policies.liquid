{%- liquid
 assign support_url = pages[section.settings.support_handle].url | default: '/pages/contact-us'
 assign warranty_url = support_url
 if section.settings.category == 'Jump Starters'
  assign warranty_url = pages['warranty'].url | default: '/pages/warranty'
 endif
-%}
<dialog class="modal" id="approved-policy-warranty" aria-labelledby="approved-warranty-title"><button type="button" class="modal-close" data-approved-close aria-label="Close dialog">×</button><p class="eyebrow">WARRANTY &amp; SERVICE</p><h2 id="approved-warranty-title">{{ section.settings.warranty_label | escape }}</h2><p class="modal-lede">{{ section.settings.warranty_text | escape }}</p><div class="modal-body"><h3>Help with your {{ section.settings.model | escape }}</h3><p>Contact our team with your order number, model, a description of the issue, and clear photos or a short video. Keep your proof of purchase and follow the product instructions.</p></div><a class="button button-dark" href="{{ warranty_url }}">View {{ section.settings.model | escape }} warranty &amp; support <svg class="icon" aria-hidden="true"><use href="#sn-approved-icon-arrow"/></svg></a></dialog>
<dialog class="modal" id="approved-policy-returns" aria-labelledby="approved-returns-title"><button type="button" class="modal-close" data-approved-close aria-label="Close dialog">×</button><p class="eyebrow">A CLEAR RETURN WINDOW</p><h2 id="approved-returns-title">14-day returns.</h2><p class="modal-lede">Request an eligible return within 14 days after delivery. Contact us for approval and an RMA before shipping.</p><div class="modal-body"><h3>What is eligible?</h3><p>Unused items in resalable condition, with the original packaging, accessories and proof of purchase.</p><h3>Return shipping</h3><p>For a change of mind or an incorrectly chosen model, the customer pays return shipping. We cover return shipping for damaged, defective or incorrect items. Follow the approved carrier and packaging instructions when returning batteries.</p></div><a class="button button-dark" href="{{ pages['return-policy'].url | default: '/pages/return-policy' }}">Full return policy <svg class="icon" aria-hidden="true"><use href="#sn-approved-icon-arrow"/></svg></a></dialog>
<dialog class="modal" id="approved-policy-shipping" aria-labelledby="approved-shipping-title"><button type="button" class="modal-close" data-approved-close aria-label="Close dialog">×</button><p class="eyebrow">U.S. DELIVERY</p><h2 id="approved-shipping-title">Free standard shipping.</h2><p class="modal-lede">Delivery to the contiguous 48 United States and Washington, DC.</p><div class="modal-body"><h3>Processing and transit</h3><p>Allow 2 business days for processing, plus an estimated 2–5 business days in transit after dispatch. Business days are Monday–Friday, excluding public holidays. Delivery estimates are not guaranteed.</p><h3>Delivery area</h3><p>Alaska, Hawaii, Puerto Rico, other U.S. territories, military addresses and destinations outside the U.S. are excluded.</p></div><a class="button button-dark" href="{{ pages['shipping-policy'].url | default: '/pages/shipping-policy' }}">Full shipping policy <svg class="icon" aria-hidden="true"><use href="#sn-approved-icon-arrow"/></svg></a></dialog>
<dialog class="modal" id="approved-policy-support" aria-labelledby="approved-support-title"><button type="button" class="modal-close" data-approved-close aria-label="Close dialog">×</button><p class="eyebrow">BEFORE &amp; AFTER YOUR PURCHASE</p><h2 id="approved-support-title">A place to turn.</h2><p class="modal-lede">Help with selecting, setting up and using your {{ section.settings.model | escape }}.</p><div class="modal-body"><h3>Start with the right information</h3><p>Tell us the model and your question. For an order or service issue, include your order number and clear photos where useful.</p></div><a class="button button-dark" href="{{ support_url }}">{{ section.settings.model | escape }} product support <svg class="icon" aria-hidden="true"><use href="#sn-approved-icon-arrow"/></svg></a></dialog>
