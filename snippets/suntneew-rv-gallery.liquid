{% doc %}
  Renders the bundled RV battery gallery with the theme's standard product-gallery presentation.

  @param {product} product - Product associated with the gallery.
  @param {string} product_form_id - Product form identifier.
  @param {string} gallery_instance_id - Unique section instance identifier.
  @param {boolean} enable_image_zoom - Whether image zoom is enabled.
  @param {number} max_image_zoom_level - Maximum image zoom level.
  @param {string} mobile_carousel_control - Mobile carousel control style.
  @param {string} mobile_media_size - Mobile gallery width setting.
  @param {number} media_autoplay_interval - Image autoplay interval in seconds.
{% enddoc %}

{%- liquid
  assign rv_model = template.suffix | default: 'rv-230ah'
  assign gallery_assets = 'suntneew-rv-230ah-gallery-new-hero.jpg|suntneew-rv-230ah-gallery-terminal-source-crop-v1.png|suntneew-rv-230ah-new-lifestyle.jpg|suntneew-rv-230ah-new-monitoring.jpg|suntneew-rv-230ah-new-temperature.jpg|suntneew-rv-230ah-new-in-box.jpg'
  assign gallery_alts = 'SuntNeew 12.8V 230Ah LiFePO4 RV battery product view|SuntNeew 230Ah LiFePO4 battery terminal detail|SuntNeew 230Ah LiFePO4 battery beside a motorhome at a lakeside campsite|SuntNeew 230Ah LiFePO4 battery with Bluetooth monitoring|SuntNeew 230Ah LiFePO4 battery in a mountain RV setting|SuntNeew 230Ah LiFePO4 battery and included accessories'

  if rv_model == 'rv-314ah'
    assign gallery_assets = 'suntneew-rv-314ah-gallery-new-hero.jpg|suntneew-rv-314ah-gallery-terminal-source-crop-v1.png|suntneew-rv-314ah-new-lifestyle.jpg|suntneew-rv-314ah-new-monitoring.jpg|suntneew-rv-314ah-new-temperature.jpg|suntneew-rv-314ah-new-in-box.jpg'
    assign gallery_alts = 'SuntNeew 12.8V 314Ah LiFePO4 RV battery product view|SuntNeew 314Ah LiFePO4 battery terminal detail|SuntNeew 314Ah LiFePO4 battery beside a motorhome at a lakeside campsite|SuntNeew 314Ah LiFePO4 battery with Bluetooth monitoring|SuntNeew 314Ah LiFePO4 battery beside a motorhome and mountain lake|SuntNeew 314Ah LiFePO4 battery and included accessories'
  elsif rv_model == 'rv-g24'
    assign gallery_assets = 'suntneew-rv-g24-gallery-new-hero.jpg|suntneew-rv-g24-gallery-terminal-v1.png|suntneew-rv-g24-new-lifestyle.jpg|suntneew-rv-g24-new-monitoring.jpg|suntneew-rv-g24-new-temperature.jpg|suntneew-rv-g24-new-in-box.jpg'
    assign gallery_alts = 'SuntNeew Group 24 100Ah LiFePO4 RV battery product view|SuntNeew Group 24 battery terminal detail|SuntNeew Group 24 battery beside a motorhome at a lakeside campsite|SuntNeew Group 24 battery with Bluetooth monitoring|SuntNeew Group 24 battery in a snowy RV setting|SuntNeew Group 24 battery and included accessories'
  elsif rv_model == 'rv-g31'
    assign gallery_assets = 'suntneew-rv-g31-gallery-main.jpg|suntneew-rv-g31-final-gallery-rear-v3.jpg|suntneew-rv-g31-gallery-specs-v3.png|suntneew-rv-g31-final-gallery-lifestyle-v2.jpg|suntneew-rv-g31-final-gallery-bluetooth-v2.jpg|suntneew-rv-g31-gallery-cycles-15000-v2.png|suntneew-rv-g31-gallery-charging-4ways-v2.png|suntneew-rv-g31-gallery-runtime-v2.png|suntneew-rv-g31-final-gallery-in-box-v2.jpg'
    assign gallery_alts = 'SuntNeew 12.8V 100Ah Group 31 LiFePO4 RV battery product view|Rear three-quarter view of the SuntNeew Group 31 battery showing its top label, terminals and safety label|SuntNeew Group 31 battery dimensions, listed weight and IP65 enclosure rating|SuntNeew Group 31 battery installed in an RV service bay at a lakeside campsite|SuntNeew Group 31 battery with Bluetooth status monitoring inside an RV|Cycle-life references for the SuntNeew Group 31 battery at different depths of discharge|Four compatible charging paths for the SuntNeew Group 31 battery|Theoretical appliance runtime examples for the 1,280Wh Group 31 battery|SuntNeew Group 31 battery, terminal hardware, insulating caps and product manual'
  endif

  assign gallery_assets = gallery_assets | split: '|'
  assign gallery_alts = gallery_alts | split: '|'
  assign gallery_id = 'rv-product-gallery-' | append: product.id | append: '-' | append: gallery_instance_id
-%}

<product-gallery
  form="{{ product_form_id }}"
  filtered-indexes="[]"
  data-suntneew-media-gallery
  data-autoplay-interval="{{ media_autoplay_interval | default: 6 }}"
  {% if enable_image_zoom %}allow-zoom="{{ max_image_zoom_level }}"{% endif %}
  class="product-gallery {% if mobile_carousel_control contains 'dots' %}product-gallery--mobile-dots{% endif %} product-gallery--desktop-carousel"
>
  {%- capture page_dots -%}
    <page-dots class="page-dots {% if mobile_carousel_control == 'floating_dots' %}page-dots--blurred{% endif %} md:hidden" aria-controls="{{ gallery_id }}">
      {%- for asset_name in gallery_assets -%}
        <button type="button" class="tap-area" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
          <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
        </button>
      {%- endfor -%}
    </page-dots>
  {%- endcapture -%}

  <div class="product-gallery__ar-wrapper">
    <div class="product-gallery__media-list-wrapper">
      <custom-cursor class="product-gallery__cursor">
        <div class="circle-button circle-button--fill circle-button--lg">
          {%- render 'icon' with 'chevron-right' -%}
        </div>
      </custom-cursor>

      <media-carousel
        desktop-mode="carousel_thumbnails_bottom"
        adaptive-height
        initial-index="0"
        id="{{ gallery_id }}"
        class="product-gallery__media-list {% if mobile_media_size == 'expanded' %}full-bleed{% else %}bleed{% endif %} scroll-area md:unbleed"
      >
        {%- for asset_name in gallery_assets -%}
          <div class="product-gallery__media snap-center" data-media-type="image" data-media-id="{{ gallery_instance_id }}-rv-{{ forloop.index }}">
            <img
              src="{{ asset_name | asset_url }}"
              alt="{{ gallery_alts[forloop.index0] | escape }}"
              width="2000"
              height="2000"
              {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
            >
          </div>
        {%- endfor -%}
      </media-carousel>

      {%- if enable_image_zoom -%}
        <div class="product-gallery__zoom">
          <button type="button" is="product-zoom-button" class="circle-button circle-button--fill ring">
            <span class="sr-only">{{ 'product.gallery.zoom' | t }}</span>
            {%- render 'icon' with 'image-zoom' -%}
          </button>
        </div>
      {%- endif -%}

      {%- if mobile_carousel_control == 'floating_dots' -%}
        {{- page_dots -}}
      {%- endif -%}
    </div>
  </div>

  <div class="suntneew-media-modes" role="tablist" aria-label="Product media">
    <button type="button" class="suntneew-media-modes__button" data-media-mode="image" role="tab" aria-selected="true">
      <span class="suntneew-media-modes__icon" aria-hidden="true">▣</span>
      Features
    </button>
  </div>

  {%- if mobile_carousel_control == 'dots' -%}
    {{- page_dots -}}
  {%- endif -%}

  <scroll-shadow class="product-gallery__thumbnail-list-wrapper">
    <page-dots align-selected class="product-gallery__thumbnail-list scroll-area bleed md:unbleed" aria-controls="{{ gallery_id }}">
      {%- for asset_name in gallery_assets -%}
        <button
          type="button"
          class="product-gallery__thumbnail"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="{{ 'general.accessibility.go_to_item' | t: index: forloop.index | escape }}"
          data-media-id="{{ gallery_instance_id }}-rv-{{ forloop.index }}"
          data-media-type="image"
        >
          <img src="{{ asset_name | asset_url }}" alt="" width="128" height="128" loading="lazy" class="object-contain rounded-sm">
        </button>
      {%- endfor -%}
    </page-dots>
  </scroll-shadow>
</product-gallery>
