{% doc %}
Renders a line icon for the SuntNeew calculator.

@param {string} icon - Icon name.
@param {string} [class] - Optional CSS class.

@example
{% render 'suntneew-calculator-icon', icon: 'refrigerator' %}
{% enddoc %}

